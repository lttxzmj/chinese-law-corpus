  "articles": [
    {
      "id": "xzfg-f272d9160c-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了保证船舶、海上设施和船运货物集装箱具备安全航行、安全作业的技术条件，保障人民生命财产的安全和防止水域环境污染，制定本条例。",
      "order": 2
    },
    {
      "id": "xzfg-f272d9160c-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "本条例适用于：\n(一)在中华人民共和国登记或者将在中华人民共和国登记的船舶(以下简称中国籍船舶)；\n(二)根据本条例或者国家有关规定申请检验的外国籍船舶；\n(三)在中华人民共和国沿海水域内设置或者将在中华人民共和国沿海水域内设置的海上设施(以下简称海上设施)；\n(四)在中华人民共和国登记的企业法人所拥有的船运货物集装箱(以下简称集装箱)。",
      "order": 3
    },
    {
      "id": "xzfg-f272d9160c-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "中华人民共和国船舶检验局(以下简称船检局)是依照本条例规定实施各项检验工作的主管机构。\n经国务院交通主管部门批准，船检局可以在主要港口和工业区设置船舶检验机构。\n经国务院交通主管部门和省、自治区、直辖市人民政府批准，省、自治区、直辖市人民政府交通主管部门可以在所辖港口设置地方船舶检验机构。",
      "order": 8
    },
    {
      "id": "xzfg-f272d9160c-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "中国船级社是社会团体性质的船舶检验机构，承办国内外船舶、海上设施和集装箱的入级检验、鉴证检验和公证检验业务；经船检局授权，可以代行法定检验。",
      "order": 11
    },
    {
      "id": "xzfg-f272d9160c-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "实施本条例规定的各项检验，应当贯彻安全第一、质量第一的原则，鼓励新技术的开发和应用。",
      "order": 12
    },
    {
      "id": "xzfg-f272d9160c-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第二章船舶检验"
      ],
      "text": "船舶检验分别由下列机构实施：\n(一)船检局设置的船舶检验机构；\n(二)省、自治区、直辖市人民政府交通主管部门设置的地方船舶检验机构；\n(三)船检局委托、指定或者认可的检验机构。\n前款所列机构，以下统称船舶检验机构。",
      "order": 14
    },
    {
      "id": "xzfg-f272d9160c-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第二章船舶检验"
      ],
      "text": "中国籍船舶的所有人或者经营人，必须向船舶检验机构申请下列检验：\n(一)建造或者改建船舶时，申请建造检验；\n(二)营运中的船舶，申请定期检验；\n(三)由外国籍船舶改为中国籍船舶的，申请初次检验。",
      "order": 19
    },
    {
      "id": "xzfg-f272d9160c-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第二章船舶检验"
      ],
      "text": "中国籍船舶所使用的有关海上交通安全的和防止水域环境污染的重要设备、部件和材料，须经船舶检验机构按照有关规定检验。",
      "order": 23
    },
    {
      "id": "xzfg-f272d9160c-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第二章船舶检验"
      ],
      "text": "中国籍船舶须由船舶检验机构测定总吨位和净吨位，核定载重线和乘客定额。",
      "order": 24
    },
    {
      "id": "xzfg-f272d9160c-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第二章船舶检验"
      ],
      "text": "在中国沿海水域从事钻探、开发作业的外国籍钻井船、移动式平台的所有人或者经营人，必须向船检局设置或者指定的船舶检验机构申请下列检验：\n(一)作业前检验；\n(二)作业期间的定期检验。",
      "order": 25
    },
    {
      "id": "xzfg-f272d9160c-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第二章船舶检验"
      ],
      "text": "中国沿海水域内的移动式平台、浮船坞和其他大型设施进行拖带航行，起拖前必须向船检局设置的或者指定的船舶检验机构申请拖航检验。",
      "order": 28
    },
    {
      "id": "xzfg-f272d9160c-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第二章船舶检验"
      ],
      "text": "中国籍船舶有下列情形之一的，船舶所有人或者经营人必须向船舶检验机构申请临时检验：\n(一)因发生事故，影响船舶适航性能的；\n(二)改变船舶证书所限定的用途或者航区的；\n(三)船舶检验机构签发的证书失效的；\n(四)海上交通安全或者环境保护主管机关责成检验的。\n在中国港口内的外国籍船舶，有前款(一)、(四)项所列情形之一的，必须向船检局设置或者指定的船舶检验机构申请临时检验。",
      "order": 29
    },
    {
      "id": "xzfg-f272d9160c-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第二章船舶检验"
      ],
      "text": "下列中国籍船舶，必须向中国船级社申请入级检验：\n(一)从事国际航行的船舶；\n(二)在海上航行的乘客定额一百人以上的客船；\n(三)载重量一千吨以上的油船；\n(四)滚装船、液化气体运输船和散装化学品运输船；\n(五)船舶所有人或者经营人要求入级的其他船舶。",
      "order": 35
    },
    {
      "id": "xzfg-f272d9160c-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第二章船舶检验"
      ],
      "text": "船舶经检验合格后，船舶检验机构应当按照规定签发相应的检验证书。",
      "order": 41
    },
    {
      "id": "xzfg-f272d9160c-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第三章海上设施检验"
      ],
      "text": "海上设施的所有人或者经营人，必须向船检局设置或者指定的船舶检验机构申请下列检验，但是本条例第三十一条规定的除外：\n(一)建造或者改建海上设施时，申请建造检验；\n(二)使用中的海上设施，申请定期检验；\n(三)因发生事故影响海上设施安全性能的，申请临时检验；\n(四)海上交通安全或者环境保护主管机关责成检验的，申请临时检验。",
      "order": 43
    },
    {
      "id": "xzfg-f272d9160c-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第三章海上设施检验"
      ],
      "text": "海上设施经检验合格后，船舶检验机构应当按照规定签发相应的检验证书。",
      "order": 48
    },
    {
      "id": "xzfg-f272d9160c-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第四章集装箱检验"
      ],
      "text": "集装箱的所有人或者经营人，必须向船检局设置或者指定的船舶检验机构申请下列检验：\n(一)制造集装箱时，申请制造检验；\n(二)使用中的集装箱，申请定期检验。",
      "order": 50
    },
    {
      "id": "xzfg-f272d9160c-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第四章集装箱检验"
      ],
      "text": "集装箱经检验合格后，船舶检验机构应当按照规定签发相应的检验证书。",
      "order": 53
    },
    {
      "id": "xzfg-f272d9160c-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第五章检验管理"
      ],
      "text": "船舶、海上设施、集装箱的检验制度和技术规范，除本条例第三十一条规定的外，由船检局制订，经国务院交通主管部门批准后公布施行。",
      "order": 55
    },
    {
      "id": "xzfg-f272d9160c-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第五章检验管理"
      ],
      "text": "船舶检验机构的检验人员，必须具备相应的专业知识和检验技能，并经考核合格。",
      "order": 56
    },
    {
      "id": "xzfg-f272d9160c-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第五章检验管理"
      ],
      "text": "检验人员执行检验任务或者对事故进行技术分析调查时，有关单位应当提供必要的条件。",
      "order": 57
    },
    {
      "id": "xzfg-f272d9160c-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第五章检验管理"
      ],
      "text": "船舶检验机构实施检验，按照规定收取费用。收费办法由国务院交通主管部门会同国务院物价主管部门、国务院财政主管部门制定。",
      "order": 58
    },
    {
      "id": "xzfg-f272d9160c-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第五章检验管理"
      ],
      "text": "当事人对船舶检验机构的检验结论有异议的，可以向上一级检验机构申请复验；对复验结论仍有异议的，可以向船检局提出再复验，由船检局组织技术专家组进行检验、评议，作出最终结论。",
      "order": 59
    },
    {
      "id": "xzfg-f272d9160c-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第五章检验管理"
      ],
      "text": "任何单位和个人不得涂改、伪造检验证书，不得擅自更改船舶检验机构勘划的船舶载重线。",
      "order": 60
    },
    {
      "id": "xzfg-f272d9160c-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第五章检验管理"
      ],
      "text": "关于外国船舶检验机构在中国境内设置常驻代表机构或者派驻检验人员的管理办法，由国务院交通主管部门制定。",
      "order": 61
    },
    {
      "id": "xzfg-f272d9160c-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第六章罚则"
      ],
      "text": "涂改检验证书、擅自更改船舶载重线或者以欺骗行为获取检验证书的，船检局或者其委托的检验机构有权撤销已签发的相应证书，并可以责令改正或者补办有关手续。",
      "order": 63
    },
    {
      "id": "xzfg-f272d9160c-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第六章罚则"
      ],
      "text": "伪造船舶检验证书或者擅自更改船舶载重线的，由有关行政主管机关给予通报批评，并可以处以相当于相应的检验费一倍至五倍的罚款；构成犯罪的，由司法机关依法追究刑事责任。",
      "order": 64
    },
    {
      "id": "xzfg-f272d9160c-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第六章罚则"
      ],
      "text": "船舶检验机构的检验人员滥用职权、徇私舞弊、玩忽职守、严重失职的，由所在单位或者上级机关给予行政处分或者撤销其检验资格；情节严重，构成犯罪的，由司法机关依法追究刑事责任。",
      "order": 65
    },
    {
      "id": "xzfg-f272d9160c-0029",
      "articleNumber": 29,
      "displayNumber": "第二十九条",
      "path": [
        "第七章附则"
      ],
      "text": "本条例下列用语的定义：\n(一)船舶，是指各类排水或者非排水船、艇、水上飞机、潜水器和移动式平台。\n(二)海上设施，是指水上水下各种固定或者浮动建筑、装置和固定平台。\n(三)沿海水域，是指中华人民共和国沿海的港口、内水和领海以及国家管辖的一切其他海域。",
      "order": 67
    },
    {
      "id": "xzfg-f272d9160c-0030",
      "articleNumber": 30,
      "displayNumber": "第三十条",
      "path": [
        "第七章附则"
      ],
      "text": "除从事国际航行的渔业辅助船舶依照本条例进行检验外，其他渔业船舶的检验，由国务院交通运输主管部门按照相关渔业船舶检验的行政法规执行。",
      "order": 71
    },
    {
      "id": "xzfg-f272d9160c-0031",
      "articleNumber": 31,
      "displayNumber": "第三十一条",
      "path": [
        "第七章附则"
      ],
      "text": "海上设施中的海上石油天然气生产设施的检验，由国务院石油主管部门会同国务院交通主管部门另行规定。",
      "order": 72
    },
    {
      "id": "xzfg-f272d9160c-0032",
      "articleNumber": 32,
      "displayNumber": "第三十二条",
      "path": [
        "第七章附则"
      ],
      "text": "下列船舶不适用本条例：\n(一)军用舰艇、公安船艇和体育运动船艇；\n(二)按照船舶登记规定，不需要登记的船舶。",
      "order": 73
    },
    {
      "id": "xzfg-f272d9160c-0033",
      "articleNumber": 33,
      "displayNumber": "第三十三条",
      "path": [
        "第七章附则"
      ],
      "text": "本条例自发布之日起施行。",
      "order": 76
    }
  ]
}
