  "articles": [
    {
      "id": "xzfg-9f85a0a4ae-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了严格控制机关、团体建设楼堂馆所，厉行节约、反对浪费，制定本条例。",
      "order": 2
    },
    {
      "id": "xzfg-9f85a0a4ae-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "机关、团体建设楼堂馆所，适用本条例。\n本条例所称建设，是指新建、扩建、改建、购置；所称楼堂馆所，是指办公用房以及培训中心等各类具有住宿、会议、餐饮等接待功能的场所和设施。",
      "order": 3
    },
    {
      "id": "xzfg-9f85a0a4ae-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "建设办公用房应当严格履行审批程序，严格执行建设标准。未经批准，不得建设办公用房。\n禁止以技术业务用房等名义建设办公用房或者违反规定在技术业务用房中设置办公用房。",
      "order": 5
    },
    {
      "id": "xzfg-9f85a0a4ae-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "建设办公用房应当遵循朴素、实用、安全、节能的原则。\n国务院发展改革部门会同国务院住房城乡建设部门、财政部门制定办公用房建设标准，并向社会公布。",
      "order": 7
    },
    {
      "id": "xzfg-9f85a0a4ae-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "机关、团体不得建设培训中心等各类具有住宿、会议、餐饮等接待功能的场所和设施。",
      "order": 9
    },
    {
      "id": "xzfg-9f85a0a4ae-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第二章项目审批"
      ],
      "text": "建设办公用房的，应当向负责项目审批的机关(以下简称审批机关)报送项目建议书、可行性研究报告、初步设计；购置办公用房的，不报送初步设计。\n根据办公用房项目的具体情况，经审批机关同意，项目建议书、可行性研究报告、初步设计可以合并编制报送。",
      "order": 11
    },
    {
      "id": "xzfg-9f85a0a4ae-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第二章项目审批"
      ],
      "text": "办公用房项目的审批机关及其审批权限，按照国家有关规定执行。",
      "order": 13
    },
    {
      "id": "xzfg-9f85a0a4ae-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第二章项目审批"
      ],
      "text": "审批机关应当严格审核办公用房项目，按照建设标准核定建设内容、建设规模和投资概算。",
      "order": 14
    },
    {
      "id": "xzfg-9f85a0a4ae-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第二章项目审批"
      ],
      "text": "办公用房项目有下列情形之一的，审批机关不得批准：\n(一)属于禁止建设办公用房的情形；\n(二)建设的必要性不充分；\n(三)建设资金来源不符合规定；\n(四)建设内容、建设规模等不符合建设标准；\n(五)其他不得批准的情形。",
      "order": 15
    },
    {
      "id": "xzfg-9f85a0a4ae-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第二章项目审批"
      ],
      "text": "对未经批准的办公用房项目，不得办理规划、用地、施工等相关手续，不得安排预算、拨付资金。",
      "order": 21
    },
    {
      "id": "xzfg-9f85a0a4ae-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第二章项目审批"
      ],
      "text": "办公用房项目应当按照审批机关核定的建设内容、建设规模和投资概算进行设计、施工。因国家政策调整、价格上涨、地质条件发生重大变化等原因确需增加投资概算的，应当经原审批机关批准。",
      "order": 22
    },
    {
      "id": "xzfg-9f85a0a4ae-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第二章项目审批"
      ],
      "text": "审批机关应当完善审批工作流程，建立健全审批工作责任制和内部监督机制。",
      "order": 23
    },
    {
      "id": "xzfg-9f85a0a4ae-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第三章建设资金"
      ],
      "text": "办公用房项目的建设资金由预算资金安排。\n办公用房项目的建设资金来源不得有下列情形：\n(一)挪用各类专项资金；\n(二)向单位、个人摊派；\n(三)向银行等金融机构借款；\n(四)接受赞助或者捐赠；\n(五)其他违反规定的情形。",
      "order": 25
    },
    {
      "id": "xzfg-9f85a0a4ae-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第三章建设资金"
      ],
      "text": "办公用房项目的建设资金按照国库集中支付制度的有关规定支付。",
      "order": 32
    },
    {
      "id": "xzfg-9f85a0a4ae-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第三章建设资金"
      ],
      "text": "办公用房项目竣工后，建设单位应当按照规定及时组织编报竣工财务决算，并及时办理固定资产入账手续。",
      "order": 33
    },
    {
      "id": "xzfg-9f85a0a4ae-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第四章监督检查"
      ],
      "text": "审批机关、财政部门、审计机关、监察机关(以下统称监督检查机关)应当按照各自的职责，加强对建设楼堂馆所活动的监督检查和绩效评价。\n监督检查机关应当密切配合，建立信息共享机制，并根据实际需要开展联合监督检查、专项监督检查。",
      "order": 35
    },
    {
      "id": "xzfg-9f85a0a4ae-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第四章监督检查"
      ],
      "text": "监督检查机关对建设楼堂馆所活动实施监督检查，有权要求建设单位以及其他相关单位提供有关文件和资料，向有关人员了解情况，进行现场核查。建设单位以及其他相关单位对监督检查应当予以配合，不得拒绝、阻碍。",
      "order": 37
    },
    {
      "id": "xzfg-9f85a0a4ae-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第四章监督检查"
      ],
      "text": "建设单位应当按照有关规定加强办公用房项目档案管理，将项目审批和实施过程中的有关文件、资料存档备查。",
      "order": 38
    },
    {
      "id": "xzfg-9f85a0a4ae-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第四章监督检查"
      ],
      "text": "除依法应当保密的情形外，下列信息应当通过政府网站等便于公众知晓的方式公开：\n(一)办公用房项目审批情况，包括建设单位名称、批准的理由以及建设内容、建设规模、投资概算等；增加投资概算的，还应当公开增加投资概算的情况和理由。\n(二)监督检查情况，包括发现的违法建设楼堂馆所的单位名称、基本事实以及处理结果等。",
      "order": 39
    },
    {
      "id": "xzfg-9f85a0a4ae-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第四章监督检查"
      ],
      "text": "对违反本条例规定的行为，任何单位和个人有权向监督检查机关举报。\n监督检查机关应当通过公开举报电话和邮箱、在政府网站设置举报专栏等方式，接受单位和个人的举报，并及时依法处理。",
      "order": 42
    },
    {
      "id": "xzfg-9f85a0a4ae-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第五章法律责任"
      ],
      "text": "机关、团体有下列情形之一的，根据具体情况责令停止相关建设活动或者改正，对所涉楼堂馆所予以收缴、拍卖或者责令限期腾退，对负有责任的领导人员和直接责任人员依法给予处分：\n(一)建设培训中心等各类具有住宿、会议、餐饮等接待功能的场所和设施；\n(二)未经批准建设办公用房；\n(三)以技术业务用房等名义建设办公用房，或者违反规定在技术业务用房中设置办公用房；\n(四)擅自改变建设内容、扩大建设规模，或者擅自增加投资概算；\n(五)办公用房项目建设资金来源不符合规定。",
      "order": 45
    },
    {
      "id": "xzfg-9f85a0a4ae-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第五章法律责任"
      ],
      "text": "有下列情形之一的，责令改正，对负有责任的领导人员和直接责任人员依法给予处分：\n(一)超越审批权限审批办公用房项目；\n(二)对不符合规定的办公用房项目予以批准；\n(三)对未经批准的办公用房项目办理规划、用地、施工等相关手续，或者安排预算、拨付资金；\n(四)其他滥用职权、玩忽职守、徇私舞弊的情形。",
      "order": 51
    },
    {
      "id": "xzfg-9f85a0a4ae-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第五章法律责任"
      ],
      "text": "建设单位未按照规定将办公用房项目审批和实施过程中的有关文件、资料存档备查，或者转移、隐匿、篡改、毁弃有关文件、资料的，责令改正，对负有责任的领导人员和直接责任人员依法给予处分。",
      "order": 56
    },
    {
      "id": "xzfg-9f85a0a4ae-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第五章法律责任"
      ],
      "text": "本条例第二十一条至第二十三条规定的处分，由监察机关或者其他有关机关按照管理权限实施，其他处理措施由审批机关实施。",
      "order": 57
    },
    {
      "id": "xzfg-9f85a0a4ae-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第五章法律责任"
      ],
      "text": "违反本条例规定，构成犯罪的，依法追究刑事责任。",
      "order": 58
    },
    {
      "id": "xzfg-9f85a0a4ae-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第六章附则"
      ],
      "text": "本条例所称团体，是指工会、共青团、妇联等人民团体。",
      "order": 60
    },
    {
      "id": "xzfg-9f85a0a4ae-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第六章附则"
      ],
      "text": "财政给予经费保障的事业单位和人民团体以外的其他团体建设楼堂馆所，参照适用本条例。",
      "order": 61
    },
    {
      "id": "xzfg-9f85a0a4ae-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第六章附则"
      ],
      "text": "机关、人民团体、财政给予经费保障的事业单位和其他团体维修办公用房，应当严格履行审批程序，执行维修标准。禁止进行超标准装修或者配置超标准的设施。\n违反前款规定的，根据具体情况责令停止维修活动或者改正，对负有责任的领导人员和直接责任人员依法给予处分。",
      "order": 62
    },
    {
      "id": "xzfg-9f85a0a4ae-0029",
      "articleNumber": 29,
      "displayNumber": "第二十九条",
      "path": [
        "第六章附则"
      ],
      "text": "财政给予经费补助的事业单位和人民团体以外的其他团体建设、维修楼堂馆所的管理办法，由国务院发展改革部门会同国务院财政部门、住房城乡建设部门等有关部门以及有关机关事务管理部门按照确有必要、严格控制的原则制定。\n国有企业建设、维修楼堂馆所的管理办法，由国务院发展改革部门会同国务院国有资产监督管理机构、财政部门、住房城乡建设部门等有关部门，按照前款规定的原则制定。",
      "order": 64
    },
    {
      "id": "xzfg-9f85a0a4ae-0030",
      "articleNumber": 30,
      "displayNumber": "第三十条",
      "path": [
        "第六章附则"
      ],
      "text": "军队单位建设、维修楼堂馆所，按照军队的有关规定执行。",
      "order": 66
    },
    {
      "id": "xzfg-9f85a0a4ae-0031",
      "articleNumber": 31,
      "displayNumber": "第三十一条",
      "path": [
        "第六章附则"
      ],
      "text": "本条例自2017年12月1日起施行。国务院1988年9月22日发布施行的《楼堂馆所建设管理暂行条例》同时废止。",
      "order": 67
    }
  ]
}
