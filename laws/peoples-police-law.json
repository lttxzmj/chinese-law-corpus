  "articles": [
    {
      "id": "peoples-police-law-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了维护国家安全和社会治安秩序，保护公民的合法权益，加强人民警察的队伍建设，从严治警，提高人民警察的素质，保障人民警察依法行使职权，保障改革开放和社会主义现代化建设的顺利进行，根据宪法，制定本法。",
      "order": 2
    },
    {
      "id": "peoples-police-law-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "人民警察的任务是维护国家安全，维护社会治安秩序，保护公民的人身安全、人身自由和合法财产，保护公共财产，预防、制止和惩治违法犯罪活动。\n人民警察包括公安机关、国家安全机关、监狱、劳动教养管理机关的人民警察和人民法院、人民检察院的司法警察。",
      "order": 3
    },
    {
      "id": "peoples-police-law-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "人民警察必须依靠人民的支持，保持同人民的密切联系，倾听人民的意见和建议，接受人民的监督，维护人民的利益，全心全意为人民服务。",
      "order": 5
    },
    {
      "id": "peoples-police-law-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "人民警察必须以宪法和法律为活动准则，忠于职守，清正廉洁，纪律严明，服从命令，严格执法。",
      "order": 6
    },
    {
      "id": "peoples-police-law-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "人民警察依法执行职务，受法律保护。",
      "order": 7
    },
    {
      "id": "peoples-police-law-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第二章职权"
      ],
      "text": "公安机关的人民警察按照职责分工，依法履行下列职责：\n（一）预防、制止和侦查违法犯罪活动；\n（二）维护社会治安秩序，制止危害社会治安秩序的行为；\n（三）维护交通安全和交通秩序，处理交通事故；\n（四）组织、实施消防工作，实行消防监督；\n（五）管理枪支弹药、管制刀具和易燃易爆、剧毒、放射性等危险物品；\n（六）对法律、法规规定的特种行业进行管理；\n（七）警卫国家规定的特定人员，守卫重要的场所和设施；\n（八）管理集会、游行、示威活动；\n（九）管理户政、国籍、入境出境事务和外国人在中国境内居留、旅行的有关事务；\n（十）维护国（边）境地区的治安秩序；\n（十一）对被判处拘役、剥夺政治权利的罪犯执行刑罚；\n（十二）监督管理计算机信息系统的安全保护工作；\n（十三）指导和监督国家机关、社会团体、企业事业组织和重点建设工程的治安保卫工作，指导治安保卫委员会等群众性组织的治安防范工作；\n（十四）法律、法规规定的其他职责。",
      "order": 9
    },
    {
      "id": "peoples-police-law-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第二章职权"
      ],
      "text": "公安机关的人民警察对违反治安管理或者其他公安行政管理法律、法规的个人或者组织，依法可以实施行政强制措施、行政处罚。",
      "order": 24
    },
    {
      "id": "peoples-police-law-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第二章职权"
      ],
      "text": "公安机关的人民警察对严重危害社会治安秩序或者威胁公共安全的人员，可以强行带离现场、依法予以拘留或者采取法律规定的其他措施。",
      "order": 25
    },
    {
      "id": "peoples-police-law-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第二章职权"
      ],
      "text": "为维护社会治安秩序，公安机关的人民警察对有违法犯罪嫌疑的人员，经出示相应证件，可以当场盘问、检查；经盘问、检查，有下列情形之一的，可以将其带至公安机关，经该公安机关批准，对其继续盘问：\n（一）被指控有犯罪行为的；\n（二）有现场作案嫌疑的；\n（三）有作案嫌疑身份不明的；\n（四）携带的物品有可能是赃物的。\n对被盘问人的留置时间自带至公安机关之时起不超过二十四小时，在特殊情况下，经县级以上公安机关批准，可以延长至四十八小时，并应当留有盘问记录。对于批准继续盘问的，应当立即通知其家属或者其所在单位。对于不批准继续盘问的，应当立即释放被盘问人。\n经继续盘问，公安机关认为对被盘问人需要依法采取拘留或者其他强制措施的，应当在前款规定的期间作出决定；在前款规定的期间不能作出上述决定的，应当立即释放被盘问人。",
      "order": 26
    },
    {
      "id": "peoples-police-law-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第二章职权"
      ],
      "text": "遇有拒捕、暴乱、越狱、抢夺枪支或者其他暴力行为的紧急情况，公安机关的人民警察依照国家有关规定可以使用武器。",
      "order": 33
    },
    {
      "id": "peoples-police-law-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第二章职权"
      ],
      "text": "为制止严重违法犯罪活动的需要，公安机关的人民警察依照国家有关规定可以使用警械。",
      "order": 34
    },
    {
      "id": "peoples-police-law-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第二章职权"
      ],
      "text": "为侦查犯罪活动的需要，公安机关的人民警察可以依法执行拘留、搜查、逮捕或者其他强制措施。",
      "order": 35
    },
    {
      "id": "peoples-police-law-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第二章职权"
      ],
      "text": "公安机关的人民警察因履行职责的紧急需要、经出示相应证件，可以优先乘坐公共交通工具，遇交通阻碍时，优先通行。\n公安机关因侦查犯罪的需要，必要时，按照国家有关规定，可以优先使用机关、团体、企业事业组织和个人的交通工具、通信工具、场地和建筑物，用后应当及时归还，并支付适当费用；造成损失的，应当赔偿。",
      "order": 36
    },
    {
      "id": "peoples-police-law-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第二章职权"
      ],
      "text": "公安机关的人民警察对严重危害公共安全或者他人人身安全的精神病人，可以采取保护性约束措施。需要送往指定的单位、场所加以监护的，应当报请县级以上人民政府公安机关批准，并及时通知其监护人。",
      "order": 38
    },
    {
      "id": "peoples-police-law-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第二章职权"
      ],
      "text": "县级以上人民政府公安机关，为预防和制止严重危害社会治安秩序的行为，可以在一定的区域和时间，限制人员、车辆的通行或者停留，必要时可以实行交通管制。\n公安机关的人民警察依照前款规定，可以采取相应的交通管制措施。",
      "order": 39
    },
    {
      "id": "peoples-police-law-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第二章职权"
      ],
      "text": "公安机关因侦查犯罪的需要，根据国家有关规定，经过严格的批准手续，可以采取技术侦察措施。",
      "order": 41
    },
    {
      "id": "peoples-police-law-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第二章职权"
      ],
      "text": "县级以上人民政府公安机关，经上级公安机关和同级人民政府批准，对严重危害社会治安秩序的突发事件，可以根据情况实行现场管制。\n公安机关的人民警察依照前款规定，可以采取必要手段强行驱散，并对拒不服从的人员强行带离现场或者立即予以拘留。",
      "order": 42
    },
    {
      "id": "peoples-police-law-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第二章职权"
      ],
      "text": "国家安全机关、监狱、劳动教养管理机关的人民警察和人民法院、人民检察院的司法警察，分别依照有关法律、行政法规的规定履行职权。",
      "order": 44
    },
    {
      "id": "peoples-police-law-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第二章职权"
      ],
      "text": "人民警察在非工作时间，遇有其职责范围内的紧急情况，应当履行职责。",
      "order": 45
    },
    {
      "id": "peoples-police-law-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第三章义务和纪律"
      ],
      "text": "人民警察必须做到：\n（一）秉公执法，办事公道；\n（二）模范遵守社会公德；\n（三）礼貌待人，文明执勤；\n（四）尊重人民群众的风俗习惯。",
      "order": 47
    },
    {
      "id": "peoples-police-law-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第三章义务和纪律"
      ],
      "text": "人民警察遇到公民人身、财产安全受到侵犯或者处于其他危难情形，应当立即救助；对公民提出解决纠纷的要求，应当给予帮助；对公民的报警案件，应当及时查处。\n人民警察应当积极参加抢险救灾和社会公益工作。",
      "order": 52
    },
    {
      "id": "peoples-police-law-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第三章义务和纪律"
      ],
      "text": "人民警察不得有下列行为：\n（一）散布有损国家声誉的言论，参加非法组织，参加旨在反对国家的集会、游行、示威等活动，参加罢工；\n（二）泄露国家秘密、警务工作秘密；\n（三）弄虚作假，隐瞒案情，包庇、纵容违法犯罪活动；\n（四）刑讯逼供或者体罚、虐待人犯；\n（五）非法剥夺、限制他人人身自由，非法搜查他人的身体、物品、住所或者场所；\n（六）敲诈勒索或者索取、收受贿赂；\n（七）殴打他人或者唆使他人打人；\n（八）违法实施处罚或者收取费用；\n（九）接受当事人及其代理人的请客送礼；\n（十）从事营利性的经营活动或者受雇于任何个人或者组织；\n（十一）玩忽职守，不履行法定义务；\n（十二）其他违法乱纪的行为。",
      "order": 54
    },
    {
      "id": "peoples-police-law-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第三章义务和纪律"
      ],
      "text": "人民警察必须按照规定着装，佩带人民警察标志或者持有人民警察证件，保持警容严整，举止端庄。",
      "order": 67
    },
    {
      "id": "peoples-police-law-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第四章组织管理"
      ],
      "text": "国家根据人民警察的工作性质、任务和特点，规定组织机构设置和职务序列。",
      "order": 69
    },
    {
      "id": "peoples-police-law-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第四章组织管理"
      ],
      "text": "人民警察依法实行警衔制度。",
      "order": 70
    },
    {
      "id": "peoples-police-law-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第四章组织管理"
      ],
      "text": "担任人民警察应当具备下列条件：\n（一）年满十八岁的公民；\n（二）拥护中华人民共和国宪法；\n（三）有良好的政治、业务素质和良好的品行；\n（四）身体健康；\n（五）具有高中毕业以上文化程度；\n（六）自愿从事人民警察工作。\n有下列情形之一的，不得担任人民警察：\n（一）曾因犯罪受过刑事处罚的；\n（二）曾被开除公职的。",
      "order": 71
    },
    {
      "id": "peoples-police-law-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第四章组织管理"
      ],
      "text": "录用人民警察，必须按照国家规定，公开考试，严格考核，择优选用。",
      "order": 81
    },
    {
      "id": "peoples-police-law-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第四章组织管理"
      ],
      "text": "担任人民警察领导职务的人员，应当具备下列条件：\n（一）具有法律专业知识；\n（二）具有政法工作经验和一定的组织管理、指挥能力；\n（三）具有大学专科以上学历；\n（四）经人民警察院校培训，考试合格。",
      "order": 82
    },
    {
      "id": "peoples-police-law-0029",
      "articleNumber": 29,
      "displayNumber": "第二十九条",
      "path": [
        "第四章组织管理"
      ],
      "text": "国家发展人民警察教育事业，对人民警察有计划地进行政治思想、法制、警察业务等教育培训。",
      "order": 87
    },
    {
      "id": "peoples-police-law-0030",
      "articleNumber": 30,
      "displayNumber": "第三十条",
      "path": [
        "第四章组织管理"
      ],
      "text": "国家根据人民警察的工作性质、任务和特点，分别规定不同岗位的服务年限和不同职务的最高任职年龄。",
      "order": 88
    },
    {
      "id": "peoples-police-law-0031",
      "articleNumber": 31,
      "displayNumber": "第三十一条",
      "path": [
        "第四章组织管理"
      ],
      "text": "人民警察个人或者集体在工作中表现突出，有显著成绩和特殊贡献的，给予奖励。奖励分为：嘉奖、三等功、二等功、一等功、授予荣誉称号。\n对受奖励的人民警察，按照国家有关规定，可以提前晋升警衔，并给予一定的物质奖励。",
      "order": 89
    },
    {
      "id": "peoples-police-law-0032",
      "articleNumber": 32,
      "displayNumber": "第三十二条",
      "path": [
        "第五章警务保障"
      ],
      "text": "人民警察必须执行上级的决定和命令。\n人民警察认为决定和命令有错误的，可以按照规定提出意见，但不得中止或者改变决定和命令的执行；提出的意见不被采纳时，必须服从决定和命令；执行决定和命令的后果由作出决定和命令的上级负责。",
      "order": 92
    },
    {
      "id": "peoples-police-law-0033",
      "articleNumber": 33,
      "displayNumber": "第三十三条",
      "path": [
        "第五章警务保障"
      ],
      "text": "人民警察对超越法律、法规规定的人民警察职责范围的指令，有权拒绝执行，并同时向上级机关报告。",
      "order": 94
    },
    {
      "id": "peoples-police-law-0034",
      "articleNumber": 34,
      "displayNumber": "第三十四条",
      "path": [
        "第五章警务保障"
      ],
      "text": "人民警察依法执行职务，公民和组织应当给予支持和协助。公民和组织协助人民警察依法执行职务的行为受法律保护。对协助人民警察执行职务有显著成绩的，给予表彰和奖励。\n公民和组织因协助人民警察执行职务，造成人身伤亡或者财产损失的，应当按照国家有关规定给予抚恤或者补偿。",
      "order": 95
    },
    {
      "id": "peoples-police-law-0035",
      "articleNumber": 35,
      "displayNumber": "第三十五条",
      "path": [
        "第五章警务保障"
      ],
      "text": "拒绝或者阻碍人民警察依法执行职务，有下列行为之一的，给予治安管理处罚：\n（一）公然侮辱正在执行职务的人民警察的；\n（二）阻碍人民警察调查取证的；\n（三）拒绝或者阻碍人民警察执行追捕、搜查、救险等任务进入有关住所、场所的；\n（四）对执行救人、救险、追捕、警卫等紧急任务的警车故意设置障碍的；\n（五）有拒绝或者阻碍人民警察执行职务的其他行为的。\n以暴力、威胁方法实施前款规定的行为，构成犯罪的，依法追究刑事责任。",
      "order": 97
    },
    {
      "id": "peoples-police-law-0036",
      "articleNumber": 36,
      "displayNumber": "第三十六条",
      "path": [
        "第五章警务保障"
      ],
      "text": "人民警察的警用标志、制式服装和警械，由国务院公安部门统一监制，会同其他有关国家机关管理，其他个人和组织不得非法制造、贩卖。\n人民警察的警用标志、制式服装、警械、证件为人民警察专用，其他个人和组织不得持有和使用。\n违反前两款规定的，没收非法制造、贩卖、持有、使用的人民警察警用标志、制式服装、警械、证件，由公安机关处十五日以下拘留或者警告，可以并处违法所得五倍以下的罚款；构成犯罪的，依法追究刑事责任。",
      "order": 104
    },
    {
      "id": "peoples-police-law-0037",
      "articleNumber": 37,
      "displayNumber": "第三十七条",
      "path": [
        "第五章警务保障"
      ],
      "text": "国家保障人民警察的经费。人民警察的经费，按照事权划分的原则，分别列入中央和地方的财政预算。",
      "order": 107
    },
    {
      "id": "peoples-police-law-0038",
      "articleNumber": 38,
      "displayNumber": "第三十八条",
      "path": [
        "第五章警务保障"
      ],
      "text": "人民警察工作所必需的通讯、训练设施和交通、消防以及派出所、监管场所等基础设施建设，各级人民政府应当列入基本建设规划和城乡建设总体规划。",
      "order": 108
    },
    {
      "id": "peoples-police-law-0039",
      "articleNumber": 39,
      "displayNumber": "第三十九条",
      "path": [
        "第五章警务保障"
      ],
      "text": "国家加强人民警察装备的现代化建设，努力推广、应用先进的科技成果。",
      "order": 109
    },
    {
      "id": "peoples-police-law-0040",
      "articleNumber": 40,
      "displayNumber": "第四十条",
      "path": [
        "第五章警务保障"
      ],
      "text": "人民警察实行国家公务员的工资制度，并享受国家规定的警衔津贴和其他津贴、补贴以及保险福利待遇。",
      "order": 110
    },
    {
      "id": "peoples-police-law-0041",
      "articleNumber": 41,
      "displayNumber": "第四十一条",
      "path": [
        "第五章警务保障"
      ],
      "text": "人民警察因公致残的，与因公致残的现役军人享受国家同样的抚恤和优待。\n人民警察因公牺牲或者病故的，其家属与因公牺牲或者病故的现役军人家属享受国家同样的抚恤和优待。",
      "order": 111
    },
    {
      "id": "peoples-police-law-0042",
      "articleNumber": 42,
      "displayNumber": "第四十二条",
      "path": [
        "第六章执法监督"
      ],
      "text": "人民警察执行职务，依法接受人民检察院和行政监察机关的监督。",
      "order": 114
    },
    {
      "id": "peoples-police-law-0043",
      "articleNumber": 43,
      "displayNumber": "第四十三条",
      "path": [
        "第六章执法监督"
      ],
      "text": "人民警察的上级机关对下级机关的执法活动进行监督，发现其作出的处理或者决定有错误的，应当予以撤销或者变更。",
      "order": 115
    },
    {
      "id": "peoples-police-law-0044",
      "articleNumber": 44,
      "displayNumber": "第四十四条",
      "path": [
        "第六章执法监督"
      ],
      "text": "人民警察执行职务，必须自觉地接受社会和公民的监督。人民警察机关作出的与公众利益直接有关的规定，应当向公众公布。",
      "order": 116
    },
    {
      "id": "peoples-police-law-0045",
      "articleNumber": 45,
      "displayNumber": "第四十五条",
      "path": [
        "第六章执法监督"
      ],
      "text": "人民警察在办理治安案件过程中，遇有下列情形之一的，应当回避，当事人或者其法定代理人也有权要求他们回避：\n（一）是本案的当事人或者是当事人的近亲属的；\n（二）本人或者其近亲属与本案有利害关系的；\n（三）与本案当事人有其他关系，可能影响案件公正处理的。\n前款规定的回避，由有关的公安机关决定。\n人民警察在办理刑事案件过程中的回避，适用刑事诉讼法的规定。",
      "order": 117
    },
    {
      "id": "peoples-police-law-0046",
      "articleNumber": 46,
      "displayNumber": "第四十六条",
      "path": [
        "第六章执法监督"
      ],
      "text": "公民或者组织对人民警察的违法、违纪行为，有权向人民警察机关或者人民检察院、行政监察机关检举、控告。受理检举、控告的机关应当及时查处，并将查处结果告知检举人、控告人。\n对依法检举、控告的公民或者组织，任何人不得压制和打击报复。",
      "order": 123
    },
    {
      "id": "peoples-police-law-0047",
      "articleNumber": 47,
      "displayNumber": "第四十七条",
      "path": [
        "第六章执法监督"
      ],
      "text": "公安机关建立督察制度，对公安机关的人民警察执行法律、法规、遵守纪律的情况进行监督。",
      "order": 125
    },
    {
      "id": "peoples-police-law-0048",
      "articleNumber": 48,
      "displayNumber": "第四十八条",
      "path": [
        "第七章法律责任"
      ],
      "text": "人民警察有本法第二十二条所列行为之一的，应当给予行政处分；构成犯罪的，依法追究刑事责任。\n行政处分分为：警告、记过、记大过、降级、撤职、开除。对受行政处分的人民警察，按照国家有关规定，可以降低警衔、取消警衔。\n对违反纪律的人民警察，必要时可以对其采取停止执行职务、禁闭的措施。",
      "order": 127
    },
    {
      "id": "peoples-police-law-0049",
      "articleNumber": 49,
      "displayNumber": "第四十九条",
      "path": [
        "第七章法律责任"
      ],
      "text": "人民警察违反规定使用武器、警械，构成犯罪的，依法追究刑事责任；尚不构成犯罪的，应当依法给予行政处分。",
      "order": 130
    },
    {
      "id": "peoples-police-law-0050",
      "articleNumber": 50,
      "displayNumber": "第五十条",
      "path": [
        "第七章法律责任"
      ],
      "text": "人民警察在执行职务中，侵犯公民或者组织的合法权益造成损害的，应当依照《中华人民共和国国家赔偿法》和其他有关法律、法规的规定给予赔偿。",
      "order": 131
    },
    {
      "id": "peoples-police-law-0051",
      "articleNumber": 51,
      "displayNumber": "第五十一条",
      "path": [
        "第八章附则"
      ],
      "text": "中国人民武装警察部队执行国家赋予的安全保卫任务。",
      "order": 133
    },
    {
      "id": "peoples-police-law-0052",
      "articleNumber": 52,
      "displayNumber": "第五十二条",
      "path": [
        "第八章附则"
      ],
      "text": "本法自公布之日起施行。1957年6月25日公布的《中华人民共和国人民警察条例》同时废止。",
      "order": 134
    }
  ]
}
