  ],
  "articles": [
    {
      "id": "xzfg-9327437f63-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了发展储蓄事业，保护储户的合法权益，加强储蓄管理，制定本条例。",
      "order": 2
    },
    {
      "id": "xzfg-9327437f63-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "凡在中国境内办理储蓄业务的储蓄机构和参加储蓄的个人，必须遵守本条例的规定。",
      "order": 3
    },
    {
      "id": "xzfg-9327437f63-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "本条例所称储蓄是指个人将属于其所有的人民币或者外币存入储蓄机构，储蓄机构开具存折或者存单作为凭证，个人凭存折或者存单可以支取存款本金和利息，储蓄机构依照规定支付存款本金和利息的活动。\n任何单位和个人不得将公款以个人名义转为储蓄存款。",
      "order": 4
    },
    {
      "id": "xzfg-9327437f63-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "本条例所称储蓄机构是指经中国人民银行或其分支机构批准，各银行、信用合作社办理储蓄业务的机构，以及邮政企业依法办理储蓄业务的机构。",
      "order": 6
    },
    {
      "id": "xzfg-9327437f63-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "国家保护个人合法储蓄存款的所有权及其他合法权益，鼓励个人参加储蓄。\n储蓄机构办理储蓄业务，必须遵循“存款自愿，取款自由，存款有息，为储户保密”的原则。",
      "order": 7
    },
    {
      "id": "xzfg-9327437f63-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第一章总则"
      ],
      "text": "中国人民银行负责全国储蓄管理工作。\n中国人民银行及其分支机构负责储蓄机构和储蓄业务的审批，协调、仲裁有关储蓄机构之间在储蓄业务方面的争议，监督、稽核储蓄机构的业务工作，纠正和处罚违反国家储蓄法律、法规和政策的行为。",
      "order": 9
    },
    {
      "id": "xzfg-9327437f63-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第一章总则"
      ],
      "text": "中国人民银行经国务院批准，可以采取适当措施稳定储蓄，保护储户利益。",
      "order": 11
    },
    {
      "id": "xzfg-9327437f63-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第一章总则"
      ],
      "text": "除储蓄机构外，任何单位和个人不得办理储蓄业务。",
      "order": 12
    },
    {
      "id": "xzfg-9327437f63-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第二章储蓄机构"
      ],
      "text": "储蓄机构的设置，应当遵循统一规划，方便群众，注重实效，确保安全的原则。",
      "order": 14
    },
    {
      "id": "xzfg-9327437f63-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第二章储蓄机构"
      ],
      "text": "储蓄机构的设置，应当按照国家有关规定报中国人民银行或其分支机构批准，并申领《经营金融业务许可证》，但国家法律、行政法规另有规定的除外。",
      "order": 15
    },
    {
      "id": "xzfg-9327437f63-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第二章储蓄机构"
      ],
      "text": "储蓄机构的设置必须具备下列条件：\n(一)有机构名称、组织机构和营业场所；\n(二)熟悉储蓄业务的工作人员不少于四人；\n(三)有必要的安全防范设备。",
      "order": 16
    },
    {
      "id": "xzfg-9327437f63-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第二章储蓄机构"
      ],
      "text": "经当地中国人民银行分支机构批准，储蓄机构可以设立储蓄代办点。储蓄代办点的管理办法，由中国人民银行规定。",
      "order": 20
    },
    {
      "id": "xzfg-9327437f63-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第二章储蓄机构"
      ],
      "text": "储蓄机构应当按照规定时间营业，不得擅自停业或者缩短营业时间。",
      "order": 21
    },
    {
      "id": "xzfg-9327437f63-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第二章储蓄机构"
      ],
      "text": "储蓄机构应当保证储蓄存款本金和利息的支付，不得违反规定拒绝支付储蓄存款本金和利息。",
      "order": 22
    },
    {
      "id": "xzfg-9327437f63-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第二章储蓄机构"
      ],
      "text": "储蓄机构不得使用不正当手段吸收储蓄存款。",
      "order": 23
    },
    {
      "id": "xzfg-9327437f63-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第三章储蓄业务"
      ],
      "text": "储蓄机构可以办理下列人民币储蓄业务：\n(一)活期储蓄存款；\n(二)整存整取定期储蓄存款；\n(三)零存整取定期储蓄存款；\n(四)存本取息定期储蓄存款；\n(五)整存零取定期储蓄存款；\n(六)定活两便储蓄存款；\n(七)华侨(人民币)整存整取定期储蓄存款；\n(八)经中国人民银行批准开办的其他种类的储蓄存款。",
      "order": 25
    },
    {
      "id": "xzfg-9327437f63-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第三章储蓄业务"
      ],
      "text": "经外汇管理部门批准，储蓄机构可以办理下列外币储蓄业务：\n(一)活期储蓄存款；\n(二)整存整取定期储蓄存款；\n(三)经中国人民银行批准开办的其他种类的外币储蓄存款。\n办理外币储蓄业务，存款本金和利息应当用外币支付。",
      "order": 34
    },
    {
      "id": "xzfg-9327437f63-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第三章储蓄业务"
      ],
      "text": "储蓄机构办理定期储蓄存款时，根据储户的意愿，可以同时为储户办理定期储蓄存款到期自动转存业务。",
      "order": 39
    },
    {
      "id": "xzfg-9327437f63-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第三章储蓄业务"
      ],
      "text": "根据国家住房改革的有关政策和实际需要，经当地中国人民银行分支机构批准，储蓄机构可以办理个人住房储蓄业务。",
      "order": 40
    },
    {
      "id": "xzfg-9327437f63-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第三章储蓄业务"
      ],
      "text": "经中国人民银行或其分支机构批准，储蓄机构可以办理下列金融业务：\n(一)发售和兑付以居民个人为发行对象的国库券、金融债券、企业债券等有价证券；\n(二)个人定期储蓄存款存单小额抵押贷款业务；\n(三)其他金融业务。",
      "order": 41
    },
    {
      "id": "xzfg-9327437f63-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第三章储蓄业务"
      ],
      "text": "储蓄机构可以办理代发工资和代收房租、水电费等服务性业务。",
      "order": 45
    },
    {
      "id": "xzfg-9327437f63-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第四章储蓄存款利率和计息"
      ],
      "text": "储蓄存款利率由中国人民银行拟订，经国务院批准后公布，或者由国务院授权中国人民银行制定、公布。",
      "order": 47
    },
    {
      "id": "xzfg-9327437f63-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第四章储蓄存款利率和计息"
      ],
      "text": "储蓄机构必须挂牌公告储蓄存款利率，不得擅自变动。",
      "order": 48
    },
    {
      "id": "xzfg-9327437f63-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第四章储蓄存款利率和计息"
      ],
      "text": "未到期的定期储蓄存款，全部提前支取的，按支取日挂牌公告的活期储蓄存款利率计付利息；部分提前支取的，提前支取的部分按支取日挂牌公告的活期储蓄存款利率计付利息，其余部分到期时按存单开户日挂牌公告的定期储蓄存款利率计付利息。",
      "order": 49
    },
    {
      "id": "xzfg-9327437f63-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第四章储蓄存款利率和计息"
      ],
      "text": "逾期支取的定期储蓄存款，其超过原定存期的部分，除约定自动转存的外，按支取日挂牌公告的活期储蓄存款利率计付利息。",
      "order": 50
    },
    {
      "id": "xzfg-9327437f63-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第四章储蓄存款利率和计息"
      ],
      "text": "定期储蓄存款在存期内遇有利率调整，按存单开户日挂牌公告的相应的定期储蓄存款利率计付利息。",
      "order": 51
    },
    {
      "id": "xzfg-9327437f63-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第四章储蓄存款利率和计息"
      ],
      "text": "活期储蓄存款在存入期间遇有利率调整，按结息日挂牌公告的活期储蓄存款利率计付利息。全部支取活期储蓄存款，按清户日挂牌公告的活期储蓄存款利率计付利息。",
      "order": 52
    },
    {
      "id": "xzfg-9327437f63-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第四章储蓄存款利率和计息"
      ],
      "text": "储户认为储蓄存款利息支付有错误时，有权向经办的储蓄机构申请复核；经办的储蓄机构应当及时受理、复核。",
      "order": 53
    },
    {
      "id": "xzfg-9327437f63-0029",
      "articleNumber": 29,
      "displayNumber": "第二十九条",
      "path": [
        "第五章提前支取、挂失、查询和过户"
      ],
      "text": "未到期的定期储蓄存款，储户提前支取的，必须持存单和存款人的身份证明办理；代储户支取的，代支取人还必须持其身份证明。",
      "order": 55
    },
    {
      "id": "xzfg-9327437f63-0030",
      "articleNumber": 30,
      "displayNumber": "第三十条",
      "path": [
        "第五章提前支取、挂失、查询和过户"
      ],
      "text": "存单、存折分为记名式和不记名式。记名式的存单、存折可以挂失，不记名式的存单、存折不能挂失。",
      "order": 56
    },
    {
      "id": "xzfg-9327437f63-0031",
      "articleNumber": 31,
      "displayNumber": "第三十一条",
      "path": [
        "第五章提前支取、挂失、查询和过户"
      ],
      "text": "储户遗失存单、存折或者预留印鉴的印章的，必须立即持本人身份证明，并提供储户的姓名、开户时间、储蓄种类、金额、账号及住址等有关情况，向其开户的储蓄机构书面申请挂失。在特殊情况下，储户可以用口头或者函电形式申请挂失，但必须在5天内补办书面申请挂失手续。\n储蓄机构受理挂失后，必须立即停止支付该储蓄存款；受理挂失前该储蓄存款已被他人支取的，储蓄机构不负赔偿责任。",
      "order": 57
    },
    {
      "id": "xzfg-9327437f63-0032",
      "articleNumber": 32,
      "displayNumber": "第三十二条",
      "path": [
        "第五章提前支取、挂失、查询和过户"
      ],
      "text": "储蓄机构及其工作人员对储户的储蓄情况负有保密责任。\n储蓄机构不代任何单位和个人查询、冻结或者划拨储蓄存款，国家法律、行政法规另有规定的除外。",
      "order": 59
    },
    {
      "id": "xzfg-9327437f63-0033",
      "articleNumber": 33,
      "displayNumber": "第三十三条",
      "path": [
        "第五章提前支取、挂失、查询和过户"
      ],
      "text": "储蓄存款的所有权发生争议，涉及办理过户的，储蓄机构依据人民法院发生法律效力的判决书、裁定书或者调解书办理过户手续。",
      "order": 61
    },
    {
      "id": "xzfg-9327437f63-0034",
      "articleNumber": 34,
      "displayNumber": "第三十四条",
      "path": [
        "第六章法律责任"
      ],
      "text": "违反本条例规定，有下列行为之一的单位和个人，由中国人民银行或其分支机构责令其纠正，并可以根据情节轻重处以罚款、停业整顿、吊销《经营金融业务许可证》；情节严重，构成犯罪的，依法追究刑事责任：\n(一)擅自开办储蓄业务的；\n(二)擅自设置储蓄机构的；\n(三)储蓄机构擅自开办新的储蓄种类的；\n(四)储蓄机构擅自办理本条例规定以外的其他金融业务的；\n(五)擅自停业或者缩短营业时间的；\n(六)储蓄机构采取不正当手段吸收储蓄存款的；\n(七)违反国家利率规定，擅自变动储蓄存款利率的；\n(八)泄露储户储蓄情况或者未经法定程序代为查询、冻结、划拨储蓄存款的；\n(九)其他违反国家储蓄法律、法规和政策的。\n违反本条例第三条第二款规定的，依照国家有关规定予以处罚。",
      "order": 63
    },
    {
      "id": "xzfg-9327437f63-0035",
      "articleNumber": 35,
      "displayNumber": "第三十五条",
      "path": [
        "第六章法律责任"
      ],
      "text": "对处罚决定不服的，当事人可以依照《中华人民共和国行政复议法》的规定申请复议。对复议决定不服的，当事人可以依照《中华人民共和国行政诉讼法》的规定向人民法院提起诉讼。",
      "order": 74
    },
    {
      "id": "xzfg-9327437f63-0036",
      "articleNumber": 36,
      "displayNumber": "第三十六条",
      "path": [
        "第六章法律责任"
      ],
      "text": "复议申请人逾期不起诉又不履行复议决定的，依照《中华人民共和国行政复议法》的规定执行。",
      "order": 75
    },
    {
      "id": "xzfg-9327437f63-0037",
      "articleNumber": 37,
      "displayNumber": "第三十七条",
      "path": [
        "第六章法律责任"
      ],
      "text": "储蓄机构违反国家有关规定，侵犯储户合法权益，造成损失的，应当依法承担赔偿责任。",
      "order": 76
    },
    {
      "id": "xzfg-9327437f63-0038",
      "articleNumber": 38,
      "displayNumber": "第三十八条",
      "path": [
        "第七章附则"
      ],
      "text": "本条例施行前的定期储蓄存款，在原定存期内，依照本条例施行前国家有关规定办理计息事宜。",
      "order": 78
    },
    {
      "id": "xzfg-9327437f63-0039",
