  "articles": [
    {
      "id": "law-0a9da86409-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了保障原子能研究、开发与和平利用，推进科技进步和产业提升，促进经济社会高质量发展，维护国家安全，增进人民福祉，制定本法。",
      "order": 12
    },
    {
      "id": "law-0a9da86409-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "本法适用于中华人民共和国领域及中华人民共和国管辖的其他海域内的原子能研究、开发和利用活动。\n本法所称原子能，也称核能，是指裂变、聚变、衰变等核反应释放的能量。",
      "order": 13
    },
    {
      "id": "law-0a9da86409-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "从事原子能研究、开发和利用活动，应当坚持中国共产党的领导，贯彻总体国家安全观，坚持理性、协调、并进的核安全观，坚持底线思维与系统观念，统筹发展和安全，保护生态环境，保障人身健康和生命财产安全。",
      "order": 15
    },
    {
      "id": "law-0a9da86409-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "原子能科技与产业发展应当坚持创新驱动发展战略和绿色发展、可持续发展战略。\n国家加强原子能产业发展统筹规划，合理安排原子能产业整体布局。",
      "order": 16
    },
    {
      "id": "law-0a9da86409-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "国务院核工业主管部门、能源主管部门、核安全监督管理部门按照职责分工负责原子能研究、开发和利用活动的管理和监督。\n国务院其他有关部门在各自职责范围内负责有关原子能研究、开发和利用活动的管理和监督工作。\n县级以上地方人民政府及其有关部门对本行政区域内的原子能研究、开发和利用活动予以支持，按照法律、行政法规的规定履行相应的管理和监督职责。",
      "order": 18
    },
    {
      "id": "law-0a9da86409-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第一章总则"
      ],
      "text": "国务院有关部门和有关地方人民政府对原子能研究、开发和利用活动，在科学技术奖励、产业发展、财政、税费等方面，按照国家规定给予政策支持。",
      "order": 21
    },
    {
      "id": "law-0a9da86409-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第一章总则"
      ],
      "text": "有关行政机关、企业事业单位应当依法做好原子能研究、开发和利用活动中安全监督管理、环境影响评价等方面的信息公开工作。\n对原子能研究、开发和利用活动中影响公众利益的重大事项，有关行政机关、企业事业单位应当加强与公众的沟通，征求利益相关方的意见，并以适当形式反馈。\n前两款规定的信息公开和公众参与涉及国家秘密、商业秘密、个人信息的，按照国家有关规定执行。",
      "order": 22
    },
    {
      "id": "law-0a9da86409-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第一章总则"
      ],
      "text": "国家加强原子能科学知识和法律知识的宣传教育，鼓励有条件的地方人民政府、核设施营运单位以及其他有关单位建设和利用科普场馆、设施，开展原子能科学知识普及活动。",
      "order": 25
    },
    {
      "id": "law-0a9da86409-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第一章总则"
      ],
      "text": "国家支持和平利用原子能，鼓励和平利用原子能的国际交流与合作，促进共享和平利用原子能事业成果。\n中华人民共和国履行缔结或者参加的国际条约所规定的义务，反对和禁止一切形式的核扩散活动，防范和应对核恐怖主义威胁，推动构建公平、合作、共赢的国际核安全体系。",
      "order": 26
    },
    {
      "id": "law-0a9da86409-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第一章总则"
      ],
      "text": "国家加强原子能领域标准体系建设，推动、参与原子能领域国际标准化活动。",
      "order": 28
    },
    {
      "id": "law-0a9da86409-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第一章总则"
      ],
      "text": "对在原子能研究、开发和利用活动中做出突出贡献的单位和个人，按照国家有关规定给予表彰、奖励。",
      "order": 29
    },
    {
      "id": "law-0a9da86409-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第二章科学研究与技术开发"
      ],
      "text": "国家加强原子能科学研究与技术开发，强化基础研究，探索前沿技术，推进学科交叉融合，鼓励自主研发，加强知识产权保护，强化国家战略科技力量建设，促进原子能领域高素质专业人才队伍建设。\n原子能领域专业人才应当坚持立德为先、诚信为本，弘扬科学家精神，遵守学术和伦理规范，恪守职业道德。",
      "order": 31
    },
    {
      "id": "law-0a9da86409-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第二章科学研究与技术开发"
      ],
      "text": "国家建立原子能领域相关科技创新基地和平台，加强原子能科研设施和科研条件保障能力建设，推动科研设施、资源开放共享，促进科技成果转化。",
      "order": 33
    },
    {
      "id": "law-0a9da86409-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第二章科学研究与技术开发"
      ],
      "text": "国家鼓励和支持受控热核聚变的科学研究与技术开发。",
      "order": 34
    },
    {
      "id": "law-0a9da86409-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第二章科学研究与技术开发"
      ],
      "text": "国家制定并实施原子能科学研究与技术开发专项规划，促进核燃料循环、核反应堆、核技术应用等领域先进技术的研究与开发，提升原子能科学技术水平。\n原子能科学研究与技术开发专项规划应当统筹基础理论、前沿领域、市场应用类研究项目，兼顾原子能行业相关发展需求，提高原子能产业的安全性、经济性和可持续性。",
      "order": 35
    },
    {
      "id": "law-0a9da86409-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第二章科学研究与技术开发"
      ],
      "text": "国家公开征集原子能科学研究与技术开发需求建议，发布项目申报指南，鼓励科研院所、高等学校、企业等单位开展原子能科学研究与技术开发。\n国家发挥财政性资金投入的引导作用，鼓励、带动承担或者参与原子能科学研究与技术开发工作的单位加大资金投入，优化资金投入结构，提高资金投入效益。\n国家支持企业组织原子能科研项目开发，发挥企业在技术创新中的主体作用，支持企业自主研发的先进技术示范应用。",
      "order": 37
    },
    {
      "id": "law-0a9da86409-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第二章科学研究与技术开发"
      ],
      "text": "国家加强原子能领域科学技术规划计划的衔接，完善科学技术资源、技术开发需求的交流机制，发挥市场配置资源的作用。",
      "order": 40
    },
    {
      "id": "law-0a9da86409-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第二章科学研究与技术开发"
      ],
      "text": "国家推动建立和完善与原子能发展相适应的设备研制生产体系，鼓励和支持企业形成自主研发、设计、制造能力。",
      "order": 41
    },
    {
      "id": "law-0a9da86409-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第三章核燃料循环"
      ],
      "text": "国家建立完整的核燃料循环体系，对乏燃料实行循环利用，妥善处理处置放射性废物。\n核燃料循环体系包括铀（钍）矿勘查、开采冶炼、纯化转化、同位素分离、燃料元件制造、乏燃料后处理等环节。",
      "order": 43
    },
    {
      "id": "law-0a9da86409-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第三章核燃料循环"
      ],
      "text": "国务院核工业主管部门负责组织编制核燃料循环中长期发展专项规划，统筹核燃料生产能力和布局。",
      "order": 45
    },
    {
      "id": "law-0a9da86409-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第三章核燃料循环"
      ],
      "text": "核燃料循环设施建设项目由国务院核工业主管部门依法审批或者核准，重大项目报国务院审批或者核准。申请条件、审批程序和时限等按照国家规定执行。",
      "order": 46
    },
    {
      "id": "law-0a9da86409-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第三章核燃料循环"
      ],
      "text": "国家依法加强铀（钍）矿勘查，合理确定铀（钍）矿与共生和伴生矿产资源的勘查和开发秩序，实行保护性开发。",
      "order": 47
    },
    {
      "id": "law-0a9da86409-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第三章核燃料循环"
      ],
      "text": "经国家批准的单位方可从事核燃料生产经营活动。",
      "order": 48
    },
    {
      "id": "law-0a9da86409-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第三章核燃料循环"
      ],
      "text": "国家建立健全乏燃料贮存、运输和后处理等管理制度，统筹规划乏燃料处理处置能力和布局，确保乏燃料的安全、高效和环保处理。\n国家设立核电站乏燃料处理处置基金，其征收使用按照国家规定执行。",
      "order": 49
    },
    {
      "id": "law-0a9da86409-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第三章核燃料循环"
      ],
      "text": "从事原子能研究、开发和利用活动的单位，应当尽可能减少放射性废物的产生量，严格按照有关法律、行政法规和标准的要求，对放射性废物实行分类管理和安全处理处置。\n放射性废物处置场所的建设应当与原子能发展的要求相适应。",
      "order": 51
    },
    {
      "id": "law-0a9da86409-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第三章核燃料循环"
      ],
      "text": "在确保国家安全的前提下，国家允许核燃料循环产业相关企业有效利用资本市场，逐步形成核燃料循环产业多元化投入机制。",
      "order": 53
    },
    {
      "id": "law-0a9da86409-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第四章利用",
        "第一节核反应堆应用"
      ],
      "text": "国家积极安全有序发展核电，规范和促进核反应堆综合利用。\n国家鼓励和支持先进核反应堆的应用。",
      "order": 56
    },
    {
      "id": "law-0a9da86409-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第四章利用",
        "第一节核反应堆应用"
      ],
      "text": "国务院能源主管部门负责核电管理，组织编制国家核电发展规划。核电发展规划按照规定的程序报国务院批准。核电站建设项目由国务院核准。",
      "order": 58
    },
    {
      "id": "law-0a9da86409-0029",
      "articleNumber": 29,
      "displayNumber": "第二十九条",
      "path": [
        "第四章利用",
        "第一节核反应堆应用"
      ],
      "text": "国家支持核反应堆在动力、供热、海水淡化、制氢、同位素生产以及科研等方面的应用。",
      "order": 59
    },
    {
      "id": "law-0a9da86409-0030",
      "articleNumber": 30,
      "displayNumber": "第三十条",
      "path": [
        "第四章利用",
        "第一节核反应堆应用"
      ],
      "text": "核反应堆的选址、设计、建造、调试、运行和管理等应当遵守有关法律、行政法规的规定。",
      "order": 60
    },
    {
      "id": "law-0a9da86409-0031",
      "articleNumber": 31,
      "displayNumber": "第三十一条",
      "path": [
        "第四章利用",
        "第一节核反应堆应用"
      ],
      "text": "核设施营运单位应当按照国家规定预提核设施退役费用、放射性废物处置费用，列入投资概算、生产成本，专门用于核设施退役、放射性废物处置。\n承担非营利性任务的核设施退役费用，按照财政事权和支出责任划分原则，由中央和地方财政承担。",
      "order": 61
    },
    {
      "id": "law-0a9da86409-0032",
      "articleNumber": 32,
      "displayNumber": "第三十二条",
      "path": [
        "第四章利用",
        "第二节核技术应用"
      ],
      "text": "国家支持放射性同位素、射线装置等在工业、农业、生物、医疗卫生、生态环境保护等领域的应用。",
      "order": 64
    },
    {
      "id": "law-0a9da86409-0033",
      "articleNumber": 33,
      "displayNumber": "第三十三条",
      "path": [
        "第四章利用",
        "第二节核技术应用"
      ],
      "text": "国务院核工业、生态环境、公安、卫生健康、疾病预防控制等主管部门按照职责分工加强对核技术应用活动的管理和监督。",
      "order": 65
    },
    {
      "id": "law-0a9da86409-0034",
      "articleNumber": 34,
      "displayNumber": "第三十四条",
      "path": [
        "第四章利用",
        "第二节核技术应用"
      ],
      "text": "国务院核工业主管部门会同有关部门制定核技术应用产业发展指导意见。\n县级以上地方人民政府及其有关部门应当采取措施，鼓励核技术应用领域先进技术研发、知识产权保护、成果转化示范应用，引导核技术应用生产经营单位有序、公平参与市场竞争。",
      "order": 66
    },
    {
      "id": "law-0a9da86409-0035",
      "articleNumber": 35,
      "displayNumber": "第三十五条",
      "path": [
        "第四章利用",
        "第二节核技术应用"
      ],
      "text": "国家对放射源、射线装置实行分类管理，具体分类办法由国务院有关部门制定。",
      "order": 68
    },
    {
      "id": "law-0a9da86409-0036",
      "articleNumber": 36,
      "displayNumber": "第三十六条",
      "path": [
        "第四章利用",
        "第二节核技术应用"
      ],
      "text": "从事核技术应用生产经营活动的单位，应当依法取得相应的资质，严格执行放射性同位素和射线装置在生产、运输、销售、使用、贮存、处置各环节的管理规定。",
      "order": 69
    },
    {
      "id": "law-0a9da86409-0037",
      "articleNumber": 37,
      "displayNumber": "第三十七条",
      "path": [
        "第四章利用",
        "第二节核技术应用"
      ],
      "text": "国家建立核技术应用废旧放射源回收制度。放射源使用单位应当按照国家规定将废旧放射源交回生产单位、返回原出口方或者送交取得相应资质的单位贮存、处置。\n核技术应用生产经营单位使用放射源的场所和生产放射性同位素的场所，以及终结运行后产生放射性污染的射线装置，应当依法实施退役。",
      "order": 70
    },
    {
      "id": "law-0a9da86409-0038",
      "articleNumber": 38,
      "displayNumber": "第三十八条",
      "path": [
        "第五章安全监督管理"
      ],
      "text": "从事原子能研究、开发和利用活动，必须遵循确保安全的方针，按照法律、行政法规的要求，严格落实核安全责任。\n核安全工作必须坚持安全第一、预防为主、责任明确、严格管理、纵深防御、独立监管、全面保障的原则。\n国务院核安全监督管理部门、核工业主管部门在各自职责范围内对原子能研究、开发和利用活动实施核安全监管。",
      "order": 73
    },
    {
      "id": "law-0a9da86409-0039",
      "articleNumber": 39,
      "displayNumber": "第三十九条",
      "path": [
        "第五章安全监督管理"
      ],
      "text": "国家建立符合受控热核聚变特点、促进核聚变应用的监督管理制度，对聚变燃料、聚变装置（设施）实行分级分类管理。",
      "order": 76
    },
    {
      "id": "law-0a9da86409-0040",
      "articleNumber": 40,
      "displayNumber": "第四十条",
      "path": [
        "第五章安全监督管理"
      ],
      "text": "从事原子能研究、开发和利用活动的单位，应当遵守国家有关辐射防护的规定，保护公众和从业人员的安全与健康，保护生态环境。",
      "order": 77
    },
    {
      "id": "law-0a9da86409-0041",
      "articleNumber": 41,
      "displayNumber": "第四十一条",
      "path": [
        "第五章安全监督管理"
      ],
      "text": "国家建立健全核安保制度，加强原子能研究、开发和利用活动的安全保卫工作。\n核材料、核设施、其他放射性物质及相关设施的持有或者营运单位应当依法开展安全保卫工作，防范相关盗窃、破坏、擅自接触、非法转移或者其他危害安全的行为，防范核恐怖主义行为。\n核设施营运单位应当采取必要措施，防范网络攻击、侵入、干扰和破坏，应对网络安全事件，保障核设施安全稳定运行。",
      "order": 78
    },
    {
      "id": "law-0a9da86409-0042",
      "articleNumber": 42,
      "displayNumber": "第四十二条",
      "path": [
        "第五章安全监督管理"
      ],
      "text": "从事涉及国家秘密的原子能研究、开发和利用活动的单位，应当依法建立健全保密管理制度，完善保密防护措施，开展保密宣传教育，加强保密监督检查。",
      "order": 81
    },
    {
      "id": "law-0a9da86409-0043",
      "articleNumber": 43,
      "displayNumber": "第四十三条",
      "path": [
        "第五章安全监督管理"
      ],
      "text": "国家对核材料实行严格管制，建立和运行国家核材料衡算与控制系统。\n持有、使用、生产、储存、运输和处置核材料的单位，应当依法取得核材料许可证。",
      "order": 82
    },
    {
      "id": "law-0a9da86409-0044",
      "articleNumber": 44,
      "displayNumber": "第四十四条",
      "path": [
        "第五章安全监督管理"
      ],
      "text": "国家加强运输通道及装备体系建设，保障放射性物品的公路、铁路、水路、航空等运输。\n国务院有关部门对放射性物品运输企业和运输过程实行严格监督和管理。",
      "order": 84
    },
    {
      "id": "law-0a9da86409-0045",
      "articleNumber": 45,
      "displayNumber": "第四十五条",
      "path": [
        "第五章安全监督管理"
      ],
      "text": "国家设立核事故应急协调委员会，组织、协调全国的核事故应急管理工作，统筹制定国家核事故应急预案，对核事故应急实行分级管理。\n国家建立健全核事故应急准备金制度，保障核事故应急准备与响应工作所需经费。\n国务院有关部门、有关地方人民政府、核设施营运单位应当依法制定核事故应急预案，开展应急演练，做好核事故应急相关工作。\n中国人民解放军和中国人民武装警察部队按照中央军事委员会的规定，做好核事故应急相关工作。",
      "order": 86
    },
    {
      "id": "law-0a9da86409-0046",
      "articleNumber": 46,
      "displayNumber": "第四十六条",
      "path": [
        "第五章安全监督管理"
      ],
      "text": "发生核事故时，有关单位和个人必须立即采取应急措施，并按照有关法律、行政法规的规定报告，禁止缓报、瞒报、谎报核事故。",
      "order": 90
    },
    {
      "id": "law-0a9da86409-0047",
      "articleNumber": 47,
      "displayNumber": "第四十七条",
      "path": [
        "第六章进出口"
      ],
      "text": "国家加强原子能领域进出口管理工作，履行进出口国际义务和承诺，保证进出口物项的和平用途。",
      "order": 92
    },
    {
      "id": "law-0a9da86409-0048",
      "articleNumber": 48,
      "displayNumber": "第四十八条",
      "path": [
        "第六章进出口"
      ],
      "text": "国家依法对核以及核两用物项出口进行严格管制，实行许可制度。\n核以及核两用物项出口，应当遵守国家有关法律、行政法规的规定，不得损害国家安全或者社会公共利益。",
      "order": 93
    },
    {
      "id": "law-0a9da86409-0049",
      "articleNumber": 49,
      "displayNumber": "第四十九条",
      "path": [
        "第六章进出口"
      ],
      "text": "国家严格限制铀浓缩设施、设备，乏燃料后处理设施、设备，重水生产设施、设备等物项及其相关技术等核扩散敏感物项，以及可以用于核爆炸装置的材料的出口。\n国家鼓励和支持企业积极有序参与国际市场开发，推动符合国家有关规定的核电、核燃料相关设备和技术服务出口。",
      "order": 95
    },
    {
      "id": "law-0a9da86409-0050",
      "articleNumber": 50,
      "displayNumber": "第五十条",
      "path": [
        "第六章进出口"
      ],
      "text": "核进口单位应当严格执行国家关于核进口的法律、行政法规和其他有关规定，履行核进口承诺义务。\n国务院核工业主管部门负责审查、办理核进口政府承诺事务，管理核进口涉及的保障监督事项。重要的保障监督事项，由国务院核工业主管部门会同外交部门、商务主管部门提出处理意见，必要时应当报国务院审批。",
      "order": 97
    },
    {
      "id": "law-0a9da86409-0051",
      "articleNumber": 51,
      "displayNumber": "第五十一条",
      "path": [
        "第六章进出口"
      ],
      "text": "进出口放射性同位素应当遵守法律、行政法规和其他有关规定确定的目录、条件和程序等要求。",
      "order": 99
    },
    {
      "id": "law-0a9da86409-0052",
      "articleNumber": 52,
      "displayNumber": "第五十二条",
      "path": [
        "第六章进出口"
      ],
      "text": "禁止将放射性废物和被放射性污染的物品输入中华人民共和国境内或者经中华人民共和国境内转移，法律、行政法规另有规定的除外。",
      "order": 100
    },
    {
      "id": "law-0a9da86409-0053",
      "articleNumber": 53,
      "displayNumber": "第五十三条",
      "path": [
        "第七章法律责任"
      ],
      "text": "国务院有关部门、县级以上地方人民政府及其有关部门，违反本法规定，有下列情形之一，对负有责任的领导人员和直接责任人员依法给予处分：\n（一）未依法对许可申请进行审批或者核准的；\n（二）发现违法行为不予查处的；\n（三）未依法公开原子能安全监督管理、环境影响评价等方面信息的；\n（四）未就原子能研究、开发和利用活动中影响公众利益的重大事项依法征求利益相关方意见的；\n（五）有其他滥用职权、玩忽职守、徇私舞弊行为的。",
      "order": 102
    },
    {
      "id": "law-0a9da86409-0054",
      "articleNumber": 54,
      "displayNumber": "第五十四条",
      "path": [
        "第七章法律责任"
      ],
      "text": "违反本法规定，未经批准，擅自从事核燃料生产经营活动的，由国务院核工业主管部门责令停止生产经营活动，没收核燃料及违法所得，处违法生产经营的核燃料市场价值二倍以上十倍以下的罚款；对负有责任的领导人员和直接责任人员处十万元以上五十万元以下的罚款，并依法给予处分。",
      "order": 108
    },
    {
      "id": "law-0a9da86409-0055",
      "articleNumber": 55,
      "displayNumber": "第五十五条",
      "path": [
        "第七章法律责任"
      ],
      "text": "核材料、核设施、其他放射性物质及相关设施的持有或者营运单位未按照有关法律、行政法规要求开展安全保卫工作的，由国务院核工业主管部门会同有关部门责令限期整改；拒不整改或者经限期整改仍不符合要求的，处一百万元以上五百万元以下的罚款，暂扣或者吊销相关许可证，对负有责任的领导人员和直接责任人员处十万元以上五十万元以下的罚款，并依法给予处分。",
      "order": 109
    },
    {
      "id": "law-0a9da86409-0056",
      "articleNumber": 56,
      "displayNumber": "第五十六条",
      "path": [
        "第七章法律责任"
      ],
      "text": "核进口单位未按照有关规定履行核进口承诺义务的，由国务院核工业主管部门责令改正，处二百万元以上一千万元以下的罚款；对负有责任的领导人员和直接责任人员处十万元以上五十万元以下的罚款，并依法给予处分。\n核出口单位违反本法规定出口核以及核两用物项的，依照有关法律、行政法规的规定承担法律责任。",
      "order": 110
    },
    {
      "id": "law-0a9da86409-0057",
      "articleNumber": 57,
      "displayNumber": "第五十七条",
      "path": [
        "第七章法律责任"
      ],
      "text": "国家建立核损害赔偿责任制度，按照法律和国家有关规定处理核事故造成的损害。",
      "order": 112
    },
    {
      "id": "law-0a9da86409-0058",
      "articleNumber": 58,
      "displayNumber": "第五十八条",
      "path": [
        "第七章法律责任"
      ],
      "text": "违反本法规定的行为，本法未作行政处罚规定，其他有关法律、行政法规有规定的，依照其规定；造成财产损失或者其他损害的，依法承担民事责任；构成犯罪的，依法追究刑事责任。",
      "order": 113
    },
    {
      "id": "law-0a9da86409-0059",
      "articleNumber": 59,
      "displayNumber": "第五十九条",
      "path": [
        "第八章附则"
      ],
      "text": "涉及军工、军事等国防领域的原子能研究、开发和利用活动的管理办法，由国务院、中央军事委员会依据本法规定的原则另行制定。",
      "order": 115
    },
    {
      "id": "law-0a9da86409-0060",
      "articleNumber": 60,
      "displayNumber": "第六十条",
      "path": [
        "第八章附则"
      ],
      "text": "任何国家或者地区在原子能领域对中华人民共和国采取歧视性的禁止、限制或者其他类似措施的，中华人民共和国可以根据实际情况对该国家或者该地区采取相应的措施。",
      "order": 116
    },
    {
      "id": "law-0a9da86409-0061",
      "articleNumber": 61,
      "displayNumber": "第六十一条",
      "path": [
        "第八章附则"
      ],
      "text": "本法下列用语的含义：\n（一）核材料，是指需要管制的核材料，包括铀-235及含铀-235的材料和制品，铀-233及含铀-233的材料和制品，钚-239及含钚-239的材料和制品，法律、行政法规规定的其他需要管制的核材料，不包括铀（钍）矿石及其初级制品。\n（二）乏燃料，是指在反应堆堆芯内受过辐照并从堆芯永久卸出的核燃料。\n（三）后处理，是指对反应堆乏燃料进行处理，以分离其中的裂变产物，并回收可裂变物质的过程。\n（四）核反应堆，是指为了利用核反应产生的能量、中子、核素等建设的装置。\n（五）核技术应用，是指放射性同位素和射线装置等非动力核技术在国民经济和社会发展各领域的应用。\n（六）放射性同位素，是指化学元素中具有相同原子序数，但质量不同且能发生放射性衰变的核素。\n（七）射线装置，是指在接通电源后方能产生电离辐射的装置，如X射线机、加速器、中子发生器等。\n（八）放射源，是指除研究堆和动力堆核燃料循环范畴的材料以外，永久密封在容器中或者有严密包层的放射性材料。\n（九）放射性物品，是指放射性物质中放射性活度和比活度均高于国家规定的豁免值的物质。\n（十）放射性废物，是指含有放射性核素或者被放射性核素污染，其浓度或者比活度大于国家确定的清洁解控水平，预期不再使用的废弃物。",
      "order": 117
    },
    {
      "id": "law-0a9da86409-0062",
      "articleNumber": 62,
      "displayNumber": "第六十二条",
      "path": [
        "第八章附则"
      ],
      "text": "本法自2026年1月15日起施行。",
      "order": 128
    }
  ]
}
