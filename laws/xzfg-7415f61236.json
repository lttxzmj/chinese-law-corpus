  "articles": [
    {
      "id": "xzfg-7415f61236-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为加强航道管理，改善通航条件，保证航道畅通和航行安全，充分发挥水上交通在国民经济和国防建设中的作用，特制定本条例。",
      "order": 2
    },
    {
      "id": "xzfg-7415f61236-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "本条例适用于中华人民共和国沿海和内河的航道、航道设施以及与通航有关的设施。",
      "order": 3
    },
    {
      "id": "xzfg-7415f61236-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "国家鼓励和保护在统筹兼顾、综合利用水资源的原则下，开发利用航道，发展水运事业。",
      "order": 4
    },
    {
      "id": "xzfg-7415f61236-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "中华人民共和国交通部主管全国航道事业。",
      "order": 5
    },
    {
      "id": "xzfg-7415f61236-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "航道分为国家航道、地方航道和专用航道。",
      "order": 6
    },
    {
      "id": "xzfg-7415f61236-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第一章总则"
      ],
      "text": "国家航道及其航道设施按海区和内河水系，由交通部或者交通部授权的省、自治区、直辖市交通主管部门管理。\n地方航道及其航道设施由省、自治区、直辖市交通主管部门管理。\n专用航道及其航道设施由专用部门管理。\n国家航道和地方航道上的过船建筑物，按照国务院规定管理。",
      "order": 7
    },
    {
      "id": "xzfg-7415f61236-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第二章航道的规划和建设"
      ],
      "text": "航道发展规划应当依据统筹兼顾、综合利用的原则，结合水利水电、城市建设以及铁路、公路、水运发展规划和国家批准的水资源综合规划制定。",
      "order": 12
    },
    {
      "id": "xzfg-7415f61236-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第二章航道的规划和建设"
      ],
      "text": "国家航道发展规划由交通部编制，报国务院审查批准后实施。\n地方航道发展规划由省、自治区、直辖市交通主管部门编制，报省、自治区、直辖市人民政府审查批准后实施，并抄报交通部备案。\n跨省、自治区、直辖市的地方航道的发展规划，由有关省、自治区、直辖市交通主管部门共同编制，报有关省、自治区、直辖市人民政府联合审查批准后实施，并抄报交通部备案；必要时报交通部审查批准后实施。\n专用航道发展规划由专用航道管理部门会同同级交通主管部门编制，报同级人民政府批准后实施。",
      "order": 13
    },
    {
      "id": "xzfg-7415f61236-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第二章航道的规划和建设"
      ],
      "text": "各级水利电力主管部门编制河流流域规划和与航运有关的水利、水电工程规划以及进行上述工程设计时，必须有同级交通主管部门参加。\n各级交通主管部门编制渠化河流和人工运河航道发展规划和进行与水利水电有关的工程设计时，必须有同级水利电力主管部门参加。\n各级水利电力主管部门、交通主管部门编制上述规划，涉及运送木材的河流和重要的渔业水域时，必须有同级林业、渔业主管部门参加。",
      "order": 17
    },
    {
      "id": "xzfg-7415f61236-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第二章航道的规划和建设"
      ],
      "text": "航道应当划分技术等级。航道技术等级的划分，由省、自治区、直辖市交通主管部门或交通部派驻水系的管理机构根据通航标准提出方案。一至四级航道由交通部会同水利电力部及其他有关部门研究批准，报国务院备案；四级以下的航道，由省、自治区、直辖市人民政府批准，报交通部备案。",
      "order": 20
    },
    {
      "id": "xzfg-7415f61236-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第二章航道的规划和建设"
      ],
      "text": "建设航道及其设施，必须遵守国家基本建设程序的规定。工程竣工经验收合格后，方能交付使用。",
      "order": 21
    },
    {
      "id": "xzfg-7415f61236-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第二章航道的规划和建设"
      ],
      "text": "建设航道及其设施，不得危及水利水电工程、跨河建筑物和其他设施的安全。\n因建设航道及其设施损坏水利水电工程、跨河建筑物和其他设施的，建设单位应当给予赔偿或者修复。\n在行洪河道上建设航道，必须符合行洪安全的要求。",
      "order": 22
    },
    {
      "id": "xzfg-7415f61236-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第三章航道的保护"
      ],
      "text": "航道和航道设施受国家保护，任何单位和个人均不得侵占或者破坏。交通部门应当加强对航道的养护，保证航道畅通。",
      "order": 26
    },
    {
      "id": "xzfg-7415f61236-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第三章航道的保护"
      ],
      "text": "修建与通航有关的设施或者治理河道、引水灌溉，必须符合国家规定的通航标准和技术要求，并应当事先征求交通主管部门的意见。\n违反前款规定，中断或者恶化通航条件的，由建设单位或者个人赔偿损失，并在规定期限内负责恢复通航。",
      "order": 27
    },
    {
      "id": "xzfg-7415f61236-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第三章航道的保护"
      ],
      "text": "在通航河流上建设永久性拦河闸坝，建设单位必须按照设计和施工方案，同时建设适当规模的过船、过木、过鱼建筑物，并解决施工期间的船舶、排筏通航问题。过船、过木、过鱼建筑物的建设费用，由建设单位承担。\n在不通航河流或者人工渠道上建设闸坝后可以通航的，建设单位应当同时建设适当规模的过船建筑物；不能同时建设的，应当预留建设过船建筑物的位置。过船建筑物的建设费用，除国家另有规定外，应当由交通部门承担。\n过船、过木、过鱼建筑物的设计任务书、设计文件和施工方案，必须取得交通、林业、渔业主管部门的同意。",
      "order": 29
    },
    {
      "id": "xzfg-7415f61236-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第三章航道的保护"
      ],
      "text": "因紧急抗旱需要，在通航河流上建临时闸坝，必须经县级以上人民政府批准。旱情解除后，建闸坝单位必须及时拆除闸坝，恢复通航条件。",
      "order": 32
    },
    {
      "id": "xzfg-7415f61236-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第三章航道的保护"
      ],
      "text": "对通航河流上碍航的闸坝、桥梁和其他建筑物以及由建筑物所造成的航道淤积，由地方人民政府按照“谁造成碍航谁恢复通航”的原则，责成有关部门改建碍航建筑物或者限期补建过船、过木、过鱼建筑物，清除淤积，恢复通航。",
      "order": 33
    },
    {
      "id": "xzfg-7415f61236-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第三章航道的保护"
      ],
      "text": "在通航河段或其上游兴建水利工程控制或引走水源，建设单位应当保证航道和船闸所需要的通航流量。在特殊情况下，由于控制水源或大量引水影响通航时，建设单位应当采取相应的工程措施，地方人民政府应当组织有关部门协商，合理分配水量。",
      "order": 34
    },
    {
      "id": "xzfg-7415f61236-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第三章航道的保护"
      ],
      "text": "水利水电工程设施管理部门制定调度运行方案，涉及通航流量、水位和航行安全时，应当事先与交通主管部门协商。协商不一致时，由县级以上人民政府决定。",
      "order": 35
    },
    {
      "id": "xzfg-7415f61236-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第三章航道的保护"
      ],
      "text": "在防洪、排涝、抗旱时，综合利用水利枢纽过船建筑物应当服从防汛抗旱指挥机构统一安排。",
      "order": 36
    },
    {
      "id": "xzfg-7415f61236-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第三章航道的保护"
      ],
      "text": "沿海和通航河流上设置的助航标志必须符合国家规定的标准。\n在沿海和通航河流上设置专用标志必须经交通主管部门同意；设置渔标和军用标，必须报交通主管部门备案。",
      "order": 37
    },
    {
      "id": "xzfg-7415f61236-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第三章航道的保护"
      ],
      "text": "禁止向河道倾倒沙石泥土和废弃物。\n在通航河道内挖取沙石泥土、堆存材料，不得恶化通航条件。",
      "order": 39
    },
    {
      "id": "xzfg-7415f61236-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第三章航道的保护"
      ],
      "text": "在航道内施工工程完成后，施工单位应当及时清除遗留物。",
      "order": 41
    },
    {
      "id": "xzfg-7415f61236-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第四章航道养护经费"
      ],
      "text": "经国家批准计征港务费的沿海和内河港口，进出港航道的维护费用由港务费开支。",
      "order": 43
    },
    {
      "id": "xzfg-7415f61236-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第四章航道养护经费"
      ],
      "text": "专用航道的维护费用，由专用部门自行解决。",
      "order": 44
    },
    {
      "id": "xzfg-7415f61236-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第四章航道养护经费"
      ],
      "text": "对中央、地方财政拨给的航道维护费用，必须坚持专款专用的原则。",
      "order": 45
    },
    {
      "id": "xzfg-7415f61236-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第五章罚则"
      ],
      "text": "对违反本条例规定的单位和个人，县以上交通主管部门可以视情节轻重给予警告、罚款的处罚。",
      "order": 47
    },
    {
      "id": "xzfg-7415f61236-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第五章罚则"
      ],
      "text": "当事人对交通主管部门的处罚不服的，可以向上级交通主管部门提出申诉；对上级交通主管部门的处理不服的，可以在接到处理决定书之日起15日内向人民法院起诉。逾期不起诉又不履行的，交通主管部门可以申请人民法院强制执行。",
      "order": 48
    },
    {
      "id": "xzfg-7415f61236-0029",
      "articleNumber": 29,
      "displayNumber": "第二十九条",
      "path": [
        "第五章罚则"
      ],
      "text": "违反本条例的规定，应当受治安管理处罚的，由公安机关处理；构成犯罪的，由司法机关依法追究刑事责任。",
      "order": 49
    },
    {
      "id": "xzfg-7415f61236-0030",
      "articleNumber": 30,
      "displayNumber": "第三十条",
      "path": [
        "第六章附则"
      ],
      "text": "本条例下列用语的含义是：\n“航道”是指中华人民共和国沿海、江河、湖泊、运河内船舶、排筏可以通航的水域。\n“国家航道”是指：(一)构成国家航道网、可以通航五百吨级以上船舶的内河干线航道；(二)跨省、自治区、直辖市，可以常年通航三百吨级以上船舶的内河干线航道；(三)沿海干线航道和主要海港航道；(四)国家指定的重要航道。\n“专用航道”是指由军事、水利电力、林业、水产等部门以及其他企业事业单位自行建设、使用的航道。\n“地方航道”是指国家航道和专用航道以外的航道。\n“航道设施”是指航道的助航导航设施、整治建筑物、航运梯级、过船建筑物(包括过船闸坝)和其他航道工程设施。\n“与通航有关的设施”是指对航道的通航条件有影响的闸坝、桥梁、码头、架空电线、水下电缆、管道等拦河、跨河、临河建筑物和其他工程设施。",
      "order": 51
    },
    {
      "id": "xzfg-7415f61236-0031",
      "articleNumber": 31,
      "displayNumber": "第三十一条",
      "path": [
        "第六章附则"
      ],
      "text": "本条例由交通部负责解释。交通部可以根据本条例制定实施细则。",
      "order": 58
    },
    {
      "id": "xzfg-7415f61236-0032",
      "articleNumber": 32,
      "displayNumber": "第三十二条",
      "path": [
        "第六章附则"
      ],
      "text": "本条例自1987年10月1日起施行。",
      "order": 59
    }
  ]
}
