  "articles": [
    {
      "id": "xzfg-68a0bd904d-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了规范本仲裁委员会的行为，保证公正、及时地仲裁经济纠纷，保护当事人的合法权益，根据《中华人民共和国仲裁法》(以下简称仲裁法)，制定本章程。",
      "order": 2
    },
    {
      "id": "xzfg-68a0bd904d-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "平等主体的公民、法人和其他组织之间发生合同纠纷和其他财产权益纠纷，可以依法向本仲裁委员会申请仲裁。\n本仲裁委员会不受理因劳动争议和农业集体经济组织内部的农业承包合同纠纷提出的仲裁申请。",
      "order": 3
    },
    {
      "id": "xzfg-68a0bd904d-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "本仲裁委员会(以下简称仲裁委员会)会址设在××市。",
      "order": 5
    },
    {
      "id": "xzfg-68a0bd904d-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第二章仲裁委员会"
      ],
      "text": "仲裁委员会由主任1人、副主任2至4人和委员7至11人组成。其中，驻会专职组成人员1至2人，其他组成人员均为兼职。\n仲裁委员会设秘书长1人。秘书长可以由驻会专职组成人员兼任。\n仲裁委员会组成人员名单报中国仲裁协会备案。",
      "order": 7
    },
    {
      "id": "xzfg-68a0bd904d-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第二章仲裁委员会"
      ],
      "text": "仲裁委员会每届任期3年。任期届满，更换1/3组成人员。\n仲裁委员会任期届满的2个月前，应当完成下届仲裁委员会组成人员的更换；有特殊情况不能完成更换的，应当在任期届满后3个月内完成更换。\n上一届仲裁委员会履行职责到新一届仲裁委员会组成为止。",
      "order": 10
    },
    {
      "id": "xzfg-68a0bd904d-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第二章仲裁委员会"
      ],
      "text": "新一届仲裁委员会组成人员由上一届仲裁委员会主任会议商市人民政府有关部门、商会后提名，由市人民政府聘任。",
      "order": 13
    },
    {
      "id": "xzfg-68a0bd904d-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第二章仲裁委员会"
      ],
      "text": "仲裁委员会会议由主任或者主任委托的副主任主持。每次会议须有2/3以上的组成人员出席，方能举行。修改章程或者对仲裁委员会作出解散决议，须经全体组成人员的2/3以上通过，其他决议须经出席会议组成人员的2/3以上通过。",
      "order": 14
    },
    {
      "id": "xzfg-68a0bd904d-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第二章仲裁委员会"
      ],
      "text": "仲裁委员会会议的主要职责是：\n(一)审议仲裁委员会的工作方针、工作计划等重要事项，并作出相应的决议；\n(二)审议、通过仲裁委员会秘书长提出的年度工作报告和财务报告；\n(三)决定仲裁委员会秘书长、专家咨询机构负责人人选；\n(四)审议、通过仲裁委员会办事机构设置方案；\n(五)决定仲裁员的聘任、解聘和除名；\n(六)仲裁委员会主任担任仲裁员的，决定主任的回避；\n(七)修改仲裁委员会章程；\n(八)决议解散仲裁委员会；\n(九)仲裁法、仲裁规则和本章程规定的其他职责。",
      "order": 15
    },
    {
      "id": "xzfg-68a0bd904d-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第二章仲裁委员会"
      ],
      "text": "仲裁委员会主任、副主任和秘书长组成主任会议，在仲裁委员会会议闭会期间，负责仲裁委员会的重要日常工作。",
      "order": 25
    },
    {
      "id": "xzfg-68a0bd904d-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第二章仲裁委员会"
      ],
      "text": "仲裁委员会可以根据需要设立专家咨询机构，为仲裁委员会和仲裁员提供对疑难问题的咨询意见。\n专家咨询机构设负责人1人，由仲裁委员会副主任兼任。",
      "order": 26
    },
    {
      "id": "xzfg-68a0bd904d-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第二章仲裁委员会"
      ],
      "text": "仲裁委员会会议作出解散决议并经市人民政府同意，仲裁委员会应当终止。",
      "order": 28
    },
    {
      "id": "xzfg-68a0bd904d-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第三章办事机构"
      ],
      "text": "仲裁委员会下设办事机构。办事机构在仲裁委员会秘书长领导下负责处理仲裁委员会的日常工作。\n办事机构的主要职责是：\n(一)具体办理仲裁案件受理、仲裁文书送达、档案管理等程序性事务；\n(二)收取和管理仲裁费用；\n(三)办理仲裁委员会交办的其他事务。",
      "order": 30
    },
    {
      "id": "xzfg-68a0bd904d-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第三章办事机构"
      ],
      "text": "办事机构工作人员，由仲裁委员会主任会议决定聘用。",
      "order": 35
    },
    {
      "id": "xzfg-68a0bd904d-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第四章仲裁员"
      ],
      "text": "仲裁员名单由仲裁委员会主任会议提出，经仲裁委员会会议审议通过后，由仲裁委员会聘任，发给聘书。\n仲裁员的聘任期为3年，期满可以继续聘任。",
      "order": 37
    },
    {
      "id": "xzfg-68a0bd904d-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第四章仲裁员"
      ],
      "text": "仲裁委员会按照不同专业设立仲裁员名册。\n仲裁员名册报中国仲裁协会备案。",
      "order": 39
    },
    {
      "id": "xzfg-68a0bd904d-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第四章仲裁员"
      ],
      "text": "仲裁员应当严格遵守仲裁规则的规定，保证当事人行使仲裁规则规定的权利。",
      "order": 41
    },
    {
      "id": "xzfg-68a0bd904d-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第四章仲裁员"
      ],
      "text": "仲裁员应当平等对待双方当事人，不得代表或者偏袒任何一方当事人。",
      "order": 42
    },
    {
      "id": "xzfg-68a0bd904d-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第四章仲裁员"
      ],
      "text": "仲裁员接受案件后，应当认真、详细审阅当事人提交的全部证据和材料，做好审理的准备工作。",
      "order": 43
    },
    {
      "id": "xzfg-68a0bd904d-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第四章仲裁员"
      ],
      "text": "仲裁员开庭审理仲裁案件的，应当充分听取双方当事人的陈述，认真查明事实。",
      "order": 44
    },
    {
      "id": "xzfg-68a0bd904d-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第四章仲裁员"
      ],
      "text": "仲裁员经仲裁庭或者仲裁委员会同意会见当事人、代理人，应当在仲裁委员会办公地点进行；未经仲裁庭或者仲裁委员会同意的，仲裁员不得私自会见任何一方当事人、代理人，不得单独接受一方当事人、代理人提供的证据、材料或者与一方当事人、代理人交谈有关仲裁案件的情况。",
      "order": 45
    },
    {
      "id": "xzfg-68a0bd904d-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第四章仲裁员"
      ],
      "text": "仲裁员应当在案件审理终结后及时进行合议，并按规定制作仲裁裁决书。",
      "order": 46
    },
    {
      "id": "xzfg-68a0bd904d-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第四章仲裁员"
      ],
      "text": "仲裁员应当严格保守仲裁秘密，不得对外界透露案件审理过程、仲裁庭合议情况、案件涉及的商业秘密等内容。",
      "order": 47
    },
    {
      "id": "xzfg-68a0bd904d-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第四章仲裁员"
      ],
      "text": "仲裁员有下列情形之一的，仲裁委员会应当予以解聘：\n(一)隐瞒应当回避的情形，对案件审理产生不良影响的；\n(二)无正当理由不到庭审理案件的；\n(三)有不宜继续担任仲裁员的其他情形的。",
      "order": 48
    },
    {
      "id": "xzfg-68a0bd904d-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第四章仲裁员"
      ],
      "text": "仲裁员私自会见当事人、代理人，或者接受当事人、代理人的请客送礼，或者在仲裁案件时有索贿受贿，徇私舞弊，枉法裁决行为的，应当依法承担法律责任，仲裁委员会应当将其除名。",
      "order": 52
    },
    {
      "id": "xzfg-68a0bd904d-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第五章财务"
      ],
      "text": "仲裁委员会的财务实行独立核算。",
      "order": 54
    },
    {
      "id": "xzfg-68a0bd904d-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第五章财务"
      ],
      "text": "仲裁委员会的经费来源是：\n(一)政府的资助；\n(二)当事人交纳的仲裁费；\n(三)其他合法收入。",
      "order": 55
    },
    {
      "id": "xzfg-68a0bd904d-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第五章财务"
      ],
      "text": "仲裁委员会终止，应当对财产进行清算。清算后，剩余财产归国家所有。",
      "order": 59
    },
    {
      "id": "xzfg-68a0bd904d-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第六章附则"
      ],
      "text": "本章程由仲裁委员会负责解释。",
      "order": 61
    },
    {
      "id": "xzfg-68a0bd904d-0029",
      "articleNumber": 29,
      "displayNumber": "第二十九条",
      "path": [
        "第六章附则"
      ],
      "text": "本章程自市人民政府批准之日起生效。\n附件二：\n仲裁委员会仲裁暂行规则示范文本",
      "order": 62
    },
    {
      "id": "xzfg-68a0bd904d-0001-r2",
      "articleNumber": 20000001,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了保证公正、及时地仲裁经济纠纷，保护当事人的合法权益，根据《中华人民共和国仲裁法》(以下简称仲裁法)和《中华人民共和国民事诉讼法》(以下简称民事诉讼法)的有关规定，制定本暂行规则。",
      "order": 66
    },
    {
      "id": "xzfg-68a0bd904d-0002-r2",
      "articleNumber": 20000002,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "平等主体的公民、法人和其他组织之间发生合同纠纷和其他财产权益纠纷，可以依法向本仲裁委员会申请仲裁。\n本仲裁委员会不受理因劳动争议和农业集体经济组织内部的农业承包合同纠纷提出的仲裁申请。",
      "order": 67
    },
    {
      "id": "xzfg-68a0bd904d-0003-r2",
      "articleNumber": 20000003,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "当事人采用仲裁方式解决纠纷，应当双方自愿，达成仲裁协议。没有仲裁协议，一方申请仲裁的，本仲裁委员会不予受理。",
      "order": 69
    },
    {
      "id": "xzfg-68a0bd904d-0004-r2",
      "articleNumber": 20000004,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "仲裁协议包括合同中订立的仲裁条款和以其他书面方式在纠纷发生前或者纠纷发生后达成的请求仲裁的协议。\n仲裁协议应当具有下列内容：\n(一)请求仲裁的意思表示；\n(二)仲裁事项；\n(三)选定本仲裁委员会的意思表示。",
      "order": 70
    },
    {
      "id": "xzfg-68a0bd904d-0005-r2",
      "articleNumber": 20000005,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "仲裁协议独立存在，合同的变更、解除、终止或者无效，不影响仲裁协议的效力。\n仲裁庭有权确认合同的效力。",
      "order": 75
    },
    {
      "id": "xzfg-68a0bd904d-0006-r2",
      "articleNumber": 20000006,
      "displayNumber": "第六条",
      "path": [
        "第一章总则"
      ],
      "text": "当事人对仲裁协议的效力有异议的，可以请求本仲裁委员会作出决定或者请求人民法院作出裁定。一方请求本仲裁委员会作出决定，另一方请求人民法院作出裁定的，由人民法院裁定。\n当事人对仲裁协议的效力有异议，应当在仲裁庭首次开庭前提出；当事人协议不开庭的，应当在首次提交答辩书前提出。",
      "order": 77
    },
    {
      "id": "xzfg-68a0bd904d-0007-r2",
      "articleNumber": 20000007,
      "displayNumber": "第七条",
      "path": [
        "第二章申请和受理"
      ],
      "text": "当事人申请仲裁应当符合下列条件：\n(一)有仲裁协议；\n(二)有具体的仲裁请求和事实、理由；\n(三)属于本仲裁委员会的受理范围。",
      "order": 80
    },
    {
      "id": "xzfg-68a0bd904d-0008-r2",
      "articleNumber": 20000008,
      "displayNumber": "第八条",
      "path": [
        "第二章申请和受理"
      ],
      "text": "申请人申请仲裁，应当向本仲裁委员会递交仲裁协议、仲裁申请书及副本。",
      "order": 84
    },
    {
      "id": "xzfg-68a0bd904d-0009-r2",
      "articleNumber": 20000009,
      "displayNumber": "第九条",
      "path": [
        "第二章申请和受理"
      ],
      "text": "仲裁申请书应当载明下列事项：\n(一)申请人和被申请人的姓名、性别、年龄、职业、工作单位和住所，法人或者其他组织的名称、住所和法定代表人或者主要负责人的姓名、职务；\n(二)仲裁请求和所根据的事实、理由；\n(三)证据和证据来源、证人姓名和住所。",
      "order": 85
    },
    {
      "id": "xzfg-68a0bd904d-0010-r2",
      "articleNumber": 20000010,
      "displayNumber": "第十条",
      "path": [
        "第二章申请和受理"
      ],
      "text": "本仲裁委员会收到仲裁申请书之日起5日内，认为符合受理条件的，应当受理，并通知当事人，也可以当即受理，并通知当事人；认为不符合受理条件的，应当书面通知当事人不予受理，并说明理由。\n本仲裁委员会收到仲裁申请书后，认为仲裁申请书不符合本暂行规则第九条规定的，可以要求当事人限期补正；逾期不补正的，视为未申请。",
      "order": 89
    },
    {
      "id": "xzfg-68a0bd904d-0011-r2",
      "articleNumber": 20000011,
      "displayNumber": "第十一条",
      "path": [
        "第二章申请和受理"
      ],
      "text": "本仲裁委员会受理仲裁申请后，应当在15日内将本暂行规则和仲裁员名册送达申请人，并将仲裁申请书副本和暂行规则、仲裁员名册送达被申请人。\n被申请人收到仲裁申请书副本后，应当在15日内向仲裁委员会提交答辩书。仲裁委员会收到答辩书后，应当在15日内将答辩书副本送达申请人。被申请人未提交答辩书的，不影响仲裁程序的进行。",
      "order": 91
    },
    {
      "id": "xzfg-68a0bd904d-0012-r2",
      "articleNumber": 20000012,
      "displayNumber": "第十二条",
      "path": [
        "第二章申请和受理"
      ],
      "text": "申请人可以放弃或者变更仲裁请求。被申请人可以承认或者反驳仲裁请求，有权提出反请求。\n本仲裁委员会应当在收到被申请人提出反请求申请书之日起15日内，将反请求申请书副本送达申请人。\n申请人应当自收到反请求申请书之日起15日内向本仲裁委员会提出书面答辩；未提出书面答辩的，不影响仲裁程序的进行。",
      "order": 93
    },
    {
      "id": "xzfg-68a0bd904d-0013-r2",
      "articleNumber": 20000013,
      "displayNumber": "第十三条",
      "path": [
        "第二章申请和受理"
      ],
      "text": "一方当事人因另一方当事人的行为或者其他原因，可能使裁决不能执行或者难以执行的，可以申请财产保全。\n当事人申请财产保全的，本仲裁委员会应当将当事人的申请依照民事诉讼法的有关规定提交人民法院。\n申请有错误的，申请人应当赔偿被申请人因财产保全遭受的损失。",
      "order": 96
    },
    {
      "id": "xzfg-68a0bd904d-0014-r2",
      "articleNumber": 20000014,
      "displayNumber": "第十四条",
      "path": [
        "第二章申请和受理"
      ],
      "text": "当事人、法定代理人可以委托律师和其他代理人进行仲裁活动。委托律师和其他代理人进行仲裁活动的，应当向本仲裁委员会提交授权委托书。",
      "order": 99
    },
    {
      "id": "xzfg-68a0bd904d-0015-r2",
      "articleNumber": 20000015,
      "displayNumber": "第十五条",
      "path": [
        "第三章仲裁庭的组成"
      ],
      "text": "仲裁庭可以由3名仲裁员或者1名仲裁员组成。由3名仲裁员组成的，设首席仲裁员。",
      "order": 101
    },
    {
      "id": "xzfg-68a0bd904d-0016-r2",
      "articleNumber": 20000016,
      "displayNumber": "第十六条",
      "path": [
        "第三章仲裁庭的组成"
      ],
      "text": "当事人约定由3名仲裁员组成仲裁庭的，应当各自选定或者各自委托本仲裁委员会主任指定1名仲裁员，第三名仲裁员由当事人共同选定或者共同委托本仲裁委员会主任指定。第三名仲裁员是首席仲裁员。\n当事人约定由1名仲裁员成立仲裁庭的，应当由当事人共同选定或者共同委托本仲裁委员会主任指定仲裁员。",
      "order": 102
    },
    {
      "id": "xzfg-68a0bd904d-0017-r2",
      "articleNumber": 20000017,
      "displayNumber": "第十七条",
      "path": [
        "第三章仲裁庭的组成"
      ],
      "text": "当事人自收到受理仲裁通知之日起15日内没有约定仲裁庭的组成方式或者选定仲裁员的，由本仲裁委员会主任指定。",
      "order": 104
    },
    {
      "id": "xzfg-68a0bd904d-0018-r2",
      "articleNumber": 20000018,
      "displayNumber": "第十八条",
      "path": [
        "第三章仲裁庭的组成"
      ],
      "text": "仲裁庭组成后，本仲裁委员会应当自仲裁庭组成之日起5日内，将仲裁庭的组成情况书面通知当事人，也可以在仲裁庭组成当日将仲裁庭的组成情况书面通知当事人。",
      "order": 105
    },
    {
      "id": "xzfg-68a0bd904d-0019-r2",
      "articleNumber": 20000019,
      "displayNumber": "第十九条",
      "path": [
        "第三章仲裁庭的组成"
      ],
      "text": "仲裁员有下列情形之一的，必须回避，当事人也有权提出回避申请：\n(一)是本案当事人或者当事人、代理人的近亲属；\n(二)与本案有利害关系；\n(三)与本案当事人、代理人有其他关系，可能影响公正仲裁的；\n(四)私自会见当事人、代理人，或者接受当事人、代理人的请客送礼的。",
      "order": 106
    },
    {
      "id": "xzfg-68a0bd904d-0020-r2",
      "articleNumber": 20000020,
      "displayNumber": "第二十条",
      "path": [
        "第三章仲裁庭的组成"
      ],
      "text": "当事人提出回避申请，应当说明理由，在首次开庭前提出。回避事由在首次开庭后知道的，可以在最后一次开庭终结前提出。",
      "order": 111
    },
    {
      "id": "xzfg-68a0bd904d-0021-r2",
      "articleNumber": 20000021,
      "displayNumber": "第二十一条",
      "path": [
        "第三章仲裁庭的组成"
      ],
      "text": "仲裁员是否回避，由本仲裁委员会主任决定；仲裁委员会主任担任仲裁员时，由本仲裁委员会会议决定。",
      "order": 112
    },
    {
      "id": "xzfg-68a0bd904d-0022-r2",
      "articleNumber": 20000022,
      "displayNumber": "第二十二条",
      "path": [
        "第三章仲裁庭的组成"
      ],
      "text": "仲裁员因回避或者其他原因不能履行职责的，应当依照仲裁法和本暂行规则的规定重新选定或者指定仲裁员。\n因回避而重新选定或者指定仲裁员后，当事人可以请求已进行的仲裁程序重新进行，是否准许，由仲裁庭决定；仲裁庭也可以自行决定已进行的仲裁程序是否重新进行。",
      "order": 113
    },
    {
      "id": "xzfg-68a0bd904d-0023-r2",
      "articleNumber": 20000023,
      "displayNumber": "第二十三条",
      "path": [
        "第三章仲裁庭的组成"
      ],
      "text": "仲裁员私自会见当事人、代理人，或者接受当事人、代理人请客送礼，情节严重的，或者仲裁员在仲裁案件时有索贿受贿，徇私舞弊，枉法裁决行为的，应当依法承担法律责任，本仲裁委员会应当将其除名。",
      "order": 115
    },
    {
      "id": "xzfg-68a0bd904d-0024-r2",
      "articleNumber": 20000024,
      "displayNumber": "第二十四条",
      "path": [
        "第四章开庭和裁决"
      ],
      "text": "仲裁应当开庭进行。当事人协议不开庭的，仲裁庭可以根据仲裁申请书、答辩书以及其他材料作出裁决。",
      "order": 117
    },
    {
      "id": "xzfg-68a0bd904d-0025-r2",
      "articleNumber": 20000025,
      "displayNumber": "第二十五条",
      "path": [
        "第四章开庭和裁决"
      ],
      "text": "仲裁不公开进行。当事人协议公开的，可以公开进行，但是涉及国家秘密的除外。",
      "order": 118
    },
    {
      "id": "xzfg-68a0bd904d-0026-r2",
      "articleNumber": 20000026,
      "displayNumber": "第二十六条",
      "path": [
        "第四章开庭和裁决"
      ],
      "text": "仲裁委员会应当在仲裁庭开庭10日前将开庭日期通知双方当事人；双方当事人经商仲裁庭同意，可以提前开庭。当事人有正当理由的，可以在开庭前7日内请求延期开庭；是否延期，由仲裁庭决定。",
      "order": 119
    },
    {
      "id": "xzfg-68a0bd904d-0027-r2",
      "articleNumber": 20000027,
      "displayNumber": "第二十七条",
      "path": [
        "第四章开庭和裁决"
      ],
      "text": "申请人经书面通知，无正当理由不到庭或者未经仲裁庭许可中途退庭的，可以视为撤回仲裁申请。\n被申请人经书面通知，无正当理由不到庭或者未经仲裁庭许可中途退庭的，可以缺席裁决。",
      "order": 120
    },
    {
      "id": "xzfg-68a0bd904d-0028-r2",
      "articleNumber": 20000028,
      "displayNumber": "第二十八条",
      "path": [
        "第四章开庭和裁决"
      ],
      "text": "当事人应当对自己的主张提供证据。\n仲裁庭认为有必要收集的证据，可以自行收集。",
      "order": 122
    },
    {
      "id": "xzfg-68a0bd904d-0029-r2",
      "articleNumber": 20000029,
      "displayNumber": "第二十九条",
      "path": [
        "第四章开庭和裁决"
      ],
      "text": "书证应当提交原件。物证应当提交原物。提交原件或者原物确有困难的，可以提交复制品、照片、副本、节录本。\n提交外文书证，应当附有中文译本。",
      "order": 124
    },
    {
      "id": "xzfg-68a0bd904d-0030",
      "articleNumber": 30,
      "displayNumber": "第三十条",
      "path": [
        "第四章开庭和裁决"
      ],
      "text": "仲裁庭对专门性问题认为需要鉴定的，可以交由当事人约定的鉴定部门鉴定，也可以由仲裁庭指定的鉴定部门鉴定。\n根据当事人的请求或者仲裁庭的要求，鉴定部门应当派鉴定人参加开庭。当事人经仲裁庭许可，可以向鉴定人提问。",
      "order": 126
    },
    {
      "id": "xzfg-68a0bd904d-0031",
      "articleNumber": 31,
      "displayNumber": "第三十一条",
      "path": [
        "第四章开庭和裁决"
      ],
      "text": "证据应当在开庭时出示，当事人可以互相质证。",
      "order": 128
    },
    {
      "id": "xzfg-68a0bd904d-0032",
      "articleNumber": 32,
      "displayNumber": "第三十二条",
      "path": [
        "第四章开庭和裁决"
      ],
      "text": "在证据可能灭失或者以后难以取得的情况下，当事人可以申请证据保全。当事人申请证据保全的，本仲裁委员会应当将当事人的申请提交证据所在地的基层人民法院。",
      "order": 129
    },
    {
      "id": "xzfg-68a0bd904d-0033",
      "articleNumber": 33,
      "displayNumber": "第三十三条",
      "path": [
        "第四章开庭和裁决"
      ],
      "text": "当事人在仲裁过程中有权进行辩论。辩论终结时，首席仲裁员或者独任仲裁员应当征询当事人的最后意见。",
      "order": 130
    },
    {
      "id": "xzfg-68a0bd904d-0034",
      "articleNumber": 34,
      "displayNumber": "第三十四条",
      "path": [
        "第四章开庭和裁决"
      ],
      "text": "仲裁庭应当将开庭情况记入笔录。当事人和其他仲裁参与人认为对自己陈述的记录有遗漏或者差错的，有权申请补正；如果不予补正，应当记录该申请。\n笔录由仲裁员、记录人员、当事人和其他仲裁参与人签名或者盖章。",
      "order": 131
    },
    {
      "id": "xzfg-68a0bd904d-0035",
      "articleNumber": 35,
      "displayNumber": "第三十五条",
      "path": [
        "第四章开庭和裁决"
      ],
      "text": "当事人申请仲裁后，可以自行和解。达成和解协议的，可以请求仲裁庭根据和解协议作出裁决书，也可以撤回仲裁申请。",
      "order": 133
    },
    {
      "id": "xzfg-68a0bd904d-0036",
      "articleNumber": 36,
      "displayNumber": "第三十六条",
      "path": [
        "第四章开庭和裁决"
      ],
      "text": "当事人达成和解协议，撤回仲裁申请后反悔的，可以根据仲裁协议申请仲裁。",
      "order": 134
    },
    {
      "id": "xzfg-68a0bd904d-0037",
      "articleNumber": 37,
      "displayNumber": "第三十七条",
      "path": [
        "第四章开庭和裁决"
      ],
      "text": "仲裁庭在作出裁决前，可以先行调解。当事人自愿调解的，仲裁庭应当调解。调解不成的，仲裁庭应当及时作出裁决。\n调解达成协议的，仲裁庭应当制作调解书或者根据协议的结果制作裁决书。调解书与裁决书具有同等法律效力。",
      "order": 135
    },
    {
      "id": "xzfg-68a0bd904d-0038",
      "articleNumber": 38,
      "displayNumber": "第三十八条",
      "path": [
        "第四章开庭和裁决"
      ],
      "text": "调解书应当写明仲裁请求和当事人协议的结果。调解书由仲裁员签名，加盖本仲裁委员会印章，送达双方当事人。\n调解书经双方当事人签收后，即发生法律效力。\n在调解书签收前当事人反悔的，仲裁庭应当及时作出裁决。",
      "order": 137
    },
    {
      "id": "xzfg-68a0bd904d-0039",
      "articleNumber": 39,
      "displayNumber": "第三十九条",
      "path": [
        "第四章开庭和裁决"
      ],
      "text": "裁决应当按照多数仲裁员的意见作出，少数仲裁员的不同意见可以记入笔录。仲裁庭不能形成多数意见时，裁决应当按照首席仲裁员的意见作出。",
      "order": 140
    },
    {
      "id": "xzfg-68a0bd904d-0040",
      "articleNumber": 40,
      "displayNumber": "第四十条",
      "path": [
        "第四章开庭和裁决"
      ],
      "text": "仲裁庭仲裁纠纷时，其中一部分事实已经清楚，可以就该部分先行裁决。",
      "order": 141
    },
    {
      "id": "xzfg-68a0bd904d-0041",
      "articleNumber": 41,
      "displayNumber": "第四十一条",
      "path": [
        "第四章开庭和裁决"
      ],
      "text": "仲裁庭应当在仲裁庭组成后4个月内作出仲裁裁决。有特殊情况需要延长的，由首席仲裁员或者独任仲裁员报经本仲裁委员会主任批准，可以适当延长。",
      "order": 142
    },
    {
      "id": "xzfg-68a0bd904d-0042",
      "articleNumber": 42,
      "displayNumber": "第四十二条",
      "path": [
        "第四章开庭和裁决"
      ],
      "text": "裁决书应当写明仲裁请求、争议事实、裁决理由、裁决结果、仲裁费用的负担和裁决日期。\n当事人协议不愿写明争议事实和裁决理由的，可以不写。\n裁决书由仲裁员签名。对裁决持不同意见的仲裁员，可以签名，也可以不签名。",
      "order": 143
    },
    {
      "id": "xzfg-68a0bd904d-0043",
      "articleNumber": 43,
      "displayNumber": "第四十三条",
      "path": [
        "第四章开庭和裁决"
      ],
      "text": "裁决书经仲裁员签名后，仲裁委员会应当加盖本仲裁委员会印章。",
      "order": 146
    },
    {
      "id": "xzfg-68a0bd904d-0044",
      "articleNumber": 44,
      "displayNumber": "第四十四条",
      "path": [
        "第四章开庭和裁决"
      ],
      "text": "裁决书自作出之日起发生法律效力。",
      "order": 147
    },
    {
      "id": "xzfg-68a0bd904d-0045",
      "articleNumber": 45,
      "displayNumber": "第四十五条",
      "path": [
        "第四章开庭和裁决"
      ],
      "text": "对裁决书中的文字、计算错误或者对仲裁庭已经裁决但在裁决书中遗漏的事项，仲裁庭应当补正；当事人自收到裁决书之日起30日内，可以请求仲裁庭补正。",
      "order": 148
    },
    {
      "id": "xzfg-68a0bd904d-0046",
      "articleNumber": 46,
      "displayNumber": "第四十六条",
      "path": [
        "第四章开庭和裁决"
      ],
      "text": "当事人提出证据证明裁决有下列情形之一的，可以自收到仲裁裁决书之日起6个月内向本仲裁委员会所在地的中级人民法院申请撤销裁决：\n(一)没有仲裁协议的；\n(二)裁决的事项不属于仲裁协议的范围或者仲裁委员会无权仲裁的；\n(三)仲裁庭的组成或者仲裁的程序违反法定程序的；\n(四)裁决所根据的证据是伪造的；\n(五)对方当事人隐瞒了足以影响公正裁决的证据的；\n(六)仲裁员在仲裁该案时有索贿受贿，徇私舞弊，枉法裁决行为的。",
      "order": 149
    },
    {
      "id": "xzfg-68a0bd904d-0047",
      "articleNumber": 47,
      "displayNumber": "第四十七条",
      "path": [
        "第四章开庭和裁决"
      ],
      "text": "当事人应当在仲裁裁决书确定的期限内履行裁决。未确定履行期限的，当事人应当立即履行。\n一方当事人不履行仲裁裁决的，另一方当事人可以依照民事诉讼法的有关规定向人民法院申请执行。",
      "order": 156
    },
    {
      "id": "xzfg-68a0bd904d-0048",
      "articleNumber": 48,
      "displayNumber": "第四十八条",
      "path": [
        "第五章附则"
      ],
      "text": "法律对仲裁时效有规定的，从其规定；法律对仲裁时效没有规定的，适用诉讼时效的规定。",
      "order": 159
    },
    {
      "id": "xzfg-68a0bd904d-0049",
      "articleNumber": 49,
      "displayNumber": "第四十九条",
      "path": [
        "第五章附则"
      ],
      "text": "除当事人另有约定或者仲裁庭另有要求外，仲裁文书、通知、材料可以直接送达当事人、代理人，或者以邮寄、传真、电报等方式送达当事人、代理人。",
      "order": 160
    },
    {
      "id": "xzfg-68a0bd904d-0050",
      "articleNumber": 50,
      "displayNumber": "第五十条",
      "path": [
        "第五章附则"
      ],
      "text": "期间以时、日、月、年计算。期间开始的时和日，不计算在期间内。\n期间届满的最后一日是节假日的，以节假日后的第一日为期间届满的日期。\n期间不包括在途时间，仲裁文书、材料、通知在期满前交邮、交发的，不算过期。",
      "order": 161
    },
    {
      "id": "xzfg-68a0bd904d-0051",
      "articleNumber": 51,
      "displayNumber": "第五十一条",
      "path": [
        "第五章附则"
      ],
      "text": "当事人因不可抗拒的事由或者其他正当理由耽误期限的，在障碍消除后的10日内，可以申请顺延期限；是否准许，由本仲裁委员会或者仲裁庭决定。",
      "order": 164
    },
    {
      "id": "xzfg-68a0bd904d-0052",
      "articleNumber": 52,
      "displayNumber": "第五十二条",
      "path": [
        "第五章附则"
      ],
      "text": "仲裁员报酬由本仲裁委员会按照仲裁员办理仲裁案件的工作时间、难易程度、争议大小等情况确定。\n仲裁员报酬从本仲裁委员会收取的仲裁案件受理费中支付。",
      "order": 165
    },
    {
      "id": "xzfg-68a0bd904d-0053",
      "articleNumber": 53,
      "displayNumber": "第五十三条",
      "path": [
        "第五章附则"
      ],
      "text": "本暂行规则自 年 月 日起生效。",
      "order": 167
    }
  ]
}
