  ],
  "articles": [
    {
      "id": "xzfg-483303739a-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了加强电力供应与使用的管理，保障供电、用电双方的合法权益，维护供电、用电秩序，安全、经济、合理地供电和用电，根据《中华人民共和国电力法》制定本条例。",
      "order": 2
    },
    {
      "id": "xzfg-483303739a-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "在中华人民共和国境内，电力供应企业(以下称供电企业)和电力使用者(以下称用户)以及与电力供应、使用有关的单位和个人，必须遵守本条例。",
      "order": 3
    },
    {
      "id": "xzfg-483303739a-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "国务院电力管理部门负责全国电力供应与使用的监督管理工作。\n县级以上地方人民政府电力管理部门负责本行政区域内电力供应与使用的监督管理工作。",
      "order": 4
    },
    {
      "id": "xzfg-483303739a-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "电网经营企业依法负责本供区内的电力供应与使用的业务工作，并接受电力管理部门的监督。",
      "order": 6
    },
    {
      "id": "xzfg-483303739a-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "国家对电力供应和使用实行安全用电、节约用电、计划用电的管理原则。\n供电企业和用户应当遵守国家有关规定，采取有效措施，做好安全用电、节约用电、计划用电工作。",
      "order": 7
    },
    {
      "id": "xzfg-483303739a-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第一章总则"
      ],
      "text": "供电企业和用户应当根据平等自愿、协商一致的原则签订供用电合同。",
      "order": 9
    },
    {
      "id": "xzfg-483303739a-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第一章总则"
      ],
      "text": "电力管理部门应当加强对供用电的监督管理，协调供用电各方关系，禁止危害供用电安全和非法侵占电能的行为。",
      "order": 10
    },
    {
      "id": "xzfg-483303739a-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第二章供电营业区"
      ],
      "text": "供电企业在批准的供电营业区内向用户供电。\n供电营业区的划分，应当考虑电网的结构和供电合理性等因素。一个供电营业区内只设立一个供电营业机构。",
      "order": 12
    },
    {
      "id": "xzfg-483303739a-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第二章供电营业区"
      ],
      "text": "供电营业区的设立、变更，由供电企业提出申请，电力管理部门依据职责和管理权限，会同同级有关部门审查批准后，发给《电力业务许可证》。\n电网经营企业应当根据电网结构和供电合理性的原则协助电力管理部门划分供电营业区。\n供电营业区的划分和管理办法，由国务院电力管理部门制定。",
      "order": 14
    },
    {
      "id": "xzfg-483303739a-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第二章供电营业区"
      ],
      "text": "并网运行的电力生产企业按照并网协议运行后，送入电网的电力、电量由供电营业机构统一经销。",
      "order": 17
    },
    {
      "id": "xzfg-483303739a-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第二章供电营业区"
      ],
      "text": "用户用电容量超过其所在的供电营业区内供电企业供电能力的，由省级以上电力管理部门指定的其他供电企业供电。",
      "order": 18
    },
    {
      "id": "xzfg-483303739a-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第三章供电设施"
      ],
      "text": "县级以上各级人民政府应当将城乡电网的建设与改造规划，纳入城市建设和乡村建设的总体规划。各级电力管理部门应当会同有关行政主管部门和电网经营企业做好城乡电网建设和改造的规划。供电企业应当按照规划做好供电设施建设和运行管理工作。",
      "order": 20
    },
    {
      "id": "xzfg-483303739a-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第三章供电设施"
      ],
      "text": "地方各级人民政府应当按照城市建设和乡村建设的总体规划统筹安排城乡供电线路走廊、电缆通道、区域变电所、区域配电所和营业网点的用地。\n供电企业可以按照国家有关规定在规划的线路走廊、电缆通道、区域变电所、区域配电所和营业网点的用地上，架线、敷设电缆和建设公用供电设施。",
      "order": 21
    },
    {
      "id": "xzfg-483303739a-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第三章供电设施"
      ],
      "text": "公用路灯由乡、民族乡、镇人民政府或者县级以上地方人民政府有关部门负责建设，并负责运行维护和交付电费，也可以委托供电企业代为有偿设计、施工和维护管理。",
      "order": 23
    },
    {
      "id": "xzfg-483303739a-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第三章供电设施"
      ],
      "text": "供电设施、受电设施的设计、施工、试验和运行，应当符合国家标准或者电力行业标准。",
      "order": 24
    },
    {
      "id": "xzfg-483303739a-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第三章供电设施"
      ],
      "text": "供电企业和用户对供电设施、受电设施进行建设和维护时，作业区域内的有关单位和个人应当给予协助，提供方便；因作业对建筑物或者农作物造成损坏的，应当依照有关法律、行政法规的规定负责修复或者给予合理的补偿。",
      "order": 25
    },
    {
      "id": "xzfg-483303739a-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第三章供电设施"
      ],
      "text": "公用供电设施建成投产后，由供电单位统一维护管理。经电力管理部门批准，供电企业可以使用、改造、扩建该供电设施。\n共用供电设施的维护管理，由产权单位协商确定，产权单位可自行维护管理，也可以委托供电企业维护管理。\n用户专用的供电设施建成投产后，由用户维护管理或者委托供电企业维护管理。",
      "order": 26
    },
    {
      "id": "xzfg-483303739a-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第三章供电设施"
      ],
      "text": "因建设需要，必须对已建成的供电设施进行迁移、改造或者采取防护措施时，建设单位应当事先与该供电设施管理单位协商，所需工程费用由建设单位负担。",
      "order": 29
    },
    {
      "id": "xzfg-483303739a-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第四章电力供应"
      ],
      "text": "用户受电端的供电质量应当符合国家标准或者电力行业标准。",
      "order": 31
    },
    {
      "id": "xzfg-483303739a-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第四章电力供应"
      ],
      "text": "供电方式应当按照安全、可靠、经济、合理和便于管理的原则，由电力供应与使用双方根据国家有关规定以及电网规划、用电需求和当地供电条件等因素协商确定。\n在公用供电设施未到达的地区，供电企业可以委托有供电能力的单位就近供电。非经供电企业委托，任何单位不得擅自向外供电。",
      "order": 32
    },
    {
      "id": "xzfg-483303739a-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第四章电力供应"
      ],
      "text": "因抢险救灾需要紧急供电时，供电企业必须尽速安排供电。所需工程费用和应付电费由有关地方人民政府有关部门从抢险救灾经费中支出，但是抗旱用电应当由用户交付电费。",
      "order": 34
    },
    {
      "id": "xzfg-483303739a-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第四章电力供应"
      ],
      "text": "用户对供电质量有特殊要求的，供电企业应当根据其必要性和电网的可能，提供相应的电力。",
      "order": 35
    },
    {
      "id": "xzfg-483303739a-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第四章电力供应"
      ],
      "text": "申请新装用电、临时用电、增加用电容量、变更用电和终止用电，均应当到当地供电企业办理手续，并按照国家有关规定交付费用；供电企业没有不予供电的合理理由的，应当供电。供电企业应当在其营业场所公告用电的程序、制度和收费标准。",
      "order": 36
    },
    {
      "id": "xzfg-483303739a-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第四章电力供应"
      ],
      "text": "供电企业应当按照国家标准或者电力行业标准参与用户受送电装置设计图纸的审核，对用户受送电装置隐蔽工程的施工过程实施监督，并在该受送电装置工程竣工后进行检验；检验合格的，方可投入使用。",
      "order": 37
    },
    {
      "id": "xzfg-483303739a-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第四章电力供应"
      ],
      "text": "供电企业应当按照国家有关规定实行分类电价、分时电价。",
      "order": 38
    },
    {
      "id": "xzfg-483303739a-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第四章电力供应"
      ],
      "text": "用户应当安装用电计量装置。用户使用的电力、电量，以计量检定机构依法认可的用电计量装置的记录为准。用电计量装置，应当安装在供电设施与受电设施的产权分界处。\n安装在用户处的用电计量装置，由用户负责保护。",
      "order": 39
    },
    {
      "id": "xzfg-483303739a-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第四章电力供应"
      ],
      "text": "供电企业应当按照国家核准的电价和用电计量装置的记录，向用户计收电费。\n用户应当按照国家批准的电价，并按照规定的期限、方式或者合同约定的办法，交付电费。",
      "order": 41
    },
    {
      "id": "xzfg-483303739a-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第四章电力供应"
      ],
      "text": "除本条例另有规定外，在发电、供电系统正常运行的情况下，供电企业应当连续向用户供电；因故需要停止供电时，应当按照下列要求事先通知用户或者进行公告：\n(一)因供电设施计划检修需要停电时，供电企业应当提前7天通知用户或者进行公告；\n(二)因供电设施临时检修需要停止供电时，供电企业应当提前24小时通知重要用户；\n(三)因发电、供电系统发生故障需要停电、限电时，供电企业应当按照事先确定的限电序位进行停电或者限电。引起停电或者限电的原因消除后，供电企业应当尽快恢复供电。",
      "order": 43
    },
    {
      "id": "xzfg-483303739a-0029",
      "articleNumber": 29,
      "displayNumber": "第二十九条",
      "path": [
        "第五章电力使用"
      ],
      "text": "县级以上人民政府电力管理部门应当遵照国家产业政策，按照统筹兼顾、保证重点、择优供应的原则，做好计划用电工作。\n供电企业和用户应当制订节约用电计划，推广和采用节约用电的新技术、新材料、新工艺、新设备，降低电能消耗。\n供电企业和用户应当采用先进技术、采取科学管理措施，安全供电、用电，避免发生事故，维护公共安全。",
      "order": 48
    },
    {
      "id": "xzfg-483303739a-0030",
      "articleNumber": 30,
      "displayNumber": "第三十条",
      "path": [
        "第五章电力使用"
      ],
      "text": "用户不得有下列危害供电、用电安全，扰乱正常供电、用电秩序的行为：\n(一)擅自改变用电类别；\n(二)擅自超过合同约定的容量用电；\n(三)擅自超过计划分配的用电指标的；\n(四)擅自使用已经在供电企业办理暂停使用手续的电力设备，或者擅自启用已经被供电企业查封的电力设备；\n(五)擅自迁移、更动或者擅自操作供电企业的用电计量装置、电力负荷控制装置、供电设施以及约定由供电企业调度的用户受电设备；\n(六)未经供电企业许可，擅自引入、供出电源或者将自备电源擅自并网。",
      "order": 51
    },
    {
      "id": "xzfg-483303739a-0031",
      "articleNumber": 31,
      "displayNumber": "第三十一条",
      "path": [
        "第五章电力使用"
      ],
      "text": "禁止窃电行为。窃电行为包括：\n(一)在供电企业的供电设施上，擅自接线用电；\n(二)绕越供电企业的用电计量装置用电；\n(三)伪造或者开启法定的或者授权的计量检定机构加封的用电计量装置封印用电；\n(四)故意损坏供电企业用电计量装置；\n(五)故意使供电企业的用电计量装置计量不准或者失效；\n(六)采用其他方法窃电。",
      "order": 58
    },
    {
      "id": "xzfg-483303739a-0032",
      "articleNumber": 32,
      "displayNumber": "第三十二条",
      "path": [
        "第六章供用电合同"
      ],
      "text": "供电企业和用户应当在供电前根据用户需要和供电企业的供电能力签订供用电合同。",
      "order": 66
    },
    {
      "id": "xzfg-483303739a-0033",
      "articleNumber": 33,
      "displayNumber": "第三十三条",
      "path": [
        "第六章供用电合同"
      ],
      "text": "供用电合同应当具备以下条款：\n(一)供电方式、供电质量和供电时间；\n(二)用电容量和用电地址、用电性质；\n(三)计量方式和电价、电费结算方式；\n(四)供用电设施维护责任的划分；\n(五)合同的有效期限；\n(六)违约责任；\n(七)双方共同认为应当约定的其他条款。",
      "order": 67
    },
    {
      "id": "xzfg-483303739a-0034",
      "articleNumber": 34,
      "displayNumber": "第三十四条",
      "path": [
        "第六章供用电合同"
      ],
      "text": "供电企业应当按照合同约定的数量、质量、时间、方式，合理调度和安全供电。\n用户应当按照合同约定的数量、条件用电，交付电费和国家规定的其他费用。",
      "order": 75
    },
    {
      "id": "xzfg-483303739a-0035",
      "articleNumber": 35,
      "displayNumber": "第三十五条",
      "path": [
        "第六章供用电合同"
      ],
      "text": "供用电合同的变更或者解除，应当依照有关法律、行政法规和本条例的规定办理。",
      "order": 77
    },
    {
      "id": "xzfg-483303739a-0036",
      "articleNumber": 36,
      "displayNumber": "第三十六条",
      "path": [
        "第七章监督与管理"
      ],
      "text": "电力管理部门应当加强对供电、用电的监督和管理。供电、用电监督检查工作人员必须具备相应的条件。供电、用电监督检查工作人员执行公务时，应当出示证件。\n供电、用电监督检查管理的具体办法，由国务院电力管理部门另行制定。",
      "order": 79
    },
    {
      "id": "xzfg-483303739a-0037",
      "articleNumber": 37,
      "displayNumber": "第三十七条",
      "path": [
        "第七章监督与管理"
      ],
      "text": "承装、承修、承试供电设施和受电设施的单位，必须经电力管理部门审核合格，取得电力管理部门颁发的《承装(修)电力设施许可证》。",
      "order": 81
    },
    {
      "id": "xzfg-483303739a-0038",
      "articleNumber": 38,
      "displayNumber": "第三十八条",
      "path": [
        "第八章法律责任"
      ],
      "text": "违反本条例规定，有下列行为之一的，由电力管理部门责令改正，没收违法所得，可以并处违法所得5倍以下的罚款：\n(一)未按照规定取得《电力业务许可证》，从事电力供应业务的；\n(二)擅自伸入或者跨越供电营业区供电的；\n(三)擅自向外转供电的。",
      "order": 83
    },
    {
      "id": "xzfg-483303739a-0039",
      "articleNumber": 39,
      "displayNumber": "第三十九条",
      "path": [
        "第八章法律责任"
      ],
      "text": "违反本条例第二十七条规定，逾期未交付电费的，供电企业可以从逾期之日起，每日按照电费总额的1‰至3‰加收违约金，具体比例由供用电双方在供用电合同中约定；自逾期之日起计算超过30日，经催交仍未交付电费的，供电企业可以按照国家规定的程序停止供电。",
      "order": 87
    },
    {
      "id": "xzfg-483303739a-0040",
      "articleNumber": 40,
      "displayNumber": "第四十条",
      "path": [
        "第八章法律责任"
      ],
      "text": "违反本条例第三十条规定，违章用电的，供电企业可以根据违章事实和造成的后果追缴电费，并按照国务院电力管理部门的规定加收电费和国家规定的其他费用；情节严重的，可以按照国家规定的程序停止供电。",
      "order": 88
    },
    {
      "id": "xzfg-483303739a-0041",
      "articleNumber": 41,
      "displayNumber": "第四十一条",
      "path": [
        "第八章法律责任"
      ],
      "text": "违反本条例第三十一条规定，盗窃电能的，由电力管理部门责令停止违法行为，追缴电费并处应交电费5倍以下的罚款；构成犯罪的，依法追究刑事责任。",
      "order": 89
    },
    {
      "id": "xzfg-483303739a-0042",
      "articleNumber": 42,
      "displayNumber": "第四十二条",
      "path": [
        "第八章法律责任"
      ],
      "text": "供电企业或者用户违反供用电合同，给对方造成损失的，应当依法承担赔偿责任。",
      "order": 90
    },
    {
      "id": "xzfg-483303739a-0043",
      "articleNumber": 43,
      "displayNumber": "第四十三条",
      "path": [
        "第八章法律责任"
      ],
      "text": "因电力运行事故给用户或者第三人造成损害的，供电企业应当依法承担赔偿责任。\n因用户或者第三人的过错给供电企业或者其他用户造成损害的，该用户或者第三人应当依法承担赔偿责任。",
      "order": 91
    },
    {
      "id": "xzfg-483303739a-0044",
      "articleNumber": 44,
      "displayNumber": "第四十四条",
      "path": [
        "第八章法律责任"
      ],
      "text": "供电企业职工违反规章制度造成供电事故的，或者滥用职权、利用职务之便谋取私利的，依法给予行政处分；构成犯罪的，依法追究刑事责任。",
      "order": 93
    },
    {
      "id": "xzfg-483303739a-0045",
      "articleNumber": 45,
      "displayNumber": "第四十五条",
      "path": [
        "第九章附则"
      ],
      "text": "本条例自1996年9月1日起施行。",
      "order": 95
    }
  ]
}
