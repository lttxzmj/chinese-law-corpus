  "articles": [
    {
      "id": "law-ec3694af23-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了加强计量监督管理，保障国家计量单位制的统一和量值的准确可靠，有利于生产、贸易和科学技术的发展，适应社会主义现代化建设的需要，维护国家、人民的利益，制定本法。",
      "order": 2
    },
    {
      "id": "law-ec3694af23-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "在中华人民共和国境内，建立计量基准器具、计量标准器具，进行计量检定，制造、修理、销售、使用计量器具，必须遵守本法。",
      "order": 3
    },
    {
      "id": "law-ec3694af23-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "国家实行法定计量单位制度。\n国际单位制计量单位和国家选定的其他计量单位，为国家法定计量单位。国家法定计量单位的名称、符号由国务院公布。\n因特殊需要采用非法定计量单位的管理办法，由国务院计量行政部门另行制定。",
      "order": 4
    },
    {
      "id": "law-ec3694af23-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "国务院计量行政部门对全国计量工作实施统一监督管理。\n县级以上地方人民政府计量行政部门对本行政区域内的计量工作实施监督管理。",
      "order": 7
    },
    {
      "id": "law-ec3694af23-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第二章计量基准器具、计量标准器具和计量检定"
      ],
      "text": "国务院计量行政部门负责建立各种计量基准器具，作为统一全国量值的最高依据。",
      "order": 10
    },
    {
      "id": "law-ec3694af23-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第二章计量基准器具、计量标准器具和计量检定"
      ],
      "text": "县级以上地方人民政府计量行政部门根据本地区的需要，建立社会公用计量标准器具，经上级人民政府计量行政部门主持考核合格后使用。",
      "order": 11
    },
    {
      "id": "law-ec3694af23-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第二章计量基准器具、计量标准器具和计量检定"
      ],
      "text": "国务院有关主管部门和省、自治区、直辖市人民政府有关主管部门，根据本部门的特殊需要，可以建立本部门使用的计量标准器具，其各项最高计量标准器具经同级人民政府计量行政部门主持考核合格后使用。",
      "order": 12
    },
    {
      "id": "law-ec3694af23-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第二章计量基准器具、计量标准器具和计量检定"
      ],
      "text": "企业、事业单位根据需要，可以建立本单位使用的计量标准器具，其各项最高计量标准器具经有关人民政府计量行政部门主持考核合格后使用。",
      "order": 13
    },
    {
      "id": "law-ec3694af23-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第二章计量基准器具、计量标准器具和计量检定"
      ],
      "text": "县级以上人民政府计量行政部门对社会公用计量标准器具，部门和企业、事业单位使用的最高计量标准器具，以及用于贸易结算、安全防护、医疗卫生、环境监测方面的列入强制检定目录的工作计量器具，实行强制检定。未按照规定申请检定或者检定不合格的，不得使用。实行强制检定的工作计量器具的目录和管理办法，由国务院制定。\n对前款规定以外的其他计量标准器具和工作计量器具，使用单位应当自行定期检定或者送其他计量检定机构检定。",
      "order": 14
    },
    {
      "id": "law-ec3694af23-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第二章计量基准器具、计量标准器具和计量检定"
      ],
      "text": "计量检定必须按照国家计量检定系统表进行。国家计量检定系统表由国务院计量行政部门制定。\n计量检定必须执行计量检定规程。国家计量检定规程由国务院计量行政部门制定。没有国家计量检定规程的，由国务院有关主管部门和省、自治区、直辖市人民政府计量行政部门分别制定部门计量检定规程和地方计量检定规程。",
      "order": 16
    },
    {
      "id": "law-ec3694af23-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第二章计量基准器具、计量标准器具和计量检定"
      ],
      "text": "计量检定工作应当按照经济合理的原则，就地就近进行。",
      "order": 18
    },
    {
      "id": "law-ec3694af23-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第三章计量器具管理"
      ],
      "text": "制造、修理计量器具的企业、事业单位，必须具有与所制造、修理的计量器具相适应的设施、人员和检定仪器设备。",
      "order": 20
    },
    {
      "id": "law-ec3694af23-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第三章计量器具管理"
      ],
      "text": "制造计量器具的企业、事业单位生产本单位未生产过的计量器具新产品，必须经省级以上人民政府计量行政部门对其样品的计量性能考核合格，方可投入生产。",
      "order": 21
    },
    {
      "id": "law-ec3694af23-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第三章计量器具管理"
      ],
      "text": "任何单位和个人不得违反规定制造、销售和进口非法定计量单位的计量器具。",
      "order": 22
    },
    {
      "id": "law-ec3694af23-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第三章计量器具管理"
      ],
      "text": "制造、修理计量器具的企业、事业单位必须对制造、修理的计量器具进行检定，保证产品计量性能合格，并对合格产品出具产品合格证。",
      "order": 23
    },
    {
      "id": "law-ec3694af23-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第三章计量器具管理"
      ],
      "text": "使用计量器具不得破坏其准确度，损害国家和消费者的利益。",
      "order": 24
    },
    {
      "id": "law-ec3694af23-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第三章计量器具管理"
      ],
      "text": "个体工商户可以制造、修理简易的计量器具。\n个体工商户制造、修理计量器具的范围和管理办法，由国务院计量行政部门制定。",
      "order": 25
    },
    {
      "id": "law-ec3694af23-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第四章计量监督"
      ],
      "text": "县级以上人民政府计量行政部门应当依法对制造、修理、销售、进口和使用计量器具，以及计量检定等相关计量活动进行监督检查。有关单位和个人不得拒绝、阻挠。",
      "order": 28
    },
    {
      "id": "law-ec3694af23-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第四章计量监督"
      ],
      "text": "县级以上人民政府计量行政部门，根据需要设置计量监督员。计量监督员管理办法，由国务院计量行政部门制定。",
      "order": 29
    },
    {
      "id": "law-ec3694af23-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第四章计量监督"
      ],
      "text": "县级以上人民政府计量行政部门可以根据需要设置计量检定机构，或者授权其他单位的计量检定机构，执行强制检定和其他检定、测试任务。\n执行前款规定的检定、测试任务的人员，必须经考核合格。",
      "order": 30
    },
    {
      "id": "law-ec3694af23-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第四章计量监督"
      ],
      "text": "处理因计量器具准确度所引起的纠纷，以国家计量基准器具或者社会公用计量标准器具检定的数据为准。",
      "order": 32
    },
    {
      "id": "law-ec3694af23-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第四章计量监督"
      ],
      "text": "为社会提供公证数据的产品质量检验机构，必须经省级以上人民政府计量行政部门对其计量检定、测试的能力和可靠性考核合格。",
      "order": 33
    },
    {
      "id": "law-ec3694af23-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第五章法律责任"
      ],
      "text": "制造、销售未经考核合格的计量器具新产品的，责令停止制造、销售该种新产品，没收违法所得，可以并处罚款。",
      "order": 35
    },
    {
      "id": "law-ec3694af23-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第五章法律责任"
      ],
      "text": "制造、修理、销售的计量器具不合格的，没收违法所得，可以并处罚款。",
      "order": 36
    },
    {
      "id": "law-ec3694af23-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第五章法律责任"
      ],
      "text": "属于强制检定范围的计量器具，未按照规定申请检定或者检定不合格继续使用的，责令停止使用，可以并处罚款。",
      "order": 37
    },
    {
      "id": "law-ec3694af23-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第五章法律责任"
      ],
      "text": "使用不合格的计量器具或者破坏计量器具准确度，给国家和消费者造成损失的，责令赔偿损失，没收计量器具和违法所得，可以并处罚款。",
      "order": 38
    },
    {
      "id": "law-ec3694af23-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第五章法律责任"
      ],
      "text": "制造、销售、使用以欺骗消费者为目的的计量器具的，没收计量器具和违法所得，处以罚款；情节严重的，并对个人或者单位直接责任人员依照刑法有关规定追究刑事责任。",
      "order": 39
    },
    {
      "id": "law-ec3694af23-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第五章法律责任"
      ],
      "text": "违反本法规定，制造、修理、销售的计量器具不合格，造成人身伤亡或者重大财产损失的，依照刑法有关规定，对个人或者单位直接责任人员追究刑事责任。",
      "order": 40
    },
    {
      "id": "law-ec3694af23-0029",
      "articleNumber": 29,
      "displayNumber": "第二十九条",
      "path": [
        "第五章法律责任"
      ],
      "text": "计量监督人员违法失职，情节严重的，依照刑法有关规定追究刑事责任；情节轻微的，给予行政处分。",
      "order": 41
    },
    {
      "id": "law-ec3694af23-0030",
      "articleNumber": 30,
      "displayNumber": "第三十条",
      "path": [
        "第五章法律责任"
      ],
      "text": "本法规定的行政处罚，由县级以上地方人民政府计量行政部门决定。",
      "order": 42
    },
    {
      "id": "law-ec3694af23-0031",
      "articleNumber": 31,
      "displayNumber": "第三十一条",
      "path": [
        "第五章法律责任"
      ],
      "text": "当事人对行政处罚决定不服的，可以在接到处罚通知之日起十五日内向人民法院起诉；对罚款、没收违法所得的行政处罚决定期满不起诉又不履行的，由作出行政处罚决定的机关申请人民法院强制执行。",
      "order": 43
    },
    {
      "id": "law-ec3694af23-0032",
      "articleNumber": 32,
      "displayNumber": "第三十二条",
      "path": [
        "第六章附则"
      ],
      "text": "中国人民解放军和国防科技工业系统计量工作的监督管理办法，由国务院、中央军事委员会依据本法另行制定。",
      "order": 45
    },
    {
      "id": "law-ec3694af23-0033",
      "articleNumber": 33,
      "displayNumber": "第三十三条",
      "path": [
        "第六章附则"
      ],
      "text": "国务院计量行政部门根据本法制定实施细则，报国务院批准施行。",
      "order": 46
    },
    {
      "id": "law-ec3694af23-0034",
      "articleNumber": 34,
      "displayNumber": "第三十四条",
      "path": [
        "第六章附则"
      ],
      "text": "本法自1986年7月1日起施行。",
      "order": 47
    }
  ]
}
