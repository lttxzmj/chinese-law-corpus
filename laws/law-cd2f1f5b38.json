  "articles": [
    {
      "id": "law-cd2f1f5b38-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了调整信托关系，规范信托行为，保护信托当事人的合法权益，促进信托事业的健康发展，制定本法。",
      "order": 2
    },
    {
      "id": "law-cd2f1f5b38-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "本法所称信托，是指委托人基于对受托人的信任，将其财产权委托给受托人，由受托人按委托人的意愿以自己的名义，为受益人的利益或者特定目的，进行管理或者处分的行为。",
      "order": 3
    },
    {
      "id": "law-cd2f1f5b38-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "委托人、受托人、受益人（以下统称信托当事人）在中华人民共和国境内进行民事、营业、公益信托活动，适用本法。",
      "order": 4
    },
    {
      "id": "law-cd2f1f5b38-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "受托人采取信托机构形式从事信托活动，其组织和管理由国务院制定具体办法。",
      "order": 5
    },
    {
      "id": "law-cd2f1f5b38-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "信托当事人进行信托活动，必须遵守法律、行政法规，遵循自愿、公平和诚实信用原则，不得损害国家利益和社会公共利益。",
      "order": 6
    },
    {
      "id": "law-cd2f1f5b38-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第二章信托的设立"
      ],
      "text": "设立信托，必须有合法的信托目的。",
      "order": 8
    },
    {
      "id": "law-cd2f1f5b38-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第二章信托的设立"
      ],
      "text": "设立信托，必须有确定的信托财产，并且该信托财产必须是委托人合法所有的财产。\n本法所称财产包括合法的财产权利。",
      "order": 9
    },
    {
      "id": "law-cd2f1f5b38-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第二章信托的设立"
      ],
      "text": "设立信托，应当采取书面形式。\n书面形式包括信托合同、遗嘱或者法律、行政法规规定的其他书面文件等。\n采取信托合同形式设立信托的，信托合同签订时，信托成立。采取其他书面形式设立信托的，受托人承诺信托时，信托成立。",
      "order": 11
    },
    {
      "id": "law-cd2f1f5b38-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第二章信托的设立"
      ],
      "text": "设立信托，其书面文件应当载明下列事项：\n（一）信托目的；\n（二）委托人、受托人的姓名或者名称、住所；\n（三）受益人或者受益人范围；\n（四）信托财产的范围、种类及状况；\n（五）受益人取得信托利益的形式、方法。\n除前款所列事项外，可以载明信托期限、信托财产的管理方法、受托人的报酬、新受托人的选任方式、信托终止事由等事项。",
      "order": 14
    },
    {
      "id": "law-cd2f1f5b38-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第二章信托的设立"
      ],
      "text": "设立信托，对于信托财产，有关法律、行政法规规定应当办理登记手续的，应当依法办理信托登记。\n未依照前款规定办理信托登记的，应当补办登记手续；不补办的，该信托不产生效力。",
      "order": 21
    },
    {
      "id": "law-cd2f1f5b38-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第二章信托的设立"
      ],
      "text": "有下列情形之一的，信托无效：\n（一）信托目的违反法律、行政法规或者损害社会公共利益；\n（二）信托财产不能确定；\n（三）委托人以非法财产或者本法规定不得设立信托的财产设立信托；\n（四）专以诉讼或者讨债为目的设立信托；\n（五）受益人或者受益人范围不能确定；\n（六）法律、行政法规规定的其他情形。",
      "order": 23
    },
    {
      "id": "law-cd2f1f5b38-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第二章信托的设立"
      ],
      "text": "委托人设立信托损害其债权人利益的，债权人有权申请人民法院撤销该信托。\n人民法院依照前款规定撤销信托的，不影响善意受益人已经取得的信托利益。\n本条第一款规定的申请权，自债权人知道或者应当知道撤销原因之日起一年内不行使的，归于消灭。",
      "order": 30
    },
    {
      "id": "law-cd2f1f5b38-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第二章信托的设立"
      ],
      "text": "设立遗嘱信托，应当遵守继承法关于遗嘱的规定。\n遗嘱指定的人拒绝或者无能力担任受托人的，由受益人另行选任受托人；受益人为无民事行为能力人或者限制民事行为能力人的，依法由其监护人代行选任。遗嘱对选任受托人另有规定的，从其规定。",
      "order": 33
    },
    {
      "id": "law-cd2f1f5b38-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第三章信托财产"
      ],
      "text": "受托人因承诺信托而取得的财产是信托财产。\n受托人因信托财产的管理运用、处分或者其他情形而取得的财产，也归入信托财产。\n法律、行政法规禁止流通的财产，不得作为信托财产。\n法律、行政法规限制流通的财产，依法经有关主管部门批准后，可以作为信托财产。",
      "order": 36
    },
    {
      "id": "law-cd2f1f5b38-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第三章信托财产"
      ],
      "text": "信托财产与委托人未设立信托的其他财产相区别。设立信托后，委托人死亡或者依法解散、被依法撤销、被宣告破产时，委托人是唯一受益人的，信托终止，信托财产作为其遗产或者清算财产；委托人不是唯一受益人的，信托存续，信托财产不作为其遗产或者清算财产；但作为共同受益人的委托人死亡或者依法解散、被依法撤销、被宣告破产时，其信托受益权作为其遗产或者清算财产。",
      "order": 40
    },
    {
      "id": "law-cd2f1f5b38-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第三章信托财产"
      ],
      "text": "信托财产与属于受托人所有的财产（以下简称固有财产）相区别，不得归入受托人的固有财产或者成为固有财产的一部分。\n受托人死亡或者依法解散、被依法撤销、被宣告破产而终止，信托财产不属于其遗产或者清算财产。",
      "order": 41
    },
    {
      "id": "law-cd2f1f5b38-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第三章信托财产"
      ],
      "text": "除因下列情形之一外，对信托财产不得强制执行：\n（一）设立信托前债权人已对该信托财产享有优先受偿的权利，并依法行使该权利的；\n（二）受托人处理信托事务所产生债务，债权人要求清偿该债务的；\n（三）信托财产本身应担负的税款；\n（四）法律规定的其他情形。\n对于违反前款规定而强制执行信托财产，委托人、受托人或者受益人有权向人民法院提出异议。",
      "order": 43
    },
    {
      "id": "law-cd2f1f5b38-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第三章信托财产"
      ],
      "text": "受托人管理运用、处分信托财产所产生的债权，不得与其固有财产产生的债务相抵销。\n受托人管理运用、处分不同委托人的信托财产所产生的债权债务，不得相互抵销。",
      "order": 49
    },
    {
      "id": "law-cd2f1f5b38-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第四章信托当事人",
        "第一节委托人"
      ],
      "text": "委托人应当是具有完全民事行为能力的自然人、法人或者依法成立的其他组织。",
      "order": 53
    },
    {
      "id": "law-cd2f1f5b38-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第四章信托当事人",
        "第一节委托人"
      ],
      "text": "委托人有权了解其信托财产的管理运用、处分及收支情况，并有权要求受托人作出说明。\n委托人有权查阅、抄录或者复制与其信托财产有关的信托帐目以及处理信托事务的其他文件。",
      "order": 54
    },
    {
      "id": "law-cd2f1f5b38-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第四章信托当事人",
        "第一节委托人"
      ],
      "text": "因设立信托时未能预见的特别事由，致使信托财产的管理方法不利于实现信托目的或者不符合受益人的利益时，委托人有权要求受托人调整该信托财产的管理方法。",
      "order": 56
    },
    {
      "id": "law-cd2f1f5b38-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第四章信托当事人",
        "第一节委托人"
      ],
      "text": "受托人违反信托目的处分信托财产或者因违背管理职责、处理信托事务不当致使信托财产受到损失的，委托人有权申请人民法院撤销该处分行为，并有权要求受托人恢复信托财产的原状或者予以赔偿；该信托财产的受让人明知是违反信托目的而接受该财产的，应当予以返还或者予以赔偿。\n前款规定的申请权，自委托人知道或者应当知道撤销原因之日起一年内不行使的，归于消灭。",
      "order": 57
    },
    {
      "id": "law-cd2f1f5b38-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第四章信托当事人",
        "第一节委托人"
      ],
      "text": "受托人违反信托目的处分信托财产或者管理运用、处分信托财产有重大过失的，委托人有权依照信托文件的规定解任受托人，或者申请人民法院解任受托人。",
      "order": 59
    },
    {
      "id": "law-cd2f1f5b38-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第四章信托当事人",
        "第二节受托人"
      ],
      "text": "受托人应当是具有完全民事行为能力的自然人、法人。\n法律、行政法规对受托人的条件另有规定的，从其规定。",
      "order": 61
    },
    {
      "id": "law-cd2f1f5b38-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第四章信托当事人",
        "第二节受托人"
      ],
      "text": "受托人应当遵守信托文件的规定，为受益人的最大利益处理信托事务。\n受托人管理信托财产，必须恪尽职守，履行诚实、信用、谨慎、有效管理的义务。",
      "order": 63
    },
    {
      "id": "law-cd2f1f5b38-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第四章信托当事人",
        "第二节受托人"
      ],
      "text": "受托人除依照本法规定取得报酬外，不得利用信托财产为自己谋取利益。\n受托人违反前款规定，利用信托财产为自己谋取利益的，所得利益归入信托财产。",
      "order": 65
    },
    {
      "id": "law-cd2f1f5b38-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第四章信托当事人",
        "第二节受托人"
      ],
      "text": "受托人不得将信托财产转为其固有财产。受托人将信托财产转为其固有财产的，必须恢复该信托财产的原状；造成信托财产损失的，应当承担赔偿责任。",
      "order": 67
    },
    {
      "id": "law-cd2f1f5b38-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第四章信托当事人",
        "第二节受托人"
      ],
      "text": "受托人不得将其固有财产与信托财产进行交易或者将不同委托人的信托财产进行相互交易，但信托文件另有规定或者经委托人或者受益人同意，并以公平的市场价格进行交易的除外。\n受托人违反前款规定，造成信托财产损失的，应当承担赔偿责任。",
      "order": 68
    },
    {
      "id": "law-cd2f1f5b38-0029",
      "articleNumber": 29,
      "displayNumber": "第二十九条",
      "path": [
        "第四章信托当事人",
        "第二节受托人"
      ],
      "text": "受托人必须将信托财产与其固有财产分别管理、分别记帐，并将不同委托人的信托财产分别管理、分别记帐。",
      "order": 70
    },
    {
      "id": "law-cd2f1f5b38-0030",
      "articleNumber": 30,
      "displayNumber": "第三十条",
      "path": [
        "第四章信托当事人",
        "第二节受托人"
      ],
      "text": "受托人应当自己处理信托事务，但信托文件另有规定或者有不得已事由的，可以委托他人代为处理。\n受托人依法将信托事务委托他人代理的，应当对他人处理信托事务的行为承担责任。",
      "order": 71
    },
    {
      "id": "law-cd2f1f5b38-0031",
      "articleNumber": 31,
      "displayNumber": "第三十一条",
      "path": [
        "第四章信托当事人",
        "第二节受托人"
      ],
      "text": "同一信托的受托人有两个以上的，为共同受托人。\n共同受托人应当共同处理信托事务，但信托文件规定对某些具体事务由受托人分别处理的，从其规定。\n共同受托人共同处理信托事务，意见不一致时，按信托文件规定处理；信托文件未规定的，由委托人、受益人或者其利害关系人决定。",
      "order": 73
    },
    {
      "id": "law-cd2f1f5b38-0032",
      "articleNumber": 32,
      "displayNumber": "第三十二条",
      "path": [
        "第四章信托当事人",
        "第二节受托人"
      ],
      "text": "共同受托人处理信托事务对第三人所负债务，应当承担连带清偿责任。第三人对共同受托人之一所作的意思表示，对其他受托人同样有效。\n共同受托人之一违反信托目的处分信托财产或者因违背管理职责、处理信托事务不当致使信托财产受到损失的，其他受托人应当承担连带赔偿责任。",
      "order": 76
    },
    {
      "id": "law-cd2f1f5b38-0033",
      "articleNumber": 33,
      "displayNumber": "第三十三条",
      "path": [
        "第四章信托当事人",
        "第二节受托人"
      ],
      "text": "受托人必须保存处理信托事务的完整记录。\n受托人应当每年定期将信托财产的管理运用、处分及收支情况，报告委托人和受益人。\n受托人对委托人、受益人以及处理信托事务的情况和资料负有依法保密的义务。",
      "order": 78
    },
    {
      "id": "law-cd2f1f5b38-0034",
      "articleNumber": 34,
      "displayNumber": "第三十四条",
      "path": [
        "第四章信托当事人",
        "第二节受托人"
      ],
      "text": "受托人以信托财产为限向受益人承担支付信托利益的义务。",
      "order": 81
    },
    {
      "id": "law-cd2f1f5b38-0035",
      "articleNumber": 35,
      "displayNumber": "第三十五条",
      "path": [
        "第四章信托当事人",
        "第二节受托人"
      ],
      "text": "受托人有权依照信托文件的约定取得报酬。信托文件未作事先约定的，经信托当事人协商同意，可以作出补充约定；未作事先约定和补充约定的，不得收取报酬。\n约定的报酬经信托当事人协商同意，可以增减其数额。",
      "order": 82
    },
    {
      "id": "law-cd2f1f5b38-0036",
      "articleNumber": 36,
      "displayNumber": "第三十六条",
      "path": [
        "第四章信托当事人",
        "第二节受托人"
      ],
      "text": "受托人违反信托目的处分信托财产或者因违背管理职责、处理信托事务不当致使信托财产受到损失的，在未恢复信托财产的原状或者未予赔偿前，不得请求给付报酬。",
      "order": 84
    },
    {
      "id": "law-cd2f1f5b38-0037",
      "articleNumber": 37,
      "displayNumber": "第三十七条",
      "path": [
        "第四章信托当事人",
        "第二节受托人"
      ],
      "text": "受托人因处理信托事务所支出的费用、对第三人所负债务，以信托财产承担。受托人以其固有财产先行支付的，对信托财产享有优先受偿的权利。\n受托人违背管理职责或者处理信托事务不当对第三人所负债务或者自己所受到的损失，以其固有财产承担。",
      "order": 85
    },
    {
      "id": "law-cd2f1f5b38-0038",
      "articleNumber": 38,
      "displayNumber": "第三十八条",
      "path": [
        "第四章信托当事人",
        "第二节受托人"
      ],
      "text": "设立信托后，经委托人和受益人同意，受托人可以辞任。本法对公益信托的受托人辞任另有规定的，从其规定。\n受托人辞任的，在新受托人选出前仍应履行管理信托事务的职责。",
      "order": 87
    },
    {
      "id": "law-cd2f1f5b38-0039",
      "articleNumber": 39,
      "displayNumber": "第三十九条",
      "path": [
        "第四章信托当事人",
        "第二节受托人"
      ],
      "text": "受托人有下列情形之一的，其职责终止：\n（一）死亡或者被依法宣告死亡；\n（二）被依法宣告为无民事行为能力人或者限制民事行为能力人；\n（三）被依法撤销或者被宣告破产；\n（四）依法解散或者法定资格丧失；\n（五）辞任或者被解任；\n（六）法律、行政法规规定的其他情形。\n受托人职责终止时，其继承人或者遗产管理人、监护人、清算人应当妥善保管信托财产，协助新受托人接管信托事务。",
      "order": 89
    },
    {
      "id": "law-cd2f1f5b38-0040",
      "articleNumber": 40,
      "displayNumber": "第四十条",
      "path": [
        "第四章信托当事人",
        "第二节受托人"
      ],
      "text": "受托人职责终止的，依照信托文件规定选任新受托人；信托文件未规定的，由委托人选任；委托人不指定或者无能力指定的，由受益人选任；受益人为无民事行为能力人或者限制民事行为能力人的，依法由其监护人代行选任。\n原受托人处理信托事务的权利和义务，由新受托人承继。",
      "order": 97
    },
    {
      "id": "law-cd2f1f5b38-0041",
      "articleNumber": 41,
      "displayNumber": "第四十一条",
      "path": [
        "第四章信托当事人",
        "第二节受托人"
      ],
      "text": "受托人有本法第三十九条第一款第（三）项至第（六）项所列情形之一，职责终止的，应当作出处理信托事务的报告，并向新受托人办理信托财产和信托事务的移交手续。\n前款报告经委托人或者受益人认可，原受托人就报告中所列事项解除责任。但原受托人有不正当行为的除外。",
      "order": 99
    },
    {
      "id": "law-cd2f1f5b38-0042",
      "articleNumber": 42,
      "displayNumber": "第四十二条",
      "path": [
        "第四章信托当事人",
        "第二节受托人"
      ],
      "text": "共同受托人之一职责终止的，信托财产由其他受托人管理和处分。",
      "order": 101
    },
    {
      "id": "law-cd2f1f5b38-0043",
      "articleNumber": 43,
      "displayNumber": "第四十三条",
      "path": [
        "第四章信托当事人",
        "第三节受益人"
      ],
      "text": "受益人是在信托中享有信托受益权的人。受益人可以是自然人、法人或者依法成立的其他组织。\n委托人可以是受益人，也可以是同一信托的唯一受益人。\n受托人可以是受益人，但不得是同一信托的唯一受益人。",
      "order": 103
    },
    {
      "id": "law-cd2f1f5b38-0044",
      "articleNumber": 44,
      "displayNumber": "第四十四条",
      "path": [
        "第四章信托当事人",
        "第三节受益人"
      ],
      "text": "受益人自信托生效之日起享有信托受益权。信托文件另有规定的，从其规定。",
      "order": 106
    },
    {
      "id": "law-cd2f1f5b38-0045",
      "articleNumber": 45,
      "displayNumber": "第四十五条",
      "path": [
        "第四章信托当事人",
        "第三节受益人"
      ],
      "text": "共同受益人按照信托文件的规定享受信托利益。信托文件对信托利益的分配比例或者分配方法未作规定的，各受益人按照均等的比例享受信托利益。",
      "order": 107
    },
    {
      "id": "law-cd2f1f5b38-0046",
      "articleNumber": 46,
      "displayNumber": "第四十六条",
      "path": [
        "第四章信托当事人",
        "第三节受益人"
      ],
      "text": "受益人可以放弃信托受益权。\n全体受益人放弃信托受益权的，信托终止。\n部分受益人放弃信托受益权的，被放弃的信托受益权按下列顺序确定归属：\n（一）信托文件规定的人；\n（二）其他受益人；\n（三）委托人或者其继承人。",
      "order": 108
    },
    {
      "id": "law-cd2f1f5b38-0047",
      "articleNumber": 47,
      "displayNumber": "第四十七条",
      "path": [
        "第四章信托当事人",
        "第三节受益人"
      ],
      "text": "受益人不能清偿到期债务的，其信托受益权可以用于清偿债务，但法律、行政法规以及信托文件有限制性规定的除外。",
      "order": 114
    },
    {
      "id": "law-cd2f1f5b38-0048",
      "articleNumber": 48,
      "displayNumber": "第四十八条",
      "path": [
        "第四章信托当事人",
        "第三节受益人"
      ],
      "text": "受益人的信托受益权可以依法转让和继承，但信托文件有限制性规定的除外。",
      "order": 115
    },
    {
      "id": "law-cd2f1f5b38-0049",
      "articleNumber": 49,
      "displayNumber": "第四十九条",
      "path": [
        "第四章信托当事人",
        "第三节受益人"
      ],
      "text": "受益人可以行使本法第二十条至第二十三条规定的委托人享有的权利。受益人行使上述权利，与委托人意见不一致时，可以申请人民法院作出裁定。\n受托人有本法第二十二条第一款所列行为，共同受益人之一申请人民法院撤销该处分行为的，人民法院所作出的撤销裁定，对全体共同受益人有效。",
      "order": 116
    },
    {
      "id": "law-cd2f1f5b38-0050",
      "articleNumber": 50,
      "displayNumber": "第五十条",
      "path": [
        "第五章信托的变更与终止"
      ],
      "text": "委托人是唯一受益人的，委托人或者其继承人可以解除信托。信托文件另有规定的，从其规定。",
      "order": 119
    },
    {
      "id": "law-cd2f1f5b38-0051",
      "articleNumber": 51,
      "displayNumber": "第五十一条",
      "path": [
        "第五章信托的变更与终止"
      ],
      "text": "设立信托后，有下列情形之一的，委托人可以变更受益人或者处分受益人的信托受益权：\n（一）受益人对委托人有重大侵权行为；\n（二）受益人对其他共同受益人有重大侵权行为；\n（三）经受益人同意；\n（四）信托文件规定的其他情形。\n有前款第（一）项、第（三）项、第（四）项所列情形之一的，委托人可以解除信托。",
      "order": 120
    },
    {
      "id": "law-cd2f1f5b38-0052",
      "articleNumber": 52,
      "displayNumber": "第五十二条",
      "path": [
        "第五章信托的变更与终止"
      ],
      "text": "信托不因委托人或者受托人的死亡、丧失民事行为能力、依法解散、被依法撤销或者被宣告破产而终止，也不因受托人的辞任而终止。但本法或者信托文件另有规定的除外。",
      "order": 126
    },
    {
      "id": "law-cd2f1f5b38-0053",
      "articleNumber": 53,
      "displayNumber": "第五十三条",
      "path": [
        "第五章信托的变更与终止"
      ],
      "text": "有下列情形之一的，信托终止：\n（一）信托文件规定的终止事由发生；\n（二）信托的存续违反信托目的；\n（三）信托目的已经实现或者不能实现；\n（四）信托当事人协商同意；\n（五）信托被撤销；\n（六）信托被解除。",
      "order": 127
    },
    {
      "id": "law-cd2f1f5b38-0054",
      "articleNumber": 54,
      "displayNumber": "第五十四条",
      "path": [
        "第五章信托的变更与终止"
      ],
      "text": "信托终止的，信托财产归属于信托文件规定的人；信托文件未规定的，按下列顺序确定归属：\n（一）受益人或者其继承人；\n（二）委托人或者其继承人。",
      "order": 134
    },
    {
      "id": "law-cd2f1f5b38-0055",
      "articleNumber": 55,
      "displayNumber": "第五十五条",
      "path": [
        "第五章信托的变更与终止"
      ],
      "text": "依照前条规定，信托财产的归属确定后，在该信托财产转移给权利归属人的过程中，信托视为存续，权利归属人视为受益人。",
      "order": 137
    },
    {
      "id": "law-cd2f1f5b38-0056",
      "articleNumber": 56,
      "displayNumber": "第五十六条",
      "path": [
        "第五章信托的变更与终止"
      ],
      "text": "信托终止后，人民法院依据本法第十七条的规定对原信托财产进行强制执行的，以权利归属人为被执行人。",
      "order": 138
    },
    {
      "id": "law-cd2f1f5b38-0057",
      "articleNumber": 57,
      "displayNumber": "第五十七条",
      "path": [
        "第五章信托的变更与终止"
      ],
      "text": "信托终止后，受托人依照本法规定行使请求给付报酬、从信托财产中获得补偿的权利时，可以留置信托财产或者对信托财产的权利归属人提出请求。",
      "order": 139
    },
    {
      "id": "law-cd2f1f5b38-0058",
      "articleNumber": 58,
      "displayNumber": "第五十八条",
      "path": [
        "第五章信托的变更与终止"
      ],
      "text": "信托终止的，受托人应当作出处理信托事务的清算报告。受益人或者信托财产的权利归属人对清算报告无异议的，受托人就清算报告所列事项解除责任。但受托人有不正当行为的除外。",
      "order": 140
    },
    {
      "id": "law-cd2f1f5b38-0059",
      "articleNumber": 59,
      "displayNumber": "第五十九条",
      "path": [
        "第六章公益信托"
      ],
      "text": "公益信托适用本章规定。本章未规定的，适用本法及其他相关法律的规定。",
      "order": 142
    },
    {
      "id": "law-cd2f1f5b38-0060",
      "articleNumber": 60,
      "displayNumber": "第六十条",
      "path": [
        "第六章公益信托"
      ],
      "text": "为了下列公共利益目的之一而设立的信托，属于公益信托：\n（一）救济贫困；\n（二）救助灾民；\n（三）扶助残疾人；\n（四）发展教育、科技、文化、艺术、体育事业：\n（五）发展医疗卫生事业；\n（六）发展环境保护事业，维护生态环境；\n（七）发展其他社会公益事业。",
      "order": 143
    },
    {
      "id": "law-cd2f1f5b38-0061",
      "articleNumber": 61,
      "displayNumber": "第六十一条",
      "path": [
        "第六章公益信托"
      ],
      "text": "国家鼓励发展公益信托。",
      "order": 151
    },
    {
      "id": "law-cd2f1f5b38-0062",
      "articleNumber": 62,
      "displayNumber": "第六十二条",
      "path": [
        "第六章公益信托"
      ],
      "text": "公益信托的设立和确定其受托人，应当经有关公益事业的管理机构（以下简称公益事业管理机构）批准。\n未经公益事业管理机构的批准，不得以公益信托的名义进行活动。\n公益事业管理机构对于公益信托活动应当给予支持。",
      "order": 152
    },
    {
      "id": "law-cd2f1f5b38-0063",
      "articleNumber": 63,
      "displayNumber": "第六十三条",
      "path": [
        "第六章公益信托"
      ],
      "text": "公益信托的信托财产及其收益，不得用于非公益目的。",
      "order": 155
    },
    {
      "id": "law-cd2f1f5b38-0064",
      "articleNumber": 64,
      "displayNumber": "第六十四条",
      "path": [
        "第六章公益信托"
      ],
      "text": "公益信托应当设置信托监察人。\n信托监察人由信托文件规定。信托文件未规定的，由公益事业管理机构指定。",
      "order": 156
    },
    {
      "id": "law-cd2f1f5b38-0065",
      "articleNumber": 65,
      "displayNumber": "第六十五条",
      "path": [
        "第六章公益信托"
      ],
      "text": "信托监察人有权以自己的名义，为维护受益人的利益，提起诉讼或者实施其他法律行为。",
      "order": 158
    },
    {
      "id": "law-cd2f1f5b38-0066",
      "articleNumber": 66,
      "displayNumber": "第六十六条",
      "path": [
        "第六章公益信托"
      ],
      "text": "公益信托的受托人未经公益事业管理机构批准，不得辞任。",
      "order": 159
    },
    {
      "id": "law-cd2f1f5b38-0067",
      "articleNumber": 67,
      "displayNumber": "第六十七条",
      "path": [
        "第六章公益信托"
      ],
      "text": "公益事业管理机构应当检查受托人处理公益信托事务的情况及财产状况。\n受托人应当至少每年一次作出信托事务处理情况及财产状况报告，经信托监察人认可后，报公益事业管理机构核准，并由受托人予以公告。",
      "order": 160
    },
    {
      "id": "law-cd2f1f5b38-0068",
      "articleNumber": 68,
      "displayNumber": "第六十八条",
      "path": [
        "第六章公益信托"
      ],
      "text": "公益信托的受托人违反信托义务或者无能力履行其职责的，由公益事业管理机构变更受托人。",
      "order": 162
    },
    {
      "id": "law-cd2f1f5b38-0069",
      "articleNumber": 69,
      "displayNumber": "第六十九条",
      "path": [
        "第六章公益信托"
      ],
      "text": "公益信托成立后，发生设立信托时不能预见的情形，公益事业管理机构可以根据信托目的，变更信托文件中的有关条款。",
      "order": 163
    },
    {
      "id": "law-cd2f1f5b38-0070",
      "articleNumber": 70,
      "displayNumber": "第七十条",
      "path": [
        "第六章公益信托"
      ],
      "text": "公益信托终止的，受托人应当于终止事由发生之日起十五日内，将终止事由和终止日期报告公益事业管理机构。",
      "order": 164
    },
    {
      "id": "law-cd2f1f5b38-0071",
      "articleNumber": 71,
      "displayNumber": "第七十一条",
      "path": [
        "第六章公益信托"
      ],
      "text": "公益信托终止的，受托人作出的处理信托事务的清算报告，应当经信托监察人认可后，报公益事业管理机构核准，并由受托人予以公告。",
      "order": 165
    },
    {
      "id": "law-cd2f1f5b38-0072",
      "articleNumber": 72,
      "displayNumber": "第七十二条",
      "path": [
        "第六章公益信托"
      ],
      "text": "公益信托终止，没有信托财产权利归属人或者信托财产权利归属人是不特定的社会公众的，经公益事业管理机构批准，受托人应当将信托财产用于与原公益目的相近似的目的，或者将信托财产转移给具有近似目的的公益组织或者其他公益信托。",
      "order": 166
    },
    {
      "id": "law-cd2f1f5b38-0073",
      "articleNumber": 73,
      "displayNumber": "第七十三条",
      "path": [
        "第六章公益信托"
      ],
      "text": "公益事业管理机构违反本法规定的，委托人、受托人或者受益人有权向人民法院起诉。",
      "order": 167
    },
    {
      "id": "law-cd2f1f5b38-0074",
      "articleNumber": 74,
      "displayNumber": "第七十四条",
      "path": [
        "第七章附则"
      ],
