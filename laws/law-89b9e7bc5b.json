  "articles": [
    {
      "id": "law-89b9e7bc5b-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了规范票据行为，保障票据活动中当事人的合法权益，维护社会经济秩序，促进社会主义市场经济的发展，制定本法。",
      "order": 2
    },
    {
      "id": "law-89b9e7bc5b-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "在中华人民共和国境内的票据活动，适用本法。\n本法所称票据，是指汇票、本票和支票。",
      "order": 3
    },
    {
      "id": "law-89b9e7bc5b-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "票据活动应当遵守法律、行政法规，不得损害社会公共利益。",
      "order": 5
    },
    {
      "id": "law-89b9e7bc5b-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "票据出票人制作票据，应当按照法定条件在票据上签章，并按照所记载的事项承担票据责任。\n持票人行使票据权利，应当按照法定程序在票据上签章，并出示票据。\n其他票据债务人在票据上签章的，按照票据所记载的事项承担票据责任。\n本法所称票据权利，是指持票人向票据债务人请求支付票据金额的权利，包括付款请求权和追索权。\n本法所称票据责任，是指票据债务人向持票人支付票据金额的义务。",
      "order": 6
    },
    {
      "id": "law-89b9e7bc5b-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "票据当事人可以委托其代理人在票据上签章，并应当在票据上表明其代理关系。\n没有代理权而以代理人名义在票据上签章的，应当由签章人承担票据责任；代理人超越代理权限的，应当就其超越权限的部分承担票据责任。",
      "order": 11
    },
    {
      "id": "law-89b9e7bc5b-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第一章总则"
      ],
      "text": "无民事行为能力人或者限制民事行为能力人在票据上签章的，其签章无效，但是不影响其他签章的效力。",
      "order": 13
    },
    {
      "id": "law-89b9e7bc5b-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第一章总则"
      ],
      "text": "票据上的签章，为签名、盖章或者签名加盖章。\n法人和其他使用票据的单位在票据上的签章，为该法人或者该单位的盖章加其法定代表人或者其授权的代理人的签章。\n在票据上的签名，应当为该当事人的本名。",
      "order": 14
    },
    {
      "id": "law-89b9e7bc5b-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第一章总则"
      ],
      "text": "票据金额以中文大写和数码同时记载，二者必须一致，二者不一致的，票据无效。",
      "order": 17
    },
    {
      "id": "law-89b9e7bc5b-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第一章总则"
      ],
      "text": "票据上的记载事项必须符合本法的规定。\n票据金额、日期、收款人名称不得更改，更改的票据无效。\n对票据上的其他记载事项，原记载人可以更改，更改时应当由原记载人签章证明。",
      "order": 18
    },
    {
      "id": "law-89b9e7bc5b-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第一章总则"
      ],
      "text": "票据的签发、取得和转让，应当遵循诚实信用的原则，具有真实的交易关系和债权债务关系。\n票据的取得，必须给付对价，即应当给付票据双方当事人认可的相对应的代价。",
      "order": 21
    },
    {
      "id": "law-89b9e7bc5b-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第一章总则"
      ],
      "text": "因税收、继承、赠与可以依法无偿取得票据的，不受给付对价的限制。但是，所享有的票据权利不得优于其前手的权利。\n前手是指在票据签章人或者持票人之前签章的其他票据债务人。",
      "order": 23
    },
    {
      "id": "law-89b9e7bc5b-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第一章总则"
      ],
      "text": "以欺诈、偷盗或者胁迫等手段取得票据的，或者明知有前列情形，出于恶意取得票据的，不得享有票据权利。\n持票人因重大过失取得不符合本法规定的票据的，也不得享有票据权利。",
      "order": 25
    },
    {
      "id": "law-89b9e7bc5b-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第一章总则"
      ],
      "text": "票据债务人不得以自己与出票人或者与持票人的前手之间的抗辩事由，对抗持票人。但是，持票人明知存在抗辩事由而取得票据的除外。\n票据债务人可以对不履行约定义务的与自己有直接债权债务关系的持票人，进行抗辩。\n本法所称抗辩，是指票据债务人根据本法规定对票据债权人拒绝履行义务的行为。",
      "order": 27
    },
    {
      "id": "law-89b9e7bc5b-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第一章总则"
      ],
      "text": "票据上的记载事项应当真实，不得伪造、变造。伪造、变造票据上的签章和其他记载事项的，应当承担法律责任。\n票据上有伪造、变造的签章的，不影响票据上其他真实签章的效力。\n票据上其他记载事项被变造的，在变造之前签章的人，对原记载事项负责；在变造之后签章的人，对变造之后的记载事项负责；不能辨别是在票据被变造之前或者之后签章的，视同在变造之前签章。",
      "order": 30
    },
    {
      "id": "law-89b9e7bc5b-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第一章总则"
      ],
      "text": "票据丧失，失票人可以及时通知票据的付款人挂失止付，但是，未记载付款人或者无法确定付款人及其代理付款人的票据除外。\n收到挂失止付通知的付款人，应当暂停支付。\n失票人应当在通知挂失止付后三日内，也可以在票据丧失后，依法向人民法院申请公示催告，或者向人民法院提起诉讼。",
      "order": 33
    },
    {
      "id": "law-89b9e7bc5b-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第一章总则"
      ],
      "text": "持票人对票据债务人行使票据权利，或者保全票据权利，应当在票据当事人的营业场所和营业时间内进行，票据当事人无营业场所的，应当在其住所进行。",
      "order": 36
    },
    {
      "id": "law-89b9e7bc5b-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第一章总则"
      ],
      "text": "票据权利在下列期限内不行使而消灭：\n（一）持票人对票据的出票人和承兑人的权利，自票据到期日起二年。见票即付的汇票、本票，自出票日起二年；\n（二）持票人对支票出票人的权利，自出票日起六个月；\n（三）持票人对前手的追索权，自被拒绝承兑或者被拒绝付款之日起六个月；\n（四）持票人对前手的再追索权，自清偿日或者被提起诉讼之日起三个月。\n票据的出票日、到期日由票据当事人依法确定。",
      "order": 37
    },
    {
      "id": "law-89b9e7bc5b-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第一章总则"
      ],
      "text": "持票人因超过票据权利时效或者因票据记载事项欠缺而丧失票据权利的，仍享有民事权利，可以请求出票人或者承兑人返还其与未支付的票据金额相当的利益。",
      "order": 43
    },
    {
      "id": "law-89b9e7bc5b-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第二章汇票",
        "第一节出票"
      ],
      "text": "汇票是出票人签发的，委托付款人在见票时或者在指定日期无条件支付确定的金额给收款人或者持票人的票据。\n汇票分为银行汇票和商业汇票。",
      "order": 46
    },
    {
      "id": "law-89b9e7bc5b-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第二章汇票",
        "第一节出票"
      ],
      "text": "出票是指出票人签发票据并将其交付给收款人的票据行为。",
      "order": 48
    },
    {
      "id": "law-89b9e7bc5b-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第二章汇票",
        "第一节出票"
      ],
      "text": "汇票的出票人必须与付款人具有真实的委托付款关系，并且具有支付汇票金额的可靠资金来源。\n不得签发无对价的汇票用以骗取银行或者其他票据当事人的资金。",
      "order": 49
    },
    {
      "id": "law-89b9e7bc5b-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第二章汇票",
        "第一节出票"
      ],
      "text": "汇票必须记载下列事项：\n（一）表明“汇票”的字样；\n（二）无条件支付的委托；\n（三）确定的金额；\n（四）付款人名称；\n（五）收款人名称；\n（六）出票日期；\n（七）出票人签章。\n汇票上未记载前款规定事项之一的，汇票无效。",
      "order": 51
    },
    {
      "id": "law-89b9e7bc5b-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第二章汇票",
        "第一节出票"
      ],
      "text": "汇票上记载付款日期、付款地、出票地等事项的，应当清楚、明确。\n汇票上未记载付款日期的，为见票即付。\n汇票上未记载付款地的，付款人的营业场所、住所或者经常居住地为付款地。\n汇票上未记载出票地的，出票人的营业场所、住所或者经常居住地为出票地。",
      "order": 60
    },
    {
      "id": "law-89b9e7bc5b-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第二章汇票",
        "第一节出票"
      ],
      "text": "汇票上可以记载本法规定事项以外的其他出票事项，但是该记载事项不具有汇票上的效力。",
      "order": 64
    },
    {
      "id": "law-89b9e7bc5b-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第二章汇票",
        "第一节出票"
      ],
      "text": "付款日期可以按照下列形式之一记载：\n（一）见票即付；\n（二）定日付款；\n（三）出票后定期付款；\n（四）见票后定期付款。\n前款规定的付款日期为汇票到期日。",
      "order": 65
    },
    {
      "id": "law-89b9e7bc5b-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第二章汇票",
        "第一节出票"
      ],
      "text": "出票人签发汇票后，即承担保证该汇票承兑和付款的责任。出票人在汇票得不到承兑或者付款时，应当向持票人清偿本法第七十条、第七十一条规定的金额和费用。",
      "order": 71
    },
    {
      "id": "law-89b9e7bc5b-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第二章汇票",
        "第二节背书"
      ],
      "text": "持票人可以将汇票权利转让给他人或者将一定的汇票权利授予他人行使。\n出票人在汇票上记载“不得转让”字样的，汇票不得转让。\n持票人行使第一款规定的权利时，应当背书并交付汇票。\n背书是指在票据背面或者粘单上记载有关事项并签章的票据行为。",
      "order": 73
    },
    {
      "id": "law-89b9e7bc5b-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第二章汇票",
        "第二节背书"
      ],
      "text": "票据凭证不能满足背书人记载事项的需要，可以加附粘单，粘附于票据凭证上。\n粘单上的第一记载人，应当在汇票和粘单的粘接处签章。",
      "order": 77
    },
    {
      "id": "law-89b9e7bc5b-0029",
      "articleNumber": 29,
      "displayNumber": "第二十九条",
      "path": [
        "第二章汇票",
        "第二节背书"
      ],
      "text": "背书由背书人签章并记载背书日期。\n背书未记载日期的，视为在汇票到期日前背书。",
      "order": 79
    },
    {
      "id": "law-89b9e7bc5b-0030",
      "articleNumber": 30,
      "displayNumber": "第三十条",
      "path": [
        "第二章汇票",
        "第二节背书"
      ],
      "text": "汇票以背书转让或者以背书将一定的汇票权利授予他人行使时，必须记载被背书人名称。",
      "order": 81
    },
    {
      "id": "law-89b9e7bc5b-0031",
      "articleNumber": 31,
      "displayNumber": "第三十一条",
      "path": [
        "第二章汇票",
        "第二节背书"
      ],
      "text": "以背书转让的汇票，背书应当连续。持票人以背书的连续，证明其汇票权利；非经背书转让，而以其他合法方式取得汇票的，依法举证，证明其汇票权利。\n前款所称背书连续，是指在票据转让中，转让汇票的背书人与受让汇票的被背书人在汇票上的签章依次前后衔接。",
      "order": 82
    },
    {
      "id": "law-89b9e7bc5b-0032",
      "articleNumber": 32,
      "displayNumber": "第三十二条",
      "path": [
        "第二章汇票",
        "第二节背书"
      ],
      "text": "以背书转让的汇票，后手应当对其直接前手背书的真实性负责。\n后手是指在票据签章人之后签章的其他票据债务人。",
      "order": 84
    },
    {
      "id": "law-89b9e7bc5b-0033",
      "articleNumber": 33,
      "displayNumber": "第三十三条",
      "path": [
        "第二章汇票",
        "第二节背书"
      ],
      "text": "背书不得附有条件。背书时附有条件的，所附条件不具有汇票上的效力。\n将汇票金额的一部分转让的背书或者将汇票金额分别转让给二人以上的背书无效。",
      "order": 86
    },
    {
      "id": "law-89b9e7bc5b-0034",
      "articleNumber": 34,
      "displayNumber": "第三十四条",
      "path": [
        "第二章汇票",
        "第二节背书"
      ],
      "text": "背书人在汇票上记载“不得转让”字样，其后手再背书转让的，原背书人对后手的被背书人不承担保证责任。",
      "order": 88
    },
    {
      "id": "law-89b9e7bc5b-0035",
      "articleNumber": 35,
      "displayNumber": "第三十五条",
      "path": [
        "第二章汇票",
        "第二节背书"
      ],
      "text": "背书记载“委托收款”字样的，被背书人有权代背书人行使被委托的汇票权利。但是，被背书人不得再以背书转让汇票权利。\n汇票可以设定质押；质押时应当以背书记载“质押”字样。被背书人依法实现其质权时，可以行使汇票权利。",
      "order": 89
    },
    {
      "id": "law-89b9e7bc5b-0036",
      "articleNumber": 36,
      "displayNumber": "第三十六条",
      "path": [
        "第二章汇票",
        "第二节背书"
      ],
      "text": "汇票被拒绝承兑、被拒绝付款或者超过付款提示期限的，不得背书转让；背书转让的，背书人应当承担汇票责任。",
      "order": 91
    },
    {
      "id": "law-89b9e7bc5b-0037",
      "articleNumber": 37,
      "displayNumber": "第三十七条",
      "path": [
        "第二章汇票",
        "第二节背书"
      ],
      "text": "背书人以背书转让汇票后，即承担保证其后手所持汇票承兑和付款的责任。背书人在汇票得不到承兑或者付款时，应当向持票人清偿本法第七十条、第七十一条规定的金额和费用。",
      "order": 92
    },
    {
      "id": "law-89b9e7bc5b-0038",
      "articleNumber": 38,
      "displayNumber": "第三十八条",
      "path": [
        "第二章汇票",
        "第三节承兑"
      ],
      "text": "承兑是指汇票付款人承诺在汇票到期日支付汇票金额的票据行为。",
      "order": 94
    },
    {
      "id": "law-89b9e7bc5b-0039",
      "articleNumber": 39,
      "displayNumber": "第三十九条",
      "path": [
        "第二章汇票",
        "第三节承兑"
      ],
      "text": "定日付款或者出票后定期付款的汇票，持票人应当在汇票到期日前向付款人提示承兑。\n提示承兑是指持票人向付款人出示汇票，并要求付款人承诺付款的行为。",
      "order": 95
    },
    {
      "id": "law-89b9e7bc5b-0040",
      "articleNumber": 40,
      "displayNumber": "第四十条",
      "path": [
        "第二章汇票",
        "第三节承兑"
      ],
      "text": "见票后定期付款的汇票，持票人应当自出票日起一个月内向付款人提示承兑。\n汇票未按照规定期限提示承兑的，持票人丧失对其前手的追索权。\n见票即付的汇票无需提示承兑。",
      "order": 97
    },
    {
      "id": "law-89b9e7bc5b-0041",
      "articleNumber": 41,
      "displayNumber": "第四十一条",
      "path": [
        "第二章汇票",
        "第三节承兑"
      ],
      "text": "付款人对向其提示承兑的汇票，应当自收到提示承兑的汇票之日起三日内承兑或者拒绝承兑。\n付款人收到持票人提示承兑的汇票时，应当向持票人签发收到汇票的回单。回单上应当记明汇票提示承兑日期并签章。",
      "order": 100
    },
    {
      "id": "law-89b9e7bc5b-0042",
      "articleNumber": 42,
      "displayNumber": "第四十二条",
      "path": [
        "第二章汇票",
        "第三节承兑"
      ],
      "text": "付款人承兑汇票的，应当在汇票正面记载“承兑”字样和承兑日期并签章；见票后定期付款的汇票，应当在承兑时记载付款日期。\n汇票上未记载承兑日期的，以前条第一款规定期限的最后一日为承兑日期。",
      "order": 102
    },
    {
      "id": "law-89b9e7bc5b-0043",
      "articleNumber": 43,
      "displayNumber": "第四十三条",
      "path": [
        "第二章汇票",
        "第三节承兑"
      ],
      "text": "付款人承兑汇票，不得附有条件；承兑附有条件的，视为拒绝承兑。",
      "order": 104
    },
    {
      "id": "law-89b9e7bc5b-0044",
      "articleNumber": 44,
      "displayNumber": "第四十四条",
      "path": [
        "第二章汇票",
        "第三节承兑"
      ],
      "text": "付款人承兑汇票后，应当承担到期付款的责任。",
      "order": 105
    },
    {
      "id": "law-89b9e7bc5b-0045",
      "articleNumber": 45,
      "displayNumber": "第四十五条",
      "path": [
        "第二章汇票",
        "第四节保证"
      ],
      "text": "汇票的债务可以由保证人承担保证责任。\n保证人由汇票债务人以外的他人担当。",
      "order": 107
    },
    {
      "id": "law-89b9e7bc5b-0046",
      "articleNumber": 46,
      "displayNumber": "第四十六条",
      "path": [
        "第二章汇票",
        "第四节保证"
      ],
      "text": "保证人必须在汇票或者粘单上记载下列事项：\n（一）表明“保证”的字样；\n（二）保证人名称和住所；\n（三）被保证人的名称；\n（四）保证日期；\n（五）保证人签章。",
      "order": 109
    },
    {
      "id": "law-89b9e7bc5b-0047",
      "articleNumber": 47,
      "displayNumber": "第四十七条",
      "path": [
        "第二章汇票",
        "第四节保证"
      ],
      "text": "保证人在汇票或者粘单上未记载前条第（三）项的，已承兑的汇票，承兑人为被保证人；未承兑的汇票，出票人为被保证人。\n保证人在汇票或者粘单上未记载前条第（四）项的，出票日期为保证日期。",
      "order": 115
    },
    {
      "id": "law-89b9e7bc5b-0048",
      "articleNumber": 48,
      "displayNumber": "第四十八条",
      "path": [
        "第二章汇票",
        "第四节保证"
      ],
      "text": "保证不得附有条件；附有条件的，不影响对汇票的保证责任。",
      "order": 117
    },
    {
      "id": "law-89b9e7bc5b-0049",
      "articleNumber": 49,
      "displayNumber": "第四十九条",
      "path": [
        "第二章汇票",
        "第四节保证"
      ],
      "text": "保证人对合法取得汇票的持票人所享有的汇票权利，承担保证责任。但是，被保证人的债务因汇票记载事项欠缺而无效的除外。",
      "order": 118
    },
    {
      "id": "law-89b9e7bc5b-0050",
      "articleNumber": 50,
      "displayNumber": "第五十条",
      "path": [
        "第二章汇票",
        "第四节保证"
      ],
      "text": "被保证的汇票，保证人应当与被保证人对持票人承担连带责任。汇票到期后得不到付款的，持票人有权向保证人请求付款，保证人应当足额付款。",
      "order": 119
    },
    {
      "id": "law-89b9e7bc5b-0051",
      "articleNumber": 51,
      "displayNumber": "第五十一条",
      "path": [
        "第二章汇票",
        "第四节保证"
      ],
      "text": "保证人为二人以上的，保证人之间承担连带责任。",
      "order": 120
    },
    {
      "id": "law-89b9e7bc5b-0052",
      "articleNumber": 52,
      "displayNumber": "第五十二条",
      "path": [
        "第二章汇票",
        "第四节保证"
      ],
      "text": "保证人清偿汇票债务后，可以行使持票人对被保证人及其前手的追索权。",
      "order": 121
    },
    {
      "id": "law-89b9e7bc5b-0053",
      "articleNumber": 53,
      "displayNumber": "第五十三条",
      "path": [
        "第二章汇票",
        "第五节付款"
      ],
      "text": "持票人应当按照下列期限提示付款：\n（一）见票即付的汇票，自出票日起一个月内向付款人提示付款；\n（二）定日付款、出票后定期付款或者见票后定期付款的汇票，自到期日起十日内向承兑人提示付款。\n持票人未按照前款规定期限提示付款的，在作出说明后，承兑人或者付款人仍应当继续对持票人承担付款责任。\n通过委托收款银行或者通过票据交换系统向付款人提示付款的，视同持票人提示付款。",
      "order": 123
    },
    {
      "id": "law-89b9e7bc5b-0054",
      "articleNumber": 54,
      "displayNumber": "第五十四条",
      "path": [
        "第二章汇票",
        "第五节付款"
      ],
      "text": "持票人依照前条规定提示付款的，付款人必须在当日足额付款。",
      "order": 128
    },
    {
      "id": "law-89b9e7bc5b-0055",
      "articleNumber": 55,
      "displayNumber": "第五十五条",
      "path": [
        "第二章汇票",
        "第五节付款"
      ],
      "text": "持票人获得付款的，应当在汇票上签收，并将汇票交给付款人。持票人委托银行收款的，受委托的银行将代收的汇票金额转账收入持票人账户，视同签收。",
      "order": 129
    },
    {
      "id": "law-89b9e7bc5b-0056",
      "articleNumber": 56,
      "displayNumber": "第五十六条",
      "path": [
        "第二章汇票",
        "第五节付款"
      ],
      "text": "持票人委托的收款银行的责任，限于按照汇票上记载事项将汇票金额转入持票人账户。\n付款人委托的付款银行的责任，限于按照汇票上记载事项从付款人账户支付汇票金额。",
      "order": 130
    },
    {
      "id": "law-89b9e7bc5b-0057",
      "articleNumber": 57,
      "displayNumber": "第五十七条",
      "path": [
        "第二章汇票",
        "第五节付款"
      ],
      "text": "付款人及其代理付款人付款时，应当审查汇票背书的连续，并审查提示付款人的合法身份证明或者有效证件。\n付款人及其代理付款人以恶意或者有重大过失付款的，应当自行承担责任。",
      "order": 132
    },
    {
      "id": "law-89b9e7bc5b-0058",
      "articleNumber": 58,
      "displayNumber": "第五十八条",
      "path": [
        "第二章汇票",
        "第五节付款"
      ],
      "text": "对定日付款、出票后定期付款或者见票后定期付款的汇票，付款人在到期日前付款的，由付款人自行承担所产生的责任。",
      "order": 134
    },
    {
      "id": "law-89b9e7bc5b-0059",
      "articleNumber": 59,
      "displayNumber": "第五十九条",
      "path": [
        "第二章汇票",
        "第五节付款"
      ],
      "text": "汇票金额为外币的，按照付款日的市场汇价，以人民币支付。\n汇票当事人对汇票支付的货币种类另有约定的，从其约定。",
      "order": 135
    },
    {
      "id": "law-89b9e7bc5b-0060",
      "articleNumber": 60,
      "displayNumber": "第六十条",
      "path": [
        "第二章汇票",
        "第五节付款"
      ],
      "text": "付款人依法足额付款后，全体汇票债务人的责任解除。",
      "order": 137
    },
    {
      "id": "law-89b9e7bc5b-0061",
      "articleNumber": 61,
      "displayNumber": "第六十一条",
      "path": [
        "第二章汇票",
        "第六节追索权"
      ],
      "text": "汇票到期被拒绝付款的，持票人可以对背书人、出票人以及汇票的其他债务人行使追索权。\n汇票到期日前，有下列情形之一的，持票人也可以行使追索权：\n（一）汇票被拒绝承兑的；\n（二）承兑人或者付款人死亡、逃匿的；\n（三）承兑人或者付款人被依法宣告破产的或者因违法被责令终止业务活动的。",
      "order": 139
    },
    {
      "id": "law-89b9e7bc5b-0062",
      "articleNumber": 62,
      "displayNumber": "第六十二条",
      "path": [
        "第二章汇票",
        "第六节追索权"
      ],
      "text": "持票人行使追索权时，应当提供被拒绝承兑或者被拒绝付款的有关证明。\n持票人提示承兑或者提示付款被拒绝的，承兑人或者付款人必须出具拒绝证明，或者出具退票理由书。未出具拒绝证明或者退票理由书的，应当承担由此产生的民事责任。",
      "order": 144
    },
    {
      "id": "law-89b9e7bc5b-0063",
      "articleNumber": 63,
      "displayNumber": "第六十三条",
      "path": [
        "第二章汇票",
        "第六节追索权"
      ],
      "text": "持票人因承兑人或者付款人死亡、逃匿或者其他原因，不能取得拒绝证明的，可以依法取得其他有关证明。",
      "order": 146
    },
    {
      "id": "law-89b9e7bc5b-0064",
      "articleNumber": 64,
      "displayNumber": "第六十四条",
      "path": [
        "第二章汇票",
        "第六节追索权"
      ],
      "text": "承兑人或者付款人被人民法院依法宣告破产的，人民法院的有关司法文书具有拒绝证明的效力。\n承兑人或者付款人因违法被责令终止业务活动的，有关行政主管部门的处罚决定具有拒绝证明的效力。",
      "order": 147
    },
    {
      "id": "law-89b9e7bc5b-0065",
      "articleNumber": 65,
      "displayNumber": "第六十五条",
      "path": [
        "第二章汇票",
        "第六节追索权"
      ],
      "text": "持票人不能出示拒绝证明、退票理由书或者未按照规定期限提供其他合法证明的，丧失对其前手的追索权。但是，承兑人或者付款人仍应当对持票人承担责任。",
      "order": 149
    },
    {
      "id": "law-89b9e7bc5b-0066",
      "articleNumber": 66,
      "displayNumber": "第六十六条",
      "path": [
        "第二章汇票",
        "第六节追索权"
      ],
      "text": "持票人应当自收到被拒绝承兑或者被拒绝付款的有关证明之日起三日内，将被拒绝事由书面通知其前手；其前手应当自收到通知之日起三日内书面通知其再前手。持票人也可以同时向各汇票债务人发出书面通知。\n未按照前款规定期限通知的，持票人仍可以行使追索权。因延期通知给其前手或者出票人造成损失的，由没有按照规定期限通知的汇票当事人，承担对该损失的赔偿责任，但是所赔偿的金额以汇票金额为限。\n在规定期限内将通知按照法定地址或者约定的地址邮寄的，视为已经发出通知。",
      "order": 150
    },
    {
      "id": "law-89b9e7bc5b-0067",
      "articleNumber": 67,
      "displayNumber": "第六十七条",
      "path": [
        "第二章汇票",
        "第六节追索权"
      ],
      "text": "依照前条第一款所作的书面通知，应当记明汇票的主要记载事项，并说明该汇票已被退票。",
      "order": 153
    },
    {
      "id": "law-89b9e7bc5b-0068",
      "articleNumber": 68,
      "displayNumber": "第六十八条",
      "path": [
        "第二章汇票",
        "第六节追索权"
      ],
      "text": "汇票的出票人、背书人、承兑人和保证人对持票人承担连带责任。\n持票人可以不按照汇票债务人的先后顺序，对其中任何一人、数人或者全体行使追索权。\n持票人对汇票债务人中的一人或者数人已经进行追索的，对其他汇票债务人仍可以行使追索权。被追索人清偿债务后，与持票人享有同一权利。",
      "order": 154
    },
    {
      "id": "law-89b9e7bc5b-0069",
      "articleNumber": 69,
      "displayNumber": "第六十九条",
      "path": [
        "第二章汇票",
        "第六节追索权"
      ],
      "text": "持票人为出票人的，对其前手无追索权。持票人为背书人的，对其后手无追索权。",
      "order": 157
    },
    {
      "id": "law-89b9e7bc5b-0070",
      "articleNumber": 70,
      "displayNumber": "第七十条",
      "path": [
        "第二章汇票",
        "第六节追索权"
      ],
      "text": "持票人行使追索权，可以请求被追索人支付下列金额和费用：\n（一）被拒绝付款的汇票金额；\n（二）汇票金额自到期日或者提示付款日起至清偿日止，按照中国人民银行规定的利率计算的利息；\n（三）取得有关拒绝证明和发出通知书的费用。\n被追索人清偿债务时，持票人应当交出汇票和有关拒绝证明，并出具所收到利息和费用的收据。",
      "order": 158
    },
    {
      "id": "law-89b9e7bc5b-0071",
      "articleNumber": 71,
      "displayNumber": "第七十一条",
      "path": [
        "第二章汇票",
        "第六节追索权"
      ],
      "text": "被追索人依照前条规定清偿后，可以向其他汇票债务人行使再追索权，请求其他汇票债务人支付下列金额和费用：\n（一）已清偿的全部金额；\n（二）前项金额自清偿日起至再追索清偿日止，按照中国人民银行规定的利率计算的利息；\n（三）发出通知书的费用。\n行使再追索权的被追索人获得清偿时，应当交出汇票和有关拒绝证明，并出具所收到利息和费用的收据。",
      "order": 163
    },
    {
      "id": "law-89b9e7bc5b-0072",
      "articleNumber": 72,
      "displayNumber": "第七十二条",
      "path": [
        "第二章汇票",
        "第六节追索权"
      ],
      "text": "被追索人依照前二条规定清偿债务后，其责任解除。",
      "order": 168
    },
    {
      "id": "law-89b9e7bc5b-0073",
      "articleNumber": 73,
      "displayNumber": "第七十三条",
      "path": [
        "第三章本票"
      ],
      "text": "本票是出票人签发的，承诺自己在见票时无条件支付确定的金额给收款人或者持票人的票据。\n本法所称本票，是指银行本票。",
      "order": 170
    },
    {
      "id": "law-89b9e7bc5b-0074",
      "articleNumber": 74,
      "displayNumber": "第七十四条",
      "path": [
        "第三章本票"
      ],
      "text": "本票的出票人必须具有支付本票金额的可靠资金来源，并保证支付。",
      "order": 172
    },
    {
      "id": "law-89b9e7bc5b-0075",
      "articleNumber": 75,
      "displayNumber": "第七十五条",
      "path": [
        "第三章本票"
      ],
      "text": "本票必须记载下列事项：\n（一）表明“本票”的字样；\n（二）无条件支付的承诺；\n（三）确定的金额；\n（四）收款人名称；\n（五）出票日期；\n（六）出票人签章。\n本票上未记载前款规定事项之一的，本票无效。",
      "order": 173
    },
    {
      "id": "law-89b9e7bc5b-0076",
      "articleNumber": 76,
      "displayNumber": "第七十六条",
      "path": [
        "第三章本票"
      ],
      "text": "本票上记载付款地、出票地等事项的，应当清楚、明确。\n本票上未记载付款地的，出票人的营业场所为付款地。\n本票上未记载出票地的，出票人的营业场所为出票地。",
      "order": 181
    },
    {
      "id": "law-89b9e7bc5b-0077",
      "articleNumber": 77,
      "displayNumber": "第七十七条",
      "path": [
        "第三章本票"
      ],
      "text": "本票的出票人在持票人提示见票时，必须承担付款的责任。",
      "order": 184
    },
    {
      "id": "law-89b9e7bc5b-0078",
      "articleNumber": 78,
      "displayNumber": "第七十八条",
      "path": [
        "第三章本票"
      ],
      "text": "本票自出票日起，付款期限最长不得超过二个月。",
      "order": 185
    },
    {
      "id": "law-89b9e7bc5b-0079",
      "articleNumber": 79,
      "displayNumber": "第七十九条",
      "path": [
        "第三章本票"
      ],
      "text": "本票的持票人未按照规定期限提示见票的，丧失对出票人以外的前手的追索权。",
      "order": 186
    },
    {
      "id": "law-89b9e7bc5b-0080",
      "articleNumber": 80,
      "displayNumber": "第八十条",
      "path": [
        "第三章本票"
      ],
      "text": "本票的背书、保证、付款行为和追索权的行使，除本章规定外，适用本法第二章有关汇票的规定。\n本票的出票行为，除本章规定外，适用本法第二十四条关于汇票的规定。",
      "order": 187
    },
    {
      "id": "law-89b9e7bc5b-0081",
      "articleNumber": 81,
      "displayNumber": "第八十一条",
      "path": [
        "第四章支票"
      ],
      "text": "支票是出票人签发的，委托办理支票存款业务的银行或者其他金融机构在见票时无条件支付确定的金额给收款人或者持票人的票据。",
      "order": 190
    },
    {
      "id": "law-89b9e7bc5b-0082",
      "articleNumber": 82,
      "displayNumber": "第八十二条",
      "path": [
        "第四章支票"
      ],
      "text": "开立支票存款账户，申请人必须使用其本名，并提交证明其身份的合法证件。\n开立支票存款账户和领用支票，应当有可靠的资信，并存入一定的资金。\n开立支票存款账户，申请人应当预留其本名的签名式样和印鉴。",
      "order": 191
    },
    {
      "id": "law-89b9e7bc5b-0083",
      "articleNumber": 83,
      "displayNumber": "第八十三条",
      "path": [
        "第四章支票"
      ],
      "text": "支票可以支取现金，也可以转账，用于转账时，应当在支票正面注明。\n支票中专门用于支取现金的，可以另行制作现金支票，现金支票只能用于支取现金。\n支票中专门用于转账的，可以另行制作转账支票，转账支票只能用于转账，不得支取现金。",
      "order": 194
    },
    {
      "id": "law-89b9e7bc5b-0084",
      "articleNumber": 84,
      "displayNumber": "第八十四条",
      "path": [
        "第四章支票"
      ],
      "text": "支票必须记载下列事项：\n（一）表明“支票”的字样；\n（二）无条件支付的委托；\n（三）确定的金额；\n（四）付款人名称；\n（五）出票日期；\n（六）出票人签章。\n支票上未记载前款规定事项之一的，支票无效。",
      "order": 197
    },
    {
      "id": "law-89b9e7bc5b-0085",
      "articleNumber": 85,
      "displayNumber": "第八十五条",
      "path": [
        "第四章支票"
      ],
      "text": "支票上的金额可以由出票人授权补记，未补记前的支票，不得使用。",
      "order": 205
    },
    {
      "id": "law-89b9e7bc5b-0086",
      "articleNumber": 86,
      "displayNumber": "第八十六条",
      "path": [
        "第四章支票"
      ],
      "text": "支票上未记载收款人名称的，经出票人授权，可以补记。\n支票上未记载付款地的，付款人的营业场所为付款地。\n支票上未记载出票地的，出票人的营业场所、住所或者经常居住地为出票地。\n出票人可以在支票上记载自己为收款人。",
      "order": 206
    },
    {
      "id": "law-89b9e7bc5b-0087",
      "articleNumber": 87,
      "displayNumber": "第八十七条",
      "path": [
        "第四章支票"
      ],
      "text": "支票的出票人所签发的支票金额不得超过其付款时在付款人处实有的存款金额。\n出票人签发的支票金额超过其付款时在付款人处实有的存款金额的，为空头支票。禁止签发空头支票。",
      "order": 210
    },
    {
      "id": "law-89b9e7bc5b-0088",
      "articleNumber": 88,
      "displayNumber": "第八十八条",
      "path": [
        "第四章支票"
      ],
      "text": "支票的出票人不得签发与其预留本名的签名式样或者印鉴不符的支票。",
      "order": 212
    },
    {
      "id": "law-89b9e7bc5b-0089",
      "articleNumber": 89,
      "displayNumber": "第八十九条",
      "path": [
        "第四章支票"
      ],
      "text": "出票人必须按照签发的支票金额承担保证向该持票人付款的责任。\n出票人在付款人处的存款足以支付支票金额时，付款人应当在当日足额付款。",
      "order": 213
    },
    {
      "id": "law-89b9e7bc5b-0090",
      "articleNumber": 90,
      "displayNumber": "第九十条",
      "path": [
        "第四章支票"
      ],
      "text": "支票限于见票即付，不得另行记载付款日期。另行记载付款日期的，该记载无效。",
      "order": 215
    },
    {
      "id": "law-89b9e7bc5b-0091",
      "articleNumber": 91,
      "displayNumber": "第九十一条",
      "path": [
        "第四章支票"
      ],
      "text": "支票的持票人应当自出票日起十日内提示付款；异地使用的支票，其提示付款的期限由中国人民银行另行规定。\n超过提示付款期限的，付款人可以不予付款；付款人不予付款的，出票人仍应当对持票人承担票据责任。",
      "order": 216
    },
    {
      "id": "law-89b9e7bc5b-0092",
      "articleNumber": 92,
      "displayNumber": "第九十二条",
      "path": [
        "第四章支票"
      ],
      "text": "付款人依法支付支票金额的，对出票人不再承担受委托付款的责任，对持票人不再承担付款的责任。但是，付款人以恶意或者有重大过失付款的除外。",
      "order": 218
    },
    {
      "id": "law-89b9e7bc5b-0093",
      "articleNumber": 93,
      "displayNumber": "第九十三条",
      "path": [
        "第四章支票"
      ],
      "text": "支票的背书、付款行为和追索权的行使，除本章规定外，适用本法第二章有关汇票的规定。\n支票的出票行为，除本章规定外，适用本法第二十四条、第二十六条关于汇票的规定。",
      "order": 219
    },
    {
      "id": "law-89b9e7bc5b-0094",
      "articleNumber": 94,
      "displayNumber": "第九十四条",
      "path": [
        "第五章涉外票据的法律适用"
      ],
      "text": "涉外票据的法律适用，依照本章的规定确定。\n前款所称涉外票据，是指出票、背书、承兑、保证、付款等行为中，既有发生在中华人民共和国境内又有发生在中华人民共和国境外的票据。",
      "order": 222
    },
    {
      "id": "law-89b9e7bc5b-0095",
      "articleNumber": 95,
      "displayNumber": "第九十五条",
      "path": [
        "第五章涉外票据的法律适用"
      ],
      "text": "中华人民共和国缔结或者参加的国际条约同本法有不同规定的，适用国际条约的规定。但是，中华人民共和国声明保留的条款除外。\n本法和中华人民共和国缔结或者参加的国际条约没有规定的，可以适用国际惯例。",
      "order": 224
    },
    {
      "id": "law-89b9e7bc5b-0096",
      "articleNumber": 96,
      "displayNumber": "第九十六条",
      "path": [
        "第五章涉外票据的法律适用"
      ],
      "text": "票据债务人的民事行为能力，适用其本国法律。\n票据债务人的民事行为能力，依照其本国法律为无民事行为能力或者为限制民事行为能力而依照行为地法律为完全民事行为能力的，适用行为地法律。",
      "order": 226
    },
    {
      "id": "law-89b9e7bc5b-0097",
      "articleNumber": 97,
      "displayNumber": "第九十七条",
      "path": [
        "第五章涉外票据的法律适用"
      ],
      "text": "汇票、本票出票时的记载事项，适用出票地法律。\n支票出票时的记载事项，适用出票地法律，经当事人协议，也可以适用付款地法律。",
      "order": 228
    },
    {
      "id": "law-89b9e7bc5b-0098",
      "articleNumber": 98,
      "displayNumber": "第九十八条",
      "path": [
        "第五章涉外票据的法律适用"
      ],
      "text": "票据的背书、承兑、付款和保证行为，适用行为地法律。",
      "order": 230
    },
    {
      "id": "law-89b9e7bc5b-0099",
      "articleNumber": 99,
      "displayNumber": "第九十九条",
      "path": [
        "第五章涉外票据的法律适用"
      ],
      "text": "票据追索权的行使期限，适用出票地法律。",
      "order": 231
    },
    {
      "id": "law-89b9e7bc5b-0100",
      "articleNumber": 100,
      "displayNumber": "第一百条",
      "path": [
        "第五章涉外票据的法律适用"
      ],
      "text": "票据的提示期限、有关拒绝证明的方式、出具拒绝证明的期限，适用付款地法律。",
      "order": 232
    },
    {
      "id": "law-89b9e7bc5b-0101",
      "articleNumber": 101,
      "displayNumber": "第一百零一条",
      "path": [
        "第五章涉外票据的法律适用"
      ],
      "text": "票据丧失时，失票人请求保全票据权利的程序，适用付款地法律。",
      "order": 233
    },
    {
      "id": "law-89b9e7bc5b-0102",
      "articleNumber": 102,
      "displayNumber": "第一百零二条",
      "path": [
        "第六章法律责任"
      ],
      "text": "有下列票据欺诈行为之一的，依法追究刑事责任：\n（一）伪造、变造票据的；\n（二）故意使用伪造、变造的票据的；\n（三）签发空头支票或者故意签发与其预留的本名签名式样或者印鉴不符的支票，骗取财物的；\n（四）签发无可靠资金来源的汇票、本票，骗取资金的；\n（五）汇票、本票的出票人在出票时作虚假记载，骗取财物的；\n（六）冒用他人的票据，或者故意使用过期或者作废的票据，骗取财物的；\n（七）付款人同出票人、持票人恶意串通，实施前六项所列行为之一的。",
      "order": 235
    },
    {
      "id": "law-89b9e7bc5b-0103",
      "articleNumber": 103,
      "displayNumber": "第一百零三条",
      "path": [
        "第六章法律责任"
      ],
      "text": "有前条所列行为之一，情节轻微，不构成犯罪的，依照国家有关规定给予行政处罚。",
      "order": 243
    },
    {
      "id": "law-89b9e7bc5b-0104",
      "articleNumber": 104,
      "displayNumber": "第一百零四条",
      "path": [
        "第六章法律责任"
      ],
      "text": "金融机构工作人员在票据业务中玩忽职守，对违反本法规定的票据予以承兑、付款或者保证的，给予处分；造成重大损失，构成犯罪的，依法追究刑事责任。\n由于金融机构工作人员因前款行为给当事人造成损失的，由该金融机构和直接责任人员依法承担赔偿责任。",
      "order": 244
    },
    {
      "id": "law-89b9e7bc5b-0105",
      "articleNumber": 105,
      "displayNumber": "第一百零五条",
      "path": [
        "第六章法律责任"
      ],
      "text": "票据的付款人对见票即付或者到期的票据，故意压票，拖延支付的，由金融行政管理部门处以罚款，对直接责任人员给予处分。\n票据的付款人故意压票，拖延支付，给持票人造成损失的，依法承担赔偿责任。",
      "order": 246
    },
    {
      "id": "law-89b9e7bc5b-0106",
      "articleNumber": 106,
      "displayNumber": "第一百零六条",
      "path": [
        "第六章法律责任"
      ],
      "text": "依照本法规定承担赔偿责任以外的其他违反本法规定的行为，给他人造成损失的，应当依法承担民事责任。",
      "order": 248
    },
    {
      "id": "law-89b9e7bc5b-0107",
      "articleNumber": 107,
      "displayNumber": "第一百零七条",
      "path": [
        "第七章附则"
      ],
      "text": "本法规定的各项期限的计算，适用民法通则关于计算期间的规定。\n按月计算期限的，按到期月的对日计算；无对日的，月末日为到期日。",
      "order": 250
    },
    {
      "id": "law-89b9e7bc5b-0108",
      "articleNumber": 108,
      "displayNumber": "第一百零八条",
      "path": [
        "第七章附则"
      ],
      "text": "汇票、本票、支票的格式应当统一。\n票据凭证的格式和印制管理办法，由中国人民银行规定。",
      "order": 252
    },
    {
      "id": "law-89b9e7bc5b-0109",
      "articleNumber": 109,
      "displayNumber": "第一百零九条",
      "path": [
        "第七章附则"
      ],
      "text": "票据管理的具体实施办法，由中国人民银行依照本法制定，报国务院批准后施行。",
      "order": 254
    },
    {
      "id": "law-89b9e7bc5b-0110",
      "articleNumber": 110,
      "displayNumber": "第一百一十条",
      "path": [
        "第七章附则"
      ],
      "text": "本法自1996年1月1日起施行。",
      "order": 255
    }
  ]
}
