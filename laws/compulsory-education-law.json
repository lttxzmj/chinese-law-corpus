  "articles": [
    {
      "id": "compulsory-education-law-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了保障适龄儿童、少年接受义务教育的权利，保证义务教育的实施，提高全民族素质，根据宪法和教育法，制定本法。",
      "order": 2
    },
    {
      "id": "compulsory-education-law-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "国家实行九年义务教育制度。\n义务教育是国家统一实施的所有适龄儿童、少年必须接受的教育，是国家必须予以保障的公益性事业。\n实施义务教育，不收学费、杂费。\n国家建立义务教育经费保障机制，保证义务教育制度实施。",
      "order": 3
    },
    {
      "id": "compulsory-education-law-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "义务教育必须贯彻国家的教育方针，实施素质教育，提高教育质量，使适龄儿童、少年在品德、智力、体质等方面全面发展，为培养有理想、有道德、有文化、有纪律的社会主义建设者和接班人奠定基础。",
      "order": 7
    },
    {
      "id": "compulsory-education-law-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "凡具有中华人民共和国国籍的适龄儿童、少年，不分性别、民族、种族、家庭财产状况、宗教信仰等，依法享有平等接受义务教育的权利，并履行接受义务教育的义务。",
      "order": 8
    },
    {
      "id": "compulsory-education-law-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "各级人民政府及其有关部门应当履行本法规定的各项职责，保障适龄儿童、少年接受义务教育的权利。\n适龄儿童、少年的父母或者其他法定监护人应当依法保证其按时入学接受并完成义务教育。\n依法实施义务教育的学校应当按照规定标准完成教育教学任务，保证教育教学质量。\n社会组织和个人应当为适龄儿童、少年接受义务教育创造良好的环境。",
      "order": 9
    },
    {
      "id": "compulsory-education-law-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第一章总则"
      ],
      "text": "国务院和县级以上地方人民政府应当合理配置教育资源，促进义务教育均衡发展，改善薄弱学校的办学条件，并采取措施，保障农村地区、民族地区实施义务教育，保障家庭经济困难的和残疾的适龄儿童、少年接受义务教育。\n国家组织和鼓励经济发达地区支援经济欠发达地区实施义务教育。",
      "order": 13
    },
    {
      "id": "compulsory-education-law-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第一章总则"
      ],
      "text": "义务教育实行国务院领导，省、自治区、直辖市人民政府统筹规划实施，县级人民政府为主管理的体制。\n县级以上人民政府教育行政部门具体负责义务教育实施工作；县级以上人民政府其他有关部门在各自的职责范围内负责义务教育实施工作。",
      "order": 15
    },
    {
      "id": "compulsory-education-law-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第一章总则"
      ],
      "text": "人民政府教育督导机构对义务教育工作执行法律法规情况、教育教学质量以及义务教育均衡发展状况等进行督导，督导报告向社会公布。",
      "order": 17
    },
    {
      "id": "compulsory-education-law-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第一章总则"
      ],
      "text": "任何社会组织或者个人有权对违反本法的行为向有关国家机关提出检举或者控告。\n发生违反本法的重大事件，妨碍义务教育实施，造成重大社会影响的，负有领导责任的人民政府或者人民政府教育行政部门负责人应当引咎辞职。",
      "order": 18
    },
    {
      "id": "compulsory-education-law-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第一章总则"
      ],
      "text": "对在义务教育实施工作中做出突出贡献的社会组织和个人，各级人民政府及其有关部门按照有关规定给予表彰、奖励。",
      "order": 20
    },
    {
      "id": "compulsory-education-law-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第二章学生"
      ],
      "text": "凡年满六周岁的儿童，其父母或者其他法定监护人应当送其入学接受并完成义务教育；条件不具备的地区的儿童，可以推迟到七周岁。\n适龄儿童、少年因身体状况需要延缓入学或者休学的，其父母或者其他法定监护人应当提出申请，由当地乡镇人民政府或者县级人民政府教育行政部门批准。",
      "order": 22
    },
    {
      "id": "compulsory-education-law-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第二章学生"
      ],
      "text": "适龄儿童、少年免试入学。地方各级人民政府应当保障适龄儿童、少年在户籍所在地学校就近入学。\n父母或者其他法定监护人在非户籍所在地工作或者居住的适龄儿童、少年，在其父母或者其他法定监护人工作或者居住地接受义务教育的，当地人民政府应当为其提供平等接受义务教育的条件。具体办法由省、自治区、直辖市规定。\n县级人民政府教育行政部门对本行政区域内的军人子女接受义务教育予以保障。",
      "order": 24
    },
    {
      "id": "compulsory-education-law-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第二章学生"
      ],
      "text": "县级人民政府教育行政部门和乡镇人民政府组织和督促适龄儿童、少年入学，帮助解决适龄儿童、少年接受义务教育的困难，采取措施防止适龄儿童、少年辍学。\n居民委员会和村民委员会协助政府做好工作，督促适龄儿童、少年入学。",
      "order": 27
    },
    {
      "id": "compulsory-education-law-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第二章学生"
      ],
      "text": "禁止用人单位招用应当接受义务教育的适龄儿童、少年。\n根据国家有关规定经批准招收适龄儿童、少年进行文艺、体育等专业训练的社会组织，应当保证所招收的适龄儿童、少年接受义务教育；自行实施义务教育的，应当经县级人民政府教育行政部门批准。",
      "order": 29
    },
    {
      "id": "compulsory-education-law-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第三章学校"
      ],
      "text": "县级以上地方人民政府根据本行政区域内居住的适龄儿童、少年的数量和分布状况等因素，按照国家有关规定，制定、调整学校设置规划。新建居民区需要设置学校的，应当与居民区的建设同步进行。",
      "order": 32
    },
    {
      "id": "compulsory-education-law-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第三章学校"
      ],
      "text": "学校建设，应当符合国家规定的办学标准，适应教育教学需要；应当符合国家规定的选址要求和建设标准，确保学生和教职工安全。",
      "order": 33
    },
    {
      "id": "compulsory-education-law-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第三章学校"
      ],
      "text": "县级人民政府根据需要设置寄宿制学校，保障居住分散的适龄儿童、少年入学接受义务教育。",
      "order": 34
    },
    {
      "id": "compulsory-education-law-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第三章学校"
      ],
      "text": "国务院教育行政部门和省、自治区、直辖市人民政府根据需要，在经济发达地区设置接收少数民族适龄儿童、少年的学校（班）。",
      "order": 35
    },
    {
      "id": "compulsory-education-law-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第三章学校"
      ],
      "text": "县级以上地方人民政府根据需要设置相应的实施特殊教育的学校（班），对视力残疾、听力语言残疾和智力残疾的适龄儿童、少年实施义务教育。特殊教育学校（班）应当具备适应残疾儿童、少年学习、康复、生活特点的场所和设施。\n普通学校应当接收具有接受普通教育能力的残疾适龄儿童、少年随班就读，并为其学习、康复提供帮助。",
      "order": 36
    },
    {
      "id": "compulsory-education-law-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第三章学校"
      ],
      "text": "县级以上地方人民政府根据需要，为具有预防未成年人犯罪法规定的严重不良行为的适龄少年设置专门的学校实施义务教育。",
      "order": 38
    },
    {
      "id": "compulsory-education-law-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第三章学校"
      ],
      "text": "对未完成义务教育的未成年犯和被采取强制性教育措施的未成年人应当进行义务教育，所需经费由人民政府予以保障。",
      "order": 39
    },
    {
      "id": "compulsory-education-law-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第三章学校"
      ],
      "text": "县级以上人民政府及其教育行政部门应当促进学校均衡发展，缩小学校之间办学条件的差距，不得将学校分为重点学校和非重点学校。学校不得分设重点班和非重点班。\n县级以上人民政府及其教育行政部门不得以任何名义改变或者变相改变公办学校的性质。",
      "order": 40
    },
    {
      "id": "compulsory-education-law-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第三章学校"
      ],
      "text": "各级人民政府及其有关部门依法维护学校周边秩序，保护学生、教师、学校的合法权益，为学校提供安全保障。",
      "order": 42
    },
    {
      "id": "compulsory-education-law-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第三章学校"
      ],
      "text": "学校应当建立、健全安全制度和应急机制，对学生进行安全教育，加强管理，及时消除隐患，预防发生事故。\n县级以上地方人民政府定期对学校校舍安全进行检查；对需要维修、改造的，及时予以维修、改造。\n学校不得聘用曾经因故意犯罪被依法剥夺政治权利或者其他不适合从事义务教育工作的人担任工作人员。",
      "order": 43
    },
    {
      "id": "compulsory-education-law-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第三章学校"
      ],
      "text": "学校不得违反国家规定收取费用，不得以向学生推销或者变相推销商品、服务等方式谋取利益。",
      "order": 46
    },
    {
      "id": "compulsory-education-law-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第三章学校"
      ],
      "text": "学校实行校长负责制。校长应当符合国家规定的任职条件。校长由县级人民政府教育行政部门依法聘任。",
      "order": 47
    },
    {
      "id": "compulsory-education-law-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第三章学校"
      ],
      "text": "对违反学校管理制度的学生，学校应当予以批评教育，不得开除。",
      "order": 48
    },
    {
      "id": "compulsory-education-law-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第四章教师"
      ],
      "text": "教师享有法律规定的权利，履行法律规定的义务，应当为人师表，忠诚于人民的教育事业。\n全社会应当尊重教师。",
      "order": 50
    },
    {
      "id": "compulsory-education-law-0029",
      "articleNumber": 29,
      "displayNumber": "第二十九条",
      "path": [
        "第四章教师"
      ],
      "text": "教师在教育教学中应当平等对待学生，关注学生的个体差异，因材施教，促进学生的充分发展。\n教师应当尊重学生的人格，不得歧视学生，不得对学生实施体罚、变相体罚或者其他侮辱人格尊严的行为，不得侵犯学生合法权益。",
      "order": 52
    },
    {
      "id": "compulsory-education-law-0030",
      "articleNumber": 30,
      "displayNumber": "第三十条",
      "path": [
        "第四章教师"
      ],
      "text": "教师应当取得国家规定的教师资格。\n国家建立统一的义务教育教师职务制度。教师职务分为初级职务、中级职务和高级职务。",
      "order": 54
    },
    {
      "id": "compulsory-education-law-0031",
      "articleNumber": 31,
      "displayNumber": "第三十一条",
      "path": [
        "第四章教师"
      ],
      "text": "各级人民政府保障教师工资福利和社会保险待遇，改善教师工作和生活条件；完善农村教师工资经费保障机制。\n教师的平均工资水平应当不低于当地公务员的平均工资水平。\n特殊教育教师享有特殊岗位补助津贴。在民族地区和边远贫困地区工作的教师享有艰苦贫困地区补助津贴。",
      "order": 56
    },
    {
      "id": "compulsory-education-law-0032",
      "articleNumber": 32,
      "displayNumber": "第三十二条",
      "path": [
        "第四章教师"
      ],
      "text": "县级以上人民政府应当加强教师培养工作，采取措施发展教师教育。\n县级人民政府教育行政部门应当均衡配置本行政区域内学校师资力量，组织校长、教师的培训和流动，加强对薄弱学校的建设。",
      "order": 59
    },
    {
      "id": "compulsory-education-law-0033",
      "articleNumber": 33,
      "displayNumber": "第三十三条",
      "path": [
        "第四章教师"
      ],
      "text": "国务院和地方各级人民政府鼓励和支持城市学校教师和高等学校毕业生到农村地区、民族地区从事义务教育工作。\n国家鼓励高等学校毕业生以志愿者的方式到农村地区、民族地区缺乏教师的学校任教。县级人民政府教育行政部门依法认定其教师资格，其任教时间计入工龄。",
      "order": 61
    },
    {
      "id": "compulsory-education-law-0034",
      "articleNumber": 34,
      "displayNumber": "第三十四条",
      "path": [
        "第五章教育教学"
      ],
      "text": "教育教学工作应当符合教育规律和学生身心发展特点，面向全体学生，教书育人，将德育、智育、体育、美育等有机统一在教育教学活动中，注重培养学生独立思考能力、创新能力和实践能力，促进学生全面发展。",
      "order": 64
    },
    {
      "id": "compulsory-education-law-0035",
      "articleNumber": 35,
      "displayNumber": "第三十五条",
      "path": [
        "第五章教育教学"
      ],
      "text": "国务院教育行政部门根据适龄儿童、少年身心发展的状况和实际情况，确定教学制度、教育教学内容和课程设置，改革考试制度，并改进高级中等学校招生办法，推进实施素质教育。\n学校和教师按照确定的教育教学内容和课程设置开展教育教学活动，保证达到国家规定的基本质量要求。\n国家鼓励学校和教师采用启发式教育等教育教学方法，提高教育教学质量。",
      "order": 65
    },
    {
      "id": "compulsory-education-law-0036",
      "articleNumber": 36,
      "displayNumber": "第三十六条",
      "path": [
        "第五章教育教学"
      ],
      "text": "学校应当把德育放在首位，寓德育于教育教学之中，开展与学生年龄相适应的社会实践活动，形成学校、家庭、社会相互配合的思想道德教育体系，促进学生养成良好的思想品德和行为习惯。",
      "order": 68
    },
    {
      "id": "compulsory-education-law-0037",
      "articleNumber": 37,
      "displayNumber": "第三十七条",
      "path": [
        "第五章教育教学"
      ],
      "text": "学校应当保证学生的课外活动时间，组织开展文化娱乐等课外活动。社会公共文化体育设施应当为学校开展课外活动提供便利。",
      "order": 69
    },
    {
      "id": "compulsory-education-law-0038",
      "articleNumber": 38,
      "displayNumber": "第三十八条",
      "path": [
        "第五章教育教学"
      ],
      "text": "教科书根据国家教育方针和课程标准编写，内容力求精简，精选必备的基础知识、基本技能，经济实用，保证质量。\n国家机关工作人员和教科书审查人员，不得参与或者变相参与教科书的编写工作。",
      "order": 70
    },
    {
      "id": "compulsory-education-law-0039",
      "articleNumber": 39,
      "displayNumber": "第三十九条",
      "path": [
        "第五章教育教学"
      ],
      "text": "国家实行教科书审定制度。教科书的审定办法由国务院教育行政部门规定。\n未经审定的教科书，不得出版、选用。",
      "order": 72
    },
    {
      "id": "compulsory-education-law-0040",
      "articleNumber": 40,
      "displayNumber": "第四十条",
      "path": [
        "第五章教育教学"
      ],
      "text": "教科书价格由省、自治区、直辖市人民政府价格行政部门会同同级出版主管部门按照微利原则确定。",
      "order": 74
    },
    {
      "id": "compulsory-education-law-0041",
      "articleNumber": 41,
      "displayNumber": "第四十一条",
      "path": [
        "第五章教育教学"
      ],
      "text": "国家鼓励教科书循环使用。",
      "order": 75
    },
    {
      "id": "compulsory-education-law-0042",
      "articleNumber": 42,
      "displayNumber": "第四十二条",
      "path": [
        "第六章经费保障"
      ],
      "text": "国家将义务教育全面纳入财政保障范围，义务教育经费由国务院和地方各级人民政府依照本法规定予以保障。\n国务院和地方各级人民政府将义务教育经费纳入财政预算，按照教职工编制标准、工资标准和学校建设标准、学生人均公用经费标准等，及时足额拨付义务教育经费，确保学校的正常运转和校舍安全，确保教职工工资按照规定发放。\n国务院和地方各级人民政府用于实施义务教育财政拨款的增长比例应当高于财政经常性收入的增长比例，保证按照在校学生人数平均的义务教育费用逐步增长，保证教职工工资和学生人均公用经费逐步增长。",
      "order": 77
    },
    {
      "id": "compulsory-education-law-0043",
      "articleNumber": 43,
      "displayNumber": "第四十三条",
      "path": [
        "第六章经费保障"
      ],
      "text": "学校的学生人均公用经费基本标准由国务院财政部门会同教育行政部门制定，并根据经济和社会发展状况适时调整。制定、调整学生人均公用经费基本标准，应当满足教育教学基本需要。\n省、自治区、直辖市人民政府可以根据本行政区域的实际情况，制定不低于国家标准的学校学生人均公用经费标准。\n特殊教育学校（班）学生人均公用经费标准应当高于普通学校学生人均公用经费标准。",
      "order": 80
    },
    {
      "id": "compulsory-education-law-0044",
      "articleNumber": 44,
      "displayNumber": "第四十四条",
      "path": [
        "第六章经费保障"
      ],
      "text": "义务教育经费投入实行国务院和地方各级人民政府根据职责共同负担，省、自治区、直辖市人民政府负责统筹落实的体制。农村义务教育所需经费，由各级人民政府根据国务院的规定分项目、按比例分担。\n各级人民政府对家庭经济困难的适龄儿童、少年免费提供教科书并补助寄宿生生活费。\n义务教育经费保障的具体办法由国务院规定。",
      "order": 83
    },
    {
      "id": "compulsory-education-law-0045",
      "articleNumber": 45,
      "displayNumber": "第四十五条",
      "path": [
        "第六章经费保障"
      ],
      "text": "地方各级人民政府在财政预算中将义务教育经费单列。\n县级人民政府编制预算，除向农村地区学校和薄弱学校倾斜外，应当均衡安排义务教育经费。",
      "order": 86
    },
    {
      "id": "compulsory-education-law-0046",
      "articleNumber": 46,
      "displayNumber": "第四十六条",
      "path": [
        "第六章经费保障"
      ],
      "text": "国务院和省、自治区、直辖市人民政府规范财政转移支付制度，加大一般性转移支付规模和规范义务教育专项转移支付，支持和引导地方各级人民政府增加对义务教育的投入。地方各级人民政府确保将上级人民政府的义务教育转移支付资金按照规定用于义务教育。",
      "order": 88
    },
    {
      "id": "compulsory-education-law-0047",
      "articleNumber": 47,
      "displayNumber": "第四十七条",
      "path": [
        "第六章经费保障"
      ],
      "text": "国务院和县级以上地方人民政府根据实际需要，设立专项资金，扶持农村地区、民族地区实施义务教育。",
      "order": 89
    },
    {
      "id": "compulsory-education-law-0048",
      "articleNumber": 48,
      "displayNumber": "第四十八条",
      "path": [
        "第六章经费保障"
      ],
      "text": "国家鼓励社会组织和个人向义务教育捐赠，鼓励按照国家有关基金会管理的规定设立义务教育基金。",
      "order": 90
    },
    {
      "id": "compulsory-education-law-0049",
      "articleNumber": 49,
      "displayNumber": "第四十九条",
      "path": [
        "第六章经费保障"
      ],
      "text": "义务教育经费严格按照预算规定用于义务教育；任何组织和个人不得侵占、挪用义务教育经费，不得向学校非法收取或者摊派费用。",
      "order": 91
    },
    {
      "id": "compulsory-education-law-0050",
      "articleNumber": 50,
      "displayNumber": "第五十条",
      "path": [
        "第六章经费保障"
      ],
      "text": "县级以上人民政府建立健全义务教育经费的审计监督和统计公告制度。",
      "order": 92
    },
    {
      "id": "compulsory-education-law-0051",
      "articleNumber": 51,
      "displayNumber": "第五十一条",
      "path": [
        "第七章法律责任"
      ],
      "text": "国务院有关部门和地方各级人民政府违反本法第六章的规定，未履行对义务教育经费保障职责的，由国务院或者上级地方人民政府责令限期改正；情节严重的，对直接负责的主管人员和其他直接责任人员依法给予行政处分。",
      "order": 94
    },
    {
      "id": "compulsory-education-law-0052",
      "articleNumber": 52,
      "displayNumber": "第五十二条",
      "path": [
        "第七章法律责任"
      ],
      "text": "县级以上地方人民政府有下列情形之一的，由上级人民政府责令限期改正；情节严重的，对直接负责的主管人员和其他直接责任人员依法给予行政处分：\n（一）未按照国家有关规定制定、调整学校的设置规划的；\n（二）学校建设不符合国家规定的办学标准、选址要求和建设标准的；\n（三）未定期对学校校舍安全进行检查，并及时维修、改造的；\n（四）未依照本法规定均衡安排义务教育经费的。",
      "order": 95
    },
    {
      "id": "compulsory-education-law-0053",
      "articleNumber": 53,
      "displayNumber": "第五十三条",
      "path": [
        "第七章法律责任"
      ],
      "text": "县级以上人民政府或者其教育行政部门有下列情形之一的，由上级人民政府或者其教育行政部门责令限期改正、通报批评；情节严重的，对直接负责的主管人员和其他直接责任人员依法给予行政处分：\n（一）将学校分为重点学校和非重点学校的；\n（二）改变或者变相改变公办学校性质的。\n县级人民政府教育行政部门或者乡镇人民政府未采取措施组织适龄儿童、少年入学或者防止辍学的，依照前款规定追究法律责任。",
      "order": 100
    },
    {
      "id": "compulsory-education-law-0054",
      "articleNumber": 54,
      "displayNumber": "第五十四条",
      "path": [
        "第七章法律责任"
      ],
      "text": "有下列情形之一的，由上级人民政府或者上级人民政府教育行政部门、财政部门、价格行政部门和审计机关根据职责分工责令限期改正；情节严重的，对直接负责的主管人员和其他直接责任人员依法给予处分：\n（一）侵占、挪用义务教育经费的；\n（二）向学校非法收取或者摊派费用的。",
      "order": 104
    },
    {
      "id": "compulsory-education-law-0055",
      "articleNumber": 55,
      "displayNumber": "第五十五条",
      "path": [
        "第七章法律责任"
      ],
      "text": "学校或者教师在义务教育工作中违反教育法、教师法规定的，依照教育法、教师法的有关规定处罚。",
      "order": 107
    },
    {
      "id": "compulsory-education-law-0056",
      "articleNumber": 56,
      "displayNumber": "第五十六条",
      "path": [
        "第七章法律责任"
      ],
      "text": "学校违反国家规定收取费用的，由县级人民政府教育行政部门责令退还所收费用；对直接负责的主管人员和其他直接责任人员依法给予处分。\n学校以向学生推销或者变相推销商品、服务等方式谋取利益的，由县级人民政府教育行政部门给予通报批评；有违法所得的，没收违法所得；对直接负责的主管人员和其他直接责任人员依法给予处分。\n国家机关工作人员和教科书审查人员参与或者变相参与教科书编写的，由县级以上人民政府或者其教育行政部门根据职责权限责令限期改正，依法给予行政处分；有违法所得的，没收违法所得。",
      "order": 108
    },
    {
      "id": "compulsory-education-law-0057",
      "articleNumber": 57,
      "displayNumber": "第五十七条",
      "path": [
        "第七章法律责任"
      ],
      "text": "学校有下列情形之一的，由县级人民政府教育行政部门责令限期改正；情节严重的，对直接负责的主管人员和其他直接责任人员依法给予处分：\n（一）拒绝接收具有接受普通教育能力的残疾适龄儿童、少年随班就读的；\n（二）分设重点班和非重点班的；\n（三）违反本法规定开除学生的；\n（四）选用未经审定的教科书的。",
      "order": 111
    },
    {
      "id": "compulsory-education-law-0058",
      "articleNumber": 58,
      "displayNumber": "第五十八条",
      "path": [
        "第七章法律责任"
      ],
      "text": "适龄儿童、少年的父母或者其他法定监护人无正当理由未依照本法规定送适龄儿童、少年入学接受义务教育的，由当地乡镇人民政府或者县级人民政府教育行政部门给予批评教育，责令限期改正。",
      "order": 116
    },
    {
      "id": "compulsory-education-law-0059",
      "articleNumber": 59,
      "displayNumber": "第五十九条",
      "path": [
        "第七章法律责任"
      ],
      "text": "有下列情形之一的，依照有关法律、行政法规的规定予以处罚：\n（一）胁迫或者诱骗应当接受义务教育的适龄儿童、少年失学、辍学的；\n（二）非法招用应当接受义务教育的适龄儿童、少年的；\n（三）出版未经依法审定的教科书的。",
      "order": 117
    },
    {
      "id": "compulsory-education-law-0060",
      "articleNumber": 60,
      "displayNumber": "第六十条",
      "path": [
        "第七章法律责任"
      ],
      "text": "违反本法规定，构成犯罪的，依法追究刑事责任。",
      "order": 121
    },
    {
      "id": "compulsory-education-law-0061",
      "articleNumber": 61,
      "displayNumber": "第六十一条",
      "path": [
        "第八章附则"
      ],
      "text": "对接受义务教育的适龄儿童、少年不收杂费的实施步骤，由国务院规定。",
      "order": 123
    },
    {
      "id": "compulsory-education-law-0062",
      "articleNumber": 62,
      "displayNumber": "第六十二条",
      "path": [
        "第八章附则"
      ],
      "text": "社会组织或者个人依法举办的民办学校实施义务教育的，依照民办教育促进法有关规定执行；民办教育促进法未作规定的，适用本法。",
      "order": 124
    },
    {
      "id": "compulsory-education-law-0063",
      "articleNumber": 63,
      "displayNumber": "第六十三条",
      "path": [
        "第八章附则"
      ],
      "text": "本法自2006年9月1日起施行。",
      "order": 125
    }
  ]
}
