  "articles": [
    {
      "id": "xzfg-6165298d37-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了加强对食盐的管理，保障食盐科学加碘工作的有效实施，确保食盐质量安全和供应安全，保护公民的身体健康，制定本办法。",
      "order": 2
    },
    {
      "id": "xzfg-6165298d37-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "国家实行食盐专营管理。\n本办法所称食盐，是指直接食用和制作食品所用的盐。",
      "order": 3
    },
    {
      "id": "xzfg-6165298d37-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "本办法适用于中华人民共和国境内的食盐生产、销售和储备活动。",
      "order": 5
    },
    {
      "id": "xzfg-6165298d37-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "国务院盐业主管部门主管全国盐业工作，负责管理全国食盐专营工作。县级以上地方人民政府确定的盐业主管部门负责管理本行政区域的食盐专营工作。\n国务院食品药品监督管理部门负责全国食盐质量安全监督管理。县级以上地方人民政府确定的食盐质量安全监督管理部门负责本行政区域的食盐质量安全监督管理。",
      "order": 6
    },
    {
      "id": "xzfg-6165298d37-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "盐业主管部门应当加强对工业用盐等非食用盐的管理，防止非食用盐流入食盐市场。",
      "order": 8
    },
    {
      "id": "xzfg-6165298d37-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第一章总则"
      ],
      "text": "国务院盐业主管部门应当会同有关部门加强对食盐生产、批发企业及其董事、监事、高级管理人员的信用管理，建立健全信用信息记录、公示制度，提高食盐行业信用水平。",
      "order": 9
    },
    {
      "id": "xzfg-6165298d37-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第一章总则"
      ],
      "text": "依法成立的盐业行业组织依照法律、行政法规和章程，保护企业合法权益，加强行业自律，促进企业守法、诚信经营，引导企业公平竞争。",
      "order": 10
    },
    {
      "id": "xzfg-6165298d37-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第二章食盐生产"
      ],
      "text": "国家实行食盐定点生产制度。非食盐定点生产企业不得生产食盐。",
      "order": 12
    },
    {
      "id": "xzfg-6165298d37-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第二章食盐生产"
      ],
      "text": "省、自治区、直辖市人民政府盐业主管部门按照统一规划、合理布局的要求审批确定食盐定点生产企业，颁发食盐定点生产企业证书，及时向社会公布食盐定点生产企业名单，并报国务院盐业主管部门备案。",
      "order": 13
    },
    {
      "id": "xzfg-6165298d37-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第二章食盐生产"
      ],
      "text": "食盐定点生产企业和非食用盐生产企业应当建立生产销售记录制度，如实记录并保存相关凭证。记录和凭证保存期限不得少于2年。\n食盐应当按照规定在外包装上作出标识，非食用盐的包装、标识应当明显区别于食盐。",
      "order": 14
    },
    {
      "id": "xzfg-6165298d37-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第二章食盐生产"
      ],
      "text": "禁止利用井矿盐卤水熬制食盐。",
      "order": 16
    },
    {
      "id": "xzfg-6165298d37-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第三章食盐销售"
      ],
      "text": "国家实行食盐定点批发制度。非食盐定点批发企业不得经营食盐批发业务。",
      "order": 18
    },
    {
      "id": "xzfg-6165298d37-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第三章食盐销售"
      ],
      "text": "省、自治区、直辖市人民政府盐业主管部门按照统一规划、合理布局的要求审批确定食盐定点批发企业，颁发食盐定点批发企业证书，及时向社会公布食盐定点批发企业名单，并报国务院盐业主管部门备案。\n食盐定点生产企业申请经营食盐批发业务的，省、自治区、直辖市人民政府盐业主管部门应当确定其为食盐定点批发企业并颁发食盐定点批发企业证书。",
      "order": 19
    },
    {
      "id": "xzfg-6165298d37-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第三章食盐销售"
      ],
      "text": "食盐定点批发企业应当从食盐定点生产企业或者其他食盐定点批发企业购进食盐，在国家规定的范围内销售。\n食盐定点批发企业在国家规定的范围内销售食盐，任何单位或者个人不得阻止或者限制。",
      "order": 21
    },
    {
      "id": "xzfg-6165298d37-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第三章食盐销售"
      ],
      "text": "食盐定点批发企业应当建立采购销售记录制度，如实记录并保存相关凭证。记录和凭证保存期限不得少于2年。",
      "order": 23
    },
    {
      "id": "xzfg-6165298d37-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第三章食盐销售"
      ],
      "text": "食盐零售单位应当从食盐定点批发企业购进食盐。",
      "order": 24
    },
    {
      "id": "xzfg-6165298d37-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第三章食盐销售"
      ],
      "text": "食盐价格由经营者自主确定。\n县级以上地方人民政府价格主管部门应当加强对食盐零售价格的市场日常监测。当食盐价格显著上涨或者有可能显著上涨时，省、自治区、直辖市人民政府可以依法采取价格干预或者其他应急措施。",
      "order": 25
    },
    {
      "id": "xzfg-6165298d37-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第三章食盐销售"
      ],
      "text": "县级以上地方人民政府应当根据实际情况，采取必要措施，保障边远地区和民族地区的食盐供应。",
      "order": 27
    },
    {
      "id": "xzfg-6165298d37-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第三章食盐销售"
      ],
      "text": "禁止销售不符合食品安全标准的食盐。\n禁止将下列产品作为食盐销售：\n(一)液体盐(含天然卤水)；\n(二)工业用盐和其他非食用盐；\n(三)利用盐土、硝土或者工业废渣、废液制作的盐；\n(四)利用井矿盐卤水熬制的盐；\n(五)外包装上无标识或者标识不符合国家有关规定的盐。",
      "order": 28
    },
    {
      "id": "xzfg-6165298d37-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第四章食盐的储备和应急管理"
      ],
      "text": "省、自治区、直辖市人民政府盐业主管部门应当根据本行政区域食盐供需情况，建立健全食盐储备制度，承担政府食盐储备责任。",
      "order": 36
    },
    {
      "id": "xzfg-6165298d37-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第四章食盐的储备和应急管理"
      ],
      "text": "食盐定点生产企业和食盐定点批发企业应当按照食盐储备制度要求，承担企业食盐储备责任，保持食盐的合理库存。",
      "order": 37
    },
    {
      "id": "xzfg-6165298d37-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第四章食盐的储备和应急管理"
      ],
      "text": "盐业主管部门应当会同有关部门制定食盐供应应急预案，在发生突发事件时协调、保障食盐供应。",
      "order": 38
    },
    {
      "id": "xzfg-6165298d37-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第五章监督管理"
      ],
      "text": "盐业主管部门依法履行监督检查职责，可以采取下列措施：\n(一)向有关单位和个人了解情况；\n(二)查阅或者复制有关合同、票据、账簿、购销记录及其他有关资料；\n(三)查封、扣押与涉嫌盐业违法行为有关的食盐及原材料，以及用于违法生产或者销售食盐的工具、设备；\n(四)查封涉嫌违法生产或者销售食盐的场所。\n采取前款第三项、第四项规定的措施，应当向盐业主管部门主要负责人书面报告，并经批准。\n盐业主管部门调查涉嫌盐业违法行为，应当遵守《中华人民共和国行政强制法》和其他有关法律、行政法规的规定。",
      "order": 40
    },
    {
      "id": "xzfg-6165298d37-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第五章监督管理"
      ],
      "text": "盐业主管部门、食盐质量安全监督管理部门应当各司其职，加强协作，相互配合，通过政务信息系统等实现信息共享，建立健全行政执法协作配合制度。\n盐业主管部门、食盐质量安全监督管理部门在监督管理工作中发现依法不属于本部门处理权限的涉嫌违法行为，应当及时移交有权处理的部门；有权处理的部门应当依法及时处理，并及时反馈处理结果。",
      "order": 47
    },
    {
      "id": "xzfg-6165298d37-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第五章监督管理"
      ],
      "text": "盐业主管部门、食盐质量安全监督管理部门应当向社会公布本部门的联系方式，方便公众举报违法行为。\n盐业主管部门、食盐质量安全监督管理部门接到举报，应当及时依法调查处理。对实名举报，盐业主管部门、食盐质量安全监督管理部门应当为举报人保密，并将处理结果告知举报人。",
      "order": 49
    },
    {
      "id": "xzfg-6165298d37-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第六章法律责任"
      ],
      "text": "有下列情形之一的，由县级以上地方人民政府盐业主管部门予以取缔，没收违法生产经营的食盐和违法所得。违法生产经营的食盐货值金额不足1万元的，可以处5万元以下的罚款；货值金额1万元以上的，并处货值金额5倍以上10倍以下的罚款：\n(一)非食盐定点生产企业生产食盐；\n(二)非食盐定点批发企业经营食盐批发业务。",
      "order": 52
    },
    {
      "id": "xzfg-6165298d37-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第六章法律责任"
      ],
      "text": "有下列情形之一的，由县级以上地方人民政府盐业主管部门责令改正，处5000元以上5万元以下的罚款；情节严重的，责令停产停业整顿，直至吊销食盐定点生产、食盐定点批发企业证书：\n(一)食盐定点生产企业、非食用盐生产企业未按照本办法规定保存生产销售记录；\n(二)食盐定点批发企业未按照本办法规定保存采购销售记录；\n(三)食盐定点批发企业超出国家规定的范围销售食盐；\n(四)将非食用盐产品作为食盐销售。",
      "order": 55
    },
    {
      "id": "xzfg-6165298d37-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第六章法律责任"
      ],
      "text": "有下列情形之一的，由县级以上地方人民政府盐业主管部门责令改正，没收违法购进的食盐，可以处违法购进的食盐货值金额3倍以下的罚款：\n(一)食盐定点批发企业从除食盐定点生产企业、其他食盐定点批发企业以外的单位或者个人购进食盐；\n(二)食盐零售单位从食盐定点批发企业以外的单位或者个人购进食盐。",
      "order": 60
    },
    {
      "id": "xzfg-6165298d37-0029",
      "articleNumber": 29,
      "displayNumber": "第二十九条",
      "path": [
        "第六章法律责任"
      ],
      "text": "未按照本办法第十条的规定作出标识的，由有关主管部门依据职责分工，责令改正，可以处5万元以下的罚款。",
      "order": 63
    },
    {
      "id": "xzfg-6165298d37-0030",
      "articleNumber": 30,
      "displayNumber": "第三十条",
      "path": [
        "第六章法律责任"
      ],
      "text": "经营者的行为违反本办法的规定同时违反《中华人民共和国食品安全法》的，由县级以上地方人民政府食盐质量安全监督管理部门依照《中华人民共和国食品安全法》进行处罚。",
      "order": 64
    },
    {
      "id": "xzfg-6165298d37-0031",
      "articleNumber": 31,
      "displayNumber": "第三十一条",
      "path": [
        "第六章法律责任"
      ],
      "text": "食盐定点生产企业、食盐定点批发企业违反本办法的规定，被处以吊销食盐定点生产、食盐定点批发企业证书行政处罚的，其法定代表人、直接负责的主管人员和其他直接责任人员自处罚决定作出之日起5年内不得从事食盐生产经营管理活动，不得担任食盐定点生产企业、食盐定点批发企业的董事、监事或者高级管理人员。\n食盐定点生产企业、食盐定点批发企业违反前款规定聘用人员的，由盐业主管部门责令改正；拒不改正的，吊销其食盐定点生产、食盐定点批发企业证书。",
      "order": 65
    },
    {
      "id": "xzfg-6165298d37-0032",
      "articleNumber": 32,
      "displayNumber": "第三十二条",
      "path": [
        "第六章法律责任"
      ],
      "text": "违反本办法的规定，构成违反治安管理行为的，依法给予治安管理处罚；构成犯罪的，依法追究刑事责任。",
      "order": 67
    },
    {
      "id": "xzfg-6165298d37-0033",
      "articleNumber": 33,
      "displayNumber": "第三十三条",
      "path": [
        "第六章法律责任"
      ],
      "text": "盐业主管部门以及其他有关部门的工作人员滥用职权、玩忽职守、徇私舞弊，构成犯罪的，依法追究刑事责任；尚不构成犯罪的，依法给予处分。",
      "order": 68
    },
    {
      "id": "xzfg-6165298d37-0034",
      "articleNumber": 34,
      "displayNumber": "第三十四条",
      "path": [
        "第七章附则"
      ],
      "text": "除本办法的规定外，食盐质量安全监督管理、食盐加碘工作还应当依照有关法律、行政法规的规定执行。",
      "order": 70
    },
    {
      "id": "xzfg-6165298d37-0035",
      "articleNumber": 35,
      "displayNumber": "第三十五条",
      "path": [
        "第七章附则"
      ],
      "text": "渔业、畜牧用盐管理办法，由国务院盐业主管部门会同国务院农业行政主管部门另行制定。",
      "order": 71
    },
