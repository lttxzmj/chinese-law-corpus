  "articles": [
    {
      "id": "xzfg-2977c4450d-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了加强对外国人在中国境内登山的管理，有组织地进行国际登山交流，促进我国登山事业发展，制定本办法。",
      "order": 2
    },
    {
      "id": "xzfg-2977c4450d-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "外国人在中国境内攀登下列对外开放的山峰以及附带在山峰区域内进行科学考察、测绘活动，适用本办法：\n(一)西藏自治区海拔五千米以上的山峰；\n(二)其他省、自治区海拔三千五百米以上的山峰。",
      "order": 3
    },
    {
      "id": "xzfg-2977c4450d-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "外国人在中国境内进行登山活动，应当遵守中国的法律；外国人的正当权益，受中国法律保护。",
      "order": 6
    },
    {
      "id": "xzfg-2977c4450d-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "对外国人在中国境内登山的管理，实行统一领导，分级负责的原则。",
      "order": 7
    },
    {
      "id": "xzfg-2977c4450d-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "对外开放山峰由中华人民共和国国家体育运动委员会(以下简称国家体委)和公安部公布。",
      "order": 8
    },
    {
      "id": "xzfg-2977c4450d-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第二章来华登山手续"
      ],
      "text": "外国人来华登山，可以自行组成团队，也可以由外国团队和中国团队组成联合团队。",
      "order": 10
    },
    {
      "id": "xzfg-2977c4450d-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第二章来华登山手续"
      ],
      "text": "外国人来华登山，应当向国家体委提出书面申请。\n外国人组成外国团队来华登山的，由外国团队提出申请，也可以委托我国省、自治区登山协会代理申请事宜。\n外国团队和中国团队组成中外联合团队登山的，由中国团队提出申请。",
      "order": 11
    },
    {
      "id": "xzfg-2977c4450d-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第二章来华登山手续"
      ],
      "text": "国家体委收到外国团队或者中外联合团队的登山申请后，应当在六十日内作出是否批准的决定，并以书面形式通知外国团队或者中外联合团队、代理申请事宜的省、自治区登山协会和登山活动所在省、自治区体委。",
      "order": 14
    },
    {
      "id": "xzfg-2977c4450d-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第二章来华登山手续"
      ],
      "text": "外国团队接到国家体委批准的登山通知后，应当按照通知要求缴纳注册费，并与通知中指定的单位签订登山议定书。\n与外国团队签订登山议定书的单位(以下简称中方签约单位)应当及时将议定书副本报送国家体委备案。",
      "order": 15
    },
    {
      "id": "xzfg-2977c4450d-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第二章来华登山手续"
      ],
      "text": "议定书报送国家体委备案后，不得任意变更。如需要变更，应当经签订议定书的中外双方协商确认；如果变更攀登的季节、路线或者山峰，应当重新报国家体委审批。",
      "order": 17
    },
    {
      "id": "xzfg-2977c4450d-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第二章来华登山手续"
      ],
      "text": "外国团队应当在入境的一个月前，将在中国境内登山的经费按预算全额汇寄中方签约单位，并按照国家体委的通知在中国驻外使(领)馆办理签证。",
      "order": 18
    },
    {
      "id": "xzfg-2977c4450d-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第三章登山活动"
      ],
      "text": "外国团队在登山前应当为随队的中国公民办理有关保险事项，并根据国家体委的要求落实保护山区自然环境的各项措施。",
      "order": 20
    },
    {
      "id": "xzfg-2977c4450d-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第三章登山活动"
      ],
      "text": "外国人登山，应当遵守下列规定：\n(一)按照国家体委批准的山峰和路线进行攀登，不得攀登其他山峰，不得越过批准的路线；外国登山团队之间不得互相转让攀登的山峰和路线；\n(二)外国登山团队不得吸收本团队以外的队员；\n(三)如要求展现外国团队所在国国旗，应当经中国国家体委同意，并同时展现规格相当的中国国旗；\n(四)使用山峰的名称和高度，应当以中国政府有关部门公布的为准；\n(五)保持登山路线和营区的环境卫生，不得自行在登山活动区域安放纪念品和其他物品；\n(六)将登山活动的结果和登山过程中的意外情况及时报告国家体委和中方签约单位。",
      "order": 21
    },
    {
      "id": "xzfg-2977c4450d-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第三章登山活动"
      ],
      "text": "外国人在登山活动结束后，应当以团队为单位写出总结报告书。\n登山活动总结报告书以及在登山期间摄录的音像资料，应当无偿向国家体委和登山活动所在省、自治区体委提供。",
      "order": 28
    },
    {
      "id": "xzfg-2977c4450d-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第三章登山活动"
      ],
      "text": "外国人在我国境内登顶成功，由国家体委确认后，发给其登顶证明书。",
      "order": 30
    },
    {
      "id": "xzfg-2977c4450d-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第三章登山活动"
      ],
      "text": "外国人在我国境内登山期间，必须有我国联络人员陪同。联络人员由中方签约单位指定，其职责是：\n(一)协助并监督外国人执行我国的有关规定；\n(二)协助解决外国人在登山活动中的有关问题；\n(三)向中方签约单位报告有关情况；\n(四)调解外国人与中方服务人员的纠纷。",
      "order": 31
    },
    {
      "id": "xzfg-2977c4450d-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第三章登山活动"
      ],
      "text": "外国人登山，需要我国公民提供服务，由我国联络人员办理。\n中国公民向外国人提供服务，可以收取服务费用。服务费用的项目和标准，由国家体委公布。",
      "order": 36
    },
    {
      "id": "xzfg-2977c4450d-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第三章登山活动"
      ],
      "text": "外国团队应当为随队的中国公民提供医疗、急救以及必要的宿营、炊事用具。\n未经我国联络人员同意，外国团队不得自行解雇随队的中国公民或者停发津贴。\n中外联合团队向随队的中国公民提供医疗、急救和宿营、炊事用具的办法，由组成中外联合团队的各方协商。",
      "order": 38
    },
    {
      "id": "xzfg-2977c4450d-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第四章登山附带科学考察和测绘"
      ],
      "text": "登山附带科学考察和测绘的，应当在办理登山申请的同时，向国家体委申报科学考察和测绘计划，由国家体委分别转国家科学技术委员会或者国家测绘局审批。\n科学考察和测绘计划未经批准，外国登山人员不得对所经地区的生物、岩石、矿物、冰雪、水样和土样进行系统观测，不得采集标本、样品、化石，不得进行测绘活动。",
      "order": 42
    },
    {
      "id": "xzfg-2977c4450d-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第四章登山附带科学考察和测绘"
      ],
      "text": "外国团队、中外联合团队登山附带科学考察的，应当通过中方签约单位向国家科学技术委员会提供下列样品和资料：\n(一)采集的标本、样品和化石的清单；\n(二)发现的动植物新种或者特殊动植物的类群；\n(三)采集的动植物新种正模式标本、特缺动植物类群的标本；\n(四)标本、样品、化石的室内分析结果；\n(五)登山附带科学考察的音像资料复制本。\n外国团队、中外联合团体登山附带测绘的，应当通过中方签约单位向国家测绘局提供测绘成果的副本或复制件。",
      "order": 44
    },
    {
      "id": "xzfg-2977c4450d-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第五章登山物资的入境和出境"
      ],
      "text": "外国人携带登山所需物资入境，按“特准进口物品”和“暂时进口物品”分别申报。经海关核准后，办理税收、担保手续。",
      "order": 52
    },
    {
      "id": "xzfg-2977c4450d-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第五章登山物资的入境和出境"
      ],
      "text": "登山物资中合理数量的专用食品、急救药品、防寒衣物、燃料等消耗性物品，可以特准免税入境；超过合理数量的，应当纳税。\n国家有关部门允许的通讯、摄影、录像、测绘器材和专用运输工具可以暂时免税入境。登山活动结束，上述物资应当复运出境。如因特殊原因无法复运出境的，应当通过国家体委依照国家有关规定办理手续。",
      "order": 53
    },
    {
      "id": "xzfg-2977c4450d-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第五章登山物资的入境和出境"
      ],
      "text": "外国团队、中外联合团队登山时采集的标本、样品、化石以及制作的音像资料，经有关部门检验许可后，方可携带出境。",
      "order": 55
    },
    {
      "id": "xzfg-2977c4450d-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第六章罚则"
      ],
      "text": "外国人来华登山，违反本办法第十二条、第十三条、第十八条、第十九条、第二十条规定或者未经国家体委批准擅自登山的，国家体委或者省、自治区体委视情节轻重，可以分别给予警告、五千元至五万元的罚款以及停止登山活动等处罚。\n违反本办法第十九条、第二十条规定的，国家体委或者省、自治区体委，还可以单处或者并处没收采集的标本、样品、化石和资料的处罚。",
      "order": 57
    },
    {
      "id": "xzfg-2977c4450d-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第六章罚则"
      ],
      "text": "当事人对行政处罚决定不服的，可以依照中国有关法律的规定先申请行政复议。当事人对复议决定不服的，可以依照中国有关法律的规定提起行政诉讼。当事人在规定的期限内不申请复议和不提起行政诉讼，逾期又不履行处罚决定的，作出处罚决定的行政机关可以申请人民法院强制执行。",
      "order": 59
    },
    {
      "id": "xzfg-2977c4450d-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第七章附则"
      ],
      "text": "台湾、香港、澳门同胞回大陆登山，参照执行本办法的规定。",
      "order": 61
    },
    {
      "id": "xzfg-2977c4450d-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第七章附则"
      ],
      "text": "本办法由国家体育运动委员会解释。",
      "order": 62
    },
    {
      "id": "xzfg-2977c4450d-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第七章附则"
      ],
      "text": "本办法自发布之日起施行。",
      "order": 63
    }
  ]
}
