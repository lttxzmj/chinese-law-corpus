{
  "id": "xzfg-8aced7f142",
  "officialId": "国务院令第111号",
  "title": "国有企业富余职工安置规定",
  "category": "行政法规",
  "issuingAuthority": "国务院",
  "promulgationDate": "1993-04-20",
  "effectiveDate": "",
  "status": "effective",
  "source": {
    "metadataPath": "data/laws/xzfg-8aced7f142/metadata.json",
    "docxPath": "data/laws/xzfg-8aced7f142/official.docx"
  },
  "paragraphCount": 22,
  "sectionCount": 0,
  "articleCount": 18,
  "sections": [],
  "articles": [
    {
      "id": "xzfg-8aced7f142-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [],
      "text": "为了妥善安置国有企业富余职工，增强企业活力，提高企业经济效益，制定本规定。",
      "order": 1
    },
    {
      "id": "xzfg-8aced7f142-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [],
      "text": "安置国有企业(以下简称企业)中的富余职工，应当遵循企业自行安置为主、社会帮助安置为辅，保障富余职工基本生活的原则。",
      "order": 2
    },
    {
      "id": "xzfg-8aced7f142-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [],
      "text": "企业安置富余职工应当依照本规定采取拓展多种经营、组织劳务活动、发展第三产业、综合利用资源和其它措施。\n企业行政主管部门、劳动行政主管部门和工会组织应当指导、帮助和支持企业做好富余职工安置工作，积极创造条件，培育和完善劳务市场，开辟社会安置渠道。",
      "order": 3
    },
    {
      "id": "xzfg-8aced7f142-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [],
      "text": "企业为安置富余职工而兴办的从事第三产业的独立核算企业，自开业之日起两年免征、三年减半征收企业所得税。",
      "order": 5
    },
    {
      "id": "xzfg-8aced7f142-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [],
      "text": "企业开办的劳动就业服务企业，应当承担安置本企业富余职工的任务。企业应当按照国家有关国有资产管理的规定，在资金、场地、原材料和设备等方面给予扶持。",
      "order": 6
    },
    {
      "id": "xzfg-8aced7f142-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [],
      "text": "企业组织本企业富余职工依法兴办的独立核算企业，可以承担本企业中原由外单位承包的技术改造或者劳务项目。",
      "order": 7
    },
    {
      "id": "xzfg-8aced7f142-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [],
      "text": "企业可以对富余职工实行待岗和转业培训，培训期间的工资待遇由企业自行确定。",
      "order": 8
    },
    {
      "id": "xzfg-8aced7f142-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [],
      "text": "经企业职工代表大会讨论同意并报企业行政主管部门备案，企业可以对职工实行有限期的放假。职工放假期间，由企业发给生活费。\n孕期或者哺乳期的女职工，经本人申请，企业可以给予不超过二年的假期，放假期间发给生活费。假期内含产假的，产假期间按照国家规定发给工资。",
      "order": 9
    },
    {
      "id": "xzfg-8aced7f142-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [],
      "text": "职工距退休年龄不到五年的，经本人申请，企业领导批准，可以退出工作岗位休养。职工退出工作岗位休养期间，由企业发给生活费。已经实行退休费用统筹的地方，企业和退出工作岗位休养的职工应当按照有关规定缴纳基本养老保险费。职工退出工作岗位休养期间达到国家规定的退休年龄时，按照规定办理退休手续。职工退出工作岗位休养期间视为工龄，与其以前的工龄合并计算。",
      "order": 11
    },
    {
      "id": "xzfg-8aced7f142-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [],
      "text": "职工可以申请辞职。经企业批准辞职的职工，在办理辞职手续时，企业应当按照国家有关规定发给一次性生活补助费。",
      "order": 12
    },
    {
      "id": "xzfg-8aced7f142-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [],
      "text": "按照本规定第八条、第九条规定发放的生活费在企业工资基金中列支，生活费标准由企业自主确定，但是不得低于省、自治区、直辖市人民政府规定的最低标准。",
      "order": 13
    },
    {
      "id": "xzfg-8aced7f142-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [],
      "text": "企业因生产经营发生重大变化，必须裁减职工的，对劳动合同制职工，经企业职工代表大会讨论同意，可以提前解除劳动合同，但是应当按照合同约定履行义务；合同没有约定的，企业对被提前解除劳动合同的职工，按照其在本企业工作的年限，工龄每满一年，发给相当于本人一个月标准工资的补偿费。",
      "order": 14
    },
    {
      "id": "xzfg-8aced7f142-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [],
      "text": "各级劳动行政主管部门和企业行政主管部门应当做好富余职工的社会安置和调剂工作，鼓励和帮助富余职工组织起来就业和自谋职业。企业之间调剂职工，可以正式调动，也可以临时借调；临时借调的，借调期间的工资和福利待遇由双方企业在协议中商定。",
      "order": 15
    },
    {
      "id": "xzfg-8aced7f142-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [],
      "text": "富余职工由企业自行安置有困难到社会待业的，在待业期间，依法享受待业保险待遇。劳动行政主管部门和有关行政主管部门应当创造条件，帮助职工再就业。",
      "order": 16
    },
    {
      "id": "xzfg-8aced7f142-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [],
      "text": "企业依照本规定兴办的独立核算企业安置的职工，按照国家有关规定纳入新办企业的职工人数和经济指标的统计范围。",
      "order": 17
    },
    {
      "id": "xzfg-8aced7f142-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [],
      "text": "省、自治区、直辖市人民政府可以根据本规定制定实施办法。",
      "order": 18
    },
    {
      "id": "xzfg-8aced7f142-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [],
      "text": "本规定由国务院劳动行政主管部门负责解释。",
      "order": 19
    },
    {
      "id": "xzfg-8aced7f142-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [],
      "text": "本规定自发布之日起施行。",
      "order": 20
    }
  ]
}
