  ],
  "articles": [
    {
      "id": "xzfg-69d39e6295-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为创造良好的公共场所卫生条件，预防疾病，保障人体健康，制定本条例。",
      "order": 2
    },
    {
      "id": "xzfg-69d39e6295-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "本条例适用于下列公共场所：\n（一）宾馆、旅店、招待所；\n（二）公共浴室、理发店、美容店；\n（三）影剧院、录像厅（室）、游艺厅（室）、舞厅、音乐厅；\n（四）体育场（馆）、游泳场（馆）、公园；\n（五）展览馆、博物馆、美术馆、图书馆；\n（六）商场（店）、书店；\n（七）候诊室、候车（机、船）室、公共交通工具。",
      "order": 3
    },
    {
      "id": "xzfg-69d39e6295-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "公共场所的下列项目应符合国家卫生标准和要求：\n（一）空气、微小气候（湿度、温度、风速）；\n（二）水质；\n（三）采光、照明；\n（四）噪音；\n（五）顾客用具和卫生设施。\n公共场所的卫生标准和要求，由国务院疾病预防控制部门负责制定。",
      "order": 11
    },
    {
      "id": "xzfg-69d39e6295-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "国家对公共场所实行“卫生许可证”制度。\n“卫生许可证”由设区的市级、县级人民政府疾病预防控制部门签发。",
      "order": 18
    },
    {
      "id": "xzfg-69d39e6295-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第二章卫生管理"
      ],
      "text": "公共场所的主管部门应当建立卫生管理制度，配备专职或者兼职卫生管理人员，对所属经营单位（包括个体经营者，下同）的卫生状况进行经常性检查，并提供必要的条件。",
      "order": 21
    },
    {
      "id": "xzfg-69d39e6295-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第二章卫生管理"
      ],
      "text": "经营单位应当负责所经营的公共场所的卫生管理，建立卫生责任制度，对本单位的从业人员进行卫生知识的培训和考核工作。",
      "order": 22
    },
    {
      "id": "xzfg-69d39e6295-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第二章卫生管理"
      ],
      "text": "公共场所直接为顾客服务的人员，持有“健康合格证”方能从事本职工作。患有痢疾、伤寒、病毒性肝炎、活动期肺结核、化脓性或者渗出性皮肤病以及其他有碍公共卫生的疾病的，治愈前不得从事直接为顾客服务的工作。",
      "order": 23
    },
    {
      "id": "xzfg-69d39e6295-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第二章卫生管理"
      ],
      "text": "除公园、体育场（馆）、公共交通工具和本条第二款规定的实行卫生备案管理的公共场所外，经营单位应当在营业前向设区的市级、县级人民政府疾病预防控制部门申请办理“卫生许可证”。\n录像厅（室）、音乐厅、展览馆、博物馆、美术馆、图书馆、书店的经营单位应当在营业之日起30天内向设区的市级、县级人民政府疾病预防控制部门办理卫生备案。",
      "order": 24
    },
    {
      "id": "xzfg-69d39e6295-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第二章卫生管理"
      ],
      "text": "公共场所因不符合卫生标准和要求造成危害健康事故的，经营单位应妥善处理，并及时报告卫生防疫机构。",
      "order": 26
    },
    {
      "id": "xzfg-69d39e6295-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第三章卫生监督"
      ],
      "text": "各级卫生防疫机构，负责管辖范围内的公共场所卫生监督工作。\n民航、铁路、交通、厂（场）矿卫生防疫机构对管辖范围内的公共场所，施行卫生监督，并接受当地卫生防疫机构的业务指导。",
      "order": 28
    },
    {
      "id": "xzfg-69d39e6295-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第三章卫生监督"
      ],
      "text": "卫生防疫机构根据需要设立公共场所卫生监督员，执行卫生防疫机构交给的任务。公共场所卫生监督员由同级人民政府发给证书。\n民航、铁路、交通、工矿企业卫生防疫机构的公共场所卫生监督员，由其上级主管部门发给证书。",
      "order": 30
    },
    {
      "id": "xzfg-69d39e6295-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第三章卫生监督"
      ],
      "text": "卫生防疫机构对公共场所的卫生监督职责：\n（一）对公共场所进行卫生监测和卫生技术指导；\n（二）监督从业人员健康检查，指导有关部门对从业人员进行卫生知识的教育和培训。",
      "order": 32
    },
    {
      "id": "xzfg-69d39e6295-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第三章卫生监督"
      ],
      "text": "卫生监督员有权对公共场所进行现场检查，索取有关资料，经营单位不得拒绝或隐瞒。卫生监督员对所提供的技术资料有保密的责任。\n公共场所卫生监督员在执行任务时，应佩戴证章、出示证件。",
      "order": 35
    },
    {
      "id": "xzfg-69d39e6295-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第四章罚则"
      ],
      "text": "凡有下列行为之一的单位或者个人，卫生防疫机构可以根据情节轻重，给予警告、罚款、停业整顿、吊销“卫生许可证”的行政处罚：\n（一）卫生质量不符合国家卫生标准和要求，而继续营业的；\n（二）未获得“健康合格证”，而从事直接为顾客服务的；\n（三）拒绝卫生监督的；\n（四）未取得“卫生许可证”擅自营业，或者未办理卫生备案的。\n罚款一律上交国库。",
      "order": 38
    },
    {
      "id": "xzfg-69d39e6295-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第四章罚则"
      ],
      "text": "违反本条例的规定造成严重危害公民健康的事故或中毒事故的单位或者个人，应当对受害人赔偿损失。\n违反本条例致人残疾或者死亡，构成犯罪的，应由司法机关依法追究直接责任人员的刑事责任。",
      "order": 44
    },
    {
      "id": "xzfg-69d39e6295-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第四章罚则"
      ],
      "text": "对罚款、停业整顿及吊销“卫生许可证”的行政处罚不服的，在接到处罚通知之日起15天内，可以向当地人民法院起诉。但对公共场所卫生质量控制的决定应立即执行。对处罚的决定不履行又逾期不起诉的，由卫生防疫机构向人民法院申请强制执行。",
      "order": 46
    },
    {
      "id": "xzfg-69d39e6295-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第四章罚则"
      ],
      "text": "公共场所卫生监督机构和卫生监督员必须尽职尽责，依法办事。对玩忽职守，滥用职权，收取贿赂的，由上级主管部门给予直接责任人员行政处分。构成犯罪的，由司法机关依法追究直接责任人员的刑事责任。",
      "order": 47
    },
    {
      "id": "xzfg-69d39e6295-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第五章附则"
      ],
      "text": "本条例的实施细则由国务院卫生行政部门负责制定。",
      "order": 49
    },
    {
      "id": "xzfg-69d39e6295-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第五章附则"
      ],
      "text": "本条例自发布之日起施行。",
      "order": 50
    }
  ]
}
