  "articles": [
    {
      "id": "xzfg-02898c1744-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为加强水库大坝安全管理，保障人民生命财产和社会主义建设的安全，根据《中华人民共和国水法》，制定本条例。",
      "order": 2
    },
    {
      "id": "xzfg-02898c1744-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "本条例适用于中华人民共和国境内坝高15米以上或者库容100万立方米以上的水库大坝（以下简称大坝）。大坝包括永久性挡水建筑物以及与其配合运用的泄洪、输水和过船建筑物等。\n坝高15米以下、10米以上或者库容100万立方米以下、10万立方米以上，对重要城镇、交通干线、重要军事设施、工矿区安全有潜在危险的大坝，其安全管理参照本条例执行。",
      "order": 3
    },
    {
      "id": "xzfg-02898c1744-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "国务院水行政主管部门会同国务院有关主管部门对全国的大坝安全实施监督。县级以上地方人民政府水行政主管部门会同有关主管部门对本行政区域内的大坝安全实施监督。\n各级水利、能源、建设、交通、农业等有关部门，是其所管辖的大坝的主管部门。",
      "order": 5
    },
    {
      "id": "xzfg-02898c1744-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "各级人民政府及其大坝主管部门对其所管辖的大坝的安全实行行政领导负责制。",
      "order": 7
    },
    {
      "id": "xzfg-02898c1744-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "大坝的建设和管理应当贯彻安全第一的方针。",
      "order": 8
    },
    {
      "id": "xzfg-02898c1744-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第一章总则"
      ],
      "text": "任何单位和个人都有保护大坝安全的义务。",
      "order": 9
    },
    {
      "id": "xzfg-02898c1744-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第二章大坝建设"
      ],
      "text": "兴建大坝必须符合由国务院水行政主管部门会同有关大坝主管部门制定的大坝安全技术标准。",
      "order": 11
    },
    {
      "id": "xzfg-02898c1744-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第二章大坝建设"
      ],
      "text": "兴建大坝必须进行工程设计。大坝的工程设计必须由具有相应资格证书的单位承担。\n大坝的工程设计应当包括工程观测、通信、动力、照明、交通、消防等管理设施的设计。",
      "order": 12
    },
    {
      "id": "xzfg-02898c1744-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第二章大坝建设"
      ],
      "text": "大坝施工必须由具有相应资格证书的单位承担。大坝施工单位必须按照施工承包合同规定的设计文件、图纸要求和有关技术标准进行施工。\n建设单位和设计单位应当派驻代表，对施工质量进行监督检查。质量不符合设计要求的，必须返工或者采取补救措施。",
      "order": 14
    },
    {
      "id": "xzfg-02898c1744-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第二章大坝建设"
      ],
      "text": "兴建大坝时，建设单位应当按照批准的设计，提请县级以上人民政府依照国家规定划定管理和保护范围，树立标志。\n已建大坝尚未划定管理和保护范围的，大坝主管部门应当根据安全管理的需要，提请县级以上人民政府划定。",
      "order": 16
    },
    {
      "id": "xzfg-02898c1744-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第二章大坝建设"
      ],
      "text": "大坝开工后，大坝主管部门应当组建大坝管理单位，由其按照工程基本建设验收规程参与质量检查以及大坝分部、分项验收和蓄水验收工作。\n大坝竣工后，建设单位应当申请大坝主管部门组织验收。",
      "order": 18
    },
    {
      "id": "xzfg-02898c1744-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第三章大坝管理"
      ],
      "text": "大坝及其设施受国家保护，任何单位和个人不得侵占、毁坏。大坝管理单位应当加强大坝的安全保卫工作。",
      "order": 21
    },
    {
      "id": "xzfg-02898c1744-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第三章大坝管理"
      ],
      "text": "禁止在大坝管理和保护范围内进行爆破、打井、采石、采矿、挖沙、取土、修坟等危害大坝安全的活动。",
      "order": 22
    },
    {
      "id": "xzfg-02898c1744-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第三章大坝管理"
      ],
      "text": "非大坝管理人员不得操作大坝的泄洪闸门、输水闸门以及其他设施，大坝管理人员操作时应当遵守有关的规章制度。禁止任何单位和个人干扰大坝的正常管理工作。",
      "order": 23
    },
    {
      "id": "xzfg-02898c1744-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第三章大坝管理"
      ],
      "text": "禁止在大坝的集水区域内乱伐林木、陡坡开荒等导致水库淤积的活动。禁止在库区内围垦和进行采石、取土等危及山体的活动。",
      "order": 24
    },
    {
      "id": "xzfg-02898c1744-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第三章大坝管理"
      ],
      "text": "大坝坝顶确需兼做公路的，须经科学论证和县级以上地方人民政府大坝主管部门批准，并采取相应的安全维护措施。",
      "order": 25
    },
    {
      "id": "xzfg-02898c1744-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第三章大坝管理"
      ],
      "text": "禁止在坝体修建码头、渠道、堆放杂物、晾晒粮草。在大坝管理和保护范围内修建码头、鱼塘的，须经大坝主管部门批准，并与坝脚和泄水、输水建筑物保持一定距离，不得影响大坝安全、工程管理和抢险工作。",
      "order": 26
    },
    {
      "id": "xzfg-02898c1744-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第三章大坝管理"
      ],
      "text": "大坝主管部门应当配备具有相应业务水平的大坝安全管理人员。\n大坝管理单位应当建立、健全安全管理规章制度。",
      "order": 27
    },
    {
      "id": "xzfg-02898c1744-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第三章大坝管理"
      ],
      "text": "大坝管理单位必须按照有关技术标准，对大坝进行安全监测和检查；对监测资料应当及时整理分析，随时掌握大坝运行状况。发现异常现象和不安全因素时，大坝管理单位应当立即报告大坝主管部门，及时采取措施。",
      "order": 29
    },
    {
      "id": "xzfg-02898c1744-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第三章大坝管理"
      ],
      "text": "大坝管理单位必须做好大坝的养护修理工作，保证大坝和闸门启闭设备完好。",
      "order": 30
    },
    {
      "id": "xzfg-02898c1744-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第三章大坝管理"
      ],
      "text": "大坝的运行，必须在保证安全的前提下，发挥综合效益。大坝管理单位应当根据批准的计划和大坝主管部门的指令进行水库的调度运用。\n在汛期，综合利用的水库，其调度运用必须服从防汛指挥机构的统一指挥；以发电为主的水库，其汛限水位以上的防洪库容及其洪水调度运用，必须服从防汛指挥机构的统一指挥。\n任何单位和个人不得非法干预水库的调度运用。",
      "order": 31
    },
    {
      "id": "xzfg-02898c1744-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第三章大坝管理"
      ],
      "text": "大坝主管部门应当建立大坝定期安全检查、鉴定制度。\n汛前、汛后，以及暴风、暴雨、特大洪水或者强烈地震发生后，大坝主管部门应当组织对其所管辖的大坝的安全进行检查。",
      "order": 34
    },
    {
      "id": "xzfg-02898c1744-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第三章大坝管理"
      ],
      "text": "大坝主管部门对其所管辖的大坝应当按期注册登记，建立技术档案。大坝注册登记办法由国务院水行政主管部门会同有关主管部门制定。",
      "order": 36
    },
    {
      "id": "xzfg-02898c1744-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第三章大坝管理"
      ],
      "text": "大坝管理单位和有关部门应当做好防汛抢险物料的准备和气象水情预报，并保证水情传递、报警以及大坝管理单位与大坝主管部门、上级防汛指挥机构之间联系通畅。",
      "order": 37
    },
    {
      "id": "xzfg-02898c1744-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第三章大坝管理"
      ],
      "text": "大坝出现险情征兆时，大坝管理单位应当立即报告大坝主管部门和上级防汛指挥机构，并采取抢救措施；有垮坝危险时，应当采取一切措施向预计的垮坝淹没地区发出警报，做好转移工作。",
      "order": 38
    },
    {
      "id": "xzfg-02898c1744-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第四章险坝处理"
      ],
      "text": "对尚未达到设计洪水标准、抗震设防标准或者有严重质量缺陷的险坝，大坝主管部门应当组织有关单位进行分类，采取除险加固等措施，或者废弃重建。\n在险坝加固前，大坝管理单位应当制定保坝应急措施；经论证必须改变原设计运行方式的，应当报请大坝主管部门审批。",
      "order": 40
    },
    {
      "id": "xzfg-02898c1744-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第四章险坝处理"
      ],
      "text": "大坝主管部门应当对其所管辖的需要加固的险坝制定加固计划，限期消除危险；有关人民政府应当优先安排所需资金和物料。\n险坝加固必须由具有相应设计资格证书的单位作出加固设计，经审批后组织实施。险坝加固竣工后，由大坝主管部门组织验收。",
      "order": 42
    },
    {
      "id": "xzfg-02898c1744-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第四章险坝处理"
      ],
      "text": "大坝主管部门应当组织有关单位，对险坝可能出现的垮坝方式、淹没范围作出预估，并制定应急方案，报防汛指挥机构批准。",
      "order": 44
    },
    {
      "id": "xzfg-02898c1744-0029",
      "articleNumber": 29,
      "displayNumber": "第二十九条",
      "path": [
        "第五章罚则"
      ],
      "text": "违反本条例规定，有下列行为之一的，由大坝主管部门责令其停止违法行为，赔偿损失，采取补救措施，可以并处罚款；应当给予治安管理处罚的，由公安机关依照《中华人民共和国治安管理处罚法》的规定处罚；构成犯罪的，依法追究刑事责任：\n（一）毁坏大坝或者其观测、通信、动力、照明、交通、消防等管理设施的；\n（二）在大坝管理和保护范围内进行爆破、打井、采石、采矿、取土、挖沙、修坟等危害大坝安全活动的；\n（三）擅自操作大坝的泄洪闸门、输水闸门以及其他设施，破坏大坝正常运行的；\n（四）在库区内围垦的；\n（五）在坝体修建码头、渠道或者堆放杂物、晾晒粮草的；\n（六）擅自在大坝管理和保护范围内修建码头、鱼塘的。",
      "order": 46
    },
    {
      "id": "xzfg-02898c1744-0030",
      "articleNumber": 30,
      "displayNumber": "第三十条",
      "path": [
        "第五章罚则"
      ],
      "text": "盗窃或者抢夺大坝工程设施、器材的，依照刑法规定追究刑事责任。",
      "order": 53
    },
    {
      "id": "xzfg-02898c1744-0031",
      "articleNumber": 31,
      "displayNumber": "第三十一条",
      "path": [
        "第五章罚则"
      ],
      "text": "由于勘测设计失误、施工质量低劣、调度运用不当以及滥用职权，玩忽职守，导致大坝事故的，由其所在单位或者上级主管机关对责任人员依法给予处分；构成犯罪的，依法追究刑事责任。",
      "order": 54
    },
    {
      "id": "xzfg-02898c1744-0032",
      "articleNumber": 32,
      "displayNumber": "第三十二条",
      "path": [
        "第五章罚则"
      ],
      "text": "当事人对行政处罚决定不服的，可以依法申请行政复议，也可以依法提起行政诉讼。当事人逾期不申请行政复议或者不向人民法院起诉又不履行行政处罚决定的，由作出行政处罚决定的机关申请人民法院强制执行。\n对治安管理处罚不服的，依照《中华人民共和国治安管理处罚法》的规定办理。",
      "order": 55
    },
    {
      "id": "xzfg-02898c1744-0033",
      "articleNumber": 33,
      "displayNumber": "第三十三条",
      "path": [
        "第六章附则"
      ],
      "text": "国务院有关部门和各省、自治区、直辖市人民政府可以根据本条例制定实施细则。",
      "order": 58
    },
    {
      "id": "xzfg-02898c1744-0034",
      "articleNumber": 34,
      "displayNumber": "第三十四条",
      "path": [
        "第六章附则"
      ],
      "text": "本条例自发布之日起施行。",
      "order": 59
    }
  ]
}
