  "articles": [
    {
      "id": "xzfg-d50e4219ee-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了加强电网调度管理，保障电网安全，保护用户利益，适应经济建设和人民生活的需要，制定本条例。",
      "order": 2
    },
    {
      "id": "xzfg-d50e4219ee-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "本条例所称电网调度，是指电网调度机构(以下简称调度机构)为保障电网的安全、优质、经济运行，对电网运行进行的组织、指挥、指导和协调。\n电网调度应当符合社会主义市场经济的要求和电网运行的客观规律。",
      "order": 3
    },
    {
      "id": "xzfg-d50e4219ee-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "中华人民共和国境内的发电、供电、用电单位以及其他有关单位和个人，必须遵守本条例。",
      "order": 5
    },
    {
      "id": "xzfg-d50e4219ee-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "电网运行实行统一调度、分级管理的原则。",
      "order": 6
    },
    {
      "id": "xzfg-d50e4219ee-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "任何单位和个人不得超计划分配电力和电量，不得超计划使用电力和电量；遇有特殊情况，需要变更计划的，须经用电计划下达部门批准。",
      "order": 7
    },
    {
      "id": "xzfg-d50e4219ee-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第一章总则"
      ],
      "text": "国务院电力行政主管部门主管电网调度工作。",
      "order": 8
    },
    {
      "id": "xzfg-d50e4219ee-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第二章调度系统"
      ],
      "text": "调度机构的职权及其调度管辖范围的划分原则，由国务院电力行政主管部门确定。",
      "order": 10
    },
    {
      "id": "xzfg-d50e4219ee-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第二章调度系统"
      ],
      "text": "调度机构直接调度的发电厂的划定原则，由国务院电力行政主管部门确定。",
      "order": 11
    },
    {
      "id": "xzfg-d50e4219ee-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第二章调度系统"
      ],
      "text": "调度系统包括各级调度机构和电网内的发电厂、变电站的运行值班单位。\n下级调度机构必须服从上级调度机构的调度。\n调度机构调度管辖范围内的发电厂、变电站的运行值班单位，必须服从该级调度机构的调度。",
      "order": 12
    },
    {
      "id": "xzfg-d50e4219ee-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第二章调度系统"
      ],
      "text": "调度机构分为五级：国家调度机构，跨省、自治区、直辖市调度机构，省、自治区、直辖市级调度机构，省辖市级调度机构，县级调度机构。",
      "order": 15
    },
    {
      "id": "xzfg-d50e4219ee-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第二章调度系统"
      ],
      "text": "调度系统值班人员须经培训、考核并取得合格证书方得上岗。\n调度系统值班人员的培训、考核办法由国务院电力行政主管部门制定。",
      "order": 16
    },
    {
      "id": "xzfg-d50e4219ee-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第三章调度计划"
      ],
      "text": "跨省电网管理部门和省级电网管理部门应当编制发电、供电计划，并将发电、供电计划报送国务院电力行政主管部门备案。\n调度机构应当编制下达发电、供电调度计划。\n值班调度人员可以按照有关规定，根据电网运行情况，调整日发电、供电调度计划。值班调度人员调整日发电、供电调度计划时，必须填写调度值班日志。",
      "order": 19
    },
    {
      "id": "xzfg-d50e4219ee-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第三章调度计划"
      ],
      "text": "跨省电网管理部门和省级电网管理部门编制发电、供电计划，调度机构编制发电、供电调度计划时，应当根据国家下达的计划、有关的供电协议和并网协议、电网的设备能力，并留有备用容量。\n对具有综合效益的水电厂(站)的水库，应当根据批准的水电厂(站)的设计文件，并考虑防洪、灌溉、发电、环保、航运等要求，合理运用水库蓄水。",
      "order": 22
    },
    {
      "id": "xzfg-d50e4219ee-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第三章调度计划"
      ],
      "text": "跨省电网管理部门和省级电网管理部门遇有下列情形之一，需要调整发电、供电计划时，应当通知有关地方人民政府的有关部门：\n(一)大中型水电厂(站)入库水量不足；\n(二)火电厂的燃料短缺；\n(三)其他需要调整发电、供电计划的情形。",
      "order": 24
    },
    {
      "id": "xzfg-d50e4219ee-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第四章调度规则"
      ],
      "text": "调度机构必须执行国家下达的供电计划，不得克扣电力、电量，并保证供电质量。",
      "order": 29
    },
    {
      "id": "xzfg-d50e4219ee-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第四章调度规则"
      ],
      "text": "发电厂必须按照调度机构下达的调度计划和规定的电压范围运行，并根据调度指令调整功率和电压。",
      "order": 30
    },
    {
      "id": "xzfg-d50e4219ee-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第四章调度规则"
      ],
      "text": "发电、供电设备的检修，应当服从调度机构的统一安排。",
      "order": 31
    },
    {
      "id": "xzfg-d50e4219ee-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第四章调度规则"
      ],
      "text": "出现下列紧急情况之一的，值班调度人员可以调整日发电、供电调度计划，发布限电、调整发电厂功率、开或者停发电机组等指令；可以向本电网内的发电厂、变电站的运行值班单位发布调度指令：\n(一)发电、供电设备发生重大事故或者电网发生事故；\n(二)电网频率或者电压超过规定范围；\n(三)输变电设备负载超过规定值；\n(四)主干线路功率值超过规定的稳定限额；\n(五)其他威胁电网安全运行的紧急情况。",
      "order": 32
    },
    {
      "id": "xzfg-d50e4219ee-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第四章调度规则"
      ],
      "text": "省级电网管理部门、省辖市级电网管理部门、县级电网管理部门应当根据本级人民政府的生产调度部门的要求、用户的特点和电网安全运行的需要，提出事故及超计划用电的限电序位表，经本级人民政府的生产调度部门审核，报本级人民政府批准后，由调度机构执行。\n限电及整个电网调度工作应当逐步实现自动化管理。",
      "order": 38
    },
    {
      "id": "xzfg-d50e4219ee-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第四章调度规则"
      ],
      "text": "未经值班调度人员许可，任何人不得操作调度机构调度管辖范围内的设备。\n电网运行遇有危及人身及设备安全的情况时，发电厂、变电站的运行值班单位的值班人员可以按照有关规定处理，处理后应当立即报告有关调度机构的值班人员。",
      "order": 40
    },
    {
      "id": "xzfg-d50e4219ee-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第五章调度指令"
      ],
      "text": "值班调度人员必须按照规定发布各种调度指令。",
      "order": 43
    },
    {
      "id": "xzfg-d50e4219ee-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第五章调度指令"
      ],
      "text": "在调度系统中，必须执行调度指令。调度系统的值班人员认为执行调度指令将危及人身及设备安全的，应当立即向发布指令的值班调度人员报告，由其决定调度指令的执行或者撤销。",
      "order": 44
    },
    {
      "id": "xzfg-d50e4219ee-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第五章调度指令"
      ],
      "text": "电网管理部门的负责人，调度机构的负责人以及发电厂、变电站的负责人，对上级调度机构的值班人员发布的调度指令有不同意见时，可以向上级电网电力行政主管部门或者上级调度机构提出，但是在其未作出答复前，调度系统的值班人员必须按照上级调度机构的值班人员发布的调度指令执行。",
      "order": 45
    },
    {
      "id": "xzfg-d50e4219ee-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第五章调度指令"
      ],
      "text": "任何单位和个人不得违反本条例干预调度系统的值班人员发布或者执行调度指令；调度系统的值班人员依法执行公务，有权拒绝各种非法干预。",
      "order": 46
    },
    {
      "id": "xzfg-d50e4219ee-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第六章并网与调度"
      ],
      "text": "并网运行的发电厂或者电网，必须服从调度机构的统一调度。",
      "order": 48
    },
    {
      "id": "xzfg-d50e4219ee-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第六章并网与调度"
      ],
      "text": "需要并网运行的发电厂与电网之间以及电网与电网之间，应当在并网前根据平等互利、协商一致的原则签订并网协议并严格执行。",
      "order": 49
    },
    {
      "id": "xzfg-d50e4219ee-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第七章罚则"
      ],
      "text": "违反本条例规定，有下列行为之一的，对主管人员和直接责任人员由其所在单位或者上级机关给予行政处分：\n(一)未经上级调度机构许可，不按照上级调度机构下达的发电、供电调度计划执行的；\n(二)不执行有关调度机构批准的检修计划的；\n(三)不执行调度指令和调度机构下达的保证电网安全的措施的；\n(四)不如实反映电网运行情况的；\n(五)不如实反映执行调度指令情况的；\n(六)调度系统的值班人员玩忽职守、徇私舞弊，尚不构成犯罪的。",
      "order": 51
    },
    {
      "id": "xzfg-d50e4219ee-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第七章罚则"
      ],
      "text": "调度机构对于超计划用电的用户应当予以警告；经警告，仍未按照计划用电的，调度机构可以发布限电指令，并可以强行扣还电力、电量；当超计划用电威胁电网安全运行时，调度机构可以部分或者全部暂时停止供电。",
      "order": 58
    },
    {
      "id": "xzfg-d50e4219ee-0029",
      "articleNumber": 29,
      "displayNumber": "第二十九条",
      "path": [
        "第七章罚则"
      ],
      "text": "违反本条例规定，未按照计划供电或者无故调整供电计划的，电网应当根据用户的需要补给少供的电力、电量。",
      "order": 59
    },
    {
      "id": "xzfg-d50e4219ee-0030",
      "articleNumber": 30,
      "displayNumber": "第三十条",
      "path": [
        "第七章罚则"
      ],
      "text": "违反本条例规定，构成违反治安管理行为的，依照《中华人民共和国治安管理处罚法》的有关规定给予处罚；构成犯罪的，依法追究刑事责任。",
      "order": 60
    },
    {
      "id": "xzfg-d50e4219ee-0031",
      "articleNumber": 31,
      "displayNumber": "第三十一条",
      "path": [
        "第八章附则"
      ],
      "text": "国务院电力行政主管部门可以根据本条例制定实施办法。\n省、自治区、直辖市人民政府可以根据本条例制定小电网管理办法。",
      "order": 62
    },
    {
      "id": "xzfg-d50e4219ee-0032",
      "articleNumber": 32,
      "displayNumber": "第三十二条",
      "path": [
        "第八章附则"
      ],
      "text": "本条例由国务院电力行政主管部门负责解释。",
      "order": 64
    },
    {
      "id": "xzfg-d50e4219ee-0033",
      "articleNumber": 33,
      "displayNumber": "第三十三条",
      "path": [
        "第八章附则"
      ],
      "text": "本条例自1993年11月1日起施行。",
      "order": 65
    }
  ]
}
