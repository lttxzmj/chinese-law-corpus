  "articles": [
    {
      "id": "law-29614e4167-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为发展对外经济合作和技术交流，促进社会主义现代化建设，在广东省深圳、珠海、汕头三市分别划出一定区域，设置经济特区（以下简称特区）。特区鼓励外国公民、华侨、港澳同胞及其公司、企业（以下简称客商），投资设厂或者与我方合资设厂，兴办企业和其他事业，并依法保护其资产、应得利润和其他合法权益。",
      "order": 3
    },
    {
      "id": "law-29614e4167-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "特区内的企业和个人，必须遵守中华人民共和国的法律、法令和有关规定。本条例有特别规定的，按照本条例的规定执行。",
      "order": 4
    },
    {
      "id": "law-29614e4167-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "设立广东省经济特区管理委员会，代表广东省人民政府对各特区实行统一管理。",
      "order": 5
    },
    {
      "id": "law-29614e4167-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "特区为客商提供广阔的经营范围，创造良好的经营条件，保证稳定的经营场所。一切在国际经济合作和技术交流中具有积极意义的工业、农业、畜牧业、养殖业、旅游业、住宅和建筑业、高级技术研究制造业，以及客商与我方共同感兴趣的其他行业，都可以投资兴办或者与我方合资兴办。",
      "order": 6
    },
    {
      "id": "law-29614e4167-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "特区的土地平整工程和供水、排水、供电、道路、码头、通讯、仓储等各项公共设施，由广东省经济特区管理委员会负责兴建，必要时也可以吸收外资参与兴建。",
      "order": 7
    },
    {
      "id": "law-29614e4167-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第一章总则"
      ],
      "text": "各特区分别聘请国内外专家和热心我国现代化建设的有关人士组成顾问委员会，作为该特区的咨询机构。",
      "order": 8
    },
    {
      "id": "law-29614e4167-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第二章注册和经营"
      ],
      "text": "客商在特区投资设厂，兴办各项经济事业，应向广东省经济特区管理委员会提出申请，经审核、批准后，发给注册证书和土地使用证书。",
      "order": 10
    },
    {
      "id": "law-29614e4167-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第二章注册和经营"
      ],
      "text": "客商可在特区内设立的中国银行或者其他经我方批准设立的银行开户，并办理有关外汇事宜。\n客商的各项保险，可向特区内设立的中国人民保险公司或者其他经我方批准设立的保险公司投保。",
      "order": 11
    },
    {
      "id": "law-29614e4167-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第二章注册和经营"
      ],
      "text": "特区企业的产品供国际市场销售；其产品如向我国内地销售，须经广东省经济特区管理委员会核准，并办理海关补税手续。",
      "order": 13
    },
    {
      "id": "law-29614e4167-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第二章注册和经营"
      ],
      "text": "客商在特区内可以独立经营自己的企业，雇用外籍人员担任技术和管理工作。",
      "order": 14
    },
    {
      "id": "law-29614e4167-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第二章注册和经营"
      ],
      "text": "客商在特区所办的企业中途停业，应向广东省经济特区管理委员会申报理由，办理停业手续，清理债权债务；停业后，其资产可转让，资金可汇出。",
      "order": 15
    },
    {
      "id": "law-29614e4167-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第三章优惠办法"
      ],
      "text": "特区的土地为中华人民共和国所有。客商用地，按实际需要提供，其使用年限、使用费数额和缴纳办法，根据不同行业和用途，给予优惠，具体办法另行规定。",
      "order": 17
    },
    {
      "id": "law-29614e4167-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第三章优惠办法"
      ],
      "text": "特区企业进口生产所必需的机器设备、零配件、原材料、运输工具和其他生产资料，免征进口税；对必需的生活用品、可以根据具体情况、分别征税或者减免进口税。上述物品进口和特区产品出口时，均应向海关办理申报手续。",
      "order": 18
    },
    {
      "id": "law-29614e4167-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第三章优惠办法"
      ],
      "text": "特区企业所得税税率为百分之十五。对在本条例公布后两年内投资兴办的企业，或者投资额达五百万美元以上的企业，或者技术性较高、资金周转期较长的企业，给予特别优惠待遇。",
      "order": 19
    },
    {
      "id": "law-29614e4167-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第三章优惠办法"
      ],
      "text": "客商在缴纳企业所得税后所得的合法利润，特区企业的外籍职工、华侨职工、港澳职工在缴纳个人所得税后的工资和其他正当收入，可以按照特区外汇管理办法的规定，通过特区内的中国银行或者其他银行汇出。",
      "order": 20
    },
    {
      "id": "law-29614e4167-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第三章优惠办法"
      ],
      "text": "客商将所得利润用于在特区内进行再投资为期五年以上者，可申请减免用于再投资部分的所得税。",
      "order": 21
    },
    {
      "id": "law-29614e4167-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第三章优惠办法"
      ],
      "text": "鼓励特区企业采用我国生产的机器设备、原材料和其他物资，其价格可按我国当时同类商品的出口价格给予优惠，以外汇结算。这些产品和物资，可凭售货单位的销售凭证直接运往特区。",
      "order": 22
    },
    {
      "id": "law-29614e4167-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第三章优惠办法"
      ],
      "text": "凡来往特区的外籍人员、华侨和港澳同胞，出入境均简化手续，给予方便。",
      "order": 23
    },
    {
      "id": "law-29614e4167-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第四章劳动管理"
      ],
      "text": "各特区设立劳动服务公司。特区企业雇用中国职员和工人，或者由当地劳动服务公司介绍，或者经广东省经济特区管理委员会同意由客商自行招聘，都由企业考核录用，同职工签订劳动合同。",
      "order": 25
    },
    {
      "id": "law-29614e4167-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第四章劳动管理"
      ],
      "text": "特区企业雇用的职工，由该企业按其经营的要求进行管理，必要时可以解雇，其手续按照劳动合同的规定办理。\n特区企业职工可按照劳动合同规定，向企业提请辞职。",
      "order": 26
    },
    {
      "id": "law-29614e4167-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第四章劳动管理"
      ],
      "text": "特区企业中的中国职工工资水平、工资形式、奖励办法，以及劳动保险、国家对职工的各项补贴，按照广东省经济特区管理委员会的规定，由企业同职工签订合同。",
      "order": 28
    },
    {
      "id": "law-29614e4167-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第四章劳动管理"
      ],
      "text": "特区企业应有必要的劳动保护措施，保证职工在安全、卫生的条件下进行工作。",
      "order": 29
    },
    {
      "id": "law-29614e4167-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第五章组织管理"
      ],
      "text": "广东省经济特区管理委员会行使以下职权：\n1.制订特区发展计划并组织实施；\n2.审核、批准客商在特区的投资项目；\n3.办理特区工商登记和土地核配；\n4.协调设在特区内的银行、保险、税务、海关、边检、邮电等机构的工作关系；\n5.为特区企业所需的职工提供来源，并保护职工的正当权益；\n6.举办特区教育、文化、卫生和各项公益事业；\n7.维护特区治安，依法保护特区内人身和财产不受侵犯。",
      "order": 31
    },
    {
      "id": "law-29614e4167-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第五章组织管理"
      ],
      "text": "深圳特区由广东省经济特区管理委员会直接经营管理；珠海、汕头特区设立必要的办事机构。",
      "order": 39
    },
    {
      "id": "law-29614e4167-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第五章组织管理"
      ],
      "text": "为适应特区经济活动的开展，设立广东省经济特区发展公司。公司业务范围：承办资金筹集和信托投资业务；经营或者与客商合资经营特区的有关企业；代理特区客商与内地贸易往来的购销事宜，并提供洽商服务。",
      "order": 40
    },
    {
      "id": "law-29614e4167-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第六章附则"
      ],
      "text": "本条例由广东省人民代表大会通过，并报中华人民共和国全国人民代表大会常务委员会批准后施行。",
      "order": 42
    }
  ]
}
