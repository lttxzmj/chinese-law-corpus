{
  "id": "xzfg-2da8931ae1",
  "officialId": "",
  "title": "中华人民共和国房产税暂行条例",
  "category": "行政法规",
  "issuingAuthority": "国务院",
  "promulgationDate": "2011-01-08",
  "effectiveDate": "",
  "status": "effective",
  "source": {
    "metadataPath": "data/laws/xzfg-2da8931ae1/metadata.json",
    "docxPath": "data/laws/xzfg-2da8931ae1/official.docx"
  },
  "paragraphCount": 21,
  "sectionCount": 0,
  "articleCount": 11,
  "sections": [],
  "articles": [
    {
      "id": "xzfg-2da8931ae1-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [],
      "text": "房产税在城市、县城、建制镇和工矿区征收。",
      "order": 1
    },
    {
      "id": "xzfg-2da8931ae1-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [],
      "text": "房产税由产权所有人缴纳。产权属于全民所有的，由经营管理的单位缴纳。产权出典的，由承典人缴纳。产权所有人、承典人不在房产所在地的，或者产权未确定及租典纠纷未解决的，由房产代管人或者使用人缴纳。\n前款列举的产权所有人、经营管理单位、承典人、房产代管人或者使用人，统称为纳税义务人(以下简称纳税人)。",
      "order": 2
    },
    {
      "id": "xzfg-2da8931ae1-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [],
      "text": "房产税依照房产原值一次减除10%至30%后的余值计算缴纳。具体减除幅度，由省、自治区、直辖市人民政府规定。\n没有房产原值作为依据的，由房产所在地税务机关参考同类房产核定。\n房产出租的，以房产租金收入为房产税的计税依据。",
      "order": 4
    },
    {
      "id": "xzfg-2da8931ae1-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [],
      "text": "房产税的税率，依照房产余值计算缴纳的，税率为1.2%；依照房产租金收入计算缴纳的，税率为12%。",
      "order": 7
    },
    {
      "id": "xzfg-2da8931ae1-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [],
      "text": "下列房产免纳房产税：\n一、国家机关、人民团体、军队自用的房产；\n二、由国家财政部门拨付事业经费的单位自用的房产；\n三、宗教寺庙、公园、名胜古迹自用的房产；\n四、个人所有非营业用的房产；\n五、经财政部批准免税的其他房产。",
      "order": 8
    },
    {
      "id": "xzfg-2da8931ae1-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [],
      "text": "除本条例第五条规定者外，纳税人纳税确有困难的，可由省、自治区、直辖市人民政府确定，定期减征或者免征房产税。",
      "order": 14
    },
    {
      "id": "xzfg-2da8931ae1-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [],
      "text": "房产税按年征收、分期缴纳。纳税期限由省、自治区、直辖市人民政府规定。",
      "order": 15
    },
    {
      "id": "xzfg-2da8931ae1-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [],
      "text": "房产税的征收管理，依照《中华人民共和国税收征收管理法》的规定办理。",
      "order": 16
    },
    {
      "id": "xzfg-2da8931ae1-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [],
      "text": "房产税由房产所在地的税务机关征收。",
      "order": 17
    },
    {
      "id": "xzfg-2da8931ae1-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [],
      "text": "本条例由财政部负责解释；施行细则由省、自治区、直辖市人民政府制定，抄送财政部备案。",
      "order": 18
    },
    {
      "id": "xzfg-2da8931ae1-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [],
      "text": "本条例自1986年10月1日起施行。",
      "order": 19
    }
  ]
}
