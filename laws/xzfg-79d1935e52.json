{
  "id": "xzfg-79d1935e52",
  "officialId": "国务院令第684号",
  "title": "无证无照经营查处办法",
  "category": "行政法规",
  "issuingAuthority": "国务院",
  "promulgationDate": "2017-08-06",
  "effectiveDate": "",
  "status": "effective",
  "source": {
    "metadataPath": "data/laws/xzfg-79d1935e52/metadata.json",
    "docxPath": "data/laws/xzfg-79d1935e52/official.docx"
  },
  "paragraphCount": 30,
  "sectionCount": 0,
  "articleCount": 19,
  "sections": [],
  "articles": [
    {
      "id": "xzfg-79d1935e52-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [],
      "text": "为了维护社会主义市场经济秩序，促进公平竞争，保护经营者和消费者的合法权益，制定本办法。",
      "order": 1
    },
    {
      "id": "xzfg-79d1935e52-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [],
      "text": "任何单位或者个人不得违反法律、法规、国务院决定的规定，从事无证无照经营。",
      "order": 2
    },
    {
      "id": "xzfg-79d1935e52-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [],
      "text": "下列经营活动，不属于无证无照经营：\n(一)在县级以上地方人民政府指定的场所和时间，销售农副产品、日常生活用品，或者个人利用自己的技能从事依法无须取得许可的便民劳务活动；\n(二)依照法律、行政法规、国务院决定的规定，从事无须取得许可或者办理注册登记的经营活动。",
      "order": 3
    },
    {
      "id": "xzfg-79d1935e52-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [],
      "text": "县级以上地方人民政府负责组织、协调本行政区域的无证无照经营查处工作，建立有关部门分工负责、协调配合的无证无照经营查处工作机制。",
      "order": 6
    },
    {
      "id": "xzfg-79d1935e52-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [],
      "text": "经营者未依法取得许可从事经营活动的，由法律、法规、国务院决定规定的部门予以查处；法律、法规、国务院决定没有规定或者规定不明确的，由省、自治区、直辖市人民政府确定的部门予以查处。",
      "order": 7
    },
    {
      "id": "xzfg-79d1935e52-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [],
      "text": "经营者未依法取得营业执照从事经营活动的，由履行工商行政管理职责的部门(以下称工商行政管理部门)予以查处。",
      "order": 8
    },
    {
      "id": "xzfg-79d1935e52-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [],
      "text": "经营者未依法取得许可且未依法取得营业执照从事经营活动的，依照本办法第五条的规定予以查处。",
      "order": 9
    },
    {
      "id": "xzfg-79d1935e52-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [],
      "text": "工商行政管理部门以及法律、法规、国务院决定规定的部门和省、自治区、直辖市人民政府确定的部门(以下统称查处部门)应当依法履行职责，密切协同配合，利用信息网络平台加强信息共享；发现不属于本部门查处职责的无证无照经营，应当及时通报有关部门。",
      "order": 10
    },
    {
      "id": "xzfg-79d1935e52-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [],
      "text": "任何单位或者个人有权向查处部门举报无证无照经营。\n查处部门应当向社会公开受理举报的电话、信箱或者电子邮件地址，并安排人员受理举报，依法予以处理。对实名举报的，查处部门应当告知处理结果，并为举报人保密。",
      "order": 11
    },
    {
      "id": "xzfg-79d1935e52-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [],
      "text": "查处部门依法查处无证无照经营，应当坚持查处与引导相结合、处罚与教育相结合的原则，对具备办理证照的法定条件、经营者有继续经营意愿的，应当督促、引导其依法办理相应证照。",
      "order": 13
    },
    {
      "id": "xzfg-79d1935e52-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [],
      "text": "县级以上人民政府工商行政管理部门对涉嫌无照经营进行查处，可以行使下列职权：\n(一)责令停止相关经营活动；\n(二)向与涉嫌无照经营有关的单位和个人调查了解有关情况；\n(三)进入涉嫌从事无照经营的场所实施现场检查；\n(四)查阅、复制与涉嫌无照经营有关的合同、票据、账簿以及其他有关资料。\n对涉嫌从事无照经营的场所，可以予以查封；对涉嫌用于无照经营的工具、设备、原材料、产品(商品)等物品，可以予以查封、扣押。\n对涉嫌无证经营进行查处，依照相关法律、法规的规定采取措施。",
      "order": 14
    },
    {
      "id": "xzfg-79d1935e52-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [],
      "text": "从事无证经营的，由查处部门依照相关法律、法规的规定予以处罚。",
      "order": 21
    },
    {
      "id": "xzfg-79d1935e52-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [],
      "text": "从事无照经营的，由工商行政管理部门依照相关法律、行政法规的规定予以处罚。法律、行政法规对无照经营的处罚没有明确规定的，由工商行政管理部门责令停止违法行为，没收违法所得，并处1万元以下的罚款。",
      "order": 22
    },
    {
      "id": "xzfg-79d1935e52-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [],
      "text": "明知属于无照经营而为经营者提供经营场所，或者提供运输、保管、仓储等条件的，由工商行政管理部门责令停止违法行为，没收违法所得，可以处5000元以下的罚款。",
      "order": 23
    },
    {
      "id": "xzfg-79d1935e52-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [],
      "text": "任何单位或者个人从事无证无照经营的，由查处部门记入信用记录，并依照相关法律、法规的规定予以公示。",
      "order": 24
    },
    {
      "id": "xzfg-79d1935e52-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [],
      "text": "妨害查处部门查处无证无照经营，构成违反治安管理行为的，由公安机关依照《中华人民共和国治安管理处罚法》的规定予以处罚。",
      "order": 25
    },
    {
      "id": "xzfg-79d1935e52-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [],
      "text": "查处部门及其工作人员滥用职权、玩忽职守、徇私舞弊的，对负有责任的领导人员和直接责任人员依法给予处分。",
      "order": 26
    },
    {
      "id": "xzfg-79d1935e52-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [],
      "text": "违反本办法规定，构成犯罪的，依法追究刑事责任。",
      "order": 27
    },
    {
      "id": "xzfg-79d1935e52-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [],
      "text": "本办法自2017年10月1日起施行。2003年1月6日国务院公布的《无照经营查处取缔办法》同时废止。",
      "order": 28
    }
  ]
}
