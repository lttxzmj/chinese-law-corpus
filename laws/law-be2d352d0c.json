  "articles": [
    {
      "id": "law-be2d352d0c-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了有效地组织人民防空，保护人民的生命和财产安全，保障社会主义现代化建设的顺利进行，制定本法。",
      "order": 2
    },
    {
      "id": "law-be2d352d0c-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "人民防空是国防的组成部分。国家根据国防需要，动员和组织群众采取防护措施，防范和减轻空袭危害。\n人民防空实行长期准备、重点建设、平战结合的方针，贯彻与经济建设协调发展、与城市建设相结合的原则。",
      "order": 3
    },
    {
      "id": "law-be2d352d0c-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "县级以上人民政府应当将人民防空建设纳入国民经济和社会发展计划。",
      "order": 5
    },
    {
      "id": "law-be2d352d0c-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "人民防空经费由国家和社会共同负担。\n中央负担的人民防空经费，列入中央预算；县级以上地方各级人民政府负担的人民防空经费，列入地方各级预算。\n有关单位应当按照国家规定负担人民防空费用。",
      "order": 6
    },
    {
      "id": "law-be2d352d0c-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "国家对人民防空设施建设按照有关规定给予优惠。\n国家鼓励、支持企业事业组织、社会团体和个人，通过多种途径，投资进行人民防空工程建设；人民防空工程平时由投资者使用管理，收益归投资者所有。",
      "order": 9
    },
    {
      "id": "law-be2d352d0c-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第一章总则"
      ],
      "text": "国务院、中央军事委员会领导全国的人民防空工作。\n大军区根据国务院、中央军事委员会的授权领导本区域的人民防空工作。\n县级以上地方各级人民政府和同级军事机关领导本行政区域的人民防空工作。",
      "order": 11
    },
    {
      "id": "law-be2d352d0c-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第一章总则"
      ],
      "text": "国家人民防空主管部门管理全国的人民防空工作。\n大军区人民防空主管部门管理本区域的人民防空工作。\n县级以上地方各级人民政府人民防空主管部门管理本行政区域的人民防空工作。\n中央国家机关人民防空主管部门管理中央国家机关的人民防空工作。\n人民防空主管部门的设置、职责和任务，由国务院、中央军事委员会规定。\n县级以上人民政府的计划、规划、建设等有关部门在各自的职责范围内负责有关的人民防空工作。",
      "order": 14
    },
    {
      "id": "law-be2d352d0c-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第一章总则"
      ],
      "text": "一切组织和个人都有得到人民防空保护的权利，都必须依法履行人民防空的义务。",
      "order": 20
    },
    {
      "id": "law-be2d352d0c-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第一章总则"
      ],
      "text": "国家保护人民防空设施不受侵害。禁止任何组织或者个人破坏、侵占人民防空设施。",
      "order": 21
    },
    {
      "id": "law-be2d352d0c-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第一章总则"
      ],
      "text": "县级以上人民政府和军事机关对在人民防空工作中做出显著成绩的组织或者个人，给予奖励。",
      "order": 22
    },
    {
      "id": "law-be2d352d0c-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第二章防护重点"
      ],
      "text": "城市是人民防空的重点。国家对城市实行分类防护。\n城市的防护类别、防护标准，由国务院、中央军事委员会规定。",
      "order": 24
    },
    {
      "id": "law-be2d352d0c-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第二章防护重点"
      ],
      "text": "城市人民政府应当制定防空袭方案及实施计划，必要时可以组织演习。",
      "order": 26
    },
    {
      "id": "law-be2d352d0c-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第二章防护重点"
      ],
      "text": "城市人民政府应当制定人民防空工程建设规划，并纳入城市总体规划。",
      "order": 27
    },
    {
      "id": "law-be2d352d0c-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第二章防护重点"
      ],
      "text": "城市的地下交通干线以及其他地下工程的建设，应当兼顾人民防空需要。",
      "order": 28
    },
    {
      "id": "law-be2d352d0c-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第二章防护重点"
      ],
      "text": "为战时储备粮食、医药、油料和其他必需物资的工程，应当建在地下或者其他隐蔽地点。",
      "order": 29
    },
    {
      "id": "law-be2d352d0c-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第二章防护重点"
      ],
      "text": "对重要的经济目标，有关部门必须采取有效防护措施，并制定应急抢险抢修方案。\n前款所称重要的经济目标，包括重要的工矿企业、科研基地、交通枢纽、通信枢纽、桥梁、水库、仓库、电站等。",
      "order": 30
    },
    {
      "id": "law-be2d352d0c-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第二章防护重点"
      ],
      "text": "人民防空主管部门应当依照规定对城市和经济目标的人民防空建设进行监督检查。被检查单位应当如实提供情况和必要的资料。",
      "order": 32
    },
    {
      "id": "law-be2d352d0c-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第三章人民防空工程"
      ],
      "text": "人民防空工程包括为保障战时人员与物资掩蔽、人民防空指挥、医疗救护等而单独修建的地下防护建筑，以及结合地面建筑修建的战时可用于防空的地下室。",
      "order": 34
    },
    {
      "id": "law-be2d352d0c-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第三章人民防空工程"
      ],
      "text": "国家对人民防空工程建设，按照不同的防护要求，实行分类指导。\n国家根据国防建设的需要，结合城市建设和经济发展水平，制定人民防空工程建设规划。",
      "order": 35
    },
    {
      "id": "law-be2d352d0c-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第三章人民防空工程"
      ],
      "text": "建设人民防空工程，应当在保证战时使用效能的前提下，有利于平时的经济建设、群众的生产生活和工程的开发利用。",
      "order": 37
    },
    {
      "id": "law-be2d352d0c-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第三章人民防空工程"
      ],
      "text": "人民防空指挥工程、公用的人员掩蔽工程和疏散干道工程由人民防空主管部门负责组织修建；医疗救护、物资储备等专用工程由其他有关部门负责组织修建。\n有关单位负责修建本单位的人员与物资掩蔽工程。",
      "order": 38
    },
    {
      "id": "law-be2d352d0c-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第三章人民防空工程"
      ],
      "text": "城市新建民用建筑，按照国家有关规定修建战时可用于防空的地下室。",
      "order": 40
    },
    {
      "id": "law-be2d352d0c-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第三章人民防空工程"
      ],
      "text": "人民防空工程建设的设计、施工、质量必须符合国家规定的防护标准和质量标准。\n人民防空工程专用设备的定型、生产必须符合国家规定的标准。",
      "order": 41
    },
    {
      "id": "law-be2d352d0c-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第三章人民防空工程"
      ],
      "text": "县级以上人民政府有关部门对人民防空工程所需的建设用地应当依法予以保障；对人民防空工程连接城市的道路、供电、供热、供水、排水、通信等系统的设施建设，应当提供必要的条件。",
      "order": 43
    },
    {
      "id": "law-be2d352d0c-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第三章人民防空工程"
      ],
      "text": "人民防空主管部门对人民防空工程的维护管理进行监督检查。\n公用的人民防空工程的维护管理由人民防空主管部门负责。\n有关单位应当按照国家规定对已经修建或者使用的人民防空工程进行维护管理，使其保持良好使用状态。",
      "order": 44
    },
    {
      "id": "law-be2d352d0c-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第三章人民防空工程"
      ],
      "text": "国家鼓励平时利用人民防空工程为经济建设和人民生活服务。平时利用人民防空工程，不得影响其防空效能。",
      "order": 47
    },
    {
      "id": "law-be2d352d0c-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第三章人民防空工程"
      ],
      "text": "任何组织或者个人不得进行影响人民防空工程使用或者降低人民防空工程防护能力的作业，不得向人民防空工程内排入废水、废气和倾倒废弃物，不得在人民防空工程内生产、储存爆炸、剧毒、易燃、放射性和腐蚀性物品。",
      "order": 48
    },
    {
      "id": "law-be2d352d0c-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第三章人民防空工程"
      ],
      "text": "任何组织或者个人不得擅自拆除本法第二十一条规定的人民防空工程；确需拆除的，必须报经人民防空主管部门批准，并由拆除单位负责补建或者补偿。",
      "order": 49
    },
    {
      "id": "law-be2d352d0c-0029",
      "articleNumber": 29,
      "displayNumber": "第二十九条",
      "path": [
        "第四章通信和警报"
      ],
      "text": "国家保障人民防空通信、警报的畅通，以迅速准确地传递、发放防空警报信号，有效地组织、指挥人民防空。",
      "order": 51
    },
    {
      "id": "law-be2d352d0c-0030",
      "articleNumber": 30,
      "displayNumber": "第三十条",
      "path": [
        "第四章通信和警报"
      ],
      "text": "国家人民防空主管部门负责制定全国的人民防空通信、警报建设规划，组织全国的人民防空通信、警报网的建设和管理。\n县级以上地方各级人民政府人民防空主管部门负责制定本行政区域的人民防空通信、警报建设规划，组织本行政区域人民防空通信、警报网的建设和管理。",
      "order": 52
    },
    {
      "id": "law-be2d352d0c-0031",
      "articleNumber": 31,
      "displayNumber": "第三十一条",
      "path": [
        "第四章通信和警报"
      ],
      "text": "邮电部门、军队通信部门和人民防空主管部门应当按照国家规定的任务和人民防空通信、警报建设规划，对人民防空通信实施保障。",
      "order": 54
    },
    {
      "id": "law-be2d352d0c-0032",
      "articleNumber": 32,
      "displayNumber": "第三十二条",
      "path": [
        "第四章通信和警报"
      ],
      "text": "人民防空主管部门建设通信、警报网所需的电路、频率，邮电部门、军队通信部门、无线电管理机构应当予以保障；安装人民防空通信、警报设施，有关单位或者个人应当提供方便条件，不得阻挠。\n国家用于人民防空通信的专用频率和防空警报音响信号，任何组织或者个人不得占用、混同。",
      "order": 55
    },
    {
      "id": "law-be2d352d0c-0033",
      "articleNumber": 33,
      "displayNumber": "第三十三条",
      "path": [
        "第四章通信和警报"
      ],
      "text": "通信、广播、电视系统，战时必须优先传递、发放防空警报信号。",
      "order": 57
    },
    {
      "id": "law-be2d352d0c-0034",
      "articleNumber": 34,
      "displayNumber": "第三十四条",
      "path": [
        "第四章通信和警报"
      ],
      "text": "军队有关部门应当向人民防空主管部门通报空中情报，协助训练有关专业人员。",
      "order": 58
    },
    {
      "id": "law-be2d352d0c-0035",
      "articleNumber": 35,
      "displayNumber": "第三十五条",
      "path": [
        "第四章通信和警报"
      ],
      "text": "人民防空通信、警报设施必须保持良好使用状态。\n设置在有关单位的人民防空警报设施，由其所在单位维护管理，不得擅自拆除。\n县级以上地方各级人民政府根据需要可以组织试鸣防空警报；并在试鸣的五日以前发布公告。",
      "order": 59
    },
    {
      "id": "law-be2d352d0c-0036",
      "articleNumber": 36,
      "displayNumber": "第三十六条",
      "path": [
        "第四章通信和警报"
      ],
      "text": "人民防空通信、警报设施平时应当为抢险救灾服务。",
      "order": 62
    },
    {
      "id": "law-be2d352d0c-0037",
      "articleNumber": 37,
      "displayNumber": "第三十七条",
      "path": [
        "第五章疏散"
      ],
      "text": "人民防空疏散由县级以上人民政府统一组织。\n人民防空疏散必须根据国家发布的命令实施，任何组织不得擅自行动。",
      "order": 64
    },
    {
      "id": "law-be2d352d0c-0038",
      "articleNumber": 38,
      "displayNumber": "第三十八条",
      "path": [
        "第五章疏散"
      ],
      "text": "城市人民防空疏散计划，由县级以上人民政府根据需要组织有关部门制定。\n预定的疏散地区，在本行政区域内的，由本级人民政府确定；跨越本行政区域的，由上一级人民政府确定。",
      "order": 66
    },
    {
      "id": "law-be2d352d0c-0039",
      "articleNumber": 39,
      "displayNumber": "第三十九条",
      "path": [
        "第五章疏散"
      ],
      "text": "县级以上人民政府应当组织有关部门和单位，做好城市疏散人口安置和物资储运、供应的准备工作。",
      "order": 68
    },
    {
      "id": "law-be2d352d0c-0040",
      "articleNumber": 40,
      "displayNumber": "第四十条",
      "path": [
        "第五章疏散"
      ],
      "text": "农村人口在有必要疏散时，由当地人民政府按照就近的原则组织实施。",
      "order": 69
    },
    {
      "id": "law-be2d352d0c-0041",
      "articleNumber": 41,
      "displayNumber": "第四十一条",
      "path": [
        "第六章群众防空组织"
      ],
      "text": "县级以上地方各级人民政府应当根据人民防空的需要，组织有关部门建立群众防空组织。\n群众防空组织战时担负抢险抢修、医疗救护、防火灭火、防疫灭菌、消毒和消除沾染、保障通信联络、抢救人员和抢运物资、维护社会治安等任务，平时应当协助防汛、防震等部门担负抢险救灾任务。",
      "order": 71
    },
    {
      "id": "law-be2d352d0c-0042",
      "articleNumber": 42,
      "displayNumber": "第四十二条",
      "path": [
        "第六章群众防空组织"
      ],
      "text": "群众防空组织由下列部门负责组建：\n（一）城建、公用、电力等部门组建抢险抢修队；\n（二）卫生、医药部门组建医疗救护队；\n（三）公安部门组建消防队、治安队；\n（四）卫生、化工、环保等部门组建防化防疫队；\n（五）邮电部门组建通信队；\n（六）交通运输部门组建运输队。\n红十字会组织依法进行救护工作。",
      "order": 73
    },
    {
      "id": "law-be2d352d0c-0043",
      "articleNumber": 43,
      "displayNumber": "第四十三条",
      "path": [
        "第六章群众防空组织"
      ],
      "text": "群众防空组织所需装备、器材和经费由人民防空主管部门和组建单位提供。",
      "order": 81
    },
    {
      "id": "law-be2d352d0c-0044",
      "articleNumber": 44,
      "displayNumber": "第四十四条",
      "path": [
        "第六章群众防空组织"
      ],
      "text": "群众防空组织应当根据人民防空主管部门制定的训练大纲和训练计划进行专业训练。",
      "order": 82
    },
    {
      "id": "law-be2d352d0c-0045",
      "articleNumber": 45,
      "displayNumber": "第四十五条",
      "path": [
        "第七章人民防空教育"
      ],
      "text": "国家开展人民防空教育，使公民增强国防观念，掌握人民防空的基本知识和技能。",
      "order": 84
    },
    {
      "id": "law-be2d352d0c-0046",
      "articleNumber": 46,
      "displayNumber": "第四十六条",
      "path": [
        "第七章人民防空教育"
      ],
      "text": "国家人民防空主管部门负责组织制定人民防空教育计划，规定教育内容。\n在校学生的人民防空教育，由各级教育主管部门和人民防空主管部门组织实施。\n国家机关、社会团体、企业事业组织人员的人民防空教育，由所在单位组织实施；其他人员的人民防空教育，由城乡基层人民政府组织实施。",
      "order": 85
    },
    {
      "id": "law-be2d352d0c-0047",
      "articleNumber": 47,
      "displayNumber": "第四十七条",
      "path": [
        "第七章人民防空教育"
      ],
      "text": "新闻、出版、广播、电影、电视、文化等有关部门应当协助开展人民防空教育。",
      "order": 88
    },
    {
      "id": "law-be2d352d0c-0048",
      "articleNumber": 48,
      "displayNumber": "第四十八条",
      "path": [
        "第八章法律责任"
      ],
      "text": "城市新建民用建筑，违反国家有关规定不修建战时可用于防空的地下室的，由县级以上人民政府人民防空主管部门对当事人给予警告，并责令限期修建，可以并处十万元以下的罚款。",
      "order": 90
    },
    {
      "id": "law-be2d352d0c-0049",
      "articleNumber": 49,
      "displayNumber": "第四十九条",
      "path": [
        "第八章法律责任"
      ],
      "text": "有下列行为之一的，由县级以上人民政府人民防空主管部门对当事人给予警告，并责令限期改正违法行为，可以对个人并处五千元以下的罚款、对单位并处一万元至五万元的罚款；造成损失的，应当依法赔偿损失：\n（一）侵占人民防空工程的；\n（二）不按照国家规定的防护标准和质量标准修建人民防空工程的；\n（三）违反国家有关规定，改变人民防空工程主体结构、拆除人民防空工程设备设施或者采用其他方法危害人民防空工程的安全和使用效能的；\n（四）拆除人民防空工程后拒不补建的；\n（五）占用人民防空通信专用频率、使用与防空警报相同的音响信号或者擅自拆除人民防空通信、警报设备设施的；\n（六）阻挠安装人民防空通信、警报设施，拒不改正的；\n（七）向人民防空工程内排入废水、废气或者倾倒废弃物的。",
      "order": 91
    },
    {
      "id": "law-be2d352d0c-0050",
      "articleNumber": 50,
      "displayNumber": "第五十条",
      "path": [
        "第八章法律责任"
      ],
      "text": "违反本法规定，故意损坏人民防空设施或者在人民防空工程内生产、储存爆炸、剧毒、易燃、放射性等危险品，尚不构成犯罪的，依照治安管理处罚法的有关规定处罚；构成犯罪的，依法追究刑事责任。",
      "order": 99
    },
    {
      "id": "law-be2d352d0c-0051",
      "articleNumber": 51,
      "displayNumber": "第五十一条",
      "path": [
        "第八章法律责任"
      ],
      "text": "人民防空主管部门的工作人员玩忽职守、滥用职权、徇私舞弊或者有其他违法、失职行为构成犯罪的，依法追究刑事责任；尚不构成犯罪的，依法给予行政处分。",
      "order": 100
    },
    {
      "id": "law-be2d352d0c-0052",
      "articleNumber": 52,
      "displayNumber": "第五十二条",
      "path": [
        "第九章附则"
      ],
      "text": "省、自治区、直辖市人民代表大会常务委员会可以根据本法制定实施办法。",
      "order": 102
    },
    {
      "id": "law-be2d352d0c-0053",
      "articleNumber": 53,
      "displayNumber": "第五十三条",
      "path": [
        "第九章附则"
      ],
      "text": "本法自1997年1月1日起施行。",
      "order": 103
    }
  ]
}
