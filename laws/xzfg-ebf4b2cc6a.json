  ],
  "articles": [
    {
      "id": "xzfg-ebf4b2cc6a-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了加强民兵武器装备管理，保障民兵完成作战、执勤、训练等项任务，制定本条例。",
      "order": 2
    },
    {
      "id": "xzfg-ebf4b2cc6a-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "本条例所称民兵武器装备，是指配备给民兵使用和储存的武器、弹药和军事技术器材。",
      "order": 3
    },
    {
      "id": "xzfg-ebf4b2cc6a-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "民兵武器装备管理工作的基本任务是保证民兵武器装备经常处于良好的技术状态，防止发生丢失、被盗等事故，确保安全，保障民兵能随时用于执行任务。",
      "order": 4
    },
    {
      "id": "xzfg-ebf4b2cc6a-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "全国的民兵武器装备管理工作在国务院、中央军事委员会领导下，由中国人民解放军总参谋部(以下简称总参谋部)主管。\n军区、省军区(含卫戍区、警备区，下同)、军分区(含警备区，下同)、县(含自治县、不设区的市、市辖区，下同)人民武装部和乡(含民族乡、镇，下同)人民武装部、企业事业单位人民武装部，负责本地区或者本单位的民兵武器装备管理工作。",
      "order": 5
    },
    {
      "id": "xzfg-ebf4b2cc6a-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "地方各级人民政府必须加强对民兵武器装备管理工作的领导，督促有关单位做好民兵武器装备管理工作。\n地方各级人民政府有关部门，应当协助军事机关做好民兵武器装备管理工作，解决有关问题。\n企业事业单位应当按照当地人民政府和本地区军事机关的要求，把民兵武器装备管理工作纳入管理计划，做好各项工作。",
      "order": 7
    },
    {
      "id": "xzfg-ebf4b2cc6a-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第一章总则"
      ],
      "text": "民兵武器装备管理，应当贯彻艰苦奋斗、勤俭建军的方针，实行管理科学化、制度化，管好现有武器装备，立足于民兵使用现有武器装备完成各项任务。",
      "order": 10
    },
    {
      "id": "xzfg-ebf4b2cc6a-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第二章职责与分工"
      ],
      "text": "军区、省军区、军分区、县人民武装部、乡人民武装部、企业事业单位人民武装部管理民兵武器装备，履行下列职责：\n(一)根据本条例和上级军事机关有关民兵武器装备管理的规定，制定本地区或者本单位民兵武器装备管理的规章制度；\n(二)组织、督促所属单位和人员执行民兵武器装备管理法规和规章制度，建立和保持良好的管理秩序；\n(三)选配和培训民兵武器装备看管人员和技术人员；\n(四)教育民兵武器装备的看管人员和使用人员管好用好武器装备；\n(五)做好民兵武器装备的安全和防止事故工作；\n(六)掌握民兵武器装备管理情况，及时报告并解决管理中的问题；\n(七)完成上级军事机关赋予的与民兵武器装备管理有关的其他工作。",
      "order": 12
    },
    {
      "id": "xzfg-ebf4b2cc6a-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第二章职责与分工"
      ],
      "text": "民兵武器装备的看管人员和使用人员应当履行下列职责：\n(一)遵守民兵武器装备管理法规和规章制度；\n(二)熟悉民兵武器装备性能，做到会使用、会保养、会检查、会排除一般故障；\n(三)保守民兵武器装备秘密；\n(四)做好民兵武器装备的安全和防止事故工作；\n(五)看管和使用民兵武器装备的其他有关职责。",
      "order": 20
    },
    {
      "id": "xzfg-ebf4b2cc6a-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第二章职责与分工"
      ],
      "text": "民兵武器装备的配备、补充、调整、动用、封存等组织计划工作，由军事机关司令部门负责。",
      "order": 26
    },
    {
      "id": "xzfg-ebf4b2cc6a-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第二章职责与分工"
      ],
      "text": "民兵武器装备的储存保管、技术鉴定、维护修理等技术管理工作，按照职责分工，由军事机关的司令部门或者装备技术部门负责。",
      "order": 27
    },
    {
      "id": "xzfg-ebf4b2cc6a-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第三章配备与补充"
      ],
      "text": "民兵武器装备的配备与补充，由总参谋部统一规划。军区、省军区、军分区和县人民武装部，根据上级的规划，制定本地区的配备与补充计划，并组织实施。",
      "order": 29
    },
    {
      "id": "xzfg-ebf4b2cc6a-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第三章配备与补充"
      ],
      "text": "民兵武器装备的配备，应当根据基干民兵的组建计划和战备、执勤、训练等项任务的需要，做到保障重点，合理布局。",
      "order": 30
    },
    {
      "id": "xzfg-ebf4b2cc6a-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第三章配备与补充"
      ],
      "text": "民兵配属部队执行作战、支前任务所需的武器装备，由县人民武装部配发；到达部队后，由所在部队按照损耗补充。",
      "order": 31
    },
    {
      "id": "xzfg-ebf4b2cc6a-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第三章配备与补充"
      ],
      "text": "民兵武器装备的调整，按照管辖范围，分别由县人民武装部、军分区、省军区、军区批准；超出管辖范围的，由上级军事机关批准；调出民兵系统的，由总参谋部批准。",
      "order": 32
    },
    {
      "id": "xzfg-ebf4b2cc6a-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第三章配备与补充"
      ],
      "text": "民兵武器装备的制造、装配、接收、购置，必须经总参谋部批准。",
      "order": 33
    },
    {
      "id": "xzfg-ebf4b2cc6a-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第四章保管与使用"
      ],
      "text": "民兵武器装备的保管，应当符合技术和战备、安全的要求，建立健全值班、交接、登记、检查、保养等制度，做到无丢失、无损坏、无锈蚀、无霉烂变质。\n武器、弹药应当分开存放。",
      "order": 35
    },
    {
      "id": "xzfg-ebf4b2cc6a-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第四章保管与使用"
      ],
      "text": "民兵武器装备，应当集中在县以上民兵武器装备仓库保管；因战备、值勤的需要，经省军区批准，可以由乡人民武装部、企业事业单位或者民兵值勤点保管。\n配备给乡、企业事业单位的高射机枪和火炮，由乡人民武装部、企业事业单位保管。",
      "order": 37
    },
    {
      "id": "xzfg-ebf4b2cc6a-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第四章保管与使用"
      ],
      "text": "省军区、军分区民兵武器装备仓库的管理，除依照本条例执行外，并应当执行中国人民解放军军械仓库业务管理的有关规定；县以下民兵武器装备仓库的管理，除依照本条例执行外，并应当执行上级军事机关的有关规定。",
      "order": 39
    },
    {
      "id": "xzfg-ebf4b2cc6a-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第四章保管与使用"
      ],
      "text": "保管民兵武器装备的乡人民武装部、企业事业单位必须有牢固的库房、枪柜(箱、架)和可靠的安全设施，配备专职看管人员。",
      "order": 40
    },
    {
      "id": "xzfg-ebf4b2cc6a-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第四章保管与使用"
      ],
      "text": "民兵武器装备仓库是国家的军事设施，地方各级人民政府和军事机关应当依照《中华人民共和国军事设施保护法》做好保护工作。",
      "order": 41
    },
    {
      "id": "xzfg-ebf4b2cc6a-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第四章保管与使用"
      ],
      "text": "掌握武器装备的民兵和民兵武器装备仓库的看管人员，应当由人民武装部门按照有关规定审查批准，并报上一级军事机关备案。",
      "order": 42
    },
    {
      "id": "xzfg-ebf4b2cc6a-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第四章保管与使用"
      ],
      "text": "省军区、军分区和县、乡人民武装部民兵武器装备仓库的新建、扩建和改建，应当纳入地方基本建设计划统筹安排，所需经费由同级人民政府解决。企业事业单位民兵武器装备仓库的修建和改建所需的经费，按照国家有关规定解决。\n省军区、军分区民兵武器装备仓库的职工工资、公务事业费和福利费等，从国防费中开支；县民兵武器装备仓库的维修费、业务费和职工工资等，按照国家的有关规定执行。",
      "order": 43
    },
    {
      "id": "xzfg-ebf4b2cc6a-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第四章保管与使用"
      ],
      "text": "平时启用封存的民兵武器装备，应当经过批准。启用简易封存的民兵武器装备，由军分区以上军事机关批准；启用新品和长期封存的民兵武器装备，由省军区以上军事机关批准。",
      "order": 45
    },
    {
      "id": "xzfg-ebf4b2cc6a-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第四章保管与使用"
      ],
      "text": "高等院校学生军事训练用的教练枪，应当按照规定经过批准，由当地县人民武装部提供，由院校负责保管。\n学生军事训练用的教练枪，必须经过技术处理，使其不能用于实弹射击。",
      "order": 46
    },
    {
      "id": "xzfg-ebf4b2cc6a-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第四章保管与使用"
      ],
      "text": "高等院校、高级中学和相当于高级中学的学校学生军事训练所需的实弹射击用枪，由当地县人民武装部提供并负责管理。",
      "order": 48
    },
    {
      "id": "xzfg-ebf4b2cc6a-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第四章保管与使用"
      ],
      "text": "民兵配合部队执行任务或者配合公安机关维护社会治安，需要动用民兵武器装备时，应当按照有关规定执行。",
      "order": 49
    },
    {
      "id": "xzfg-ebf4b2cc6a-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第四章保管与使用"
      ],
      "text": "民兵武器装备，不得擅自借出。因执勤、训练需要借用配发给民兵或者民兵组织的武器装备的，必须报经县人民武装部批准。借用县以上民兵武器装备仓库保管的民兵武器装备，必须报上一级军事机关批准。",
      "order": 50
    },
    {
      "id": "xzfg-ebf4b2cc6a-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第四章保管与使用"
      ],
      "text": "保管与使用民兵武器、弹药的，必须遵守下列规定：\n(一)不准随意射击、投掷；\n(二)不准用与武器非配用的弹药射击；\n(三)不准持武器、弹药打闹；\n(四)不准随意拆卸武器、弹药和改变其性能；\n(五)不准擅自借出武器、弹药；\n(六)不准擅自动用武器、弹药打猎；\n(七)不准擅自携带武器、弹药；\n(八)不准动用武器、弹药参加械斗和参与处理民间纠纷。",
      "order": 51
    },
    {
      "id": "xzfg-ebf4b2cc6a-0029",
      "articleNumber": 29,
      "displayNumber": "第二十九条",
      "path": [
        "第四章保管与使用"
      ],
      "text": "因执行任务需要，按照规定配发给个人的民兵武器、弹药，实行持枪证和持枪通行证制度。持枪证和持枪通行证式样及使用办法，由总参谋部规定。",
      "order": 60
    },
    {
      "id": "xzfg-ebf4b2cc6a-0030",
      "articleNumber": 30,
      "displayNumber": "第三十条",
      "path": [
        "第四章保管与使用"
      ],
      "text": "民兵弹药的使用，应当执行用旧存新、用零存整的原则。军事训练、武器修理、试验等剩余的弹药，必须交回县以上民兵武器装备仓库保管，列入本年度装备实力统计，任何单位或者个人不得私自留存。",
      "order": 61
    },
    {
      "id": "xzfg-ebf4b2cc6a-0031",
      "articleNumber": 31,
      "displayNumber": "第三十一条",
      "path": [
        "第四章保管与使用"
      ],
      "text": "民兵、学生军事训练所需弹药，由总参谋部规定标准和下达指标，逐级进行分配。",
      "order": 62
    },
    {
      "id": "xzfg-ebf4b2cc6a-0032",
      "articleNumber": 32,
      "displayNumber": "第三十二条",
      "path": [
        "第四章保管与使用"
      ],
      "text": "经中央军事委员会或者总参谋部批准，民兵为外国人进行军事表演所需弹药，由省军区拨给。",
      "order": 63
    },
    {
      "id": "xzfg-ebf4b2cc6a-0033",
      "articleNumber": 33,
      "displayNumber": "第三十三条",
      "path": [
        "第四章保管与使用"
      ],
      "text": "修理、试验民兵武器和进行试验、化验所需要的弹药，按照中国人民解放军有关标准执行，由省军区装备技术部批准拨给；未设装备技术部的，由司令部批准拨给。",
      "order": 64
    },
    {
      "id": "xzfg-ebf4b2cc6a-0034",
      "articleNumber": 34,
      "displayNumber": "第三十四条",
      "path": [
        "第四章保管与使用"
      ],
      "text": "严禁挪用、出租、交换民兵武器装备。\n未经中央军事委员会或者总参谋部批准，不得馈赠、出售民兵武器装备。",
      "order": 65
    },
    {
      "id": "xzfg-ebf4b2cc6a-0035",
      "articleNumber": 35,
      "displayNumber": "第三十五条",
      "path": [
        "第四章保管与使用"
      ],
      "text": "未经总参谋部批准，不得动用民兵武器装备从事生产经营活动。",
      "order": 67
    },
    {
      "id": "xzfg-ebf4b2cc6a-0036",
      "articleNumber": 36,
      "displayNumber": "第三十六条",
      "path": [
        "第四章保管与使用"
      ],
      "text": "发生民兵武器装备丢失、被盗等事故时，应当立即向当地军事机关和人民政府报告，并迅速处理。\n军事机关必须及时逐级上报总参谋部。",
      "order": 68
    },
    {
      "id": "xzfg-ebf4b2cc6a-0037",
      "articleNumber": 37,
      "displayNumber": "第三十七条",
      "path": [
        "第五章修理与报废"
      ],
      "text": "县人民武装部负责修理其管理的民兵武器装备，企业事业单位负责修理其保管的民兵武器装备；无力修理的，由军分区、省军区、军区修械所(厂)修理。其中，弹药的修理，由省军区民兵武器装备仓库负责；无力修理的，由军区司令部门安排修理。\n民兵武器装备维修所需的经费，从民兵事业费的装备管理维修费中开支。",
      "order": 71
    },
    {
      "id": "xzfg-ebf4b2cc6a-0038",
      "articleNumber": 38,
      "displayNumber": "第三十八条",
      "path": [
        "第五章修理与报废"
      ],
      "text": "军分区、省军区修械所负责修理民兵武器装备和军分区、省军区直属分队的武器装备。其职工工资、公务事业费和福利费等从国防费中开支。",
      "order": 73
    },
    {
      "id": "xzfg-ebf4b2cc6a-0039",
      "articleNumber": 39,
      "displayNumber": "第三十九条",
      "path": [
        "第五章修理与报废"
      ],
      "text": "民兵武器装备的分级和转级，按照中国人民解放军有关规定执行。",
      "order": 74
    },
    {
      "id": "xzfg-ebf4b2cc6a-0040",
      "articleNumber": 40,
      "displayNumber": "第四十条",
      "path": [
        "第五章修理与报废"
      ],
      "text": "民兵武器装备的报废，应当经过批准。报废的批准和处理权限，由总参谋部规定。\n民兵武器装备的报废处理规则，按照中国人民解放军有关规定执行。\n有重要历史意义的民兵武器装备，应当妥善保管，不得自行处理。",
      "order": 75
    },
    {
      "id": "xzfg-ebf4b2cc6a-0041",
      "articleNumber": 41,
      "displayNumber": "第四十一条",
      "path": [
        "第五章修理与报废"
      ],
      "text": "严禁将民兵武器装备管理维修费、民兵武器装备维修材料或者备件挪作他用。",
      "order": 78
    },
    {
      "id": "xzfg-ebf4b2cc6a-0042",
      "articleNumber": 42,
      "displayNumber": "第四十二条",
      "path": [
        "第六章奖励与惩处"
      ],
      "text": "符合下列条件之一的单位和个人，由人民政府、军事机关给予奖励：\n(一)同抢劫、盗窃、破坏民兵武器装备以及其他危害民兵武器装备的行为进行斗争的；\n(二)在危险事故中抢救或者保护民兵武器装备，或者避免危险事故发生的；\n(三)长期在基层从事民兵武器装备管理工作或者在民兵武器装备维修等项工作中，完成任务出色的；\n(四)在民兵武器装备管理工作中从事危险作业，圆满完成任务的；\n(五)在民兵武器装备管理工作中严格执行各项规章制度，成绩突出的。",
      "order": 80
    },
    {
      "id": "xzfg-ebf4b2cc6a-0043",
      "articleNumber": 43,
      "displayNumber": "第四十三条",
      "path": [
        "第六章奖励与惩处"
      ],
      "text": "有下列行为之一的，依法给予行政处分；属于违反治安管理行为的，依照治安管理处罚法的有关规定处罚；构成犯罪的，依法追究刑事责任：\n(一)私藏、盗窃、抢劫、破坏民兵武器装备，或者利用民兵武器装备进行违法活动的；\n(二)擅自制造、装配、接收、购置民兵武器装备或者擅自挪用、出租、交换、馈赠、出售、携带、留存、动用、借出民兵武器装备的；\n(三)挪用民兵装备管理维修费、武器装备维修材料或者备件的；\n(四)玩忽职守，致使民兵武器装备丢失、被盗或者损坏、锈蚀、霉烂变质，影响使用的；\n(五)违反民兵武器装备操作规程和使用规定，造成后果的；\n(六)在民兵武器装备受到抢劫、盗窃、破坏时，不采取制止和保护措施，致使武器装备遭受损失的；\n(七)对民兵武器装备事故隐瞒不报的；\n(八)有违反本条例的其他行为的。",
      "order": 86
    },
    {
      "id": "xzfg-ebf4b2cc6a-0044",
      "articleNumber": 44,
      "displayNumber": "第四十四条",
      "path": [
        "第六章奖励与惩处"
      ],
      "text": "有本条例第四十三条所列行为之一的单位，除对主管负责人员和直接责任人员给予行政处分、行政处罚或者依法追究刑事责任外，应当对该单位给予通报批评，并限期改正。",
      "order": 95
    },
    {
      "id": "xzfg-ebf4b2cc6a-0045",
      "articleNumber": 45,
      "displayNumber": "第四十五条",
      "path": [
        "第七章附则"
      ],
      "text": "民兵通信装备、工兵装备、防化装备的管理办法，由总参谋部根据本条例制定。\n省、自治区、直辖市人民政府和省军区可以根据本条例，制定本地区民兵武器装备管理的具体办法。",
      "order": 97
    },
    {
      "id": "xzfg-ebf4b2cc6a-0046",
      "articleNumber": 46,
      "displayNumber": "第四十六条",
      "path": [
        "第七章附则"
      ],
      "text": "本条例自发布之日起施行。",
      "order": 99
    }
  ]
}
