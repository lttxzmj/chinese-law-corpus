  ],
  "articles": [
    {
      "id": "xzfg-381315c19a-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了规范技术进出口管理，维护技术进出口秩序，促进国民经济和社会发展，根据《中华人民共和国对外贸易法》(以下简称对外贸易法)及其他有关法律的有关规定，制定本条例。",
      "order": 2
    },
    {
      "id": "xzfg-381315c19a-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "本条例所称技术进出口，是指从中华人民共和国境外向中华人民共和国境内，或者从中华人民共和国境内向中华人民共和国境外，通过贸易、投资或者经济技术合作的方式转移技术的行为。\n前款规定的行为包括专利权转让、专利申请权转让、专利实施许可、技术秘密转让、技术服务和其他方式的技术转移。",
      "order": 3
    },
    {
      "id": "xzfg-381315c19a-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "国家对技术进出口实行统一的管理制度，依法维护公平、自由的技术进出口秩序。",
      "order": 5
    },
    {
      "id": "xzfg-381315c19a-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "技术进出口应当符合国家的产业政策、科技政策和社会发展政策，有利于促进我国科技进步和对外经济技术合作的发展，有利于维护我国经济技术权益。",
      "order": 6
    },
    {
      "id": "xzfg-381315c19a-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "国家准许技术的自由进出口；但是，法律、行政法规另有规定的除外。",
      "order": 7
    },
    {
      "id": "xzfg-381315c19a-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第一章总则"
      ],
      "text": "国务院对外经济贸易主管部门(以下简称国务院外经贸主管部门)依照对外贸易法和本条例的规定，负责全国的技术进出口管理工作。省、自治区、直辖市人民政府外经贸主管部门根据国务院外经贸主管部门的授权，负责本行政区域内的技术进出口管理工作。\n国务院有关部门按照国务院的规定，履行技术进出口项目的有关管理职责。",
      "order": 8
    },
    {
      "id": "xzfg-381315c19a-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第二章技术进口管理"
      ],
      "text": "国家鼓励先进、适用的技术进口。",
      "order": 11
    },
    {
      "id": "xzfg-381315c19a-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第二章技术进口管理"
      ],
      "text": "有对外贸易法第十六条规定情形之一的技术，禁止或者限制进口。\n国务院外经贸主管部门会同国务院有关部门，制定、调整并公布禁止或者限制进口的技术目录。",
      "order": 12
    },
    {
      "id": "xzfg-381315c19a-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第二章技术进口管理"
      ],
      "text": "属于禁止进口的技术，不得进口。",
      "order": 14
    },
    {
      "id": "xzfg-381315c19a-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第二章技术进口管理"
      ],
      "text": "属于限制进口的技术，实行许可证管理；未经许可，不得进口。",
      "order": 15
    },
    {
      "id": "xzfg-381315c19a-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第二章技术进口管理"
      ],
      "text": "进口属于限制进口的技术，应当向国务院外经贸主管部门提出技术进口申请并附有关文件。\n技术进口项目需经有关部门批准的，还应当提交有关部门的批准文件。",
      "order": 16
    },
    {
      "id": "xzfg-381315c19a-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第二章技术进口管理"
      ],
      "text": "国务院外经贸主管部门收到技术进口申请后，应当会同国务院有关部门对申请进行审查，并自收到申请之日起30个工作日内作出批准或者不批准的决定。",
      "order": 18
    },
    {
      "id": "xzfg-381315c19a-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第二章技术进口管理"
      ],
      "text": "技术进口申请经批准的，由国务院外经贸主管部门发给技术进口许可意向书。\n进口经营者取得技术进口许可意向书后，可以对外签订技术进口合同。",
      "order": 19
    },
    {
      "id": "xzfg-381315c19a-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第二章技术进口管理"
      ],
      "text": "进口经营者签订技术进口合同后，应当向国务院外经贸主管部门提交技术进口合同副本及有关文件，申请技术进口许可证。\n国务院外经贸主管部门对技术进口合同的真实性进行审查，并自收到前款规定的文件之日起10个工作日内，对技术进口作出许可或者不许可的决定。",
      "order": 21
    },
    {
      "id": "xzfg-381315c19a-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第二章技术进口管理"
      ],
      "text": "申请人依照本条例第十一条的规定向国务院外经贸主管部门提出技术进口申请时，可以一并提交已经签订的技术进口合同副本。\n国务院外经贸主管部门应当依照本条例第十二条和第十四条的规定对申请及其技术进口合同的真实性一并进行审查，并自收到前款规定的文件之日起40个工作日内，对技术进口作出许可或者不许可的决定。",
      "order": 23
    },
    {
      "id": "xzfg-381315c19a-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第二章技术进口管理"
      ],
      "text": "技术进口经许可的，由国务院外经贸主管部门颁发技术进口许可证。技术进口合同自技术进口许可证颁发之日起生效。",
      "order": 25
    },
    {
      "id": "xzfg-381315c19a-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第二章技术进口管理"
      ],
      "text": "对属于自由进口的技术，实行合同登记管理。\n进口属于自由进口的技术，合同自依法成立时生效，不以登记为合同生效的条件。",
      "order": 26
    },
    {
      "id": "xzfg-381315c19a-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第二章技术进口管理"
      ],
      "text": "进口属于自由进口的技术，应当向国务院外经贸主管部门办理登记，并提交下列文件：\n(一)技术进口合同登记申请书；\n(二)技术进口合同副本；\n(三)签约双方法律地位的证明文件。",
      "order": 28
    },
    {
      "id": "xzfg-381315c19a-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第二章技术进口管理"
      ],
      "text": "国务院外经贸主管部门应当自收到本条例第十八条规定的文件之日起3个工作日内，对技术进口合同进行登记，颁发技术进口合同登记证。",
      "order": 32
    },
    {
      "id": "xzfg-381315c19a-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第二章技术进口管理"
      ],
      "text": "申请人凭技术进口许可证或者技术进口合同登记证，办理外汇、银行、税务、海关等相关手续。",
      "order": 33
    },
    {
      "id": "xzfg-381315c19a-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第二章技术进口管理"
      ],
      "text": "依照本条例的规定，经许可或者登记的技术进口合同，合同的主要内容发生变更的，应当重新办理许可或者登记手续。\n经许可或者登记的技术进口合同终止的，应当及时向国务院外经贸主管部门备案。",
      "order": 34
    },
    {
      "id": "xzfg-381315c19a-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第二章技术进口管理"
      ],
      "text": "国务院外经贸主管部门和有关部门及其工作人员在履行技术进口管理职责中，对所知悉的商业秘密负有保密义务。",
      "order": 36
    },
    {
      "id": "xzfg-381315c19a-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第二章技术进口管理"
      ],
      "text": "技术进口合同的让与人应当保证自己是所提供技术的合法拥有者或者有权转让、许可者。\n技术进口合同的受让人按照合同约定使用让与人提供的技术，被第三方指控侵权的，受让人应当立即通知让与人；让与人接到通知后，应当协助受让人排除妨碍。",
      "order": 37
    },
    {
      "id": "xzfg-381315c19a-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第二章技术进口管理"
      ],
      "text": "技术进口合同的让与人应当保证所提供的技术完整、无误、有效，能够达到约定的技术目标。",
      "order": 39
    },
    {
      "id": "xzfg-381315c19a-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第二章技术进口管理"
      ],
      "text": "技术进口合同的受让人、让与人应当在合同约定的保密范围和保密期限内，对让与人提供的技术中尚未公开的秘密部分承担保密义务。\n在保密期限内，承担保密义务的一方在保密技术非因自己的原因被公开后，其承担的保密义务即予终止。",
      "order": 40
    },
    {
      "id": "xzfg-381315c19a-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第二章技术进口管理"
      ],
      "text": "技术进口合同期满后，技术让与人和受让人可以依照公平合理的原则，就技术的继续使用进行协商。",
      "order": 42
    },
    {
      "id": "xzfg-381315c19a-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第三章技术出口管理"
      ],
      "text": "国家鼓励成熟的产业化技术出口。",
      "order": 44
    },
    {
      "id": "xzfg-381315c19a-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第三章技术出口管理"
      ],
      "text": "有对外贸易法第十六条规定情形之一的技术，禁止或者限制出口。\n国务院外经贸主管部门会同国务院有关部门，制定、调整并公布禁止或者限制出口的技术目录。",
      "order": 45
    },
    {
      "id": "xzfg-381315c19a-0029",
      "articleNumber": 29,
      "displayNumber": "第二十九条",
      "path": [
        "第三章技术出口管理"
      ],
      "text": "属于禁止出口的技术，不得出口。",
      "order": 47
    },
    {
      "id": "xzfg-381315c19a-0030",
      "articleNumber": 30,
      "displayNumber": "第三十条",
      "path": [
        "第三章技术出口管理"
      ],
      "text": "属于限制出口的技术，实行许可证管理；未经许可，不得出口。",
      "order": 48
    },
    {
      "id": "xzfg-381315c19a-0031",
      "articleNumber": 31,
      "displayNumber": "第三十一条",
      "path": [
        "第三章技术出口管理"
      ],
      "text": "出口属于限制出口的技术，应当向国务院外经贸主管部门提出申请。",
      "order": 49
    },
    {
      "id": "xzfg-381315c19a-0032",
      "articleNumber": 32,
      "displayNumber": "第三十二条",
      "path": [
        "第三章技术出口管理"
      ],
      "text": "国务院外经贸主管部门收到技术出口申请后，应当会同国务院科技管理部门对申请出口的技术进行审查，并自收到申请之日起30个工作日内作出批准或者不批准的决定。\n限制出口的技术需经有关部门进行保密审查的，按照国家有关规定执行。",
      "order": 50
    },
    {
      "id": "xzfg-381315c19a-0033",
      "articleNumber": 33,
      "displayNumber": "第三十三条",
      "path": [
        "第三章技术出口管理"
      ],
      "text": "技术出口申请经批准的，由国务院外经贸主管部门发给技术出口许可意向书。\n申请人取得技术出口许可意向书后，方可对外进行实质性谈判，签订技术出口合同。",
      "order": 52
    },
    {
      "id": "xzfg-381315c19a-0034",
      "articleNumber": 34,
      "displayNumber": "第三十四条",
      "path": [
        "第三章技术出口管理"
      ],
      "text": "申请人签订技术出口合同后，应当向国务院外经贸主管部门提交下列文件，申请技术出口许可证：\n(一)技术出口许可意向书；\n(二)技术出口合同副本；\n(三)技术资料出口清单；\n(四)签约双方法律地位的证明文件。\n国务院外经贸主管部门对技术出口合同的真实性进行审查，并自收到前款规定的文件之日起15个工作日内，对技术出口作出许可或者不许可的决定。",
      "order": 54
    },
    {
      "id": "xzfg-381315c19a-0035",
      "articleNumber": 35,
      "displayNumber": "第三十五条",
      "path": [
        "第三章技术出口管理"
      ],
      "text": "技术出口经许可的，由国务院外经贸主管部门颁发技术出口许可证。技术出口合同自技术出口许可证颁发之日起生效。",
      "order": 60
    },
    {
      "id": "xzfg-381315c19a-0036",
      "articleNumber": 36,
      "displayNumber": "第三十六条",
      "path": [
        "第三章技术出口管理"
      ],
      "text": "对属于自由出口的技术，实行合同登记管理。\n出口属于自由出口的技术，合同自依法成立时生效，不以登记为合同生效的条件。",
      "order": 61
    },
    {
      "id": "xzfg-381315c19a-0037",
      "articleNumber": 37,
      "displayNumber": "第三十七条",
      "path": [
        "第三章技术出口管理"
      ],
      "text": "出口属于自由出口的技术，应当向国务院外经贸主管部门办理登记，并提交下列文件：\n(一)技术出口合同登记申请书；\n(二)技术出口合同副本；\n(三)签约双方法律地位的证明文件。",
      "order": 63
    },
    {
      "id": "xzfg-381315c19a-0038",
      "articleNumber": 38,
      "displayNumber": "第三十八条",
      "path": [
        "第三章技术出口管理"
      ],
      "text": "国务院外经贸主管部门应当自收到本条例第三十七条规定的文件之日起3个工作日内，对技术出口合同进行登记，颁发技术出口合同登记证。",
      "order": 67
    },
    {
      "id": "xzfg-381315c19a-0039",
      "articleNumber": 39,
      "displayNumber": "第三十九条",
      "path": [
        "第三章技术出口管理"
      ],
      "text": "申请人凭技术出口许可证或者技术出口合同登记证办理外汇、银行、税务、海关等相关手续。",
      "order": 68
    },
    {
      "id": "xzfg-381315c19a-0040",
      "articleNumber": 40,
      "displayNumber": "第四十条",
      "path": [
        "第三章技术出口管理"
      ],
      "text": "依照本条例的规定，经许可或者登记的技术出口合同，合同的主要内容发生变更的，应当重新办理许可或者登记手续。\n经许可或者登记的技术出口合同终止的，应当及时向国务院外经贸主管部门备案。",
      "order": 69
    },
    {
      "id": "xzfg-381315c19a-0041",
      "articleNumber": 41,
      "displayNumber": "第四十一条",
      "path": [
        "第三章技术出口管理"
      ],
      "text": "国务院外经贸主管部门和有关部门及其工作人员在履行技术出口管理职责中，对国家秘密和所知悉的商业秘密负有保密义务。",
      "order": 71
    },
    {
      "id": "xzfg-381315c19a-0042",
      "articleNumber": 42,
      "displayNumber": "第四十二条",
      "path": [
        "第三章技术出口管理"
      ],
      "text": "出口核技术、核两用品相关技术、监控化学品生产技术、军事技术等出口管制技术的，依照有关行政法规的规定办理。",
      "order": 72
    },
    {
      "id": "xzfg-381315c19a-0043",
      "articleNumber": 43,
      "displayNumber": "第四十三条",
      "path": [
        "第四章法律责任"
      ],
      "text": "进口或者出口属于禁止进出口的技术的，或者未经许可擅自进口或者出口属于限制进出口的技术的，依照刑法关于走私罪、非法经营罪、泄露国家秘密罪或者其他罪的规定，依法追究刑事责任；尚不够刑事处罚的，区别不同情况，依照海关法的有关规定处罚，或者由国务院外经贸主管部门给予警告，没收违法所得，处违法所得1倍以上5倍以下的罚款；国务院外经贸主管部门并可以撤销其对外贸易经营许可。",
      "order": 74
    },
    {
      "id": "xzfg-381315c19a-0044",
      "articleNumber": 44,
      "displayNumber": "第四十四条",
      "path": [
        "第四章法律责任"
      ],
      "text": "擅自超出许可的范围进口或者出口属于限制进出口的技术的，依照刑法关于非法经营罪或者其他罪的规定，依法追究刑事责任；尚不够刑事处罚的，区别不同情况，依照海关法的有关规定处罚，或者由国务院外经贸主管部门给予警告，没收违法所得，处违法所得1倍以上3倍以下的罚款；国务院外经贸主管部门并可以暂停直至撤销其对外贸易经营许可。",
      "order": 75
    },
    {
      "id": "xzfg-381315c19a-0045",
      "articleNumber": 45,
      "displayNumber": "第四十五条",
      "path": [
        "第四章法律责任"
      ],
      "text": "伪造、变造或者买卖技术进出口许可证或者技术进出口合同登记证的，依照刑法关于非法经营罪或者伪造、变造、买卖国家机关公文、证件、印章罪的规定，依法追究刑事责任；尚不够刑事处罚的，依照海关法的有关规定处罚；国务院外经贸主管部门并可以撤销其对外贸易经营许可。",
      "order": 76
    },
    {
      "id": "xzfg-381315c19a-0046",
      "articleNumber": 46,
      "displayNumber": "第四十六条",
      "path": [
        "第四章法律责任"
      ],
      "text": "以欺骗或者其他不正当手段获取技术进出口许可的，由国务院外经贸主管部门吊销其技术进出口许可证，暂停直至撤销其对外贸易经营许可。",
      "order": 77
    },
    {
      "id": "xzfg-381315c19a-0047",
      "articleNumber": 47,
      "displayNumber": "第四十七条",
      "path": [
        "第四章法律责任"
      ],
      "text": "以欺骗或者其他不正当手段获取技术进出口合同登记的，由国务院外经贸主管部门吊销其技术进出口合同登记证，暂停直至撤销其对外贸易经营许可。",
      "order": 78
    },
    {
      "id": "xzfg-381315c19a-0048",
      "articleNumber": 48,
      "displayNumber": "第四十八条",
      "path": [
        "第四章法律责任"
      ],
      "text": "技术进出口管理工作人员违反本条例的规定，泄露国家秘密或者所知悉的商业秘密的，依照刑法关于泄露国家秘密罪或者侵犯商业秘密罪的规定，依法追究刑事责任；尚不够刑事处罚的，依法给予行政处分。",
      "order": 79
    },
    {
      "id": "xzfg-381315c19a-0049",
      "articleNumber": 49,
      "displayNumber": "第四十九条",
      "path": [
        "第四章法律责任"
      ],
      "text": "技术进出口管理工作人员滥用职权、玩忽职守或者利用职务上的便利收受、索取他人财物的，依照刑法关于滥用职权罪、玩忽职守罪、受贿罪或者其他罪的规定，依法追究刑事责任；尚不够刑事处罚的，依法给予行政处分。",
      "order": 80
    },
    {
      "id": "xzfg-381315c19a-0050",
      "articleNumber": 50,
      "displayNumber": "第五十条",
      "path": [
        "第五章附则"
      ],
      "text": "对国务院外经贸主管部门作出的有关技术进出口的批准、许可、登记或者行政处罚决定不服的，可以依法申请行政复议，也可以依法向人民法院提起诉讼。",
      "order": 82
    },
    {
      "id": "xzfg-381315c19a-0051",
      "articleNumber": 51,
      "displayNumber": "第五十一条",
      "path": [
        "第五章附则"
      ],
      "text": "本条例公布前国务院制定的有关技术进出口管理的规定与本条例的规定不一致的，以本条例为准。",
      "order": 83
    },
    {
      "id": "xzfg-381315c19a-0052",
      "articleNumber": 52,
      "displayNumber": "第五十二条",
      "path": [
        "第五章附则"
      ],
      "text": "本条例自2002年1月1日起施行。1985年5月24日国务院发布的《中华人民共和国技术引进合同管理条例》和1987年12月30日国务院批准、1988年1月20日对外经济贸易部发布的《中华人民共和国技术引进合同管理条例施行细则》同时废止。",
      "order": 84
    }
  ]
}
