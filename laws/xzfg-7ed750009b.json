  "articles": [
    {
      "id": "xzfg-7ed750009b-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为保障刑事诉讼活动的顺利进行，依据《中华人民共和国刑事诉讼法》及其他有关法律的规定，制定本条例。",
      "order": 2
    },
    {
      "id": "xzfg-7ed750009b-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "看守所是羁押依法被逮捕、刑事拘留的人犯的机关。\n被判处有期徒刑一年以下，或者余刑在一年以下，不便送往劳动改造场所执行的罪犯，也可以由看守所监管。",
      "order": 3
    },
    {
      "id": "xzfg-7ed750009b-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "看守所的任务是依据国家法律对被羁押的人犯实行武装警戒看守，保障安全；对人犯进行教育；管理人犯的生活和卫生；保障侦查、起诉和审判工作的顺利进行。",
      "order": 5
    },
    {
      "id": "xzfg-7ed750009b-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "看守所监管人犯，必须坚持严密警戒看管与教育相结合的方针，坚持依法管理、严格管理、科学管理和文明管理，保障人犯的合法权益。严禁打骂、体罚、虐待人犯。",
      "order": 6
    },
    {
      "id": "xzfg-7ed750009b-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "看守所以县级以上的行政区域为单位设置，由本级公安机关管辖。\n省、自治区、直辖市国家安全厅(局)根据需要，可以设置看守所。\n铁道、交通、林业、民航等系统相当于县级以上的公安机关，可以设置看守所。",
      "order": 7
    },
    {
      "id": "xzfg-7ed750009b-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第一章总则"
      ],
      "text": "看守所设所长一人，副所长一至二人；根据工作需要，配备看守、管教、医务、财会、炊事等工作人员若干人。\n看守所应当配备女工作人员管理女性人犯。",
      "order": 10
    },
    {
      "id": "xzfg-7ed750009b-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第一章总则"
      ],
      "text": "看守所对人犯的武装警戒和押解由中国人民武装警察部队(以下简称武警)担任。看守所对执行任务的武警实行业务指导。",
      "order": 12
    },
    {
      "id": "xzfg-7ed750009b-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第一章总则"
      ],
      "text": "看守所的监管活动受人民检察院的法律监督。",
      "order": 13
    },
    {
      "id": "xzfg-7ed750009b-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第二章收押"
      ],
      "text": "看守所收押人犯，须凭送押机关持有的县级以上公安机关、国家安全机关签发的逮捕证、刑事拘留证或者县级以上公安机关、国家安全机关、监狱、劳动改造机关，人民法院、人民检察院追捕、押解人犯临时寄押的证明文书。没有上述凭证，或者凭证的记载与实际情况不符的，不予收押。",
      "order": 15
    },
    {
      "id": "xzfg-7ed750009b-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第二章收押"
      ],
      "text": "看守所收押人犯，应当进行健康检查，有下列情形之一的，不予收押：\n(一)患有精神病或者急性传染病的；\n(二)患有其他严重疾病，在羁押中可能发生生命危险或者生活不能自理的，但是罪大恶极不羁押对社会有危险性的除外；\n(三)怀孕或者哺乳自己不满一周岁的婴儿的妇女。",
      "order": 16
    },
    {
      "id": "xzfg-7ed750009b-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第二章收押"
      ],
      "text": "看守所收押人犯，应当对其人身和携带的物品进行严格检查。非日常用品应当登记，代为保管，出所时核对发还或者转监狱、劳动改造机关。违禁物品予以没收。发现犯罪证据和可疑物品，要当场制作记录，由人犯签字捺指印后，送案件主管机关处理。\n对女性人犯的人身检查，由女工作人员进行。",
      "order": 20
    },
    {
      "id": "xzfg-7ed750009b-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第二章收押"
      ],
      "text": "收押人犯，应当建立人犯档案。",
      "order": 22
    },
    {
      "id": "xzfg-7ed750009b-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第二章收押"
      ],
      "text": "收押人犯，应当告知人犯在羁押期间必须遵守的监规和享有的合法权益。",
      "order": 23
    },
    {
      "id": "xzfg-7ed750009b-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第二章收押"
      ],
      "text": "对男性人犯和女性人犯，成年人犯和未成年人犯，同案犯以及其他需要分别羁押的人犯，应当分别羁押。",
      "order": 24
    },
    {
      "id": "xzfg-7ed750009b-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第二章收押"
      ],
      "text": "公安机关或者国家安全机关侦查终结、人民检察院决定受理的人犯，人民检察院审查或者侦查终结、人民法院决定受理的人犯，递次移送交接，均应办理换押手续，书面通知看守所。",
      "order": 25
    },
    {
      "id": "xzfg-7ed750009b-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第三章警戒、看守"
      ],
      "text": "看守所实行二十四小时值班制度。值班人员应当坚守岗位，随时巡视监房。",
      "order": 27
    },
    {
      "id": "xzfg-7ed750009b-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第三章警戒、看守"
      ],
      "text": "对已被判处死刑、尚未执行的犯人，必须加戴械具。\n对有事实表明可能行凶、暴动、脱逃、自杀的人犯，经看守所所长批准，可以使用械具。在紧急情况下，可以先行使用，然后报告看守所所长。上述情形消除后，应当予以解除。",
      "order": 28
    },
    {
      "id": "xzfg-7ed750009b-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第三章警戒、看守"
      ],
      "text": "看守人员和武警遇有下列情形之一，采取其他措施不能制止时，可以按照有关规定开枪射击：\n(一) 人犯越狱或者暴动的；\n(二) 人犯脱逃不听制止，或者在追捕中抗拒逮捕的；\n(三) 劫持人犯的；\n(四) 人犯持有管制刀具或者其他危险物，正在行凶或者破坏的；\n(五) 人犯暴力威胁看守人员、武警的生命安全的。\n需要开枪射击时，除遇到特别紧迫的情况外，应当先鸣枪警告，人犯有畏服表示，应当立即停止射击。开枪射击后，应当保护现场，并立即报告主管公安机关和人民检察院。",
      "order": 30
    },
    {
      "id": "xzfg-7ed750009b-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第四章提讯、押解"
      ],
      "text": "公安机关、国家安全机关、人民检察院、人民法院提讯人犯时，必须持有提讯证或者提票。提讯人员不得少于二人。\n不符合前款规定的，看守所应当拒绝提讯。",
      "order": 38
    },
    {
      "id": "xzfg-7ed750009b-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第四章提讯、押解"
      ],
      "text": "提讯人员讯问人犯完毕，应当立即将人犯交给值班看守人员收押，并收回提讯证或者提票。",
      "order": 40
    },
    {
      "id": "xzfg-7ed750009b-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第四章提讯、押解"
      ],
      "text": "押解人员在押解人犯途中，必须严密看管，防止发生意外。对被押解的人犯，可以使用械具。\n押解女性人犯，应当有女工作人员负责途中的生活管理。",
      "order": 41
    },
    {
      "id": "xzfg-7ed750009b-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第五章生活、卫生"
      ],
      "text": "监室应当通风、采光，能够防潮、防暑、防寒。看守所对监房应当经常检查，及时维修，防止火灾和其他自然灾害。\n被羁押人犯的居住面积，应当不影响其日常生活。",
      "order": 44
    },
    {
      "id": "xzfg-7ed750009b-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第五章生活、卫生"
      ],
      "text": "人犯在羁押期间的伙食按规定标准供应，禁止克扣、挪用。\n对少数民族人犯和外国籍人犯，应当考虑到他们的民族风俗习惯，在生活上予以适当照顾。",
      "order": 46
    },
    {
      "id": "xzfg-7ed750009b-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第五章生活、卫生"
      ],
      "text": "人犯应当自备衣服、被褥。确实不能自备的，由看守所提供。",
      "order": 48
    },
    {
      "id": "xzfg-7ed750009b-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第五章生活、卫生"
      ],
      "text": "人犯每日应当有必要的睡眠时间和一至两小时的室外活动。\n看守所应当建立人犯的防疫和清洁卫生制度。",
      "order": 49
    },
    {
      "id": "xzfg-7ed750009b-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第五章生活、卫生"
      ],
      "text": "看守所应当配备必要的医疗器械和常用药品。人犯患病，应当给予及时治疗；需要到医院治疗的，当地医院应当负责治疗；病情严重的可以依法取保候审。",
      "order": 51
    },
    {
      "id": "xzfg-7ed750009b-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第五章生活、卫生"
      ],
      "text": "人犯在羁押期间死亡的，应当立即报告人民检察院和办案机关，由法医或者医生作出死亡原因的鉴定，并通知死者家属。",
      "order": 52
    },
    {
      "id": "xzfg-7ed750009b-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第六章会见、通信"
      ],
      "text": "人犯在羁押期间，经办案机关同意，并经公安机关批准，可以与近亲属通信、会见。",
      "order": 54
    },
    {
      "id": "xzfg-7ed750009b-0029",
      "articleNumber": 29,
      "displayNumber": "第二十九条",
      "path": [
        "第六章会见、通信"
      ],
      "text": "人犯的近亲属病重或者死亡时，应当及时通知人犯。\n人犯的配偶、父母或者子女病危时，除案情重大的以外，经办案机关同意，并经公安机关批准，在严格监护的条件下，允许人犯回家探视。",
      "order": 55
    },
    {
      "id": "xzfg-7ed750009b-0030",
      "articleNumber": 30,
      "displayNumber": "第三十条",
      "path": [
        "第六章会见、通信"
      ],
      "text": "人犯近亲属给人犯的物品，须经看守人员检查。",
      "order": 57
    },
    {
      "id": "xzfg-7ed750009b-0031",
      "articleNumber": 31,
      "displayNumber": "第三十一条",
      "path": [
        "第六章会见、通信"
      ],
      "text": "看守所接受办案机关的委托，对人犯发收的信件可以进行检查。如果发现有碍侦查、起诉、审判的，可以扣留，并移送办案机关处理。",
      "order": 58
    },
    {
      "id": "xzfg-7ed750009b-0032",
      "articleNumber": 32,
      "displayNumber": "第三十二条",
      "path": [
        "第六章会见、通信"
      ],
      "text": "人民检察院已经决定提起公诉的案件，被羁押的人犯在接到起诉书副本后，可以与本人委托的辩护人或者由人民法院指定的辩护人会见、通信。",
      "order": 59
    },
    {
      "id": "xzfg-7ed750009b-0033",
      "articleNumber": 33,
      "displayNumber": "第三十三条",
      "path": [
        "第七章教育、奖惩"
      ],
      "text": "看守所应当对人犯进行法制、道德以及必要的形势和劳动教育。",
      "order": 61
    },
    {
      "id": "xzfg-7ed750009b-0034",
      "articleNumber": 34,
      "displayNumber": "第三十四条",
      "path": [
        "第七章教育、奖惩"
      ],
      "text": "在保证安全和不影响刑事诉讼活动的前提下，看守所可以组织人犯进行适当的劳动。\n人犯的劳动收入和支出，要建立帐目，严格手续。",
      "order": 62
    },
    {
      "id": "xzfg-7ed750009b-0035",
      "articleNumber": 35,
      "displayNumber": "第三十五条",
      "path": [
        "第七章教育、奖惩"
      ],
      "text": "人犯在被羁押期间，遵守监规，表现良好的，应当予以表扬和鼓励；有立功表现的，应当报请办案机关依法从宽处理。",
      "order": 64
    },
    {
      "id": "xzfg-7ed750009b-0036",
      "articleNumber": 36,
      "displayNumber": "第三十六条",
      "path": [
        "第七章教育、奖惩"
      ],
      "text": "看守所对于违反监规的人犯，可予以警告或者训诫；情节严重，经教育不改的，可以责令具结悔过或者经看守所所长批准予以禁闭。",
      "order": 65
    },
    {
      "id": "xzfg-7ed750009b-0037",
      "articleNumber": 37,
      "displayNumber": "第三十七条",
      "path": [
        "第七章教育、奖惩"
      ],
      "text": "人犯在羁押期间有犯罪行为的，看守所应当及时将情况通知办案机关依法处理。",
      "order": 66
    },
    {
      "id": "xzfg-7ed750009b-0038",
      "articleNumber": 38,
      "displayNumber": "第三十八条",
      "path": [
        "第八章出所"
      ],
      "text": "对于被判处死刑缓期二年执行、无期徒刑、有期徒刑、拘役或者管制的罪犯，看守所根据人民法院的执行通知书、判决书办理出所手续。",
      "order": 68
    },
    {
      "id": "xzfg-7ed750009b-0039",
      "articleNumber": 39,
      "displayNumber": "第三十九条",
      "path": [
        "第八章出所"
      ],
      "text": "对于被依法释放的人，看守所根据人民法院、人民检察院、公安机关或者国家安全机关的释放通知文书，办理释放手续。\n释放被羁押人，发给释放证明书。",
      "order": 69
    },
    {
      "id": "xzfg-7ed750009b-0040",
      "articleNumber": 40,
      "displayNumber": "第四十条",
      "path": [
        "第八章出所"
      ],
      "text": "对于被决定劳动教养的人和转送外地羁押的人犯，看守所根据有关主管机关的证明文件，办理出所手续。",
      "order": 71
    },
    {
      "id": "xzfg-7ed750009b-0041",
      "articleNumber": 41,
      "displayNumber": "第四十一条",
      "path": [
        "第九章检察监督"
      ],
      "text": "看守所应当教育工作人员严格执法，严守纪律，向人民检察院报告监管活动情况。",
      "order": 73
    },
    {
      "id": "xzfg-7ed750009b-0042",
      "articleNumber": 42,
      "displayNumber": "第四十二条",
      "path": [
        "第九章检察监督"
      ],
      "text": "看守所对人民检察院提出的违法情况的纠正意见，应当认真研究，及时处理，并将处理结果告知人民检察院。",
      "order": 74
    },
    {
      "id": "xzfg-7ed750009b-0043",
      "articleNumber": 43,
      "displayNumber": "第四十三条",
      "path": [
        "第十章其他规定"
      ],
      "text": "看守所对人犯的法定羁押期限即将到期而案件又尚未审理终结的，应当及时通知办案机关迅速审结；超过法定羁押期限的，应当将情况报告人民检察院。",
      "order": 76
    },
    {
      "id": "xzfg-7ed750009b-0044",
      "articleNumber": 44,
      "displayNumber": "第四十四条",
      "path": [
        "第十章其他规定"
      ],
      "text": "对于人民检察院或者人民法院没有决定停止行使选举权利的被羁押人犯，准予参加县级以下人民代表大会代表的选举。",
      "order": 77
    },
    {
      "id": "xzfg-7ed750009b-0045",
      "articleNumber": 45,
      "displayNumber": "第四十五条",
      "path": [
        "第十章其他规定"
      ],
      "text": "看守所在人犯羁押期间发现人犯中有错拘、错捕或者错判的，应当及时通知办案机关查证核实，依法处理。",
      "order": 78
    },
    {
      "id": "xzfg-7ed750009b-0046",
      "articleNumber": 46,
      "displayNumber": "第四十六条",
      "path": [
        "第十章其他规定"
      ],
      "text": "对人犯的上诉书、申诉书，看守所应当及时转送，不得阻挠和扣押。\n人犯揭发、控告司法工作人员违法行为的材料，应当及时报请人民检察院处理。",
      "order": 79
    },
    {
      "id": "xzfg-7ed750009b-0047",
      "articleNumber": 47,
      "displayNumber": "第四十七条",
      "path": [
        "第十一章附则"
      ],
      "text": "看守所监管已决犯，执行有关对已决犯管理的法律规定。",
      "order": 82
    },
    {
      "id": "xzfg-7ed750009b-0048",
      "articleNumber": 48,
      "displayNumber": "第四十八条",
      "path": [
        "第十一章附则"
      ],
      "text": "看守所所需修缮费和人犯给养费应当编报预算，按隶属关系由各级财政专项拨付。\n看守所的经费开支，单立帐户，专款专用。\n新建和迁建的看守所应当纳入城市建设规划，列入基本建设项目。",
      "order": 83
    },
    {
      "id": "xzfg-7ed750009b-0049",
      "articleNumber": 49,
      "displayNumber": "第四十九条",
      "path": [
        "第十一章附则"
      ],
      "text": "本条例所称“以上”、“以下”，均包括本数、本级在内。",
      "order": 86
    },
    {
      "id": "xzfg-7ed750009b-0050",
      "articleNumber": 50,
      "displayNumber": "第五十条",
      "path": [
        "第十一章附则"
      ],
      "text": "本条例由公安部负责解释，实施办法由公安部制定。",
      "order": 87
    },
    {
      "id": "xzfg-7ed750009b-0051",
      "articleNumber": 51,
      "displayNumber": "第五十一条",
      "path": [
        "第十一章附则"
      ],
      "text": "中国人民解放军根据军队看守所的具体情况，可以另行制定实施办法。",
      "order": 88
    },
    {
      "id": "xzfg-7ed750009b-0052",
      "articleNumber": 52,
      "displayNumber": "第五十二条",
      "path": [
        "第十一章附则"
      ],
      "text": "本条例自发布之日起施行，一九五四年九月七日政务院公布的《中华人民共和国劳动改造条例》中有关看守所的规定即行废止。",
      "order": 89
    }
  ]
}
