  "articles": [
    {
      "id": "xzfg-ee5342b684-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了加强对人民币的管理，维护人民币的信誉，稳定金融秩序，根据《中华人民共和国中国人民银行法》，制定本条例。",
      "order": 2
    },
    {
      "id": "xzfg-ee5342b684-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "本条例所称人民币，是指中国人民银行依法发行的货币，包括纸币和硬币。\n从事人民币的设计、印制、发行、流通和回收等活动，应当遵守本条例。",
      "order": 3
    },
    {
      "id": "xzfg-ee5342b684-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "中华人民共和国的法定货币是人民币。以人民币支付中华人民共和国境内的一切公共的和私人的债务，任何单位和个人不得拒收。",
      "order": 5
    },
    {
      "id": "xzfg-ee5342b684-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "人民币的单位为元，人民币辅币单位为角、分。1元等于10角，1角等于10分。\n人民币依其面额支付。",
      "order": 6
    },
    {
      "id": "xzfg-ee5342b684-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "中国人民银行是国家管理人民币的主管机关，负责本条例的组织实施。",
      "order": 8
    },
    {
      "id": "xzfg-ee5342b684-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第一章总则"
      ],
      "text": "任何单位和个人都应当爱护人民币。禁止损害人民币和妨碍人民币流通。",
      "order": 9
    },
    {
      "id": "xzfg-ee5342b684-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第二章设计和印制"
      ],
      "text": "新版人民币由中国人民银行组织设计，报国务院批准。",
      "order": 11
    },
    {
      "id": "xzfg-ee5342b684-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第二章设计和印制"
      ],
      "text": "人民币由中国人民银行指定的专门企业印制。",
      "order": 12
    },
    {
      "id": "xzfg-ee5342b684-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第二章设计和印制"
      ],
      "text": "印制人民币的企业应当按照中国人民银行制定的人民币质量标准和印制计划印制人民币。",
      "order": 13
    },
    {
      "id": "xzfg-ee5342b684-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第二章设计和印制"
      ],
      "text": "印制人民币的企业应当将合格的人民币产品全部解缴中国人民银行人民币发行库，将不合格的人民币产品按照中国人民银行的规定全部销毁。",
      "order": 14
    },
    {
      "id": "xzfg-ee5342b684-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第二章设计和印制"
      ],
      "text": "印制人民币的原版、原模使用完毕后，由中国人民银行封存。",
      "order": 15
    },
    {
      "id": "xzfg-ee5342b684-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第二章设计和印制"
      ],
      "text": "印制人民币的特殊材料、技术、工艺、专用设备等重要事项属于国家秘密。印制人民币的企业和有关人员应当保守国家秘密；未经中国人民银行批准，任何单位和个人不得对外提供。",
      "order": 16
    },
    {
      "id": "xzfg-ee5342b684-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第二章设计和印制"
      ],
      "text": "除中国人民银行指定的印制人民币的企业外，任何单位和个人不得研制、仿制、引进、销售、购买和使用印制人民币所特有的防伪材料、防伪技术、防伪工艺和专用设备。有关管理办法由中国人民银行另行制定。",
      "order": 17
    },
    {
      "id": "xzfg-ee5342b684-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第二章设计和印制"
      ],
      "text": "人民币样币是检验人民币印制质量和鉴别人民币真伪的标准样本，由印制人民币的企业按照中国人民银行的规定印制。人民币样币上应当加印“样币”字样。",
      "order": 18
    },
    {
      "id": "xzfg-ee5342b684-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第三章发行和回收"
      ],
      "text": "人民币由中国人民银行统一发行。",
      "order": 20
    },
    {
      "id": "xzfg-ee5342b684-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第三章发行和回收"
      ],
      "text": "中国人民银行发行新版人民币，应当报国务院批准。\n中国人民银行应当将新版人民币的发行时间、面额、图案、式样、规格、主色调、主要特征等予以公告。\n中国人民银行不得在新版人民币发行公告发布前将新版人民币支付给金融机构。",
      "order": 21
    },
    {
      "id": "xzfg-ee5342b684-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第三章发行和回收"
      ],
      "text": "因防伪或者其他原因，需要改变人民币的印制材料、技术或者工艺的，由中国人民银行决定。\n中国人民银行应当将改版后的人民币的发行时间、面额、主要特征等予以公告。\n中国人民银行不得在改版人民币发行公告发布前将改版人民币支付给金融机构。",
      "order": 24
    },
    {
      "id": "xzfg-ee5342b684-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第三章发行和回收"
      ],
      "text": "中国人民银行可以根据需要发行纪念币。\n纪念币是具有特定主题的限量发行的人民币，包括普通纪念币和贵金属纪念币。",
      "order": 27
    },
    {
      "id": "xzfg-ee5342b684-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第三章发行和回收"
      ],
      "text": "纪念币的主题、面额、图案、材质、式样、规格、发行数量、发行时间等由中国人民银行确定；但是，纪念币的主题涉及重大政治、历史题材的，应当报国务院批准。\n中国人民银行应当将纪念币的主题、面额、图案、材质、式样、规格、发行数量、发行时间等予以公告。\n中国人民银行不得在纪念币发行公告发布前将纪念币支付给金融机构。",
      "order": 29
    },
    {
      "id": "xzfg-ee5342b684-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第三章发行和回收"
      ],
      "text": "中国人民银行设立人民币发行库，在其分支机构设立分支库，负责保管人民币发行基金。各级人民币发行库主任由同级中国人民银行行长担任。\n人民币发行基金是中国人民银行人民币发行库保存的未进入流通的人民币。\n人民币发行基金的调拨，应当按照中国人民银行的规定办理。任何单位和个人不得违反规定动用人民币发行基金，不得干扰、阻碍人民币发行基金的调拨。",
      "order": 32
    },
    {
      "id": "xzfg-ee5342b684-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第三章发行和回收"
      ],
      "text": "特定版别的人民币的停止流通，应当报国务院批准，并由中国人民银行公告。\n办理人民币存取款业务的金融机构应当按照中国人民银行的规定，收兑停止流通的人民币，并将其交存当地中国人民银行。\n中国人民银行不得将停止流通的人民币支付给金融机构，金融机构不得将停止流通的人民币对外支付。",
      "order": 35
    },
    {
      "id": "xzfg-ee5342b684-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第三章发行和回收"
      ],
      "text": "办理人民币存取款业务的金融机构应当按照中国人民银行的规定，无偿为公众兑换残缺、污损的人民币，挑剔残缺、污损的人民币，并将其交存当地中国人民银行。\n中国人民银行不得将残缺、污损的人民币支付给金融机构，金融机构不得将残缺、污损的人民币对外支付。",
      "order": 38
    },
    {
      "id": "xzfg-ee5342b684-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第三章发行和回收"
      ],
      "text": "停止流通的人民币和残缺、污损的人民币，由中国人民银行负责回收、销毁。具体办法由中国人民银行制定。",
      "order": 40
    },
    {
      "id": "xzfg-ee5342b684-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第四章流通和保护"
      ],
      "text": "办理人民币存取款业务的金融机构应当根据合理需要的原则，办理人民币券别调剂业务。",
      "order": 42
    },
    {
      "id": "xzfg-ee5342b684-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第四章流通和保护"
      ],
      "text": "禁止非法买卖流通人民币。\n纪念币的买卖，应当遵守中国人民银行的有关规定。",
      "order": 43
    },
    {
      "id": "xzfg-ee5342b684-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第四章流通和保护"
      ],
      "text": "禁止下列损害人民币的行为：\n(一)故意毁损人民币；\n(二)制作、仿制、买卖人民币图样；\n(三)未经中国人民银行批准，在宣传品、出版物或者其他商品上使用人民币图样；\n(四)中国人民银行规定的其他损害人民币的行为。\n前款人民币图样包括放大、缩小和同样大小的人民币图样。",
      "order": 45
    },
    {
      "id": "xzfg-ee5342b684-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第四章流通和保护"
      ],
      "text": "人民币样币禁止流通。\n人民币样币的管理办法，由中国人民银行制定。",
      "order": 51
    },
    {
      "id": "xzfg-ee5342b684-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第四章流通和保护"
      ],
      "text": "任何单位和个人不得印制、发售代币票券，以代替人民币在市场上流通。",
      "order": 53
    },
    {
      "id": "xzfg-ee5342b684-0029",
      "articleNumber": 29,
      "displayNumber": "第二十九条",
      "path": [
        "第四章流通和保护"
      ],
      "text": "中国公民出入境、外国人入出境携带人民币实行限额管理制度，具体限额由中国人民银行规定。",
      "order": 54
    },
    {
      "id": "xzfg-ee5342b684-0030",
      "articleNumber": 30,
      "displayNumber": "第三十条",
      "path": [
        "第四章流通和保护"
      ],
      "text": "禁止伪造、变造人民币。禁止出售、购买伪造、变造的人民币。禁止走私、运输、持有、使用伪造、变造的人民币。",
      "order": 55
    },
    {
      "id": "xzfg-ee5342b684-0031",
      "articleNumber": 31,
      "displayNumber": "第三十一条",
      "path": [
        "第四章流通和保护"
      ],
      "text": "单位和个人持有伪造、变造的人民币的，应当及时上交中国人民银行、公安机关或者办理人民币存取款业务的金融机构；发现他人持有伪造、变造的人民币的，应当立即向公安机关报告。",
      "order": 56
    },
    {
      "id": "xzfg-ee5342b684-0032",
      "articleNumber": 32,
      "displayNumber": "第三十二条",
      "path": [
        "第四章流通和保护"
      ],
      "text": "中国人民银行、公安机关发现伪造、变造的人民币，应当予以没收，加盖“假币”字样的戳记，并登记造册；持有人对公安机关没收的人民币的真伪有异议的，可以向中国人民银行申请鉴定。\n公安机关应当将没收的伪造、变造的人民币解缴当地中国人民银行。",
      "order": 57
    },
    {
      "id": "xzfg-ee5342b684-0033",
      "articleNumber": 33,
      "displayNumber": "第三十三条",
      "path": [
        "第四章流通和保护"
      ],
      "text": "办理人民币存取款业务的金融机构发现伪造、变造的人民币，数量较多、有新版的伪造人民币或者有其他制造贩卖伪造、变造的人民币线索的，应当立即报告公安机关；数量较少的，由该金融机构两名以上工作人员当面予以收缴，加盖“假币”字样的戳记，登记造册，向持有人出具中国人民银行统一印制的收缴凭证，并告知持有人可以向中国人民银行或者向中国人民银行授权的国有独资商业银行的业务机构申请鉴定。对伪造、变造的人民币收缴及鉴定的具体办法，由中国人民银行制定。\n办理人民币存取款业务的金融机构应当将收缴的伪造、变造的人民币解缴当地中国人民银行。",
      "order": 59
    },
    {
      "id": "xzfg-ee5342b684-0034",
      "articleNumber": 34,
      "displayNumber": "第三十四条",
      "path": [
        "第四章流通和保护"
      ],
      "text": "中国人民银行和中国人民银行授权的国有独资商业银行的业务机构应当无偿提供鉴定人民币真伪的服务。\n对盖有“假币”字样戳记的人民币，经鉴定为真币的，由中国人民银行或者中国人民银行授权的国有独资商业银行的业务机构按照面额予以兑换；经鉴定为假币的，由中国人民银行或者中国人民银行授权的国有独资商业银行的业务机构予以没收。\n中国人民银行授权的国有独资商业银行的业务机构应当将没收的伪造、变造的人民币解缴当地中国人民银行。",
      "order": 61
    },
    {
      "id": "xzfg-ee5342b684-0035",
      "articleNumber": 35,
      "displayNumber": "第三十五条",
      "path": [
        "第四章流通和保护"
      ],
      "text": "办理人民币存取款业务的金融机构应当采取有效措施，防止以伪造、变造的人民币对外支付。\n办理人民币存取款业务的金融机构应当在营业场所无偿提供鉴别人民币真伪的服务。",
      "order": 64
    },
    {
      "id": "xzfg-ee5342b684-0036",
      "articleNumber": 36,
      "displayNumber": "第三十六条",
      "path": [
        "第四章流通和保护"
      ],
      "text": "伪造、变造的人民币由中国人民银行统一销毁。",
      "order": 66
    },
    {
      "id": "xzfg-ee5342b684-0037",
      "articleNumber": 37,
      "displayNumber": "第三十七条",
      "path": [
        "第四章流通和保护"
      ],
      "text": "人民币反假鉴别仪应当按照国家规定标准生产。\n人民币反假鉴别仪国家标准，由中国人民银行会同有关部门制定，并协助组织实施。",
      "order": 67
    },
    {
      "id": "xzfg-ee5342b684-0038",
      "articleNumber": 38,
      "displayNumber": "第三十八条",
      "path": [
        "第四章流通和保护"
      ],
      "text": "人民币有下列情形之一的，不得流通：\n(一)不能兑换的残缺、污损的人民币；\n(二)停止流通的人民币。",
      "order": 69
    },
    {
      "id": "xzfg-ee5342b684-0039",
      "articleNumber": 39,
      "displayNumber": "第三十九条",
      "path": [
        "第五章罚则"
      ],
      "text": "印制人民币的企业和有关人员有下列情形之一的，由中国人民银行给予警告，没收违法所得，并处违法所得1倍以上3倍以下的罚款，没有违法所得的，处1万元以上10万元以下的罚款；对直接负责的主管人员和其他直接责任人员，依法给予纪律处分：\n(一)未按照中国人民银行制定的人民币质量标准和印制计划印制人民币的；\n(二)未将合格的人民币产品全部解缴中国人民银行人民币发行库的；\n(三)未按照中国人民银行的规定将不合格的人民币产品全部销毁的；\n(四)未经中国人民银行批准，擅自对外提供印制人民币的特殊材料、技术、工艺或者专用设备等国家秘密的。",
      "order": 73
    },
    {
      "id": "xzfg-ee5342b684-0040",
      "articleNumber": 40,
      "displayNumber": "第四十条",
      "path": [
        "第五章罚则"
      ],
      "text": "违反本条例第十三条规定的，由工商行政管理机关和其他有关行政执法机关给予警告，没收违法所得和非法财物，并处违法所得1倍以上3倍以下的罚款；没有违法所得的，处2万元以上20万元以下的罚款。",
      "order": 78
    },
    {
      "id": "xzfg-ee5342b684-0041",
      "articleNumber": 41,
      "displayNumber": "第四十一条",
      "path": [
        "第五章罚则"
      ],
      "text": "办理人民币存取款业务的金融机构违反本条例第二十一条第二款、第三款和第二十二条规定的，由中国人民银行给予警告，并处1000元以上5000元以下的罚款；对直接负责的主管人员和其他直接责任人员，依法给予纪律处分。",
      "order": 79
    },
    {
      "id": "xzfg-ee5342b684-0042",
      "articleNumber": 42,
      "displayNumber": "第四十二条",
      "path": [
        "第五章罚则"
      ],
      "text": "故意毁损人民币的，由公安机关给予警告，并处1万元以下的罚款。",
      "order": 80
    },
    {
      "id": "xzfg-ee5342b684-0043",
      "articleNumber": 43,
      "displayNumber": "第四十三条",
      "path": [
        "第五章罚则"
      ],
      "text": "违反本条例第二十五条、第二十六条第一款第二项和第四项规定的，由工商行政管理机关和其他有关行政执法机关给予警告，没收违法所得和非法财物，并处违法所得1倍以上3倍以下的罚款；没有违法所得的，处1000元以上5万元以下的罚款。\n工商行政管理机关和其他有关行政执法机关应当销毁非法使用的人民币图样。",
      "order": 81
    },
    {
      "id": "xzfg-ee5342b684-0044",
      "articleNumber": 44,
      "displayNumber": "第四十四条",
      "path": [
        "第五章罚则"
      ],
      "text": "办理人民币存取款业务的金融机构、中国人民银行授权的国有独资商业银行的业务机构违反本条例第三十三条、第三十四条和第三十五条规定的，由中国人民银行给予警告，并处1000元以上5万元以下的罚款；对直接负责的主管人员和其他直接责任人员，依法给予纪律处分。",
      "order": 83
    },
    {
      "id": "xzfg-ee5342b684-0045",
      "articleNumber": 45,
      "displayNumber": "第四十五条",
      "path": [
        "第五章罚则"
      ],
      "text": "中国人民银行、公安机关、工商行政管理机关及其工作人员违反本条例有关规定的，对直接负责的主管人员和其他直接责任人员，依法给予行政处分。",
      "order": 84
    },
    {
      "id": "xzfg-ee5342b684-0046",
      "articleNumber": 46,
      "displayNumber": "第四十六条",
      "path": [
        "第五章罚则"
      ],
      "text": "违反本条例第二十条第三款、第二十六条第一款第三项、第二十八条和第三十条规定的，依照《中华人民共和国中国人民银行法》的有关规定予以处罚；其中，违反本条例第三十条规定，构成犯罪的，依法追究刑事责任。",
      "order": 85
    },
    {
      "id": "xzfg-ee5342b684-0047",
      "articleNumber": 47,
      "displayNumber": "第四十七条",
      "path": [
        "第六章附则"
      ],
      "text": "本条例自2000年5月1日起施行。",
      "order": 87
    }
  ]
}
