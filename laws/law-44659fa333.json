  "articles": [
    {
      "id": "law-44659fa333-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了加强进出口商品检验工作，规范进出口商品检验行为，维护社会公共利益和进出口贸易有关各方的合法权益，促进对外经济贸易关系的顺利发展，制定本法。",
      "order": 2
    },
    {
      "id": "law-44659fa333-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "国务院设立进出口商品检验部门（以下简称国家商检部门），主管全国进出口商品检验工作。国家商检部门设在各地的进出口商品检验机构（以下简称商检机构）管理所辖地区的进出口商品检验工作。",
      "order": 3
    },
    {
      "id": "law-44659fa333-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "商检机构和依法设立的检验机构（以下称其他检验机构），依法对进出口商品实施检验。",
      "order": 4
    },
    {
      "id": "law-44659fa333-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "进出口商品检验应当根据保护人类健康和安全、保护动物或者植物的生命和健康、保护环境、防止欺诈行为、维护国家安全的原则，由国家商检部门制定、调整必须实施检验的进出口商品目录（以下简称目录）并公布实施。",
      "order": 5
    },
    {
      "id": "law-44659fa333-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "列入目录的进出口商品，由商检机构实施检验。\n前款规定的进口商品未经检验的，不准销售、使用；前款规定的出口商品未经检验合格的，不准出口。\n本条第一款规定的进出口商品，其中符合国家规定的免予检验条件的，由收货人或者发货人申请，经国家商检部门审查批准，可以免予检验。",
      "order": 6
    },
    {
      "id": "law-44659fa333-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第一章总则"
      ],
      "text": "必须实施的进出口商品检验，是指确定列入目录的进出口商品是否符合国家技术规范的强制性要求的合格评定活动。\n合格评定程序包括：抽样、检验和检查；评估、验证和合格保证；注册、认可和批准以及各项的组合。\n对本条第一款规定的进出口商品检验，商检机构可以采信检验机构的检验结果；国家商检部门对前述检验机构实行目录管理。",
      "order": 9
    },
    {
      "id": "law-44659fa333-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第一章总则"
      ],
      "text": "列入目录的进出口商品，按照国家技术规范的强制性要求进行检验；尚未制定国家技术规范的强制性要求的，应当依法及时制定，未制定之前，可以参照国家商检部门指定的国外有关标准进行检验。",
      "order": 12
    },
    {
      "id": "law-44659fa333-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第一章总则"
      ],
      "text": "其他检验机构可以接受对外贸易关系人或者外国检验机构的委托，办理进出口商品检验鉴定业务。",
      "order": 13
    },
    {
      "id": "law-44659fa333-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第一章总则"
      ],
      "text": "法律、行政法规规定由其他检验机构实施检验的进出口商品或者检验项目，依照有关法律、行政法规的规定办理。",
      "order": 14
    },
    {
      "id": "law-44659fa333-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第一章总则"
      ],
      "text": "国家商检部门和商检机构应当及时收集和向有关方面提供进出口商品检验方面的信息。\n国家商检部门和商检机构的工作人员在履行进出口商品检验的职责中，对所知悉的商业秘密负有保密义务。",
      "order": 15
    },
    {
      "id": "law-44659fa333-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第二章进口商品的检验"
      ],
      "text": "本法规定必须经商检机构检验的进口商品的收货人或者其代理人，应当向报关地的商检机构报检。",
      "order": 18
    },
    {
      "id": "law-44659fa333-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第二章进口商品的检验"
      ],
      "text": "本法规定必须经商检机构检验的进口商品的收货人或者其代理人，应当在商检机构规定的地点和期限内，接受商检机构对进口商品的检验。商检机构应当在国家商检部门统一规定的期限内检验完毕，并出具检验证单。",
      "order": 19
    },
    {
      "id": "law-44659fa333-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第二章进口商品的检验"
      ],
      "text": "本法规定必须经商检机构检验的进口商品以外的进口商品的收货人，发现进口商品质量不合格或者残损短缺，需要由商检机构出证索赔的，应当向商检机构申请检验出证。",
      "order": 20
    },
    {
      "id": "law-44659fa333-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第二章进口商品的检验"
      ],
      "text": "对重要的进口商品和大型的成套设备，收货人应当依据对外贸易合同约定在出口国装运前进行预检验、监造或者监装，主管部门应当加强监督；商检机构根据需要可以派出检验人员参加。",
      "order": 21
    },
    {
      "id": "law-44659fa333-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第三章出口商品的检验"
      ],
      "text": "本法规定必须经商检机构检验的出口商品的发货人或者其代理人，应当在商检机构规定的地点和期限内，向商检机构报检。商检机构应当在国家商检部门统一规定的期限内检验完毕，并出具检验证单。",
      "order": 23
    },
    {
      "id": "law-44659fa333-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第三章出口商品的检验"
      ],
      "text": "经商检机构检验合格发给检验证单的出口商品，应当在商检机构规定的期限内报关出口；超过期限的，应当重新报检。",
      "order": 24
    },
    {
      "id": "law-44659fa333-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第三章出口商品的检验"
      ],
      "text": "为出口危险货物生产包装容器的企业，必须申请商检机构进行包装容器的性能鉴定。生产出口危险货物的企业，必须申请商检机构进行包装容器的使用鉴定。使用未经鉴定合格的包装容器的危险货物，不准出口。",
      "order": 25
    },
    {
      "id": "law-44659fa333-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第三章出口商品的检验"
      ],
      "text": "对装运出口易腐烂变质食品的船舱和集装箱，承运人或者装箱单位必须在装货前申请检验。未经检验合格的，不准装运。",
      "order": 26
    },
    {
      "id": "law-44659fa333-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第四章监督管理"
      ],
      "text": "商检机构对本法规定必须经商检机构检验的进出口商品以外的进出口商品，根据国家规定实施抽查检验。\n国家商检部门可以公布抽查检验结果或者向有关部门通报抽查检验情况。",
      "order": 28
    },
    {
      "id": "law-44659fa333-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第四章监督管理"
      ],
      "text": "商检机构根据便利对外贸易的需要，可以按照国家规定对列入目录的出口商品进行出厂前的质量监督管理和检验。",
      "order": 30
    },
    {
      "id": "law-44659fa333-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第四章监督管理"
      ],
      "text": "为进出口货物的收发货人办理报检手续的代理人办理报检手续时应当向商检机构提交授权委托书。",
      "order": 31
    },
    {
      "id": "law-44659fa333-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第四章监督管理"
      ],
      "text": "国家商检部门和商检机构依法对其他检验机构的进出口商品检验鉴定业务活动进行监督，可以对其检验的商品抽查检验。",
      "order": 32
    },
    {
      "id": "law-44659fa333-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第四章监督管理"
      ],
      "text": "国务院认证认可监督管理部门根据国家统一的认证制度，对有关的进出口商品实施认证管理。",
      "order": 33
    },
    {
      "id": "law-44659fa333-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第四章监督管理"
      ],
      "text": "认证机构可以根据国务院认证认可监督管理部门同外国有关机构签订的协议或者接受外国有关机构的委托进行进出口商品质量认证工作，准许在认证合格的进出口商品上使用质量认证标志。",
      "order": 34
    },
    {
      "id": "law-44659fa333-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第四章监督管理"
      ],
      "text": "商检机构依照本法对实施许可制度的进出口商品实行验证管理，查验单证，核对证货是否相符。",
      "order": 35
    },
    {
      "id": "law-44659fa333-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第四章监督管理"
      ],
      "text": "商检机构根据需要，对检验合格的进出口商品，可以加施商检标志或者封识。",
      "order": 36
    },
    {
      "id": "law-44659fa333-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第四章监督管理"
      ],
      "text": "进出口商品的报检人对商检机构作出的检验结果有异议的，可以向原商检机构或者其上级商检机构以至国家商检部门申请复验，由受理复验的商检机构或者国家商检部门及时作出复验结论。",
      "order": 37
    },
    {
      "id": "law-44659fa333-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第四章监督管理"
      ],
      "text": "当事人对商检机构、国家商检部门作出的复验结论不服或者对商检机构作出的处罚决定不服的，可以依法申请行政复议，也可以依法向人民法院提起诉讼。",
      "order": 38
    },
    {
      "id": "law-44659fa333-0029",
      "articleNumber": 29,
      "displayNumber": "第二十九条",
      "path": [
        "第四章监督管理"
      ],
      "text": "国家商检部门和商检机构履行职责，必须遵守法律，维护国家利益，依照法定职权和法定程序严格执法，接受监督。\n国家商检部门和商检机构应当根据依法履行职责的需要，加强队伍建设，使商检工作人员具有良好的政治、业务素质。商检工作人员应当定期接受业务培训和考核，经考核合格，方可上岗执行职务。\n商检工作人员必须忠于职守，文明服务，遵守职业道德，不得滥用职权，谋取私利。",
      "order": 39
    },
    {
      "id": "law-44659fa333-0030",
      "articleNumber": 30,
      "displayNumber": "第三十条",
      "path": [
        "第四章监督管理"
      ],
      "text": "国家商检部门和商检机构应当建立健全内部监督制度，对其工作人员的执法活动进行监督检查。\n商检机构内部负责受理报检、检验、出证放行等主要岗位的职责权限应当明确，并相互分离、相互制约。",
      "order": 42
    },
    {
      "id": "law-44659fa333-0031",
      "articleNumber": 31,
      "displayNumber": "第三十一条",
      "path": [
        "第四章监督管理"
      ],
      "text": "任何单位和个人均有权对国家商检部门、商检机构及其工作人员的违法、违纪行为进行控告、检举。收到控告、检举的机关应当依法按照职责分工及时查处，并为控告人、检举人保密。",
      "order": 44
    },
    {
      "id": "law-44659fa333-0032",
      "articleNumber": 32,
      "displayNumber": "第三十二条",
      "path": [
        "第五章法律责任"
      ],
      "text": "违反本法规定，将必须经商检机构检验的进口商品未报经检验而擅自销售或者使用的，或者将必须经商检机构检验的出口商品未报经检验合格而擅自出口的，由商检机构没收违法所得，并处货值金额百分之五以上百分之二十以下的罚款；构成犯罪的，依法追究刑事责任。",
      "order": 46
    },
    {
      "id": "law-44659fa333-0033",
      "articleNumber": 33,
      "displayNumber": "第三十三条",
      "path": [
        "第五章法律责任"
      ],
      "text": "进口或者出口属于掺杂掺假、以假充真、以次充好的商品或者以不合格进出口商品冒充合格进出口商品的，由商检机构责令停止进口或者出口，没收违法所得，并处货值金额百分之五十以上三倍以下的罚款；构成犯罪的，依法追究刑事责任。",
      "order": 47
    },
    {
      "id": "law-44659fa333-0034",
      "articleNumber": 34,
      "displayNumber": "第三十四条",
      "path": [
        "第五章法律责任"
      ],
      "text": "伪造、变造、买卖或者盗窃商检单证、印章、标志、封识、质量认证标志的，依法追究刑事责任；尚不够刑事处罚的，由商检机构、认证认可监督管理部门依据各自职责责令改正，没收违法所得，并处货值金额等值以下的罚款。",
      "order": 48
    },
    {
      "id": "law-44659fa333-0035",
      "articleNumber": 35,
      "displayNumber": "第三十五条",
      "path": [
        "第五章法律责任"
      ],
      "text": "国家商检部门、商检机构的工作人员违反本法规定，泄露所知悉的商业秘密的，依法给予行政处分，有违法所得的，没收违法所得；构成犯罪的，依法追究刑事责任。",
      "order": 49
    },
    {
      "id": "law-44659fa333-0036",
      "articleNumber": 36,
      "displayNumber": "第三十六条",
      "path": [
        "第五章法律责任"
      ],
      "text": "国家商检部门、商检机构的工作人员滥用职权，故意刁难的，徇私舞弊，伪造检验结果的，或者玩忽职守，延误检验出证的，依法给予行政处分；构成犯罪的，依法追究刑事责任。",
      "order": 50
    },
    {
      "id": "law-44659fa333-0037",
      "articleNumber": 37,
      "displayNumber": "第三十七条",
      "path": [
        "第六章附则"
      ],
      "text": "商检机构和其他检验机构依照本法的规定实施检验和办理检验鉴定业务，依照国家有关规定收取费用。",
      "order": 52
    },
    {
      "id": "law-44659fa333-0038",
      "articleNumber": 38,
      "displayNumber": "第三十八条",
      "path": [
        "第六章附则"
      ],
      "text": "国务院根据本法制定实施条例。",
      "order": 53
    },
    {
      "id": "law-44659fa333-0039",
      "articleNumber": 39,
      "displayNumber": "第三十九条",
      "path": [
