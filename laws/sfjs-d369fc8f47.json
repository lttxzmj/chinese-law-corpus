{
  "id": "sfjs-d369fc8f47",
  "officialId": "",
  "title": "最高人民法院关于审理拐卖妇女儿童犯罪案件具体应用法律若干问题的解释",
  "category": "司法解释",
  "issuingAuthority": "最高人民法院",
  "promulgationDate": "2016-12-21",
  "effectiveDate": "2017-01-01",
  "status": "effective",
  "source": {
    "metadataPath": "data/laws/sfjs-d369fc8f47/metadata.json",
    "docxPath": "data/laws/sfjs-d369fc8f47/official.docx"
  },
  "paragraphCount": 20,
  "sectionCount": 0,
  "articleCount": 10,
  "sections": [],
  "articles": [
    {
      "id": "sfjs-d369fc8f47-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [],
      "text": "对婴幼儿采取欺骗、利诱等手段使其脱离监护人或者看护人的，视为刑法第二百四十条第一款第（六）项规定的“偷盗婴幼儿”。",
      "order": 1
    },
    {
      "id": "sfjs-d369fc8f47-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [],
      "text": "医疗机构、社会福利机构等单位的工作人员以非法获利为目的，将所诊疗、护理、抚养的儿童出卖给他人的，以拐卖儿童罪论处。",
      "order": 2
    },
    {
      "id": "sfjs-d369fc8f47-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [],
      "text": "以介绍婚姻为名，采取非法扣押身份证件、限制人身自由等方式，或者利用妇女人地生疏、语言不通、孤立无援等境况，违背妇女意志，将其出卖给他人的，应当以拐卖妇女罪追究刑事责任。\n以介绍婚姻为名，与被介绍妇女串通骗取他人钱财，数额较大的，应当以诈骗罪追究刑事责任。",
      "order": 3
    },
    {
      "id": "sfjs-d369fc8f47-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [],
      "text": "在国家机关工作人员排查来历不明儿童或者进行解救时，将所收买的儿童藏匿、转移或者实施其他妨碍解救行为，经说服教育仍不配合的，属于刑法第二百四十一条第六款规定的“阻碍对其进行解救”。",
      "order": 5
    },
    {
      "id": "sfjs-d369fc8f47-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [],
      "text": "收买被拐卖的妇女，业已形成稳定的婚姻家庭关系，解救时被买妇女自愿继续留在当地共同生活的，可以视为“按照被买妇女的意愿，不阻碍其返回原居住地”。",
      "order": 6
    },
    {
      "id": "sfjs-d369fc8f47-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [],
      "text": "收买被拐卖的妇女、儿童后又组织、强迫卖淫或者组织乞讨、进行违反治安管理活动等构成其他犯罪的，依照数罪并罚的规定处罚。",
      "order": 7
    },
    {
      "id": "sfjs-d369fc8f47-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [],
      "text": "收买被拐卖的妇女、儿童，又以暴力、威胁方法阻碍国家机关工作人员解救被收买的妇女、儿童，或者聚众阻碍国家机关工作人员解救被收买的妇女、儿童，构成妨害公务罪、聚众阻碍解救被收买的妇女、儿童罪的，依照数罪并罚的规定处罚。",
      "order": 8
    },
    {
      "id": "sfjs-d369fc8f47-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [],
      "text": "出于结婚目的收买被拐卖的妇女，或者出于抚养目的收买被拐卖的儿童，涉及多名家庭成员、亲友参与的，对其中起主要作用的人员应当依法追究刑事责任。",
      "order": 9
    },
    {
      "id": "sfjs-d369fc8f47-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [],
      "text": "刑法第二百四十条、第二百四十一条规定的儿童，是指不满十四周岁的人。其中，不满一周岁的为婴儿，一周岁以上不满六周岁的为幼儿。",
      "order": 10
    },
    {
      "id": "sfjs-d369fc8f47-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [],
      "text": "本解释自2017年1月1日起施行。",
      "order": 11
    }
  ]
}
