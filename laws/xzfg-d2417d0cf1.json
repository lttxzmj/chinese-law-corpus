{
  "id": "xzfg-d2417d0cf1",
  "officialId": "国务院令第151号",
  "title": "教学成果奖励条例",
  "category": "行政法规",
  "issuingAuthority": "国务院",
  "promulgationDate": "2024-03-10",
  "effectiveDate": "2024-05-01",
  "status": "effective",
  "source": {
    "metadataPath": "data/laws/xzfg-d2417d0cf1/metadata.json",
    "docxPath": "data/laws/xzfg-d2417d0cf1/official.docx"
  },
  "paragraphCount": 22,
  "sectionCount": 0,
  "articleCount": 16,
  "sections": [],
  "articles": [
    {
      "id": "xzfg-d2417d0cf1-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [],
      "text": "为奖励取得教学成果的集体和个人，鼓励教育工作者从事教育教学研究，提高教学水平和教育质量，制定本条例。",
      "order": 1
    },
    {
      "id": "xzfg-d2417d0cf1-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [],
      "text": "本条例所称教学成果，是指反映教育教学规律，具有独创性、新颖性、实用性，对提高教学水平和教育质量、实现培养目标产生明显效果的教育教学方案。",
      "order": 2
    },
    {
      "id": "xzfg-d2417d0cf1-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [],
      "text": "各级各类学校、学术团体和其他社会组织、教师及其他个人，均可以依照本条例的规定申请教学成果奖。",
      "order": 3
    },
    {
      "id": "xzfg-d2417d0cf1-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [],
      "text": "教学成果奖，按其对提高教学水平和教育质量、实现培养目标产生的效果，分为国家级和省（部）级。",
      "order": 4
    },
    {
      "id": "xzfg-d2417d0cf1-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [],
      "text": "具备下列条件的，可以申请国家级教学成果奖：\n（一）国内首创的；\n（二）经过2年以上教育教学实践检验的；\n（三）在全国产生一定影响的。",
      "order": 5
    },
    {
      "id": "xzfg-d2417d0cf1-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [],
      "text": "国家级教学成果奖分为特等奖、一等奖、二等奖三个等级，授予相应的证书、奖章和奖金。",
      "order": 9
    },
    {
      "id": "xzfg-d2417d0cf1-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [],
      "text": "国家级教学成果奖的评审、批准和授予工作，由国务院教育行政部门负责；其中授予特等奖的，应当报经国务院批准。",
      "order": 10
    },
    {
      "id": "xzfg-d2417d0cf1-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [],
      "text": "申请国家级教学成果奖，由成果的持有单位或者个人，按照其行政隶属关系，向省、自治区、直辖市人民政府教育行政部门或者国务院有关部门教育管理机构提出申请，由受理申请的教育行政部门或者教育管理机构向国务院教育行政部门推荐。\n国务院有关部门所属单位或者个人也可以向所在地省、自治区、直辖市人民政府教育行政部门提出申请，由受理申请的教育行政部门向国务院教育行政部门推荐。",
      "order": 11
    },
    {
      "id": "xzfg-d2417d0cf1-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [],
      "text": "不属于同一省、自治区、直辖市或者国务院部门的两个以上单位或者个人共同完成的教学成果项目申请国家级教学成果奖的，由参加单位或者个人联合向主持单位或者主持人所在地省、自治区、直辖市人民政府教育行政部门或者国务院有关部门教育管理机构提出申请，由受理申请的教育行政部门或者教育管理机构向国务院教育行政部门推荐。",
      "order": 13
    },
    {
      "id": "xzfg-d2417d0cf1-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [],
      "text": "国务院教育行政部门对申请国家级教学成果奖的项目，应当自收到推荐之日起90日内予以公布；任何单位或者个人对该教学成果权属有异议的，可以自公布之日起90日内提出，报国务院教育行政部门裁定。",
      "order": 14
    },
    {
      "id": "xzfg-d2417d0cf1-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [],
      "text": "国家级教学成果奖每4年评审一次。",
      "order": 15
    },
    {
      "id": "xzfg-d2417d0cf1-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [],
      "text": "省（部）级教学成果奖的评奖条件、奖励等级、奖金数额、评审组织和办法，由省、自治区、直辖市人民政府、国务院有关部门参照本条例规定。其奖金来源，属于省、自治区、直辖市人民政府批准授予的，从地方预算安排的事业费中支付；属于国务院有关部门批准授予的，从其事业费中支付。",
      "order": 16
    },
    {
      "id": "xzfg-d2417d0cf1-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [],
      "text": "教学成果奖的奖金，归项目获奖者所有，任何单位或者个人不得截留。",
      "order": 17
    },
    {
      "id": "xzfg-d2417d0cf1-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [],
      "text": "获得教学成果奖，应当记入本人考绩档案，作为评定职称、晋级增薪的一项重要依据。",
      "order": 18
    },
    {
      "id": "xzfg-d2417d0cf1-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [],
      "text": "弄虚作假或者剽窃他人教学成果获奖的，由授奖单位予以撤销，收回证书、奖章和奖金，并责成有关单位给予行政处分。",
      "order": 19
    },
    {
      "id": "xzfg-d2417d0cf1-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [],
      "text": "本条例自发布之日起施行。",
      "order": 20
    }
  ]
}
