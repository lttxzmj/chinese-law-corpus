  "title": "最高人民法院关于审理倒卖车票刑事案件有关问题的解释",
  "category": "司法解释",
  "issuingAuthority": "最高人民法院",
  "promulgationDate": "1999-09-06",
  "effectiveDate": "1999-09-14",
