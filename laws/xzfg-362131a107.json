  "articles": [
    {
      "id": "xzfg-362131a107-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了加强对军品出口的统一管理，维护正常的军品出口秩序，制定本条例。",
      "order": 2
    },
    {
      "id": "xzfg-362131a107-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "本条例所称军品出口，是指用于军事目的的装备、专用生产设备及其他物资、技术和有关服务的贸易性出口。\n前款所称军品出口，纳入军品出口管理清单。军品出口管理清单由国家军品出口主管部门制定、调整并公布。",
      "order": 3
    },
    {
      "id": "xzfg-362131a107-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "国家军品出口主管部门在国务院、中央军事委员会的领导下，主管全国的军品出口工作，对全国的军品出口实施监督管理。",
      "order": 5
    },
    {
      "id": "xzfg-362131a107-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "国家实行统一的军品出口管理制度，禁止任何损害国家的利益和安全的军品出口行为，依法保障正常的军品出口秩序。",
      "order": 6
    },
    {
      "id": "xzfg-362131a107-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "军品出口应当遵循下列原则：\n(一)有助于接受国的正当自卫能力；\n(二)不损害有关地区的和世界的和平、安全与稳定；\n(三)不干涉接受国的内政。",
      "order": 7
    },
    {
      "id": "xzfg-362131a107-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第一章总则"
      ],
      "text": "中华人民共和国缔结或者参加的国际条约同本条例有不同规定的，适用国际条约的规定；但是，中华人民共和国声明保留的条款除外。",
      "order": 11
    },
    {
      "id": "xzfg-362131a107-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第二章军品贸易公司"
      ],
      "text": "本条例所称军品贸易公司，是指依法取得军品出口经营权，并在核定的经营范围内从事军品出口经营活动的企业法人。",
      "order": 13
    },
    {
      "id": "xzfg-362131a107-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第二章军品贸易公司"
      ],
      "text": "军品出口经营权由国家军品出口主管部门审查批准。具体办法由国家军品出口主管部门规定。",
      "order": 14
    },
    {
      "id": "xzfg-362131a107-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第二章军品贸易公司"
      ],
      "text": "军品贸易公司依法自主经营、自负盈亏。",
      "order": 15
    },
    {
      "id": "xzfg-362131a107-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第二章军品贸易公司"
      ],
      "text": "军品贸易公司应当信守合同，保证商品质量，完善售后服务。",
      "order": 16
    },
    {
      "id": "xzfg-362131a107-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第二章军品贸易公司"
      ],
      "text": "军品贸易公司应当按照国家军品出口主管部门的规定，如实提交与其军品出口经营活动有关的文件及资料。国家军品出口主管部门应当为军品贸易公司保守商业秘密，维护军品贸易公司的合法权益。",
      "order": 17
    },
    {
      "id": "xzfg-362131a107-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第二章军品贸易公司"
      ],
      "text": "军品贸易公司可以委托经批准的军品出口运输企业，办理军品出口运输及相关业务。具体办法由国家军品出口主管部门规定。",
      "order": 18
    },
    {
      "id": "xzfg-362131a107-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第三章军品出口管理"
      ],
      "text": "国家对军品出口实行许可制度。\n军品出口项目、合同，应当依照本条例的规定申请审查批准。军品出口，应当凭军品出口许可证。",
      "order": 20
    },
    {
      "id": "xzfg-362131a107-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第三章军品出口管理"
      ],
      "text": "军品出口项目，由国家军品出口主管部门或者由国家军品出口主管部门会同国务院、中央军事委员会的有关部门审查批准。",
      "order": 22
    },
    {
      "id": "xzfg-362131a107-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第三章军品出口管理"
      ],
      "text": "军品出口项目经批准后，军品贸易公司可以对外签订军品出口合同。军品出口合同签订后，应当向国家军品出口主管部门申请审查批准；国家军品出口主管部门应当自收到申请之日起20日内作出决定。军品出口合同获得批准，方可生效。\n军品贸易公司向国家军品出口主管部门申请批准军品出口合同时，应当附送接受国的有效证明文件。",
      "order": 23
    },
    {
      "id": "xzfg-362131a107-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第三章军品出口管理"
      ],
      "text": "重大的军品出口项目、合同，应当经国家军品出口主管部门会同国务院、中央军事委员会的有关部门审查，报国务院和中央军事委员会批准。",
      "order": 25
    },
    {
      "id": "xzfg-362131a107-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第三章军品出口管理"
      ],
      "text": "军品贸易公司在军品出口前，应当凭军品出口合同批准文件，向国家军品出口主管部门申请领取军品出口许可证；符合军品出口合同规定的，国家军品出口主管部门应当自收到申请之日起10日内签发军品出口许可证。\n海关凭军品出口许可证接受申报，并按照国家有关规定验放。",
      "order": 26
    },
    {
      "id": "xzfg-362131a107-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第三章军品出口管理"
      ],
      "text": "军品出口项目、合同的审查批准办法和军品出口许可证的签发办法，由国家军品出口主管部门制定。",
      "order": 28
    },
    {
      "id": "xzfg-362131a107-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第三章军品出口管理"
      ],
      "text": "军品出口，由国家军品出口主管部门会同有关部门下达军品出口通知。有关部门和地方人民政府收到军品出口通知后，应当按照国家有关规定认真履行职责，保证军品出口的安全、迅速、准确。",
      "order": 29
    },
    {
      "id": "xzfg-362131a107-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第四章军品出口秩序"
      ],
      "text": "未取得军品出口经营权的任何单位或者组织，不得从事军品出口经营活动。\n国家禁止个人从事军品出口经营活动。",
      "order": 31
    },
    {
      "id": "xzfg-362131a107-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第四章军品出口秩序"
      ],
      "text": "军品贸易公司在军品出口经营活动中，应当遵守法律和行政法规的规定，维护正常的军品出口秩序。",
      "order": 33
    },
    {
      "id": "xzfg-362131a107-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第四章军品出口秩序"
      ],
      "text": "军品贸易公司在军品出口经营活动中，不得有下列行为：\n(一)危害国家安全或者社会公共利益；\n(二)以不正当竞争手段排挤竞争对手；\n(三)侵害中华人民共和国法律保护的知识产权；\n(四)伪造、变造、骗取或者转让军品出口项目批准文件、合同批准文件、许可证和接受国的有效证明文件等单证；\n(五)超越核定的经营范围经营；\n(六)违反法律和行政法规规定的其他行为。",
      "order": 34
    },
    {
      "id": "xzfg-362131a107-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第四章军品出口秩序"
      ],
      "text": "国家军品出口主管部门认为必要时或者根据军品贸易公司的请求，可以对妨碍正常的军品出口秩序的行为进行处理。",
      "order": 41
    },
    {
      "id": "xzfg-362131a107-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第五章法律责任"
      ],
      "text": "军品贸易公司违反本条例第十一条规定的，由国家军品出口主管部门责令限期改正，予以警告；逾期不改正的，处2万元以上10万元以下的罚款，暂停直至撤销其军品出口经营权。",
      "order": 43
    },
    {
      "id": "xzfg-362131a107-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第五章法律责任"
      ],
      "text": "军品贸易公司违反本条例第二十二条第(四)项、第(五)项规定，触犯刑律的，依照刑法关于非法经营罪，伪造、变造、买卖国家机关公文、证件、印章罪或者其他罪的规定，依法追究刑事责任；尚不够刑事处罚的，由国家军品出口主管部门予以警告，没收违法所得，并处违法所得1倍以上3倍以下的罚款，没有违法所得或者违法所得不足10万元的，处10万元以上30万元以下的罚款，暂停直至撤销其军品出口经营权。\n军品贸易公司违反本条例第二十二条第(一)项、第(二)项、第(三)项规定或者其他法律、行政法规规定的，由国家有关主管部门依照有关法律和行政法规的规定予以处罚，国家军品出口主管部门并可以暂停直至撤销其军品出口经营权；触犯刑律的，依照刑法有关规定，依法追究刑事责任。",
      "order": 44
    },
    {
      "id": "xzfg-362131a107-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第五章法律责任"
      ],
      "text": "违反本条例第二十条规定的，由国家军品出口主管部门取缔非法活动；触犯刑律的，依照刑法关于非法经营罪或者其他罪的规定，依法追究刑事责任；尚不够刑事处罚的，由国家军品出口主管部门予以警告，没收违法所得，并处违法所得1倍以上5倍以下的罚款，没有违法所得或者违法所得不足10万元的，处10万元以上50万元以下的罚款。",
      "order": 46
    },
    {
      "id": "xzfg-362131a107-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第五章法律责任"
      ],
      "text": "军品贸易公司对国家军品出口主管部门作出的具体行政行为不服的，应当先依法申请行政复议；对行政复议决定仍不服的，可以依法向人民法院提起行政诉讼。",
      "order": 47
    },
    {
      "id": "xzfg-362131a107-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第五章法律责任"
      ],
      "text": "国家军品出口管理工作人员滥用职权、玩忽职守或者利用职务上的便利收受、索取他人财物，触犯刑律的，依照刑法关于滥用职权罪、玩忽职守罪、受贿罪或者其他罪的规定，依法追究刑事责任；尚不够刑事处罚的，依法给予行政处分。",
      "order": 48
    },
    {
      "id": "xzfg-362131a107-0029",
      "articleNumber": 29,
      "displayNumber": "第二十九条",
      "path": [
        "第六章附则"
      ],
      "text": "警用装备的出口适用本条例。",
      "order": 50
    },
    {
      "id": "xzfg-362131a107-0030",
      "articleNumber": 30,
      "displayNumber": "第三十条",
      "path": [
        "第六章附则"
      ],
      "text": "本条例自1998年1月1日起施行。",
      "order": 51
    }
  ]
}
