  "articles": [
    {
      "id": "law-373a1450f2-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了规范军人保险关系，维护军人合法权益，促进国防和军队建设，制定本法。",
      "order": 2
    },
    {
      "id": "law-373a1450f2-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "国家建立军人保险制度。\n军人伤亡保险、退役养老保险、退役医疗保险和随军未就业的军人配偶保险的建立、缴费和转移接续等适用本法。",
      "order": 3
    },
    {
      "id": "law-373a1450f2-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "军人保险制度应当体现军人职业特点，与社会保险制度相衔接，与经济社会发展水平相适应。\n国家根据社会保险制度的发展，适时补充完善军人保险制度。",
      "order": 5
    },
    {
      "id": "law-373a1450f2-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "国家促进军人保险事业的发展，为军人保险提供财政拨款和政策支持。",
      "order": 7
    },
    {
      "id": "law-373a1450f2-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "中国人民解放军军人保险主管部门负责全军的军人保险工作。国务院社会保险行政部门、财政部门和军队其他有关部门在各自职责范围内负责有关的军人保险工作。\n军队后勤（联勤）机关财务部门负责承办军人保险登记、个人权益记录、军人保险待遇支付等工作。\n军队后勤（联勤）机关财务部门和地方社会保险经办机构，按照各自职责办理军人保险与社会保险关系转移接续手续。",
      "order": 8
    },
    {
      "id": "law-373a1450f2-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第一章总则"
      ],
      "text": "军人依法参加军人保险并享受相应的保险待遇。\n军人有权查询、核对个人缴费记录和个人权益记录，要求军队后勤（联勤）机关财务部门和地方社会保险经办机构依法办理养老、医疗等保险关系转移接续手续，提供军人保险和社会保险咨询等相关服务。",
      "order": 11
    },
    {
      "id": "law-373a1450f2-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第二章军人伤亡保险"
      ],
      "text": "军人因战、因公死亡的，按照认定的死亡性质和相应的保险金标准，给付军人死亡保险金。",
      "order": 14
    },
    {
      "id": "law-373a1450f2-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第二章军人伤亡保险"
      ],
      "text": "军人因战、因公、因病致残的，按照评定的残疾等级和相应的保险金标准，给付军人残疾保险金。",
      "order": 15
    },
    {
      "id": "law-373a1450f2-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第二章军人伤亡保险"
      ],
      "text": "军人死亡和残疾的性质认定、残疾等级评定和相应的保险金标准，按照国家和军队有关规定执行。",
      "order": 16
    },
    {
      "id": "law-373a1450f2-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第二章军人伤亡保险"
      ],
      "text": "军人因下列情形之一死亡或者致残的，不享受军人伤亡保险待遇：\n（一）故意犯罪的；\n（二）醉酒或者吸毒的；\n（三）自残或者自杀的；\n（四）法律、行政法规和军事法规规定的其他情形。",
      "order": 17
    },
    {
      "id": "law-373a1450f2-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第二章军人伤亡保险"
      ],
      "text": "已经评定残疾等级的因战、因公致残的军人退出现役参加工作后旧伤复发的，依法享受相应的工伤待遇。",
      "order": 22
    },
    {
      "id": "law-373a1450f2-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第二章军人伤亡保险"
      ],
      "text": "军人伤亡保险所需资金由国家承担，个人不缴纳保险费。",
      "order": 23
    },
    {
      "id": "law-373a1450f2-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第三章退役养老保险"
      ],
      "text": "军人退出现役参加基本养老保险的，国家给予退役养老保险补助。",
      "order": 25
    },
    {
      "id": "law-373a1450f2-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第三章退役养老保险"
      ],
      "text": "军人退役养老保险补助标准，由中国人民解放军总后勤部会同国务院有关部门，按照国家规定的基本养老保险缴费标准、军人工资水平等因素拟订，报国务院、中央军事委员会批准。",
      "order": 26
    },
    {
      "id": "law-373a1450f2-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第三章退役养老保险"
      ],
      "text": "军人入伍前已经参加基本养老保险的，由地方社会保险经办机构和军队后勤（联勤）机关财务部门办理基本养老保险关系转移接续手续。",
      "order": 27
    },
    {
      "id": "law-373a1450f2-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第三章退役养老保险"
      ],
      "text": "军人退出现役后参加职工基本养老保险的，由军队后勤（联勤）机关财务部门将军人退役养老保险关系和相应资金转入地方社会保险经办机构，地方社会保险经办机构办理相应的转移接续手续。\n军人服现役年限与入伍前和退出现役后参加职工基本养老保险的缴费年限合并计算。",
      "order": 28
    },
    {
      "id": "law-373a1450f2-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第三章退役养老保险"
      ],
      "text": "军人退出现役后参加新型农村社会养老保险或者城镇居民社会养老保险的，按照国家有关规定办理转移接续手续。",
      "order": 30
    },
    {
      "id": "law-373a1450f2-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第三章退役养老保险"
      ],
      "text": "军人退出现役到公务员岗位或者参照公务员法管理的工作人员岗位的，以及现役军官、文职干部退出现役自主择业的，其养老保险办法按照国家有关规定执行。",
      "order": 31
    },
    {
      "id": "law-373a1450f2-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第三章退役养老保险"
      ],
      "text": "军人退出现役采取退休方式安置的，其养老办法按照国务院和中央军事委员会的有关规定执行。",
      "order": 32
    },
    {
      "id": "law-373a1450f2-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第四章退役医疗保险"
      ],
      "text": "参加军人退役医疗保险的军官、文职干部和士官应当缴纳军人退役医疗保险费，国家按照个人缴纳的军人退役医疗保险费的同等数额给予补助。\n义务兵和供给制学员不缴纳军人退役医疗保险费，国家按照规定的标准给予军人退役医疗保险补助。",
      "order": 34
    },
    {
      "id": "law-373a1450f2-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第四章退役医疗保险"
      ],
      "text": "军人退役医疗保险个人缴费标准和国家补助标准，由中国人民解放军总后勤部会同国务院有关部门，按照国家规定的缴费比例、军人工资水平等因素确定。",
      "order": 36
    },
    {
      "id": "law-373a1450f2-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第四章退役医疗保险"
      ],
      "text": "军人入伍前已经参加基本医疗保险的，由地方社会保险经办机构和军队后勤（联勤）机关财务部门办理基本医疗保险关系转移接续手续。",
      "order": 37
    },
    {
      "id": "law-373a1450f2-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第四章退役医疗保险"
      ],
      "text": "军人退出现役后参加职工基本医疗保险的，由军队后勤（联勤）机关财务部门将军人退役医疗保险关系和相应资金转入地方社会保险经办机构，地方社会保险经办机构办理相应的转移接续手续。\n军人服现役年限视同职工基本医疗保险缴费年限，与入伍前和退出现役后参加职工基本医疗保险的缴费年限合并计算。",
      "order": 38
    },
    {
      "id": "law-373a1450f2-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第四章退役医疗保险"
      ],
      "text": "军人退出现役后参加新型农村合作医疗或者城镇居民基本医疗保险的，按照国家有关规定办理。",
      "order": 40
    },
    {
      "id": "law-373a1450f2-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第五章随军未就业的军人配偶保险"
      ],
      "text": "国家为随军未就业的军人配偶建立养老保险、医疗保险等。随军未就业的军人配偶参加保险，应当缴纳养老保险费和医疗保险费，国家给予相应的补助。\n随军未就业的军人配偶保险个人缴费标准和国家补助标准，按照国家有关规定执行。",
      "order": 42
    },
    {
      "id": "law-373a1450f2-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第五章随军未就业的军人配偶保险"
      ],
      "text": "随军未就业的军人配偶随军前已经参加社会保险的，由地方社会保险经办机构和军队后勤（联勤）机关财务部门办理保险关系转移接续手续。",
      "order": 44
    },
    {
      "id": "law-373a1450f2-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第五章随军未就业的军人配偶保险"
      ],
      "text": "随军未就业的军人配偶实现就业或者军人退出现役时，由军队后勤（联勤）机关财务部门将其养老保险、医疗保险关系和相应资金转入地方社会保险经办机构，地方社会保险经办机构办理相应的转移接续手续。\n军人配偶在随军未就业期间的养老保险、医疗保险缴费年限与其在地方参加职工基本养老保险、职工基本医疗保险的缴费年限合并计算。",
      "order": 45
    },
    {
      "id": "law-373a1450f2-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第五章随军未就业的军人配偶保险"
      ],
      "text": "随军未就业的军人配偶达到国家规定的退休年龄时，按照国家有关规定确定退休地，由军队后勤（联勤）机关财务部门将其养老保险关系和相应资金转入退休地社会保险经办机构，享受相应的基本养老保险待遇。",
      "order": 47
    },
    {
      "id": "law-373a1450f2-0029",
      "articleNumber": 29,
      "displayNumber": "第二十九条",
      "path": [
        "第五章随军未就业的军人配偶保险"
      ],
      "text": "地方人民政府和有关部门应当为随军未就业的军人配偶提供就业指导、培训等方面的服务。\n随军未就业的军人配偶无正当理由拒不接受当地人民政府就业安置，或者无正当理由拒不接受当地人民政府指定部门、机构介绍的适当工作、提供的就业培训的，停止给予保险缴费补助。",
      "order": 48
    },
    {
      "id": "law-373a1450f2-0030",
      "articleNumber": 30,
      "displayNumber": "第三十条",
      "path": [
        "第六章军人保险基金"
      ],
      "text": "军人保险基金包括军人伤亡保险基金、军人退役养老保险基金、军人退役医疗保险基金和随军未就业的军人配偶保险基金。各项军人保险基金按照军人保险险种分别建账，分账核算，执行军队的会计制度。",
      "order": 51
    },
    {
      "id": "law-373a1450f2-0031",
      "articleNumber": 31,
      "displayNumber": "第三十一条",
      "path": [
        "第六章军人保险基金"
      ],
      "text": "军人保险基金由个人缴费、中央财政负担的军人保险资金以及利息收入等资金构成。",
      "order": 52
    },
    {
      "id": "law-373a1450f2-0032",
      "articleNumber": 32,
      "displayNumber": "第三十二条",
      "path": [
        "第六章军人保险基金"
      ],
      "text": "军人应当缴纳的保险费，由其所在单位代扣代缴。\n随军未就业的军人配偶应当缴纳的保险费，由军人所在单位代扣代缴。",
      "order": 53
    },
    {
      "id": "law-373a1450f2-0033",
      "articleNumber": 33,
      "displayNumber": "第三十三条",
      "path": [
        "第六章军人保险基金"
      ],
      "text": "中央财政负担的军人保险资金，由国务院财政部门纳入年度国防费预算。",
      "order": 55
    },
    {
      "id": "law-373a1450f2-0034",
      "articleNumber": 34,
      "displayNumber": "第三十四条",
      "path": [
        "第六章军人保险基金"
      ],
      "text": "军人保险基金按照国家和军队的预算管理制度，实行预算、决算管理。",
      "order": 56
    },
    {
      "id": "law-373a1450f2-0035",
      "articleNumber": 35,
      "displayNumber": "第三十五条",
      "path": [
        "第六章军人保险基金"
      ],
      "text": "军人保险基金实行专户存储，具体管理办法按照国家和军队有关规定执行。",
      "order": 57
    },
    {
      "id": "law-373a1450f2-0036",
      "articleNumber": 36,
      "displayNumber": "第三十六条",
      "path": [
        "第六章军人保险基金"
      ],
      "text": "军人保险基金由中国人民解放军总后勤部军人保险基金管理机构集中管理。\n军人保险基金管理机构应当严格管理军人保险基金，保证基金安全。",
      "order": 58
    },
    {
      "id": "law-373a1450f2-0037",
      "articleNumber": 37,
      "displayNumber": "第三十七条",
      "path": [
        "第六章军人保险基金"
      ],
      "text": "军人保险基金应当专款专用，按照规定的项目、范围和标准支出，任何单位和个人不得贪污、侵占、挪用，不得变更支出项目、扩大支出范围或者改变支出标准。",
      "order": 60
    },
    {
      "id": "law-373a1450f2-0038",
      "articleNumber": 38,
      "displayNumber": "第三十八条",
      "path": [
        "第七章保险经办与监督"
      ],
      "text": "军队后勤（联勤）机关财务部门和地方社会保险经办机构应当建立健全军人保险经办管理制度。\n军队后勤（联勤）机关财务部门应当按时足额支付军人保险金。\n军队后勤（联勤）机关财务部门和地方社会保险经办机构应当及时办理军人保险和社会保险关系转移接续手续。",
      "order": 62
    },
    {
      "id": "law-373a1450f2-0039",
      "articleNumber": 39,
      "displayNumber": "第三十九条",
      "path": [
        "第七章保险经办与监督"
      ],
      "text": "军队后勤（联勤）机关财务部门应当为军人及随军未就业的军人配偶建立保险档案，及时、完整、准确地记录其个人缴费和国家补助，以及享受军人保险待遇等个人权益记录，并定期将个人权益记录单送达本人。\n军队后勤（联勤）机关财务部门和地方社会保险经办机构应当为军人及随军未就业的军人配偶提供军人保险和社会保险咨询等相关服务。",
      "order": 65
    },
    {
      "id": "law-373a1450f2-0040",
      "articleNumber": 40,
      "displayNumber": "第四十条",
      "path": [
        "第七章保险经办与监督"
      ],
      "text": "军人保险信息系统由中国人民解放军总后勤部负责统一建设。",
      "order": 67
    },
    {
      "id": "law-373a1450f2-0041",
      "articleNumber": 41,
      "displayNumber": "第四十一条",
      "path": [
        "第七章保险经办与监督"
      ],
      "text": "中国人民解放军总后勤部财务部门和中国人民解放军审计机关按照各自职责，对军人保险基金的收支和管理情况实施监督。",
      "order": 68
    },
    {
      "id": "law-373a1450f2-0042",
      "articleNumber": 42,
      "displayNumber": "第四十二条",
      "path": [
        "第七章保险经办与监督"
      ],
      "text": "军队后勤（联勤）机关、地方社会保险行政部门，应当对单位和个人遵守本法的情况进行监督检查。\n军队后勤（联勤）机关、地方社会保险行政部门实施监督检查时，被检查单位和个人应当如实提供与军人保险有关的资料，不得拒绝检查或者谎报、瞒报。",
      "order": 69
    },
    {
      "id": "law-373a1450f2-0043",
      "articleNumber": 43,
      "displayNumber": "第四十三条",
      "path": [
        "第七章保险经办与监督"
      ],
      "text": "军队后勤（联勤）机关财务部门和地方社会保险经办机构及其工作人员，应当依法为军队单位和军人的信息保密，不得以任何形式泄露。",
      "order": 71
    },
    {
      "id": "law-373a1450f2-0044",
      "articleNumber": 44,
      "displayNumber": "第四十四条",
      "path": [
        "第七章保险经办与监督"
      ],
      "text": "任何单位或者个人有权对违反本法规定的行为进行举报、投诉。\n军队和地方有关部门、机构对属于职责范围内的举报、投诉，应当依法处理；对不属于本部门、本机构职责范围的，应当书面通知并移交有权处理的部门、机构处理。有权处理的部门、机构应当及时处理，不得推诿。",
      "order": 72
    },
    {
      "id": "law-373a1450f2-0045",
      "articleNumber": 45,
      "displayNumber": "第四十五条",
      "path": [
        "第八章法律责任"
      ],
      "text": "军队后勤（联勤）机关财务部门、社会保险经办机构，有下列情形之一的，由军队后勤（联勤）机关或者社会保险行政部门责令改正；对直接负责的主管人员和其他直接责任人员依法给予处分；造成损失的，依法承担赔偿责任：\n（一）不按照规定建立、转移接续军人保险关系的；\n（二）不按照规定收缴、上缴个人缴纳的保险费的；\n（三）不按照规定给付军人保险金的；\n（四）篡改或者丢失个人缴费记录等军人保险档案资料的；\n（五）泄露军队单位和军人的信息的；\n（六）违反规定划拨、存储军人保险基金的；\n（七）有违反法律、法规损害军人保险权益的其他行为的。",
      "order": 75
    },
    {
      "id": "law-373a1450f2-0046",
      "articleNumber": 46,
      "displayNumber": "第四十六条",
      "path": [
        "第八章法律责任"
      ],
      "text": "贪污、侵占、挪用军人保险基金的，由军队后勤（联勤）机关责令限期退回，对直接负责的主管人员和其他直接责任人员依法给予处分。",
      "order": 83
    },
    {
      "id": "law-373a1450f2-0047",
      "articleNumber": 47,
      "displayNumber": "第四十七条",
      "path": [
        "第八章法律责任"
      ],
      "text": "以欺诈、伪造证明材料等手段骗取军人保险待遇的，由军队后勤（联勤）机关和社会保险行政部门责令限期退回，并依法给予处分。",
      "order": 84
    },
    {
      "id": "law-373a1450f2-0048",
      "articleNumber": 48,
      "displayNumber": "第四十八条",
      "path": [
        "第八章法律责任"
      ],
      "text": "违反本法规定，构成犯罪的，依法追究刑事责任。",
      "order": 85
    },
    {
      "id": "law-373a1450f2-0049",
      "articleNumber": 49,
      "displayNumber": "第四十九条",
      "path": [
        "第九章附则"
      ],
      "text": "军人退出现役后参加失业保险的，其服现役年限视同失业保险缴费年限，与入伍前和退出现役后参加失业保险的缴费年限合并计算。",
      "order": 87
    },
    {
      "id": "law-373a1450f2-0050",
      "articleNumber": 50,
      "displayNumber": "第五十条",
      "path": [
        "第九章附则"
      ],
      "text": "本法关于军人保险权益和义务的规定，适用于人民武装警察；中国人民武装警察部队保险基金管理，按照中国人民武装警察部队资金管理体制执行。",
      "order": 88
    },
    {
      "id": "law-373a1450f2-0051",
      "articleNumber": 51,
      "displayNumber": "第五十一条",
      "path": [
        "第九章附则"
      ],
      "text": "本法自2012年7月1日起施行。",
      "order": 89
    }
  ]
}
