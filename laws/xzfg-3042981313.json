  "articles": [
    {
      "id": "xzfg-3042981313-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了加强城市道路管理，保障城市道路完好，充分发挥城市道路功能，促进城市经济和社会发展，制定本条例。",
      "order": 2
    },
    {
      "id": "xzfg-3042981313-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "本条例所称城市道路，是指城市供车辆、行人通行的，具备一定技术条件的道路、桥梁及其附属设施。",
      "order": 3
    },
    {
      "id": "xzfg-3042981313-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "本条例适用于城市道路规划、建设、养护、维修和路政管理。",
      "order": 4
    },
    {
      "id": "xzfg-3042981313-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "城市道路管理实行统一规划、配套建设、协调发展和建设、养护、管理并重的原则。",
      "order": 5
    },
    {
      "id": "xzfg-3042981313-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "国家鼓励和支持城市道路科学技术研究，推广先进技术，提高城市道路管理的科学技术水平。",
      "order": 6
    },
    {
      "id": "xzfg-3042981313-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第一章总则"
      ],
      "text": "国务院建设行政主管部门主管全国城市道路管理工作。\n省、自治区人民政府城市建设行政主管部门主管本行政区域内的城市道路管理工作。\n县级以上城市人民政府市政工程行政主管部门主管本行政区域内的城市道路管理工作。",
      "order": 7
    },
    {
      "id": "xzfg-3042981313-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第二章规划和建设"
      ],
      "text": "县级以上城市人民政府应当组织市政工程、城市规划、公安交通等部门，根据城市总体规划编制城市道路发展规划。\n市政工程行政主管部门应当根据城市道路发展规划，制定城市道路年度建设计划，经城市人民政府批准后实施。",
      "order": 11
    },
    {
      "id": "xzfg-3042981313-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第二章规划和建设"
      ],
      "text": "城市道路建设资金可以按照国家有关规定，采取政府投资、集资、国内外贷款、国有土地有偿使用收入、发行债券等多种渠道筹集。",
      "order": 13
    },
    {
      "id": "xzfg-3042981313-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第二章规划和建设"
      ],
      "text": "城市道路的建设应当符合城市道路技术规范。",
      "order": 14
    },
    {
      "id": "xzfg-3042981313-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第二章规划和建设"
      ],
      "text": "政府投资建设城市道路的，应当根据城市道路发展规划和年度建设计划，由市政工程行政主管部门组织建设。\n单位投资建设城市道路的，应当符合城市道路发展规划。\n城市住宅小区、开发区内的道路建设，应当分别纳入住宅小区、开发区的开发建设计划配套建设。",
      "order": 15
    },
    {
      "id": "xzfg-3042981313-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第二章规划和建设"
      ],
      "text": "国家鼓励国内外企业和其他组织以及个人按照城市道路发展规划，投资建设城市道路。",
      "order": 18
    },
    {
      "id": "xzfg-3042981313-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第二章规划和建设"
      ],
      "text": "城市供水、排水、燃气、热力、供电、通信、消防等依附于城市道路的各种管线、杆线等设施的建设计划，应当与城市道路发展规划和年度建设计划相协调，坚持先地下、后地上的施工原则，与城市道路同步建设。",
      "order": 19
    },
    {
      "id": "xzfg-3042981313-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第二章规划和建设"
      ],
      "text": "新建的城市道路与铁路干线相交的，应当根据需要在城市规划中预留立体交通设施的建设位置。\n城市道路与铁路相交的道口建设应当符合国家有关技术规范，并根据需要逐步建设立体交通设施。建设立体交通设施所需投资，按照国家规定由有关部门协商确定。",
      "order": 20
    },
    {
      "id": "xzfg-3042981313-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第二章规划和建设"
      ],
      "text": "建设跨越江河的桥梁和隧道，应当符合国家规定的防洪、通航标准和其他有关技术规范。",
      "order": 22
    },
    {
      "id": "xzfg-3042981313-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第二章规划和建设"
      ],
      "text": "县级以上城市人民政府应当有计划地按照城市道路技术规范改建、拓宽城市道路和公路的结合部，公路行政主管部门可以按照国家有关规定在资金上给予补助。",
      "order": 23
    },
    {
      "id": "xzfg-3042981313-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第二章规划和建设"
      ],
      "text": "承担城市道路设计、施工的单位，应当具有相应的资质等级，并按照资质等级承担相应的城市道路的设计、施工任务。",
      "order": 24
    },
    {
      "id": "xzfg-3042981313-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第二章规划和建设"
      ],
      "text": "城市道路的设计、施工，应当严格执行国家和地方规定的城市道路设计、施工的技术规范。\n城市道路施工，实行工程质量监督制度。\n城市道路工程竣工，经验收合格后，方可交付使用；未经验收或者验收不合格的，不得交付使用。",
      "order": 25
    },
    {
      "id": "xzfg-3042981313-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第二章规划和建设"
      ],
      "text": "城市道路实行工程质量保修制度。城市道路的保修期为1年，自交付使用之日起计算。保修期内出现工程质量问题，由有关责任单位负责保修。",
      "order": 28
    },
    {
      "id": "xzfg-3042981313-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第二章规划和建设"
      ],
      "text": "市政工程行政主管部门对利用贷款或者集资建设的大型桥梁、隧道等，可以在一定期限内向过往车辆(军用车辆除外)收取通行费，用于偿还贷款或者集资款，不得挪作他用。\n收取通行费的范围和期限，由省、自治区、直辖市人民政府规定。",
      "order": 29
    },
    {
      "id": "xzfg-3042981313-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第三章养护和维修"
      ],
      "text": "市政工程行政主管部门对其组织建设和管理的城市道路，按照城市道路的等级、数量及养护和维修的定额，逐年核定养护、维修经费，统一安排养护、维修资金。",
      "order": 32
    },
    {
      "id": "xzfg-3042981313-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第三章养护和维修"
      ],
      "text": "承担城市道路养护、维修的单位，应当严格执行城市道路养护、维修的技术规范，定期对城市道路进行养护、维修，确保养护、维修工程的质量。\n市政工程行政主管部门负责对养护、维修工程的质量进行监督检查，保障城市道路完好。",
      "order": 33
    },
    {
      "id": "xzfg-3042981313-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第三章养护和维修"
      ],
      "text": "市政工程行政主管部门组织建设和管理的道路，由其委托的城市道路养护、维修单位负责养护、维修。单位投资建设和管理的道路，由投资建设的单位或者其委托的单位负责养护、维修。城市住宅小区、开发区内的道路，由建设单位或者其委托的单位负责养护、维修。",
      "order": 35
    },
    {
      "id": "xzfg-3042981313-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第三章养护和维修"
      ],
      "text": "设在城市道路上的各类管线的检查井、箱盖或者城市道路附属设施，应当符合城市道路养护规范。因缺损影响交通和安全时，有关产权单位应当及时补缺或者修复。",
      "order": 36
    },
    {
      "id": "xzfg-3042981313-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第三章养护和维修"
      ],
      "text": "城市道路的养护、维修工程应当按照规定的期限修复竣工，并在养护、维修工程施工现场设置明显标志和安全防围设施，保障行人和交通车辆安全。",
      "order": 37
    },
    {
      "id": "xzfg-3042981313-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第三章养护和维修"
      ],
      "text": "城市道路养护、维修的专用车辆应当使用统一标志；执行任务时，在保证交通安全畅通的情况下，不受行驶路线和行驶方向的限制。",
      "order": 38
    },
    {
      "id": "xzfg-3042981313-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第四章路政管理"
      ],
      "text": "市政工程行政主管部门执行路政管理的人员执行公务，应当按照有关规定佩戴标志，持证上岗。",
      "order": 40
    },
    {
      "id": "xzfg-3042981313-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第四章路政管理"
      ],
      "text": "城市道路范围内禁止下列行为：\n(一)擅自占用或者挖掘城市道路；\n(二)履带车、铁轮车或者超重、超高、超长车辆擅自在城市道路上行驶；\n(三)机动车在桥梁或者非指定的城市道路上试刹车；\n(四)擅自在城市道路上建设建筑物、构筑物；\n(五)在桥梁上架设压力在4公斤/平方厘米(0.4兆帕)以上的煤气管道、10千伏以上的高压电力线和其他易燃易爆管线；\n(六)擅自在桥梁或者路灯设施上设置广告牌或者其他挂浮物；\n(七)其他损害、侵占城市道路的行为。",
      "order": 41
    },
    {
      "id": "xzfg-3042981313-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第四章路政管理"
      ],
      "text": "履带车、铁轮车或者超重、超高、超长车辆需要在城市道路上行驶的，事先须征得市政工程行政主管部门同意，并按照公安交通管理部门指定的时间、路线行驶。\n军用车辆执行任务需要在城市道路上行驶的，可以不受前款限制，但是应当按照规定采取安全保护措施。",
      "order": 49
    },
    {
      "id": "xzfg-3042981313-0029",
      "articleNumber": 29,
      "displayNumber": "第二十九条",
      "path": [
        "第四章路政管理"
      ],
      "text": "依附于城市道路建设各种管线、杆线等设施的，应当经市政工程行政主管部门批准，方可建设。",
      "order": 51
    },
    {
      "id": "xzfg-3042981313-0030",
      "articleNumber": 30,
      "displayNumber": "第三十条",
      "path": [
        "第四章路政管理"
      ],
      "text": "未经市政工程行政主管部门和公安交通管理部门批准，任何单位或者个人不得占用或者挖掘城市道路。",
      "order": 52
    },
    {
      "id": "xzfg-3042981313-0031",
      "articleNumber": 31,
      "displayNumber": "第三十一条",
      "path": [
        "第四章路政管理"
      ],
      "text": "因特殊情况需要临时占用城市道路的，须经市政工程行政主管部门和公安交通管理部门批准，方可按照规定占用。\n经批准临时占用城市道路的，不得损坏城市道路；占用期满后，应当及时清理占用现场，恢复城市道路原状；损坏城市道路的，应当修复或者给予赔偿。",
      "order": 53
    },
    {
      "id": "xzfg-3042981313-0032",
      "articleNumber": 32,
      "displayNumber": "第三十二条",
      "path": [
        "第四章路政管理"
      ],
      "text": "城市人民政府应当严格控制占用城市道路作为集贸市场。",
      "order": 55
    },
    {
      "id": "xzfg-3042981313-0033",
      "articleNumber": 33,
      "displayNumber": "第三十三条",
      "path": [
        "第四章路政管理"
      ],
      "text": "因工程建设需要挖掘城市道路的，应当提交城市规划部门批准签发的文件和有关设计文件，经市政工程行政主管部门和公安交通管理部门批准，方可按照规定挖掘。\n新建、扩建、改建的城市道路交付使用后5年内、大修的城市道路竣工后3年内不得挖掘；因特殊情况需要挖掘的，须经县级以上城市人民政府批准。",
      "order": 56
    },
    {
      "id": "xzfg-3042981313-0034",
      "articleNumber": 34,
      "displayNumber": "第三十四条",
      "path": [
        "第四章路政管理"
      ],
      "text": "埋设在城市道路下的管线发生故障需要紧急抢修的，可以先行破路抢修，并同时通知市政工程行政主管部门和公安交通管理部门，在24小时内按照规定补办批准手续。",
      "order": 58
    },
    {
      "id": "xzfg-3042981313-0035",
      "articleNumber": 35,
      "displayNumber": "第三十五条",
      "path": [
        "第四章路政管理"
      ],
      "text": "经批准挖掘城市道路的，应当在施工现场设置明显标志和安全防围设施；竣工后，应当及时清理现场，通知市政工程行政主管部门检查验收。",
      "order": 59
    },
    {
      "id": "xzfg-3042981313-0036",
      "articleNumber": 36,
      "displayNumber": "第三十六条",
      "path": [
        "第四章路政管理"
      ],
      "text": "经批准占用或者挖掘城市道路的，应当按照批准的位置、面积、期限占用或者挖掘。需要移动位置、扩大面积、延长时间的，应当提前办理变更审批手续。",
      "order": 60
    },
    {
      "id": "xzfg-3042981313-0037",
      "articleNumber": 37,
      "displayNumber": "第三十七条",
      "path": [
        "第四章路政管理"
      ],
      "text": "占用或者挖掘由市政工程行政主管部门管理的城市道路的，应当向市政工程行政主管部门交纳城市道路占用费或者城市道路挖掘修复费。\n城市道路占用费的收费标准，由省、自治区人民政府的建设行政主管部门、直辖市人民政府的市政工程行政主管部门拟订，报同级财政、物价主管部门核定；城市道路挖掘修复费的收费标准，由省、自治区人民政府的建设行政主管部门、直辖市人民政府的市政工程行政主管部门制定，报同级财政、物价主管部门备案。",
      "order": 61
    },
    {
      "id": "xzfg-3042981313-0038",
      "articleNumber": 38,
      "displayNumber": "第三十八条",
      "path": [
        "第四章路政管理"
      ],
      "text": "根据城市建设或者其他特殊需要，市政工程行政主管部门可以对临时占用城市道路的单位或者个人决定缩小占用面积、缩短占用时间或者停止占用，并根据具体情况退还部分城市道路占用费。",
      "order": 63
    },
    {
      "id": "xzfg-3042981313-0039",
      "articleNumber": 39,
      "displayNumber": "第三十九条",
      "path": [
        "第五章罚则"
      ],
      "text": "违反本条例的规定，有下列行为之一的，由市政工程行政主管部门责令停止设计、施工，限期改正，可以并处3万元以下的罚款；已经取得设计、施工资格证书，情节严重的，提请原发证机关吊销设计、施工资格证书：\n(一)未取得设计、施工资格或者未按照资质等级承担城市道路的设计、施工任务的；\n(二)未按照城市道路设计、施工技术规范设计、施工的；\n(三)未按照设计图纸施工或者擅自修改图纸的。",
      "order": 65
    },
    {
      "id": "xzfg-3042981313-0040",
      "articleNumber": 40,
      "displayNumber": "第四十条",
      "path": [
        "第五章罚则"
      ],
      "text": "违反本条例第十七条规定，擅自使用未经验收或者验收不合格的城市道路的，由市政工程行政主管部门责令限期改正，给予警告，可以并处工程造价2%以下的罚款。",
      "order": 69
    },
    {
      "id": "xzfg-3042981313-0041",
      "articleNumber": 41,
      "displayNumber": "第四十一条",
      "path": [
        "第五章罚则"
      ],
      "text": "承担城市道路养护、维修的单位违反本条例的规定，未定期对城市道路进行养护、维修或者未按照规定的期限修复竣工，并拒绝接受市政工程行政主管部门监督、检查的，由市政工程行政主管部门责令限期改正，给予警告；对负有直接责任的主管人员和其他直接责任人员，依法给予行政处分。",
      "order": 70
    },
    {
      "id": "xzfg-3042981313-0042",
      "articleNumber": 42,
      "displayNumber": "第四十二条",
      "path": [
        "第五章罚则"
      ],
      "text": "违反本条例第二十七条规定，或者有下列行为之一的，由市政工程行政主管部门或者其他有关部门责令限期改正，可以处以2万元以下的罚款；造成损失的，应当依法承担赔偿责任：\n(一)未对设在城市道路上的各种管线的检查井、箱盖或者城市道路附属设施的缺损及时补缺或者修复的；\n(二)未在城市道路施工现场设置明显标志和安全防围设施的；\n(三)占用城市道路期满或者挖掘城市道路后，不及时清理现场的；\n(四)依附于城市道路建设各种管线、杆线等设施，不按照规定办理批准手续的；\n(五)紧急抢修埋设在城市道路下的管线，不按照规定补办批准手续的；\n(六)未按照批准的位置、面积、期限占用或者挖掘城市道路，或者需要移动位置、扩大面积、延长时间，未提前办理变更审批手续的。",
      "order": 71
    },
    {
      "id": "xzfg-3042981313-0043",
      "articleNumber": 43,
      "displayNumber": "第四十三条",
      "path": [
        "第五章罚则"
      ],
      "text": "违反本条例，构成犯罪的，由司法机关依法追究刑事责任；尚不构成犯罪，应当给予治安管理处罚的，依照治安管理处罚法的规定给予处罚。",
      "order": 78
    },
    {
      "id": "xzfg-3042981313-0044",
      "articleNumber": 44,
      "displayNumber": "第四十四条",
      "path": [
        "第五章罚则"
      ],
      "text": "市政工程行政主管部门人员玩忽职守、滥用职权、徇私舞弊，构成犯罪的，依法追究刑事责任；尚不构成犯罪的，依法给予行政处分。",
      "order": 79
    },
    {
      "id": "xzfg-3042981313-0045",
      "articleNumber": 45,
      "displayNumber": "第四十五条",
      "path": [
        "第六章附则"
      ],
      "text": "本条例自1996年10月1日起施行。",
      "order": 81
    }
  ]
}
