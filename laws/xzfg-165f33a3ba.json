  ],
  "articles": [
    {
      "id": "xzfg-165f33a3ba-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了促进残疾人就业，保障残疾人的劳动权利，根据《中华人民共和国残疾人保障法》和其他有关法律，制定本条例。",
      "order": 2
    },
    {
      "id": "xzfg-165f33a3ba-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "国家对残疾人就业实行集中就业与分散就业相结合的方针，促进残疾人就业。\n县级以上人民政府应当将残疾人就业纳入国民经济和社会发展规划，并制定优惠政策和具体扶持保护措施，为残疾人就业创造条件。",
      "order": 3
    },
    {
      "id": "xzfg-165f33a3ba-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "机关、团体、企业、事业单位和民办非企业单位(以下统称用人单位)应当依照有关法律、本条例和其他有关行政法规的规定，履行扶持残疾人就业的责任和义务。",
      "order": 5
    },
    {
      "id": "xzfg-165f33a3ba-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "国家鼓励社会组织和个人通过多种渠道、多种形式，帮助、支持残疾人就业，鼓励残疾人通过应聘等多种形式就业。禁止在就业中歧视残疾人。\n残疾人应当提高自身素质，增强就业能力。",
      "order": 6
    },
    {
      "id": "xzfg-165f33a3ba-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "各级人民政府应当加强对残疾人就业工作的统筹规划，综合协调。县级以上人民政府负责残疾人工作的机构，负责组织、协调、指导、督促有关部门做好残疾人就业工作。\n县级以上人民政府劳动保障、民政等有关部门在各自的职责范围内，做好残疾人就业工作。",
      "order": 8
    },
    {
      "id": "xzfg-165f33a3ba-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第一章总则"
      ],
      "text": "中国残疾人联合会及其地方组织依照法律、法规或者接受政府委托，负责残疾人就业工作的具体组织实施与监督。\n工会、共产主义青年团、妇女联合会，应当在各自的工作范围内，做好残疾人就业工作。",
      "order": 10
    },
    {
      "id": "xzfg-165f33a3ba-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第一章总则"
      ],
      "text": "各级人民政府对在残疾人就业工作中做出显著成绩的单位和个人，给予表彰和奖励。",
      "order": 12
    },
    {
      "id": "xzfg-165f33a3ba-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第二章用人单位的责任"
      ],
      "text": "用人单位应当按照一定比例安排残疾人就业，并为其提供适当的工种、岗位。\n用人单位安排残疾人就业的比例不得低于本单位在职职工总数的1.5%。具体比例由省、自治区、直辖市人民政府根据本地区的实际情况规定。\n用人单位跨地区招用残疾人的，应当计入所安排的残疾人职工人数之内。",
      "order": 14
    },
    {
      "id": "xzfg-165f33a3ba-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第二章用人单位的责任"
      ],
      "text": "用人单位安排残疾人就业达不到其所在地省、自治区、直辖市人民政府规定比例的，应当缴纳残疾人就业保障金。",
      "order": 17
    },
    {
      "id": "xzfg-165f33a3ba-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第二章用人单位的责任"
      ],
      "text": "政府和社会依法兴办的残疾人福利企业、盲人按摩机构和其他福利性单位(以下统称集中使用残疾人的用人单位)，应当集中安排残疾人就业。\n集中使用残疾人的用人单位的资格认定，按照国家有关规定执行。",
      "order": 18
    },
    {
      "id": "xzfg-165f33a3ba-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第二章用人单位的责任"
      ],
      "text": "集中使用残疾人的用人单位中从事全日制工作的残疾人职工，应当占本单位在职职工总数的25%以上。",
      "order": 20
    },
    {
      "id": "xzfg-165f33a3ba-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第二章用人单位的责任"
      ],
      "text": "用人单位招用残疾人职工，应当依法与其签订劳动合同或者服务协议。",
      "order": 21
    },
    {
      "id": "xzfg-165f33a3ba-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第二章用人单位的责任"
      ],
      "text": "用人单位应当为残疾人职工提供适合其身体状况的劳动条件和劳动保护，不得在晋职、晋级、评定职称、报酬、社会保险、生活福利等方面歧视残疾人职工。",
      "order": 22
    },
    {
      "id": "xzfg-165f33a3ba-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第二章用人单位的责任"
      ],
      "text": "用人单位应当根据本单位残疾人职工的实际情况，对残疾人职工进行上岗、在岗、转岗等培训。",
      "order": 23
    },
    {
      "id": "xzfg-165f33a3ba-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第三章保障措施"
      ],
      "text": "县级以上人民政府应当采取措施，拓宽残疾人就业渠道，开发适合残疾人就业的公益性岗位，保障残疾人就业。\n县级以上地方人民政府发展社区服务事业，应当优先考虑残疾人就业。",
      "order": 25
    },
    {
      "id": "xzfg-165f33a3ba-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第三章保障措施"
      ],
      "text": "依法征收的残疾人就业保障金应当纳入财政预算，专项用于残疾人职业培训以及为残疾人提供就业服务和就业援助，任何组织或者个人不得贪污、挪用、截留或者私分。残疾人就业保障金征收、使用、管理的具体办法，由国务院财政部门会同国务院有关部门规定。\n财政部门和审计机关应当依法加强对残疾人就业保障金使用情况的监督检查。",
      "order": 27
    },
    {
      "id": "xzfg-165f33a3ba-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第三章保障措施"
      ],
      "text": "国家对集中使用残疾人的用人单位依法给予税收优惠，并在生产、经营、技术、资金、物资、场地使用等方面给予扶持。",
      "order": 29
    },
    {
      "id": "xzfg-165f33a3ba-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第三章保障措施"
      ],
      "text": "县级以上地方人民政府及其有关部门应当确定适合残疾人生产、经营的产品、项目，优先安排集中使用残疾人的用人单位生产或者经营，并根据集中使用残疾人的用人单位的生产特点确定某些产品由其专产。\n政府采购，在同等条件下，应当优先购买集中使用残疾人的用人单位的产品或者服务。",
      "order": 30
    },
    {
      "id": "xzfg-165f33a3ba-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第三章保障措施"
      ],
      "text": "国家鼓励扶持残疾人自主择业、自主创业。对残疾人从事个体经营的，应当依法给予税收优惠，有关部门应当在经营场地等方面给予照顾，并按照规定免收管理类、登记类和证照类的行政事业性收费。\n国家对自主择业、自主创业的残疾人在一定期限内给予小额信贷等扶持。",
      "order": 32
    },
    {
      "id": "xzfg-165f33a3ba-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第三章保障措施"
      ],
      "text": "地方各级人民政府应当多方面筹集资金，组织和扶持农村残疾人从事种植业、养殖业、手工业和其他形式的生产劳动。\n有关部门对从事农业生产劳动的农村残疾人，应当在生产服务、技术指导、农用物资供应、农副产品收购和信贷等方面给予帮助。",
      "order": 34
    },
    {
      "id": "xzfg-165f33a3ba-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第四章就业服务"
      ],
      "text": "各级人民政府和有关部门应当为就业困难的残疾人提供有针对性的就业援助服务，鼓励和扶持职业培训机构为残疾人提供职业培训，并组织残疾人定期开展职业技能竞赛。",
      "order": 37
    },
    {
      "id": "xzfg-165f33a3ba-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第四章就业服务"
      ],
      "text": "中国残疾人联合会及其地方组织所属的残疾人就业服务机构应当免费为残疾人就业提供下列服务：\n(一)发布残疾人就业信息；\n(二)组织开展残疾人职业培训；\n(三)为残疾人提供职业心理咨询、职业适应评估、职业康复训练、求职定向指导、职业介绍等服务；\n(四)为残疾人自主择业提供必要的帮助；\n(五)为用人单位安排残疾人就业提供必要的支持。\n国家鼓励其他就业服务机构为残疾人就业提供免费服务。",
      "order": 38
    },
    {
      "id": "xzfg-165f33a3ba-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第四章就业服务"
      ],
      "text": "受劳动保障部门的委托，残疾人就业服务机构可以进行残疾人失业登记、残疾人就业与失业统计；经所在地劳动保障部门批准，残疾人就业服务机构还可以进行残疾人职业技能鉴定。",
      "order": 45
    },
    {
      "id": "xzfg-165f33a3ba-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第四章就业服务"
      ],
      "text": "残疾人职工与用人单位发生争议的，当地法律援助机构应当依法为其提供法律援助，各级残疾人联合会应当给予支持和帮助。",
      "order": 46
    },
    {
      "id": "xzfg-165f33a3ba-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第五章法律责任"
      ],
      "text": "违反本条例规定，有关行政主管部门及其工作人员滥用职权、玩忽职守、徇私舞弊，构成犯罪的，依法追究刑事责任；尚不构成犯罪的，依法给予处分。",
      "order": 48
    },
    {
      "id": "xzfg-165f33a3ba-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第五章法律责任"
      ],
      "text": "违反本条例规定，贪污、挪用、截留、私分残疾人就业保障金，构成犯罪的，依法追究刑事责任；尚不构成犯罪的，对有关责任单位、直接负责的主管人员和其他直接责任人员依法给予处分或者处罚。",
      "order": 49
    },
    {
      "id": "xzfg-165f33a3ba-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第五章法律责任"
      ],
      "text": "违反本条例规定，用人单位未按照规定缴纳残疾人就业保障金的，由财政部门给予警告，责令限期缴纳；逾期仍不缴纳的，除补缴欠缴数额外，还应当自欠缴之日起，按日加收5‰的滞纳金。",
      "order": 50
    },
    {
      "id": "xzfg-165f33a3ba-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第五章法律责任"
      ],
      "text": "违反本条例规定，用人单位弄虚作假，虚报安排残疾人就业人数，骗取集中使用残疾人的用人单位享受的税收优惠待遇的，由税务机关依法处理。",
      "order": 51
    },
    {
      "id": "xzfg-165f33a3ba-0029",
      "articleNumber": 29,
      "displayNumber": "第二十九条",
      "path": [
        "第六章附则"
      ],
      "text": "本条例所称残疾人就业，是指符合法定就业年龄有就业要求的残疾人从事有报酬的劳动。",
      "order": 53
    },
    {
      "id": "xzfg-165f33a3ba-0030",
      "articleNumber": 30,
      "displayNumber": "第三十条",
      "path": [
        "第六章附则"
      ],
      "text": "本条例自2007年5月1日起施行。",
      "order": 54
    }
  ]
}
