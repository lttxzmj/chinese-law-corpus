{
  "id": "xzfg-165f33a3ba",
  "officialId": "国务院令第488号",
  "title": "残疾人就业条例",
  "category": "行政法规",
  "issuingAuthority": "国务院",
  "promulgationDate": "2007-02-25",
  "effectiveDate": "",
