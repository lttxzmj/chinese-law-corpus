  ],
  "articles": [
    {
      "id": "xzfg-8990c55479-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了规范事业单位登记管理，保障事业单位的合法权益，发挥事业单位在社会主义物质文明和精神文明建设中的作用，制定本条例。",
      "order": 2
    },
    {
      "id": "xzfg-8990c55479-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "本条例所称事业单位，是指国家为了社会公益目的，由国家机关举办或者其他组织利用国有资产举办的，从事教育、科技、文化、卫生等活动的社会服务组织。\n事业单位依法举办的营利性经营组织，必须实行独立核算，依照国家有关公司、企业等经营组织的法律、法规登记管理。",
      "order": 3
    },
    {
      "id": "xzfg-8990c55479-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "事业单位经县级以上各级人民政府及其有关主管部门(以下统称审批机关)批准成立后，应当依照本条例的规定登记或者备案。\n事业单位应当具备法人条件。",
      "order": 5
    },
    {
      "id": "xzfg-8990c55479-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "事业单位应当遵守宪法、法律、法规和国家政策。",
      "order": 7
    },
    {
      "id": "xzfg-8990c55479-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "县级以上各级人民政府机构编制管理机关所属的事业单位登记管理机构(以下简称登记管理机关)负责实施事业单位的登记管理工作。县级以上各级人民政府机构编制管理机关应当加强对登记管理机关的事业单位登记管理工作的监督检查。\n事业单位实行分级登记管理。分级登记管理的具体办法由国务院机构编制管理机关规定。\n法律、行政法规对事业单位的监督管理另有规定的，依照有关法律、行政法规的规定执行。",
      "order": 8
    },
    {
      "id": "xzfg-8990c55479-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第二章登记"
      ],
      "text": "申请事业单位法人登记，应当具备下列条件：\n(一)经审批机关批准设立；\n(二)有自己的名称、组织机构和场所；\n(三)有与其业务活动相适应的从业人员；\n(四)有与其业务活动相适应的经费来源；\n(五)能够独立承担民事责任。",
      "order": 12
    },
    {
      "id": "xzfg-8990c55479-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第二章登记"
      ],
      "text": "申请事业单位法人登记，应当向登记管理机关提交下列文件：\n(一)登记申请书；\n(二)审批机关的批准文件；\n(三)场所使用权证明；\n(四)经费来源证明；\n(五)其他有关证明文件。",
      "order": 18
    },
    {
      "id": "xzfg-8990c55479-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第二章登记"
      ],
      "text": "登记管理机关应当自收到登记申请书之日起30日内依照本条例的规定进行审查，作出准予登记或者不予登记的决定。准予登记的，发给《事业单位法人证书》；不予登记的，应当说明理由。\n事业单位法人登记事项包括：名称、住所、宗旨和业务范围、法定代表人、经费来源(开办资金)等情况。",
      "order": 24
    },
    {
      "id": "xzfg-8990c55479-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第二章登记"
      ],
      "text": "经登记的事业单位，凭《事业单位法人证书》刻制印章，申请开立银行账户。事业单位应当将印章式样报登记管理机关备案。",
      "order": 26
    },
    {
      "id": "xzfg-8990c55479-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第二章登记"
      ],
      "text": "事业单位的登记事项需要变更的，应当向登记管理机关办理变更登记。",
      "order": 27
    },
    {
      "id": "xzfg-8990c55479-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第二章登记"
      ],
      "text": "法律规定具备法人条件、自批准设立之日起即取得法人资格的事业单位，或者法律、其他行政法规规定具备法人条件、经有关主管部门依法审核或者登记，已经取得相应的执业许可证书的事业单位，不再办理事业单位法人登记，由有关主管部门按照分级登记管理的规定向登记管理机关备案。\n县级以上各级人民政府设立的直属事业单位直接向登记管理机关备案。",
      "order": 28
    },
    {
      "id": "xzfg-8990c55479-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第二章登记"
      ],
      "text": "事业单位备案的事项，除本条例第八条第二款所列事项外，还应当包括执业许可证明文件或者设立批准文件。\n对备案的事业单位，登记管理机关应当自收到备案文件之日起30日内发给《事业单位法人证书》。",
      "order": 30
    },
    {
      "id": "xzfg-8990c55479-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第二章登记"
      ],
      "text": "事业单位被撤销、解散的，应当向登记管理机关办理注销登记或者注销备案。\n事业单位办理注销登记前，应当在审批机关指导下成立清算组织，完成清算工作。\n事业单位应当自清算结束之日起15日内，向登记管理机关办理注销登记。事业单位办理注销登记，应当提交撤销或者解散该事业单位的文件和清算报告；登记管理机关收缴《事业单位法人证书》和印章。",
      "order": 32
    },
    {
      "id": "xzfg-8990c55479-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第二章登记"
      ],
      "text": "事业单位的登记、备案或者变更名称、住所以及注销登记或者注销备案，由登记管理机关予以公告。",
      "order": 35
    },
    {
      "id": "xzfg-8990c55479-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第三章监督管理"
      ],
      "text": "事业单位开展活动，按照国家有关规定取得的合法收入，必须用于符合其宗旨和业务范围的活动。\n事业单位接受捐赠、资助，必须符合事业单位的宗旨和业务范围，必须根据与捐赠人、资助人约定的期限、方式和合法用途使用。",
      "order": 37
    },
    {
      "id": "xzfg-8990c55479-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第三章监督管理"
      ],
      "text": "事业单位必须执行国家有关财务、价格等管理制度，接受财税、审计部门的监督。",
      "order": 39
    },
    {
      "id": "xzfg-8990c55479-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第三章监督管理"
      ],
      "text": "事业单位应当于每年3月31日前分别向登记管理机关和审批机关报送上一年度执行本条例情况的报告。",
      "order": 40
    },
    {
      "id": "xzfg-8990c55479-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第三章监督管理"
      ],
      "text": "事业单位未按照本条例规定办理登记的，由登记管理机关责令限期补办登记手续；逾期不补办的，由登记管理机关建议对该事业单位的负责人和其他直接责任人员依法给予纪律处分。",
      "order": 41
    },
    {
      "id": "xzfg-8990c55479-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第三章监督管理"
      ],
      "text": "事业单位有下列情形之一的，由登记管理机关给予警告，责令限期改正；情节严重的，经审批机关同意，予以撤销登记，收缴《事业单位法人证书》和印章：\n(一)不按照本条例的规定办理变更登记、注销登记的；\n(二)涂改、出租、出借《事业单位法人证书》或者出租、出借印章的；\n(三)违反规定接受、使用捐赠、资助的。\n事业单位违反法律、其他法规的，由有关机关依法处理。",
      "order": 42
    },
    {
      "id": "xzfg-8990c55479-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第三章监督管理"
      ],
      "text": "登记管理机关的工作人员在事业单位登记管理工作中滥用职权、玩忽职守、徇私舞弊构成犯罪的，依法追究刑事责任；尚不构成犯罪的，依法给予行政处分。",
      "order": 47
    },
    {
      "id": "xzfg-8990c55479-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第四章附则"
      ],
      "text": "《事业单位法人证书》的式样由国务院机构编制管理机关制定。",
      "order": 49
    },
    {
      "id": "xzfg-8990c55479-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第四章附则"
      ],
      "text": "本条例实行前已经成立的事业单位，应当自本条例实行之日起1年内依照本条例有关规定办理登记或者备案手续。",
      "order": 50
    },
    {
      "id": "xzfg-8990c55479-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第四章附则"
      ],
      "text": "本条例自发布之日起施行。",
      "order": 51
    }
  ]
}
