{
  "id": "xzfg-8990c55479",
  "officialId": "国务院令第252号",
  "title": "事业单位登记管理暂行条例",
  "category": "行政法规",
  "issuingAuthority": "国务院",
  "promulgationDate": "2004-06-27",
