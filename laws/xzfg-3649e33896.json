{
  "id": "xzfg-3649e33896",
  "officialId": "",
  "title": "野生药材资源保护管理条例",
  "category": "行政法规",
  "issuingAuthority": "国务院",
  "promulgationDate": "1987-10-30",
  "effectiveDate": "",
  "status": "effective",
  "source": {
    "metadataPath": "data/laws/xzfg-3649e33896/metadata.json",
    "docxPath": "data/laws/xzfg-3649e33896/official.docx"
  },
  "paragraphCount": 37,
  "sectionCount": 0,
  "articleCount": 26,
  "sections": [],
  "articles": [
    {
      "id": "xzfg-3649e33896-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [],
      "text": "为保护和合理利用野生药材资源，适应人民医疗保健事业的需要，特制定本条例。",
      "order": 1
    },
    {
      "id": "xzfg-3649e33896-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [],
      "text": "在中华人民共和国境内采猎、经营野生药材的任何单位或个人，除国家另有规定外，都必须遵守本条例。",
      "order": 2
    },
    {
      "id": "xzfg-3649e33896-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [],
      "text": "国家对野生药材资源实行保护、采猎相结合的原则，并创造条件开展人工种养。",
      "order": 3
    },
    {
      "id": "xzfg-3649e33896-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [],
      "text": "国家重点保护的野生药材物种分为三级：\n一级：濒临灭绝状态的稀有珍贵野生药材物种(以下简称一级保护野生药材物种)；\n二级：分布区域缩小、资源处于衰竭状态的重要野生药材物种(以下简称二级保护野生药材物种)；\n三级：资源严重减少的主要常用野生药材物种(以下简称三级保护野生药材物种)。",
      "order": 4
    },
    {
      "id": "xzfg-3649e33896-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [],
      "text": "国家重点保护的野生药材物种名录，由国家医药管理部门会同国务院野生动物、植物管理部门制定。\n在国家重点保护的野生药材物种名录之外，需要增加的野生药材保护物种，由省、自治区、直辖市人民政府制定并抄送国家医药管理部门备案。",
      "order": 8
    },
    {
      "id": "xzfg-3649e33896-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [],
      "text": "禁止采猎一级保护野生药材物种。",
      "order": 10
    },
    {
      "id": "xzfg-3649e33896-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [],
      "text": "采猎、收购二、三级保护野生药材物种的，必须按照批准的计划执行。该计划由县以上(含县，下同)医药管理部门(含当地人民政府授权管理该项工作的有关部门，下同)会同同级野生动物、植物管理部门制定，报上一级医药管理部门批准。",
      "order": 11
    },
    {
      "id": "xzfg-3649e33896-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [],
      "text": "采猎二、三级保护野生药材物种的，不得在禁止采猎区、禁止采猎期进行采猎，不得使用禁用工具进行采猎。\n前款关于禁止采猎区、禁止采猎期和禁止使用的工具，由县以上医药管理部门会同同级野生动物、植物管理部门确定。",
      "order": 12
    },
    {
      "id": "xzfg-3649e33896-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [],
      "text": "采猎二、三级保护野生药材物种的，必须持有采药证。\n取得采药证后，需要进行采伐或狩猎的，必须分别向有关部门申请采伐证或狩猎证。",
      "order": 14
    },
    {
      "id": "xzfg-3649e33896-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [],
      "text": "采药证的格式由国家医药管理部门确定。采药证由县以上医药管理部门会同同级野生动物、植物管理部门核发。\n采伐证或狩猎证的核发，按照国家有关规定办理。",
      "order": 16
    },
    {
      "id": "xzfg-3649e33896-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [],
      "text": "建立国家或地方野生药材资源保护区，需经国务院或县以上地方人民政府批准。\n在国家或地方自然保护区内建立野生药材资源保护区，必须征得国家或地方自然保护区主管部门的同意。",
      "order": 18
    },
    {
      "id": "xzfg-3649e33896-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [],
      "text": "进入野生药材资源保护区从事科研、教学、旅游等活动的，必须经该保护区管理部门批准。进入设在国家或地方自然保护区范围内野生药材资源保护区的，还须征得该自然保护区主管部门的同意。",
      "order": 20
    },
    {
      "id": "xzfg-3649e33896-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [],
      "text": "一级保护野生药材物种属于自然淘汰的，其药用部分由各级药材公司负责经营管理，但不得出口。",
      "order": 21
    },
    {
      "id": "xzfg-3649e33896-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [],
      "text": "二、三级保护野生药材物种属于国家计划管理的品种，由中国药材公司统一经营管理；其余品种由产地县药材公司或其委托单位按照计划收购。",
      "order": 22
    },
    {
      "id": "xzfg-3649e33896-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [],
      "text": "二、三级保护野生药材物种的药用部分，除国家另有规定外，实行限量出口。\n实行限量出口和出口许可证制度的品种，由国家医药管理部门会同国务院有关部门确定。",
      "order": 23
    },
    {
      "id": "xzfg-3649e33896-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [],
      "text": "野生药材的规格、等级标准，由国家医药管理部门会同国务院有关部门制定。",
      "order": 25
    },
    {
      "id": "xzfg-3649e33896-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [],
      "text": "对保护野生药材资源作出显著成绩的单位或个人，由各级医药管理部门会同同级有关部门给予精神鼓励或一次性物质奖励。",
      "order": 26
    },
    {
      "id": "xzfg-3649e33896-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [],
      "text": "违反本条例第六条、第七条、第八条、第九条规定的，由当地县以上医药管理部门会同同级有关部门没收其非法采猎的野生药材及使用工具，并处以罚款。",
      "order": 27
    },
    {
      "id": "xzfg-3649e33896-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [],
      "text": "违反本条例第十二条规定的，当地县以上医药管理部门和自然保护区主管部门有权制止；造成损失的，必须承担赔偿责任。",
      "order": 28
    },
    {
      "id": "xzfg-3649e33896-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [],
      "text": "违反本条例第十三条、第十四条、第十五条规定的，由工商行政管理部门或有关部门没收其野生药材和全部违法所得，并处以罚款。",
      "order": 29
    },
    {
      "id": "xzfg-3649e33896-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [],
      "text": "保护野生药材资源管理部门工作人员徇私舞弊的，由所在单位或上级管理部门给予行政处分；造成野生药材资源损失的，必须承担赔偿责任。",
      "order": 30
    },
    {
      "id": "xzfg-3649e33896-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [],
      "text": "当事人对行政处罚决定不服的，可以在接到处罚决定书之日起十五日内向人民法院起诉；期满不起诉又不执行的，作出行政处罚决定的部门可以申请人民法院强制执行。",
      "order": 31
    },
    {
      "id": "xzfg-3649e33896-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [],
      "text": "破坏野生药材资源情节严重，构成犯罪的，由司法机关依法追究刑事责任。",
      "order": 32
    },
    {
      "id": "xzfg-3649e33896-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [],
      "text": "省、自治区、直辖市人民政府可以根据本条例制定实施细则。",
      "order": 33
    },
    {
      "id": "xzfg-3649e33896-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [],
      "text": "本条例由国家医药管理局负责解释。",
      "order": 34
    },
    {
      "id": "xzfg-3649e33896-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [],
      "text": "本条例自1987年12月1日起施行。",
      "order": 35
    }
  ]
}
