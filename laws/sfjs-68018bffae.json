{
  "id": "sfjs-68018bffae",
  "officialId": "",
  "title": "最高人民法院关于人民法院委托评估、拍卖工作的若干规定",
  "category": "司法解释",
  "issuingAuthority": "最高人民法院",
  "promulgationDate": "2011-09-07",
  "effectiveDate": "2012-01-01",
  "status": "effective",
  "source": {
    "metadataPath": "data/laws/sfjs-68018bffae/metadata.json",
    "docxPath": "data/laws/sfjs-68018bffae/official.docx"
  },
  "paragraphCount": 24,
  "sectionCount": 0,
  "articleCount": 10,
  "sections": [],
  "articles": [
    {
      "id": "sfjs-68018bffae-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [],
      "text": "人民法院司法辅助部门负责统一管理和协调司法委托评估、拍卖工作。",
      "order": 1
    },
    {
      "id": "sfjs-68018bffae-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [],
      "text": "取得政府管理部门行政许可并达到一定资质等级的评估、拍卖机构，可以自愿报名参加人民法院委托的评估、拍卖活动。\n人民法院不再编制委托评估、拍卖机构名册。",
      "order": 2
    },
    {
      "id": "sfjs-68018bffae-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [],
      "text": "人民法院采用随机方式确定评估、拍卖机构。高级人民法院或者中级人民法院可以根据本地实际情况统一实施对外委托。",
      "order": 4
    },
    {
      "id": "sfjs-68018bffae-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [],
      "text": "人民法院委托的拍卖活动应在有关管理部门确定的统一交易场所或网络平台上进行，另有规定的除外。",
      "order": 5
    },
    {
      "id": "sfjs-68018bffae-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [],
      "text": "受委托的拍卖机构应通过管理部门的信息平台发布拍卖信息，公示评估、拍卖结果。",
      "order": 6
    },
    {
      "id": "sfjs-68018bffae-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [],
      "text": "涉国有资产的司法委托拍卖由省级以上国有产权交易机构实施，拍卖机构负责拍卖环节相关工作，并依照相关监管部门制定的实施细则进行。",
      "order": 7
    },
    {
      "id": "sfjs-68018bffae-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [],
      "text": "《中华人民共和国证券法》规定应当在证券交易所上市交易或转让的证券资产的司法委托拍卖，通过证券交易所实施，拍卖机构负责拍卖环节相关工作；其他证券类资产的司法委托拍卖由拍卖机构实施，并依照相关监管部门制定的实施细则进行。",
      "order": 8
    },
    {
      "id": "sfjs-68018bffae-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [],
      "text": "人民法院对其委托的评估、拍卖活动实行监督。出现下列情形之一，影响评估、拍卖结果，侵害当事人合法利益的，人民法院将不再委托其从事委托评估、拍卖工作。涉及违反法律法规的，依据有关规定处理：\n（1）评估结果明显失实；\n（2）拍卖过程中弄虚作假、存在瑕疵；\n（3）随机选定后无正当理由不能按时完成评估拍卖工作；\n（4）其他有关情形。",
      "order": 9
    },
    {
      "id": "sfjs-68018bffae-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [],
      "text": "各高级人民法院可参照本规定，结合各地实际情况，制定实施细则，报最高人民法院备案。",
      "order": 14
    },
    {
      "id": "sfjs-68018bffae-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [],
      "text": "本规定自2012年1月1日起施行。此前的司法解释和有关规定，与本规定相抵触的，以本规定为准。",
      "order": 15
    }
  ]
}
