  "articles": [
    {
      "id": "xzfg-0d4c9eabb5-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [],
      "text": "为维护中华人民共和国的主权，维持港口和沿海水域的秩序，保证航行安全，防止水域污染，特制定本规则。",
      "order": 1
    },
    {
      "id": "xzfg-0d4c9eabb5-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [],
      "text": "在中华人民共和国港口和沿海水域航行的外国籍船舶(以下简称船舶)应遵守本规则以及中华人民共和国一切有关法令、规章和规定。中华人民共和国政府设置在港口的港务监督认为有必要对船舶进行检查时，船舶应接受检查。\n本规则所称沿海水域是指属于中华人民共和国的内水和领海以及国家规定的管辖水域。",
      "order": 2
    },
    {
      "id": "xzfg-0d4c9eabb5-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章进出港和航行"
      ],
      "text": "船长或船舶所有人应在船舶预定到达港口一星期之前，通过外轮代理公司填具规定的表报，向港务监督办理进口申请批准手续，并在到达港口之前二十四小时(航程不足二十四小时的，在驶离前一港口时)，将预计到港时间，前、后吃水等情况通过外轮代理公司向港务监督报告。如预计到港时间有变化，应随时报告。船舶在航行途中，因遇险、发生故障、船员或旅客患急病等特殊情况，需临时进港或返航，应事先向港务监督报告。",
      "order": 5
    },
    {
      "id": "xzfg-0d4c9eabb5-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章进出港和航行"
      ],
      "text": "船舶进出港口或在港内航行、移泊，必须由港务监督指派引航员引航。有关引航的具体事项，应按照中华人民共和国交通部颁发的《海港引航工作规定》办理。",
      "order": 6
    },
    {
      "id": "xzfg-0d4c9eabb5-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章进出港和航行"
      ],
      "text": "船舶抵港后，应即呈报进口报告书及其它有关表报，同时交验船舶证书及有关文书，并接受检查。船舶出港前，应呈报出口报告书及其它有关表报，经检查发给出口许可证后，才可出口。",
      "order": 7
    },
    {
      "id": "xzfg-0d4c9eabb5-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第一章进出港和航行"
      ],
      "text": "船舶上的武器、弹药，应在船舶抵港后由港务监督予以封存。无线电报发射机、无线电话发射机、火箭信号、火焰信号、信号枪，只有在危急情况下才可以使用，但在使用后必须向港务监督报告。",
      "order": 8
    },
    {
      "id": "xzfg-0d4c9eabb5-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第一章进出港和航行"
      ],
      "text": "港内禁止射击、游泳、钓鱼、鸣放鞭炮或焰火以及其它危及港口安全秩序的行为。",
      "order": 9
    },
    {
      "id": "xzfg-0d4c9eabb5-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第一章进出港和航行"
      ],
      "text": "船舶有下列情况之一者，港务监督有权在一定期间内禁止其出港或令其停航、改航、返航：\n一、处于不适航状态；\n二、违反中华人民共和国的法律或规章；\n三、发生海损事故；\n四、未缴付应承担的款项，又未提供适当担保者；\n五、其它需要禁止航行的情况。",
      "order": 10
    },
    {
      "id": "xzfg-0d4c9eabb5-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第一章进出港和航行"
      ],
      "text": "航行在中华人民共和国港口和沿海水域的船舶，不得进行危害中华人民共和国安全和权益的活动，并应遵守有关海峡、水道、航线和禁航区的规定。",
      "order": 16
    },
    {
      "id": "xzfg-0d4c9eabb5-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第一章进出港和航行"
      ],
      "text": "船舶在港内不得以危及其它船舶和港口设施安全的速度航行。",
      "order": 17
    },
    {
      "id": "xzfg-0d4c9eabb5-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第一章进出港和航行"
      ],
      "text": "船舶附属的艇(筏)，除了救生以外，不准在港内航行。",
      "order": 18
    },
    {
      "id": "xzfg-0d4c9eabb5-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第一章进出港和航行"
      ],
      "text": "船舶在港内航行、移泊时，船上的艇(筏)、吊货杆和舷梯等，不得伸出舷外。",
      "order": 19
    },
    {
      "id": "xzfg-0d4c9eabb5-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第一章进出港和航行"
      ],
      "text": "需要进入中华人民共和国对外轮开放的港口避风或临时停泊的船舶应向港务监督申请批准，申请内容包括：船名、呼号、国籍、船公司名称、出发港、目的港、船位、航速、吃水、船体颜色、烟囱颜色和标志，并应在指定的地点避风。\n船舶如需在中华人民共和国对外轮开放的港口以外的地点避风或临时停泊，除办理上述申请批准手续外，还应遵守下列规定：\n一、及时向就近的港务监督报告抛锚时间、位置和驶离时间；\n二、遵守当地有关部门的规定，接受检查和询问，并听从指挥；\n三、未经当地有关部门批准，船上人员不得登陆，不得装卸货物。",
      "order": 20
    },
    {
      "id": "xzfg-0d4c9eabb5-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第二章停泊"
      ],
      "text": "船舶在港内停泊，必须留有足以保证船舶安全操纵的船员值班，遇有台风警报等紧急情况，全体船员必须立即回船采取防范、应急等措施。",
      "order": 26
    },
    {
      "id": "xzfg-0d4c9eabb5-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第二章停泊"
      ],
      "text": "船舶在船员、旅客和其他人员上下之处设置的舷梯必须稳固，并有栏杆或攀索，软梯必须牢固安全，夜间应有足够的照明。",
      "order": 27
    },
    {
      "id": "xzfg-0d4c9eabb5-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第二章停泊"
      ],
      "text": "船舶需要活车时，必须注意尾部周围环境，在不危及其他船舶和港口设施安全的情况下才可进行。",
      "order": 28
    },
    {
      "id": "xzfg-0d4c9eabb5-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第二章停泊"
      ],
      "text": "停泊在港内的船舶，其两舷可能影响其他船舶、码头或人员上下的出水口必须加盖复罩。",
      "order": 29
    },
    {
      "id": "xzfg-0d4c9eabb5-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第二章停泊"
      ],
      "text": "船舶的灯光不得影响其他船舶的航行安全，船上射向航道的强灯光，应予以遮蔽。",
      "order": 30
    },
    {
      "id": "xzfg-0d4c9eabb5-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第二章停泊"
      ],
      "text": "船舶对装卸操作应提供安全良好的条件，装卸设备应具有合格证书，保持良好的技术状态。",
      "order": 31
    },
    {
      "id": "xzfg-0d4c9eabb5-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第二章停泊"
      ],
      "text": "船舶进行下列事项，应事先向港务监督申请批准：\n一、拆修锅炉、主机、锚机、舵机、电台；\n二、试航、试车；\n三、放艇(筏)进行救生演习；\n四、烧焊(进船厂修理的除外)，或者在甲板上明火作业；\n五、悬挂彩灯。",
      "order": 32
    },
    {
      "id": "xzfg-0d4c9eabb5-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第二章停泊"
      ],
      "text": "船舶熏蒸，应采取严密的安全措施，并应悬挂港口规定的信号。",
      "order": 38
    },
    {
      "id": "xzfg-0d4c9eabb5-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第二章停泊"
      ],
      "text": "为了维护港口和船舶的安全，需要在港内的船舶移泊或提前、推迟开航，船舶应遵守港务监督的决定。",
      "order": 39
    },
    {
      "id": "xzfg-0d4c9eabb5-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第三章信号和通讯"
      ],
      "text": "船舶在中华人民共和国港口和沿海水域航行、停泊，白天应悬挂船籍国的国旗，进出港口和移泊应加挂船名呼号旗和港口规定的有关信号。",
      "order": 41
    },
    {
      "id": "xzfg-0d4c9eabb5-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第三章信号和通讯"
      ],
      "text": "船舶在进出港口和锚泊时，应注意港口信号台的呼号和信号，在使用视觉信号时，应遵守中华人民共和国沿海港口信号规定。沿海港口未曾规定的信号，应依照《国际信号规则》办理。",
      "order": 42
    },
    {
      "id": "xzfg-0d4c9eabb5-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第三章信号和通讯"
      ],
      "text": "船舶在港内除因航行安全必须外，不得随意鸣放声号。需要试笛时，应事先向港务监督报告。",
      "order": 43
    },
    {
      "id": "xzfg-0d4c9eabb5-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第三章信号和通讯"
      ],
      "text": "船舶在港内使用甚高频无线电话，应遵守中华人民共和国交通部颁发的《关于外轮使用甚高频无线电话暂行办法》。",
      "order": 44
    },
    {
      "id": "xzfg-0d4c9eabb5-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第四章危险货物"
      ],
      "text": "船舶装卸、载运危险货物，应悬挂规定的信号，遵守有关危险货物运输管理的规定，采取必要的安全措施，特别是性能相抵触的货物，不许混装，严禁爆炸物品与发火物、易燃物品装载于同一舱内。",
      "order": 46
    },
    {
      "id": "xzfg-0d4c9eabb5-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第四章危险货物"
      ],
      "text": "船舶载运爆炸物品、剧毒物品、放射性物品、压缩气体和液化气体、氧化剂、自燃物品、遇水燃烧物品、易燃液体、易燃固体和酸性腐蚀物品等一级烈性危险货物，应详细列具品名、性质、包装数量和装载位置，并且附具危险货物性质说明书，在预定到达港口三天之前，通过外轮代理公司向港务监督申请办理签证，经许可后才可进港、起卸或者过境。出口船舶载运上述危险货物，应在开始装载的三天以前，申请办理签证，经许可后才可装运。",
      "order": 47
    },
    {
      "id": "xzfg-0d4c9eabb5-0029",
      "articleNumber": 29,
      "displayNumber": "第二十九条",
      "path": [
        "第四章危险货物"
      ],
      "text": "船舶申请签发装运出口危险货物安全装载证明书，应在开始装载三天之前向港务监督提出书面申请，写明危险货物的品名、性质、包装、数量、装载位置(并且附具货物装载图)、中途港和目的港等事项并在港务监督指定的泊位进行装载。",
      "order": 48
    },
    {
      "id": "xzfg-0d4c9eabb5-0030",
      "articleNumber": 30,
      "displayNumber": "第三十条",
      "path": [
        "第五章航道保护"
      ],
      "text": "船舶航行应遵守航行规定，维护航行秩序，如船舶发生意外事故有沉没危险时，应立即向港务监督报告，并尽力采取有效措施，驶离航道，避免妨碍交通和危及其他船舶。如果船舶已经沉没，船方应及时在沉没地点设置临时信号标志。",
      "order": 50
    },
    {
      "id": "xzfg-0d4c9eabb5-0031",
      "articleNumber": 31,
      "displayNumber": "第三十一条",
      "path": [
        "第五章航道保护"
      ],
      "text": "对沉没在港口或沿海水域的船舶或其他物体的打捞，均按照《中华人民共和国打捞沉船、沉物管理办法》办理。港务监督可视具体情况，通知沉船沉物所有人限期打捞清除，或立即组织打捞或解体清除，全部责任和费用应由沉船沉物所有人承担。",
      "order": 51
    },
    {
      "id": "xzfg-0d4c9eabb5-0032",
      "articleNumber": 32,
      "displayNumber": "第三十二条",
      "path": [
        "第五章航道保护"
      ],
      "text": "船舶发现或捞获沉、浮物体，应报告或送交港务监督处理，由港务监督酌情给予奖励。",
      "order": 52
    },
    {
      "id": "xzfg-0d4c9eabb5-0033",
      "articleNumber": 33,
      "displayNumber": "第三十三条",
      "path": [
        "第五章航道保护"
      ],
      "text": "船舶在港内需要倾倒垃圾等废弃物，应显示港口规定的信号招用垃圾船(车)。",
      "order": 53
    },
    {
      "id": "xzfg-0d4c9eabb5-0034",
      "articleNumber": 34,
      "displayNumber": "第三十四条",
      "path": [
        "第五章航道保护"
      ],
      "text": "船舶应爱护航道设备和助航标志，如损坏了助航标志、港口建筑或其他设施，应立即向港务监督报告，并应负责恢复原状或偿付恢复原状所需费用。",
      "order": 54
    },
    {
      "id": "xzfg-0d4c9eabb5-0035",
      "articleNumber": 35,
      "displayNumber": "第三十五条",
      "path": [
        "第六章防止污染"
      ],
      "text": "在中华人民共和国的港口和沿海水域，禁止船舶任意排放油类、油性混合物，以及其他有害的污染物质和废弃物。",
      "order": 56
    },
    {
      "id": "xzfg-0d4c9eabb5-0036",
      "articleNumber": 36,
      "displayNumber": "第三十六条",
      "path": [
        "第六章防止污染"
      ],
      "text": "船舶排放压舱水、洗舱水、舱底水，必须向港务监督申请批准。如果船舶来自有疫情的港口，应经过卫生检疫机关卫生处理。装运危险货物和其他有害污染物船舱的污水、洗舱水，应经有关卫生部门鉴定合格后，方可在指定地点排放。",
      "order": 57
    },
    {
      "id": "xzfg-0d4c9eabb5-0037",
      "articleNumber": 37,
      "displayNumber": "第三十七条",
      "path": [
        "第六章防止污染"
      ],
      "text": "凡油轮和使用燃油的船舶，应备有油类记录簿，并且按照记录簿各项规定及时如实记载。",
      "order": 58
    },
    {
      "id": "xzfg-0d4c9eabb5-0038",
      "articleNumber": 38,
      "displayNumber": "第三十八条",
      "path": [
        "第六章防止污染"
      ],
      "text": "如船舶在港口和沿海水域发生污染事故，应将经过情况分别记入油类记录簿和航海日志，并立即向港务监督报告，同时必须采取有效的措施防止扩散。如需采用化学剂处理，应提供化学成份说明书，向港务监督申请批准。",
      "order": 59
    },
    {
      "id": "xzfg-0d4c9eabb5-0039",
      "articleNumber": 39,
      "displayNumber": "第三十九条",
      "path": [
        "第六章防止污染"
      ],
      "text": "本章未列事项，按照中华人民共和国有关防止水域污染的规定办理。",
      "order": 60
    },
    {
      "id": "xzfg-0d4c9eabb5-0040",
      "articleNumber": 40,
      "displayNumber": "第四十条",
      "path": [
        "第七章消防和救助"
      ],
      "text": "严禁在货舱以及易于引起船舶火警的场所吸烟和弄火。",
      "order": 62
    },
    {
      "id": "xzfg-0d4c9eabb5-0041",
      "articleNumber": 41,
      "displayNumber": "第四十一条",
      "path": [
        "第七章消防和救助"
      ],
      "text": "船舶加油和油船装卸作业，应采取严密的防火安全措施。",
      "order": 63
    },
    {
      "id": "xzfg-0d4c9eabb5-0042",
      "articleNumber": 42,
      "displayNumber": "第四十二条",
      "path": [
        "第七章消防和救助"
      ],
      "text": "船舶在港内进行烧焊等工程，应事先清理周围环境，采取严密防范措施，配备消防设备，并且在施工前后进行检查。对油舱及其邻近部位还必须卸完全部油料，清除残油，彻底通风，排除其内部易燃气体，并取得合格证明之后，才可以烧焊。",
      "order": 64
    },
    {
      "id": "xzfg-0d4c9eabb5-0043",
      "articleNumber": 43,
      "displayNumber": "第四十三条",
      "path": [
        "第七章消防和救助"
      ],
      "text": "船舶失火或发生海难，应立即将出事地点和本船吨位、吃水、载货、受损和需要某种援助等情况报告港务监督。",
      "order": 65
    },
    {
      "id": "xzfg-0d4c9eabb5-0044",
      "articleNumber": 44,
      "displayNumber": "第四十四条",
      "path": [
        "第七章消防和救助"
      ],
      "text": "港务监督在必要时，可动员和指挥在港内或沿海水域的船舶参加救助遇难船舶，在不影响本船安全的情况下，被动员的船舶有责任尽力救助。",
      "order": 66
    },
    {
      "id": "xzfg-0d4c9eabb5-0045",
      "articleNumber": 45,
      "displayNumber": "第四十五条",
      "path": [
        "第七章消防和救助"
      ],
      "text": "港务监督或救助部门的负责人员到达现场，遇难船舶的船长应立即报告失事情况及已经采取的措施，提供救助必需的资料和方便，并且可以提出有关救助的建议。港务监督为维护安全秩序作出的决定，有关方面必须遵守。",
      "order": 67
    },
    {
      "id": "xzfg-0d4c9eabb5-0046",
      "articleNumber": 46,
      "displayNumber": "第四十六条",
      "path": [
        "第八章海损事故"
      ],
      "text": "船舶发生海损事故，应尽速用电报或无线电话向港务监督报出扼要报告。在港区以外发出的海损事故，船长应在船舶进入第一港口四十八小时内，向港务监督递交海损事故报告书；在港区内发生的海损事故，船长应在二十四小时内向港务监督递交海损事故报告书。",
      "order": 69
    },
    {
      "id": "xzfg-0d4c9eabb5-0047",
      "articleNumber": 47,
      "displayNumber": "第四十七条",
      "path": [
        "第八章海损事故"
      ],
      "text": "船舶在中华人民共和国港口和沿海水域造成人命、财产损害事故时，应积极救助受害的船舶和人员，及时向港务监督报告，并接受调查和处理。如果肇事者见危不救，隐匿逃遁，将从严处理。",
      "order": 70
    },
    {
      "id": "xzfg-0d4c9eabb5-0048",
      "articleNumber": 48,
      "displayNumber": "第四十八条",
      "path": [
        "第八章海损事故"
      ],
      "text": "船舶发生船员死亡事故，应立即向港务监督报告。在港内由于船方或港方人员的过失，造成对方损害或伤亡事故等，应保留现场，双方都应及时向港务监督报告。如果发生纠纷，当事的任何一方，都可以向港务监督申请调查处理，涉及刑事范围的，由中华人民共和国司法机关处理。",
      "order": 71
    },
    {
      "id": "xzfg-0d4c9eabb5-0049",
      "articleNumber": 49,
      "displayNumber": "第四十九条",
      "path": [
        "第八章海损事故"
      ],
      "text": "本章未列事项，按照中华人民共和国交通部颁发的《海损事故调查和处理规则》办理。",
      "order": 72
    },
    {
      "id": "xzfg-0d4c9eabb5-0050",
      "articleNumber": 50,
      "displayNumber": "第五十条",
      "path": [
        "第九章违章处罚"
      ],
      "text": "凡违反本规则以及中华人民共和国一切有关法令、规章和规定者，港务监督得按其性质、情节分别给予警告、罚款等处分，性质恶劣、情节严重者移交司法机关处理。",
      "order": 74
    },
    {
      "id": "xzfg-0d4c9eabb5-0051",
      "articleNumber": 51,
      "displayNumber": "第五十一条",
      "path": [
        "第九章违章处罚"
      ],
      "text": "受处分者如果对所受处分不服，可以在接到通告的次日起十五日之内，向中华人民共和国港务监督局提出申诉。但在没有变更决定之前，原处分仍为有效。",
      "order": 75
    },
    {
      "id": "xzfg-0d4c9eabb5-0052",
      "articleNumber": 52,
      "displayNumber": "第五十二条",
      "path": [
        "第十章附则"
      ],
      "text": "关于船舶避碰，本规则和中华人民共和国其他有关规定中未列事项，依照中华人民共和国施行的《国际海上避碰规则》办理。",
      "order": 77
    },
    {
      "id": "xzfg-0d4c9eabb5-0053",
      "articleNumber": 53,
      "displayNumber": "第五十三条",
      "path": [
        "第十章附则"
      ],
      "text": "本规则由中华人民共和国国务院批准施行，中华人民共和国交通部一九五七年三月十二日颁发的《中华人民共和国对外国籍船舶进出港口管理办法》同时废止。",
      "order": 78
    }
  ]
}
