  "articles": [
    {
      "id": "xzfg-414619875c-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了规范公平竞争审查工作，促进市场公平竞争，优化营商环境，建设全国统一大市场，根据《中华人民共和国反垄断法》等法律，制定本条例。",
      "order": 2
    },
    {
      "id": "xzfg-414619875c-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "起草涉及经营者经济活动的法律、行政法规、地方性法规、规章、规范性文件以及具体政策措施（以下统称政策措施），行政机关和法律、法规授权的具有管理公共事务职能的组织（以下统称起草单位）应当依照本条例规定开展公平竞争审查。",
      "order": 3
    },
    {
      "id": "xzfg-414619875c-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "公平竞争审查工作坚持中国共产党的领导，贯彻党和国家路线方针政策和决策部署。\n国家加强公平竞争审查工作，保障各类经营者依法平等使用生产要素、公平参与市场竞争。",
      "order": 4
    },
    {
      "id": "xzfg-414619875c-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "国务院建立公平竞争审查协调机制，统筹、协调和指导全国公平竞争审查工作，研究解决公平竞争审查工作中的重大问题，评估全国公平竞争审查工作情况。",
      "order": 6
    },
    {
      "id": "xzfg-414619875c-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "县级以上地方人民政府应当建立健全公平竞争审查工作机制，保障公平竞争审查工作力量，并将公平竞争审查工作经费纳入本级政府预算。",
      "order": 7
    },
    {
      "id": "xzfg-414619875c-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第一章总则"
      ],
      "text": "国务院市场监督管理部门负责指导实施公平竞争审查制度，督促有关部门和地方开展公平竞争审查工作。\n县级以上地方人民政府市场监督管理部门负责在本行政区域组织实施公平竞争审查制度。",
      "order": 8
    },
    {
      "id": "xzfg-414619875c-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第一章总则"
      ],
      "text": "县级以上人民政府将公平竞争审查工作情况纳入法治政府建设、优化营商环境等考核评价内容。",
      "order": 10
    },
    {
      "id": "xzfg-414619875c-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第二章审查标准"
      ],
      "text": "起草单位起草的政策措施，不得含有下列限制或者变相限制市场准入和退出的内容：\n（一）对市场准入负面清单以外的行业、领域、业务等违法设置审批程序；\n（二）违法设置或者授予特许经营权；\n（三）限定经营、购买或者使用特定经营者提供的商品或者服务（以下统称商品）；\n（四）设置不合理或者歧视性的准入、退出条件；\n（五）其他限制或者变相限制市场准入和退出的内容。",
      "order": 12
    },
    {
      "id": "xzfg-414619875c-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第二章审查标准"
      ],
      "text": "起草单位起草的政策措施，不得含有下列限制商品、要素自由流动的内容：\n（一）限制外地或者进口商品、要素进入本地市场，或者阻碍本地经营者迁出，商品、要素输出；\n（二）排斥、限制、强制或者变相强制外地经营者在本地投资经营或者设立分支机构；\n（三）排斥、限制或者变相限制外地经营者参加本地政府采购、招标投标；\n（四）对外地或者进口商品、要素设置歧视性收费项目、收费标准、价格或者补贴；\n（五）在资质标准、监管执法等方面对外地经营者在本地投资经营设置歧视性要求；\n（六）其他限制商品、要素自由流动的内容。",
      "order": 18
    },
    {
      "id": "xzfg-414619875c-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第二章审查标准"
      ],
      "text": "起草单位起草的政策措施，没有法律、行政法规依据或者未经国务院批准，不得含有下列影响生产经营成本的内容：\n（一）给予特定经营者税收优惠；\n（二）给予特定经营者选择性、差异化的财政奖励或者补贴；\n（三）给予特定经营者要素获取、行政事业性收费、政府性基金、社会保险费等方面的优惠；\n（四）其他影响生产经营成本的内容。",
      "order": 25
    },
    {
      "id": "xzfg-414619875c-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第二章审查标准"
      ],
      "text": "起草单位起草的政策措施，不得含有下列影响生产经营行为的内容：\n（一）强制或者变相强制经营者实施垄断行为，或者为经营者实施垄断行为提供便利条件；\n（二）超越法定权限制定政府指导价、政府定价，为特定经营者提供优惠价格；\n（三）违法干预实行市场调节价的商品、要素的价格水平；\n（四）其他影响生产经营行为的内容。",
      "order": 30
    },
    {
      "id": "xzfg-414619875c-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第二章审查标准"
      ],
      "text": "起草单位起草的政策措施，具有或者可能具有排除、限制竞争效果，但符合下列情形之一，且没有对公平竞争影响更小的替代方案，并能够确定合理的实施期限或者终止条件的，可以出台：\n（一）为维护国家安全和发展利益的；\n（二）为促进科学技术进步、增强国家自主创新能力的；\n（三）为实现节约能源、保护环境、救灾救助等社会公共利益的；\n（四）法律、行政法规规定的其他情形。",
      "order": 35
    },
    {
      "id": "xzfg-414619875c-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第三章审查机制"
      ],
      "text": "拟由部门出台的政策措施，由起草单位在起草阶段开展公平竞争审查。\n拟由多个部门联合出台的政策措施，由牵头起草单位在起草阶段开展公平竞争审查。",
      "order": 41
    },
    {
      "id": "xzfg-414619875c-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第三章审查机制"
      ],
      "text": "拟由县级以上人民政府出台或者提请本级人民代表大会及其常务委员会审议的政策措施，由本级人民政府市场监督管理部门会同起草单位在起草阶段开展公平竞争审查。起草单位应当开展初审，并将政策措施草案和初审意见送市场监督管理部门审查。",
      "order": 43
    },
    {
      "id": "xzfg-414619875c-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第三章审查机制"
      ],
      "text": "国家鼓励有条件的地区探索建立跨区域、跨部门的公平竞争审查工作机制。",
      "order": 44
    },
    {
      "id": "xzfg-414619875c-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第三章审查机制"
      ],
      "text": "开展公平竞争审查，应当听取有关经营者、行业协会商会等利害关系人关于公平竞争影响的意见。涉及社会公众利益的，应当听取社会公众意见。",
      "order": 45
    },
    {
      "id": "xzfg-414619875c-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第三章审查机制"
      ],
      "text": "开展公平竞争审查，应当按照本条例规定的审查标准，在评估对公平竞争影响后，作出审查结论。\n适用本条例第十二条规定的，应当在审查结论中详细说明。",
      "order": 46
    },
    {
      "id": "xzfg-414619875c-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第三章审查机制"
      ],
      "text": "政策措施未经公平竞争审查，或者经公平竞争审查认为违反本条例第八条至第十一条规定且不符合第十二条规定情形的，不得出台。",
      "order": 48
    },
    {
      "id": "xzfg-414619875c-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第三章审查机制"
      ],
      "text": "有关部门和单位、个人对在公平竞争审查过程中知悉的国家秘密、商业秘密和个人隐私，应当依法予以保密。",
      "order": 49
    },
    {
      "id": "xzfg-414619875c-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第四章监督保障"
      ],
      "text": "国务院市场监督管理部门强化公平竞争审查工作监督保障，建立健全公平竞争审查抽查、举报处理、督查等机制。",
      "order": 51
    },
    {
      "id": "xzfg-414619875c-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第四章监督保障"
      ],
      "text": "市场监督管理部门建立健全公平竞争审查抽查机制，组织对有关政策措施开展抽查，经核查发现违反本条例规定的，应当督促起草单位进行整改。\n市场监督管理部门应当向本级人民政府报告抽查情况，抽查结果可以向社会公开。",
      "order": 52
    },
    {
      "id": "xzfg-414619875c-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第四章监督保障"
      ],
      "text": "对违反本条例规定的政策措施，任何单位和个人可以向市场监督管理部门举报。市场监督管理部门接到举报后，应当及时处理或者转送有关部门处理。\n市场监督管理部门应当向社会公开受理举报的电话、信箱或者电子邮件地址。",
      "order": 54
    },
    {
      "id": "xzfg-414619875c-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第四章监督保障"
      ],
      "text": "国务院定期对县级以上地方人民政府公平竞争审查工作机制建设情况、公平竞争审查工作开展情况、举报处理情况等开展督查。国务院市场监督管理部门负责具体实施。",
      "order": 56
    },
    {
      "id": "xzfg-414619875c-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第四章监督保障"
      ],
      "text": "起草单位未依照本条例规定开展公平竞争审查，经市场监督管理部门督促，逾期仍未整改的，上一级市场监督管理部门可以对其负责人进行约谈。",
      "order": 57
    },
    {
      "id": "xzfg-414619875c-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第四章监督保障"
      ],
      "text": "未依照本条例规定开展公平竞争审查，造成严重不良影响的，对起草单位直接负责的主管人员和其他直接责任人员依法给予处分。",
      "order": 58
    },
    {
      "id": "xzfg-414619875c-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第五章附则"
      ],
      "text": "国务院市场监督管理部门根据本条例制定公平竞争审查的具体实施办法。",
      "order": 60
    },
    {
      "id": "xzfg-414619875c-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第五章附则"
      ],
      "text": "本条例自2024年8月1日起施行。",
      "order": 61
    }
  ]
}
