  "articles": [
    {
      "id": "law-e837c631ef-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了保障教师的合法权益，建设具有良好思想品德修养和业务素质的教师队伍，促进社会主义教育事业的发展，制定本法。",
      "order": 2
    },
    {
      "id": "law-e837c631ef-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "本法适用于在各级各类学校和其他教育机构中专门从事教育教学工作的教师。",
      "order": 3
    },
    {
      "id": "law-e837c631ef-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "教师是履行教育教学职责的专业人员，承担教书育人，培养社会主义事业建设者和接班人、提高民族素质的使命。教师应当忠诚于人民的教育事业。",
      "order": 4
    },
    {
      "id": "law-e837c631ef-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "各级人民政府应当采取措施，加强教师的思想政治教育和业务培训，改善教师的工作条件和生活条件，保障教师的合法权益，提高教师的社会地位。\n全社会都应当尊重教师。",
      "order": 5
    },
    {
      "id": "law-e837c631ef-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "国务院教育行政部门主管全国的教师工作。\n国务院有关部门在各自职权范围内负责有关的教师工作。\n学校和其他教育机构根据国家规定，自主进行教师管理工作。",
      "order": 7
    },
    {
      "id": "law-e837c631ef-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第一章总则"
      ],
      "text": "每年九月十日为教师节。",
      "order": 10
    },
    {
      "id": "law-e837c631ef-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第二章权利和义务"
      ],
      "text": "教师享有下列权利：\n（一）进行教育教学活动，开展教育教学改革和实验；\n（二）从事科学研究、学术交流，参加专业的学术团体，在学术活动中充分发表意见；\n（三）指导学生的学习和发展，评定学生的品行和学业成绩；\n（四）按时获取工资报酬，享受国家规定的福利待遇以及寒暑假期的带薪休假；\n（五）对学校教育教学、管理工作和教育行政部门的工作提出意见和建议，通过教职工代表大会或者其他形式，参与学校的民主管理；\n（六）参加进修或者其他方式的培训。",
      "order": 12
    },
    {
      "id": "law-e837c631ef-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第二章权利和义务"
      ],
      "text": "教师应当履行下列义务：\n（一）遵守宪法、法律和职业道德，为人师表；\n（二）贯彻国家的教育方针，遵守规章制度，执行学校的教学计划，履行教师聘约，完成教育教学工作任务；\n（三）对学生进行宪法所确定的基本原则的教育和爱国主义、民族团结的教育，法制教育以及思想品德、文化、科学技术教育，组织、带领学生开展有益的社会活动；\n（四）关心、爱护全体学生，尊重学生人格，促进学生在品德、智力、体质等方面全面发展；\n（五）制止有害于学生的行为或者其他侵犯学生合法权益的行为，批评和抵制有害于学生健康成长的现象；\n（六）不断提高思想政治觉悟和教育教学业务水平。",
      "order": 19
    },
    {
      "id": "law-e837c631ef-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第二章权利和义务"
      ],
      "text": "为保障教师完成教育教学任务，各级人民政府、教育行政部门、有关部门、学校和其他教育机构应当履行下列职责：\n（一）提供符合国家安全标准的教育教学设施和设备；\n（二）提供必需的图书、资料及其他教育教学用品；\n（三）对教师在教育教学、科学研究中的创造性工作给以鼓励和帮助；\n（四）支持教师制止有害于学生的行为或者其他侵犯学生合法权益的行为。",
      "order": 26
    },
    {
      "id": "law-e837c631ef-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第三章资格和任用"
      ],
      "text": "国家实行教师资格制度。\n中国公民凡遵守宪法和法律，热爱教育事业，具有良好的思想品德，具备本法规定的学历或者经国家教师资格考试合格，有教育教学能力，经认定合格的，可以取得教师资格。",
      "order": 32
    },
    {
      "id": "law-e837c631ef-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第三章资格和任用"
      ],
      "text": "取得教师资格应当具备的相应学历是：\n（一）取得幼儿园教师资格，应当具备幼儿师范学校毕业及其以上学历；\n（二）取得小学教师资格，应当具备中等师范学校毕业及其以上学历；\n（三）取得初级中学教师、初级职业学校文化、专业课教师资格，应当具备高等师范专科学校或者其他大学专科毕业及其以上学历；\n（四）取得高级中学教师资格和中等专业学校、技工学校、职业高中文化课、专业课教师资格，应当具备高等师范院校本科或者其他大学本科毕业及其以上学历；取得中等专业学校、技工学校和职业高中学生实习指导教师资格应当具备的学历，由国务院教育行政部门规定；\n（五）取得高等学校教师资格，应当具备研究生或者大学本科毕业学历；\n（六）取得成人教育教师资格，应当按照成人教育的层次、类别，分别具备高等、中等学校毕业及其以上学历。\n不具备本法规定的教师资格学历的公民，申请获取教师资格，必须通过国家教师资格考试。国家教师资格考试制度由国务院规定。",
      "order": 34
    },
    {
      "id": "law-e837c631ef-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第三章资格和任用"
      ],
      "text": "本法实施前已经在学校或者其他教育机构中任教的教师，未具备本法规定学历的，由国务院教育行政部门规定教师资格过渡办法。",
      "order": 42
    },
    {
      "id": "law-e837c631ef-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第三章资格和任用"
      ],
      "text": "中小学教师资格由县级以上地方人民政府教育行政部门认定。中等专业学校、技工学校的教师资格由县级以上地方人民政府教育行政部门组织有关主管部门认定。普通高等学校的教师资格由国务院或者省、自治区、直辖市教育行政部门或者由其委托的学校认定。\n具备本法规定的学历或者经国家教师资格考试合格的公民，要求有关部门认定其教师资格的，有关部门应当依照本法规定的条件予以认定。\n取得教师资格的人员首次任教时，应当有试用期。",
      "order": 43
    },
    {
      "id": "law-e837c631ef-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第三章资格和任用"
      ],
      "text": "受到剥夺政治权利或者故意犯罪受到有期徒刑以上刑事处罚的，不能取得教师资格；已经取得教师资格的，丧失教师资格。",
      "order": 46
    },
    {
      "id": "law-e837c631ef-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第三章资格和任用"
      ],
      "text": "各级师范学校毕业生，应当按照国家有关规定从事教育教学工作。\n国家鼓励非师范高等学校毕业生到中小学或者职业学校任教。",
      "order": 47
    },
    {
      "id": "law-e837c631ef-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第三章资格和任用"
      ],
      "text": "国家实行教师职务制度，具体办法由国务院规定。",
      "order": 49
    },
    {
      "id": "law-e837c631ef-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第三章资格和任用"
      ],
      "text": "学校和其他教育机构应当逐步实行教师聘任制。教师的聘任应当遵循双方地位平等的原则，由学校和教师签订聘任合同，明确规定双方的权利、义务和责任。\n实施教师聘任制的步骤、办法由国务院教育行政部门规定。",
      "order": 50
    },
    {
      "id": "law-e837c631ef-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第四章培养和培训"
      ],
      "text": "各级人民政府和有关部门应当办好师范教育，并采取措施，鼓励优秀青年进入各级师范学校学习。各级教师进修学校承担培训中小学教师的任务。\n非师范学校应当承担培养和培训中小学教师的任务。\n各级师范学校学生享受专业奖学金。",
      "order": 53
    },
    {
      "id": "law-e837c631ef-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第四章培养和培训"
      ],
      "text": "各级人民政府教育行政部门、学校主管部门和学校应当制定教师培训规划，对教师进行多种形式的思想政治、业务培训。",
      "order": 56
    },
    {
      "id": "law-e837c631ef-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第四章培养和培训"
      ],
      "text": "国家机关、企业事业单位和其他社会组织应当为教师的社会调查和社会实践提供方便，给予协助。",
      "order": 57
    },
    {
      "id": "law-e837c631ef-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第四章培养和培训"
      ],
      "text": "各级人民政府应当采取措施，为少数民族地区和边远贫困地区培养、培训教师。",
      "order": 58
    },
    {
      "id": "law-e837c631ef-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第五章考核"
      ],
      "text": "学校或者其他教育机构应当对教师的政治思想、业务水平、工作态度和工作成绩进行考核。\n教育行政部门对教师的考核工作进行指导、监督。",
      "order": 60
    },
    {
      "id": "law-e837c631ef-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第五章考核"
      ],
      "text": "考核应当客观、公正、准确，充分听取教师本人、其他教师以及学生的意见。",
      "order": 62
    },
    {
      "id": "law-e837c631ef-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第五章考核"
      ],
      "text": "教师考核结果是受聘任教、晋升工资、实施奖惩的依据。",
      "order": 63
    },
    {
      "id": "law-e837c631ef-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第六章待遇"
      ],
      "text": "教师的平均工资水平应当不低于或者高于国家公务员的平均工资水平，并逐步提高。建立正常晋级增薪制度，具体办法由国务院规定。",
      "order": 65
    },
    {
      "id": "law-e837c631ef-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第六章待遇"
      ],
      "text": "中小学教师和职业学校教师享受教龄津贴和其他津贴，具体办法由国务院教育行政部门会同有关部门制定。",
      "order": 66
    },
    {
      "id": "law-e837c631ef-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第六章待遇"
      ],
      "text": "地方各级人民政府对教师以及具有中专以上学历的毕业生到少数民族地区和边远贫困地区从事教育教学工作的，应当予以补贴。",
      "order": 67
    },
    {
      "id": "law-e837c631ef-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第六章待遇"
      ],
      "text": "地方各级人民政府和国务院有关部门，对城市教师住房的建设、租赁、出售实行优先、优惠。\n县、乡两级人民政府应当为农村中小学教师解决住房提供方便。",
      "order": 68
    },
    {
      "id": "law-e837c631ef-0029",
      "articleNumber": 29,
      "displayNumber": "第二十九条",
      "path": [
        "第六章待遇"
      ],
      "text": "教师的医疗同当地国家公务员享受同等的待遇；定期对教师进行身体健康检查，并因地制宜安排教师进行休养。\n医疗机构应当对当地教师的医疗提供方便。",
      "order": 70
    },
    {
      "id": "law-e837c631ef-0030",
      "articleNumber": 30,
      "displayNumber": "第三十条",
      "path": [
        "第六章待遇"
      ],
      "text": "教师退休或者退职后，享受国家规定的退休或者退职待遇。\n县级以上地方人民政府可以适当提高长期从事教育教学工作的中小学退休教师的退休金比例。",
      "order": 72
    },
    {
      "id": "law-e837c631ef-0031",
      "articleNumber": 31,
      "displayNumber": "第三十一条",
      "path": [
        "第六章待遇"
      ],
      "text": "各级人民政府应当采取措施，改善国家补助、集体支付工资的中小学教师的待遇，逐步做到在工资收入上与国家支付工资的教师同工同酬，具体办法由地方各级人民政府根据本地区的实际情况规定。",
      "order": 74
    },
    {
      "id": "law-e837c631ef-0032",
      "articleNumber": 32,
      "displayNumber": "第三十二条",
      "path": [
        "第六章待遇"
      ],
      "text": "社会力量所办学校的教师的待遇，由举办者自行确定并予以保障。",
      "order": 75
    },
    {
      "id": "law-e837c631ef-0033",
      "articleNumber": 33,
      "displayNumber": "第三十三条",
      "path": [
        "第七章奖励"
      ],
      "text": "教师在教育教学、培养人才、科学研究、教学改革、学校建设、社会服务、勤工俭学等方面成绩优异的，由所在学校予以表彰、奖励。\n国务院和地方各级人民政府及其有关部门对有突出贡献的教师，应当予以表彰、奖励。\n对有重大贡献的教师，依照国家有关规定授予荣誉称号。",
      "order": 77
    },
    {
      "id": "law-e837c631ef-0034",
      "articleNumber": 34,
      "displayNumber": "第三十四条",
      "path": [
        "第七章奖励"
      ],
      "text": "国家支持和鼓励社会组织或者个人向依法成立的奖励教师的基金组织捐助资金，对教师进行奖励。",
      "order": 80
    },
    {
      "id": "law-e837c631ef-0035",
      "articleNumber": 35,
      "displayNumber": "第三十五条",
      "path": [
        "第八章法律责任"
      ],
      "text": "侮辱、殴打教师的，根据不同情况，分别给予行政处分或者行政处罚；造成损害的，责令赔偿损失；情节严重，构成犯罪的，依法追究刑事责任。",
      "order": 82
    },
    {
      "id": "law-e837c631ef-0036",
      "articleNumber": 36,
      "displayNumber": "第三十六条",
      "path": [
        "第八章法律责任"
      ],
      "text": "对依法提出申诉、控告、检举的教师进行打击报复的，由其所在单位或者上级机关责令改正；情节严重的，可以根据具体情况给予行政处分。\n国家工作人员对教师打击报复构成犯罪的，依照刑法有关规定追究刑事责任。",
      "order": 83
    },
    {
      "id": "law-e837c631ef-0037",
      "articleNumber": 37,
      "displayNumber": "第三十七条",
      "path": [
        "第八章法律责任"
      ],
      "text": "教师有下列情形之一的，由所在学校、其他教育机构或者教育行政部门给予行政处分或者解聘：\n（一）故意不完成教育教学任务给教育教学工作造成损失的；\n（二）体罚学生，经教育不改的；\n（三）品行不良、侮辱学生，影响恶劣的。\n教师有前款第（二）项、第（三）项所列情形之一，情节严重，构成犯罪的，依法追究刑事责任。",
      "order": 85
    },
    {
      "id": "law-e837c631ef-0038",
      "articleNumber": 38,
      "displayNumber": "第三十八条",
      "path": [
        "第八章法律责任"
      ],
      "text": "地方人民政府对违反本法规定，拖欠教师工资或者侵犯教师其他合法权益的，应当责令其限期改正。\n违反国家财政制度、财务制度，挪用国家财政用于教育的经费，严重妨碍教育教学工作，拖欠教师工资，损害教师合法权益的，由上级机关责令限期归还被挪用的经费，并对直接责任人员给予行政处分；情节严重，构成犯罪的，依法追究刑事责任。",
      "order": 90
    },
    {
      "id": "law-e837c631ef-0039",
      "articleNumber": 39,
      "displayNumber": "第三十九条",
      "path": [
        "第八章法律责任"
      ],
      "text": "教师对学校或者其他教育机构侵犯其合法权益的，或者对学校或者其他教育机构作出的处理不服的，可以向教育行政部门提出申诉，教育行政部门应当在接到申诉的三十日内，作出处理。\n教师认为当地人民政府有关行政部门侵犯其根据本法规定享有的权利的，可以向同级人民政府或者上一级人民政府有关部门提出申诉，同级人民政府或者上一级人民政府有关部门应当作出处理。",
      "order": 92
    },
    {
      "id": "law-e837c631ef-0040",
      "articleNumber": 40,
      "displayNumber": "第四十条",
      "path": [
        "第九章附则"
      ],
      "text": "本法下列用语的含义是：\n（一）各级各类学校，是指实施学前教育、普通初等教育、普通中等教育、职业教育、普通高等教育以及特殊教育、成人教育的学校。\n（二）其他教育机构，是指少年宫以及地方教研室、电化教育机构等。\n（三）中小学教师，是指幼儿园、特殊教育机构、普通中小学、成人初等中等教育机构、职业中学以及其他教育机构的教师。",
      "order": 95
    },
    {
      "id": "law-e837c631ef-0041",
      "articleNumber": 41,
      "displayNumber": "第四十一条",
      "path": [
        "第九章附则"
      ],
      "text": "学校和其他教育机构中的教育教学辅助人员，其他类型的学校的教师和教育教学辅助人员，可以根据实际情况参照本法的有关规定执行。\n军队所属院校的教师和教育教学辅助人员，由中央军事委员会依照本法制定有关规定。",
      "order": 99
    },
    {
      "id": "law-e837c631ef-0042",
      "articleNumber": 42,
      "displayNumber": "第四十二条",
      "path": [
        "第九章附则"
      ],
      "text": "外籍教师的聘任办法由国务院教育行政部门规定。",
      "order": 101
    },
    {
      "id": "law-e837c631ef-0043",
      "articleNumber": 43,
      "displayNumber": "第四十三条",
      "path": [
        "第九章附则"
      ],
      "text": "本法自1994年1月1日起施行。",
      "order": 102
    }
  ]
}
