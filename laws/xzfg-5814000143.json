{
  "id": "xzfg-5814000143",
  "officialId": "",
  "title": "民族乡行政工作条例",
  "category": "行政法规",
  "issuingAuthority": "国务院",
  "promulgationDate": "1993-09-15",
  "effectiveDate": "",
  "status": "effective",
  "source": {
    "metadataPath": "data/laws/xzfg-5814000143/metadata.json",
    "docxPath": "data/laws/xzfg-5814000143/official.docx"
  },
  "paragraphCount": 37,
  "sectionCount": 0,
  "articleCount": 24,
  "sections": [],
  "articles": [
    {
      "id": "xzfg-5814000143-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [],
      "text": "为了促进民族乡经济、文化等项事业的发展，保障少数民族的合法权益，增强民族团结，根据宪法和法律的有关规定，制定本条例。",
      "order": 1
    },
    {
      "id": "xzfg-5814000143-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [],
      "text": "民族乡是在少数民族聚居的地方建立的乡级行政区域。\n少数民族人口占全乡总人口30%以上的乡，可以按照规定申请设立民族乡；特殊情况的，可以略低于这个比例。",
      "order": 2
    },
    {
      "id": "xzfg-5814000143-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [],
      "text": "民族乡的建立，由省、自治区、直辖市人民政府决定。\n民族乡的名称，除特殊情况外，按照以地方名称加民族名称确定。",
      "order": 4
    },
    {
      "id": "xzfg-5814000143-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [],
      "text": "民族乡人民政府配备工作人员，应当尽量配备建乡的民族和其他少数民族人员。",
      "order": 6
    },
    {
      "id": "xzfg-5814000143-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [],
      "text": "民族乡人民政府在执行职务的时候，使用当地通用的语言文字。",
      "order": 7
    },
    {
      "id": "xzfg-5814000143-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [],
      "text": "民族乡人民政府依照法律、法规和国家有关规定，结合本乡的具体情况和民族特点，因地制宜地发展经济、教育、科技、文化、卫生等项事业。",
      "order": 8
    },
    {
      "id": "xzfg-5814000143-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [],
      "text": "民族乡人民政府在本行政区域各族人民中进行爱国主义、社会主义和民族政策、民族团结的教育，不断巩固和发展平等、团结、互助的社会主义民族关系。",
      "order": 9
    },
    {
      "id": "xzfg-5814000143-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [],
      "text": "民族乡财政由各省、自治区、直辖市人民政府按照优待民族乡的原则确定。\n民族乡的上一级人民政府在编制财政预算时，应当给民族乡安排一定的机动财力，乡财政收入的超收部分和财政支出的节余部分，应当全部留给民族乡周转使用。",
      "order": 10
    },
    {
      "id": "xzfg-5814000143-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [],
      "text": "信贷部门应当根据法律、法规和国家其他有关规定，对经济发展水平较低的民族乡用于生产建设、资源开发和少数民族用品生产方面的贷款给予照顾。",
      "order": 12
    },
    {
      "id": "xzfg-5814000143-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [],
      "text": "县级以上地方各级人民政府依照税收法律、法规的规定及税收管理权限，可以采取减税、免税措施，扶持民族乡经济的发展。",
      "order": 13
    },
    {
      "id": "xzfg-5814000143-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [],
      "text": "县级以上地方各级人民政府在分配支援经济不发达地区专项资金及其他固定或者临时专项资金时，对经济发展水平较低的民族乡给予照顾。\n县级以上地方各级人民政府在分配扶贫专项物资时，应当照顾贫困民族乡的需要。",
      "order": 14
    },
    {
      "id": "xzfg-5814000143-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [],
      "text": "民族乡依照法律、法规和国家其他有关规定，管理和保护本乡的自然资源，并对可以由本乡开发的自然资源优先合理开发利用。\n在民族乡依法开发资源、兴办企业，应当照顾民族乡的利益和当地人民群众的生产、生活，在配套加工产品的生产和招收当地少数民族人员方面做出合理安排。",
      "order": 16
    },
    {
      "id": "xzfg-5814000143-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [],
      "text": "县级以上地方各级人民政府应当帮助民族乡加强农业、林业、牧业、副业、渔业和水利、电力等基础设施的建设，扶持民族乡发展交通事业。",
      "order": 18
    },
    {
      "id": "xzfg-5814000143-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [],
      "text": "县级以上地方各级人民政府应当在师资、经费、教学设施等方面采取优惠政策，帮助民族乡发展教育事业，提高教育质量。\n民族乡根据实际情况，可以兴办小学、中学和初级职业学校；牧区、山区以及经济困难的民族乡，在上级人民政府的帮助和指导下，可以设立以寄宿制和助学金为主的学校。\n民族乡的中小学可以使用当地少数民族通用的语言文字教学，同时推广全国通用的普通话。使用民族语言文字教学的中小学，其教育行政经费、教职工编制可以高于普通学校。\n民族乡在上级人民政府的帮助和指导下，积极开展扫盲工作。\n县级以上地方各级人民政府可以根据当地实际情况，在有关大中专院校和中学中设立民族班，尽可能使民族乡有一定数量的学生入学。",
      "order": 19
    },
    {
      "id": "xzfg-5814000143-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [],
      "text": "县级以上地方各级人民政府应当帮助民族乡开展科学技术知识的普及工作，组织和促进科学技术的交流和协作。",
      "order": 24
    },
    {
      "id": "xzfg-5814000143-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [],
      "text": "县级以上地方各级人民政府应当积极帮助民族乡创办广播站、文化馆(站)等文化设施，丰富各族人民的文化生活，保护和继承具有民族特点的优秀文化遗产。",
      "order": 25
    },
    {
      "id": "xzfg-5814000143-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [],
      "text": "县级以上地方各级人民政府应当积极帮助民族乡发展医药卫生事业，扶持民族乡办好卫生院(所)，培养和使用少数民族医疗保健人员，加强对地方病、多发病、常见病的防治，积极开展妇幼保健工作。",
      "order": 26
    },
    {
      "id": "xzfg-5814000143-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [],
      "text": "民族乡应当积极做好计划生育工作，搞好优生优育优教，提高人口素质。",
      "order": 27
    },
    {
      "id": "xzfg-5814000143-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [],
      "text": "民族乡应当在上级人民政府的帮助和指导下，采取各种措施，加强对少数民族干部的培养和使用。",
      "order": 28
    },
    {
      "id": "xzfg-5814000143-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [],
      "text": "民族乡应当采取多种形式和提供优惠待遇，引进人才参加本乡的社会主义建设事业。\n县级以上地方各级人民政府应当采取调派、聘任、轮换等办法，组织教师、医生、科技人员等到民族乡工作。\n县级以上地方各级人民政府对长期在边远地区的民族乡工作的教师、医生和科技人员，应当给予优惠待遇。",
      "order": 29
    },
    {
      "id": "xzfg-5814000143-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [],
      "text": "少数民族聚居镇的行政工作，可以参照本条例执行。",
      "order": 32
    },
    {
      "id": "xzfg-5814000143-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [],
      "text": "辖有民族乡的省、自治区、直辖市人民政府可以根据本条例制定实施办法。",
      "order": 33
    },
    {
      "id": "xzfg-5814000143-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [],
      "text": "本条例由国家民族事务委员会负责解释。",
      "order": 34
    },
    {
      "id": "xzfg-5814000143-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [],
      "text": "本条例自发布之日起施行。",
      "order": 35
    }
  ]
}
