  "articles": [
    {
      "id": "xzfg-d987f71050-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为建立高等教育自学考试制度，完善高等教育体系，根据宪法第十九条“鼓励自学成才”的规定，制定本条例。",
      "order": 2
    },
    {
      "id": "xzfg-d987f71050-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "本条例所称高等教育自学考试，是对自学者进行以学历考试为主的高等教育国家考试，是个人自学、社会助学和国家考试相结合的高等教育形式。\n高等教育自学考试的任务，是通过国家考试促进广泛的个人自学和社会助学活动，推进在职专业教育和大学后继续教育，造就和选拔德才兼备的专门人才，提高全民族的思想道德、科学文化素质，适应社会主义现代化建设的需要。",
      "order": 3
    },
    {
      "id": "xzfg-d987f71050-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "中华人民共和国公民，不受性别、年龄、民族、种族和已受教育程度的限制，均可依照本条例的规定参加高等教育自学考试。",
      "order": 5
    },
    {
      "id": "xzfg-d987f71050-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "高等教育自学考试，应以教育为社会主义建设服务为根本方向，讲求社会效益，保证人才质量。根据经济建设和社会发展的需要，人才需求的科学预测和开考条件的实际可能，设置考试专业。",
      "order": 6
    },
    {
      "id": "xzfg-d987f71050-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "高等教育自学考试的专科(基础科)、本科等学历层次，与普通高等学校的学历层次水平的要求应相一致。",
      "order": 7
    },
    {
      "id": "xzfg-d987f71050-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第二章考试机构"
      ],
      "text": "全国高等教育自学考试指导委员会(以下简称“全国考委”)在国家教育委员会领导下，负责全国高等教育自学考试工作。\n全国考委由国务院教育、计划、财政、劳动人事部门的负责人，军队和有关人民团体的负责人，以及部分高等学校的校(院)长、专家、学者组成。\n全国考委的职责是：\n(一)根据国家的教育方针和有关政策、法规，制定高等教育自学考试的具体政策和业务规范；\n(二)指导和协调各省、自治区、直辖市的高等教育自学考试工作；\n(三)制定高等教育自学考试开考专业的规划，审批开考本科专业；\n(四)制定和审定高等教育自学考试专业考试计划、课程自学考试大纲；\n(五)根据本条例，对高等教育自学考试的有效性进行审查；\n(六)组织高等教育自学考试的研究工作。\n国家教育委员会设立高等教育自学考试工作管理机构，该机构同时作为全国考委的日常办事机构。",
      "order": 9
    },
    {
      "id": "xzfg-d987f71050-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第二章考试机构"
      ],
      "text": "全国考委根据工作需要设立若干专业委员会，负责拟订专业考试计划和课程自学考试大纲，组织编写和推荐适合自学的高等教育教材，对本专业考试工作进行业务指导和质量评估。",
      "order": 19
    },
    {
      "id": "xzfg-d987f71050-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第二章考试机构"
      ],
      "text": "省、自治区、直辖市高等教育自学考试委员会(以下简称“省考委”)在省、自治区、直辖市人民政府领导和全国考委指导下进行工作。省考委的组成，参照全国考委的组成确定。\n省考委的职责是：\n(一)贯彻执行高等教育自学考试的方针、政策、法规和业务规范；\n(二)在全国考委关于开考专业的规划和原则的指导下，结合本地实际拟定开考专业，指定主考学校；\n(三)组织本地区开考专业的考试工作；\n(四)负责本地区应考者的考籍管理，颁发单科合格证书和毕业证书；\n(五)指导本地区的社会助学活动；\n(六)根据国家教育委员会的委托，对已经批准建校招生的成人高等学校的教学质量，通过考试的方法进行检查。\n省、自治区、直辖市教育行政部门设立高等教育自学考试工作管理机构，该机构同时作为省考委的日常办事机构。",
      "order": 20
    },
    {
      "id": "xzfg-d987f71050-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第二章考试机构"
      ],
      "text": "省、自治区人民政府的派出机关所辖地区(以下简称“地区”)、市、直辖市的市辖区高等教育自学考试工作委员会(以下简称“地市考委”)在地区行署或市(区)人民政府领导和省考委的指导下进行工作。\n地市考委的职责是：\n(一)负责本地区高等教育自学考试的组织工作；\n(二)指导本地区的社会助学活动；\n(三)负责组织本地区高等教育自学考试毕业人员的思想品德鉴定工作。\n地市考委的日常工作由当地教育行政部门负责。",
      "order": 29
    },
    {
      "id": "xzfg-d987f71050-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第二章考试机构"
      ],
      "text": "主考学校由省考委遴选专业师资力量较强的全日制普通高等学校担任。主考学校在高等教育自学考试工作上接受省考委的领导，参与命题和评卷，负责有关实践性学习环节的考核，在毕业证书上副署，办理省考委交办的其他有关工作。\n主考学校应设立高等教育自学考试办事机构，根据任务配备专职工作人员，所需编制列入学校总编制数内，由学校主管部门解决。",
      "order": 35
    },
    {
      "id": "xzfg-d987f71050-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第三章开考专业"
      ],
      "text": "高等教育自学考试开考专科新专业，由省考委确定；开考本科新专业，由省考委组织有关部门和专家进行论证，并提出申请，报全国考委审批。",
      "order": 38
    },
    {
      "id": "xzfg-d987f71050-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第三章开考专业"
      ],
      "text": "可以实行省际协作开考新专业。",
      "order": 39
    },
    {
      "id": "xzfg-d987f71050-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第三章开考专业"
      ],
      "text": "开考新专业必须具备下列条件：\n(一)有健全的工作机构、必要的专职人员和经费；\n(二)有符合本条例第十条规定的主考学校；\n(三)有专业考试计划；\n(四)有保证实践性环节考核的必要条件。",
      "order": 40
    },
    {
      "id": "xzfg-d987f71050-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第三章开考专业"
      ],
      "text": "开考承认学历的新专业，一般应在普通高等学校已有专业目录中选择确定。",
      "order": 45
    },
    {
      "id": "xzfg-d987f71050-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第三章开考专业"
      ],
      "text": "国务院各部委、各直属机构和军队系统要求开考本系统所需专业的，可以委托省考委组织办理，或由全国考委协调办理。",
      "order": 46
    },
    {
      "id": "xzfg-d987f71050-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第三章开考专业"
      ],
      "text": "全国考委每年一次集中进行专业审批。省考委应于每年6月底前将申报材料报送全国考委，逾期者延至下一年度重新申报办理。审批结果由全国考委于当年第三季度内下达。凡批准开考的专业均可于次年接受报考，并于首次开考前半年向社会公布开考专业名称和专业考试计划。",
      "order": 47
    },
    {
      "id": "xzfg-d987f71050-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第四章考试办法"
      ],
      "text": "高等教育自学考试的命题由全国考委统筹安排，分别采取全国统一命题、区域命题、省级命题三种办法。逐步建立题库，实现必要的命题标准化。\n试题(包括副题)及参考答案、评分标准启用前属绝密材料。",
      "order": 49
    },
    {
      "id": "xzfg-d987f71050-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第四章考试办法"
      ],
      "text": "各专业考试计划的安排，专科(基础科)一般为3至4年，本科一般为4至5年。",
      "order": 51
    },
    {
      "id": "xzfg-d987f71050-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第四章考试办法"
      ],
      "text": "按照专业考试计划的要求，每门课程进行一次性考试。课程考试合格者，发给单科合格证书，并按规定计算学分。不及格者，可参加下一次该门课程的考试。",
      "order": 52
    },
    {
      "id": "xzfg-d987f71050-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第四章考试办法"
      ],
      "text": "报考人员可在本地区的开考专业范围内，自愿选择考试专业，但根据专业要求对报考对象作职业上必要限制的专业除外。\n提倡在职人员按照学用一致的原则选择考试专业。\n各级各类全日制学校的在校生不得报考。",
      "order": 53
    },
    {
      "id": "xzfg-d987f71050-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第四章考试办法"
      ],
      "text": "报考人员应按本地区的有关规定，到省考委或地市考委指定的单位办理报名手续。",
      "order": 56
    },
    {
      "id": "xzfg-d987f71050-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第四章考试办法"
      ],
      "text": "已经取得高等学校研究生、本科生或专科生学历的人员参加高等教育自学考试的，可以按照有关规定免考部分课程。",
      "order": 57
    },
    {
      "id": "xzfg-d987f71050-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第四章考试办法"
      ],
      "text": "高等教育自学考试以地区、市、直辖市的市辖区为单位设考场。有条件的，地市考委经省考委批准可在县设考场，由地市考委直接领导。",
      "order": 58
    },
    {
      "id": "xzfg-d987f71050-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第五章考籍管理"
      ],
      "text": "高等教育自学考试应考者取得一门课程的单科合格证书后，省考委即应为其建立考籍管理档案。\n应考者因户口迁移或工作变动需要转地区或转专业参加考试的，按考籍管理办法办理有关手续。",
      "order": 60
    },
    {
      "id": "xzfg-d987f71050-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第五章考籍管理"
      ],
      "text": "高等教育自学考试应考者符合下列规定，可以取得毕业证书：\n(一)考完专业考试计划规定的全部课程，并取得合格成绩；\n(二)完成规定的毕业论文(设计)或其他教学实践任务；\n(三)思想品德鉴定合格。\n获得专科(基础科)或本科毕业证书者，国家承认其学历。",
      "order": 62
    },
    {
      "id": "xzfg-d987f71050-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第五章考籍管理"
      ],
      "text": "符合相应学位条件的高等教育自学考试本科毕业人员，由有学位授予权的主考学校依照《中华人民共和国学位条例》的规定，授予相应的学位。",
      "order": 67
    },
    {
      "id": "xzfg-d987f71050-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第五章考籍管理"
      ],
      "text": "高等教育自学考试应考者毕业时间，为每年的6月和12月。",
      "order": 68
    },
    {
      "id": "xzfg-d987f71050-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第六章社会助学"
      ],
      "text": "国家鼓励企业、事业单位和其他社会力量，根据高等教育自学考试的专业考试计划和课程自学考试大纲的要求，通过电视、广播、函授、面授等多种形式开展助学活动。",
      "order": 70
    },
    {
      "id": "xzfg-d987f71050-0029",
      "articleNumber": 29,
      "displayNumber": "第二十九条",
      "path": [
        "第六章社会助学"
      ],
      "text": "各种形式的社会助学活动，应当接受高等教育自学考试机构的指导和教育行政部门的管理。",
      "order": 71
    },
    {
      "id": "xzfg-d987f71050-0030",
      "articleNumber": 30,
      "displayNumber": "第三十条",
      "path": [
        "第六章社会助学"
      ],
      "text": "高等教育自学考试辅导材料的出版、发行，应遵守国家的有关规定。",
      "order": 72
    },
    {
      "id": "xzfg-d987f71050-0031",
      "articleNumber": 31,
      "displayNumber": "第三十一条",
      "path": [
        "第七章毕业人员的使用与待遇"
      ],
      "text": "高等教育自学考试专科(基础科)或本科毕业证书获得者，在职人员由所在单位或其上级主管部门本着用其所学、发挥所长的原则，根据工作需要，调整他们的工作；非在职人员(包括农民)由省、自治区、直辖市劳动人事部门根据需要，在编制和增人指标范围内有计划地择优录用或聘用。",
      "order": 74
    },
    {
      "id": "xzfg-d987f71050-0032",
      "articleNumber": 32,
      "displayNumber": "第三十二条",
      "path": [
        "第七章毕业人员的使用与待遇"
      ],
      "text": "高等教育自学考试毕业证书获得者的工资待遇：非在职人员录用后，与普通高等学校同类毕业生相同；在职人员的工资待遇低于普通高等学校同类毕业生的，从获得毕业证书之日起，按普通高等学校同类毕业生工资标准执行。",
      "order": 75
    },
    {
      "id": "xzfg-d987f71050-0033",
      "articleNumber": 33,
      "displayNumber": "第三十三条",
      "path": [
        "第八章考试经费"
      ],
      "text": "县以上各级所需高等教育自学考试经费，按照现行财政管理体制，在教育事业费中列支。地方各级人民政府应妥善安排，予以保证。",
      "order": 77
    },
    {
      "id": "xzfg-d987f71050-0034",
      "articleNumber": 34,
      "displayNumber": "第三十四条",
      "path": [
        "第八章考试经费"
      ],
      "text": "各业务部门和军队系统要求开考本部门、本系统所需专业的，须向高等教育自学考试机构提供考试补助费。",
      "order": 78
    },
    {
      "id": "xzfg-d987f71050-0035",
      "articleNumber": 35,
      "displayNumber": "第三十五条",
      "path": [
        "第八章考试经费"
      ],
      "text": "高等教育自学考试所收缴的报名费，应用于高等教育自学考试工作，不得挪作他用。",
      "order": 79
    },
    {
      "id": "xzfg-d987f71050-0036",
      "articleNumber": 36,
      "displayNumber": "第三十六条",
      "path": [
        "第九章奖励和处罚"
      ],
      "text": "有下列情形之一的个人或单位，可由全国考委或省考委给予奖励：\n(一)参加高等教育自学考试成绩特别优异或事迹突出的；\n(二)从事高等教育自学考试工作，作出重大贡献的；\n(三)从事高等教育自学考试的社会助学工作，取得显著成绩的。",
      "order": 81
    },
    {
      "id": "xzfg-d987f71050-0037",
      "articleNumber": 37,
      "displayNumber": "第三十七条",
      "path": [
        "第九章奖励和处罚"
      ],
      "text": "高等教育自学考试应考者在考试中有夹带、传递、抄袭、换卷、代考等舞弊行为以及其他违反考试规则的行为，省考委视情节轻重，分别给予警告、取消考试成绩、停考1至3年的处罚。",
      "order": 85
    },
    {
      "id": "xzfg-d987f71050-0038",
      "articleNumber": 38,
      "displayNumber": "第三十八条",
      "path": [
        "第九章奖励和处罚"
      ],
      "text": "高等教育自学考试工作人员和考试组织工作参与人员有下列行为之一的，省考委或其所在单位取消其考试工作人员资格或给予行政处分：\n(一)涂改应考者试卷、考试分数及其他考籍档案材料的；\n(二)在应考者证明材料中弄虚作假的；\n(三)纵容他人实施本条(一)、(二)项舞弊行为的。",
      "order": 86
    },
    {
      "id": "xzfg-d987f71050-0039",
      "articleNumber": 39,
      "displayNumber": "第三十九条",
      "path": [
        "第九章奖励和处罚"
      ],
      "text": "有下列破坏高等教育自学考试工作行为之一的个人，由公安机关或司法机关依法追究法律责任：\n(一)盗窃或泄露试题及其他有关保密材料的；\n(二)扰乱考场秩序不听劝阻的；\n(三)利用职权徇私舞弊，情节严重的。",
      "order": 90
    },
    {
      "id": "xzfg-d987f71050-0040",
      "articleNumber": 40,
      "displayNumber": "第四十条",
      "path": [
        "第十章附则"
      ],
      "text": "国家教育委员会根据本条例制定实施细则。\n省、自治区、直辖市人民政府可以根据本条例和国家教育委员会的实施细则，制定具体实施办法。",
      "order": 95
    },
    {
      "id": "xzfg-d987f71050-0041",
      "articleNumber": 41,
      "displayNumber": "第四十一条",
      "path": [
        "第十章附则"
      ],
      "text": "本条例由国家教育委员会负责解释。",
      "order": 97
    },
    {
      "id": "xzfg-d987f71050-0042",
      "articleNumber": 42,
      "displayNumber": "第四十二条",
      "path": [
        "第十章附则"
      ],
      "text": "本条例自发布之日起施行。\n1981年1月13日《国务院批转教育部关于高等教育自学考试试行办法的报告》和1983年5月3日《国务院批转教育部等部门关于成立全国高等教育自学考试指导委员会的请示的通知》同时废止。",
      "order": 98
    }
  ]
}
