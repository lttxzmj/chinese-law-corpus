  ],
  "articles": [
    {
      "id": "xzfg-d0d74f67c4-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了促进全民健身活动的开展，保障公民在全民健身活动中的合法权益，提高公民身体素质，制定本条例。",
      "order": 2
    },
    {
      "id": "xzfg-d0d74f67c4-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "县级以上地方人民政府应当将全民健身事业纳入本级国民经济和社会发展规划，有计划地建设公共体育设施，加大对农村地区和城市社区等基层公共体育设施建设的投入，促进全民健身事业均衡协调发展。\n国家支持、鼓励、推动与人民群众生活水平相适应的体育消费以及体育产业的发展。",
      "order": 3
    },
    {
      "id": "xzfg-d0d74f67c4-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "国家推动基层文化体育组织建设，鼓励体育类社会团体、体育类民办非企业单位等群众性体育组织开展全民健身活动。",
      "order": 5
    },
    {
      "id": "xzfg-d0d74f67c4-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "公民有依法参加全民健身活动的权利。\n地方各级人民政府应当依法保障公民参加全民健身活动的权利。",
      "order": 6
    },
    {
      "id": "xzfg-d0d74f67c4-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "国务院体育主管部门负责全国的全民健身工作，国务院其他有关部门在各自职责范围内负责有关的全民健身工作。\n县级以上地方人民政府主管体育工作的部门(以下简称体育主管部门)负责本行政区域内的全民健身工作，县级以上地方人民政府其他有关部门在各自职责范围内负责有关的全民健身工作。",
      "order": 8
    },
    {
      "id": "xzfg-d0d74f67c4-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第一章总则"
      ],
      "text": "国家鼓励对全民健身事业提供捐赠和赞助。\n自然人、法人或者其他组织对全民健身事业提供捐赠的，依法享受税收优惠。",
      "order": 10
    },
    {
      "id": "xzfg-d0d74f67c4-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第一章总则"
      ],
      "text": "对在发展全民健身事业中做出突出贡献的组织和个人，按照国家有关规定给予表彰、奖励。",
      "order": 12
    },
    {
      "id": "xzfg-d0d74f67c4-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第二章全民健身计划"
      ],
      "text": "国务院制定全民健身计划，明确全民健身工作的目标、任务、措施、保障等内容。\n县级以上地方人民政府根据本地区的实际情况制定本行政区域的全民健身实施计划。\n制定全民健身计划和全民健身实施计划，应当充分考虑学生、老年人、残疾人和农村居民的特殊需求。",
      "order": 14
    },
    {
      "id": "xzfg-d0d74f67c4-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第二章全民健身计划"
      ],
      "text": "国家定期开展公民体质监测和全民健身活动状况调查。\n公民体质监测由国务院体育主管部门会同有关部门组织实施；其中，对学生的体质监测由国务院教育主管部门组织实施。\n全民健身活动状况调查由国务院体育主管部门组织实施。",
      "order": 17
    },
    {
      "id": "xzfg-d0d74f67c4-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第二章全民健身计划"
      ],
      "text": "国务院根据公民体质监测结果和全民健身活动状况调查结果，修订全民健身计划。\n县级以上地方人民政府根据公民体质监测结果和全民健身活动状况调查结果，修订全民健身实施计划。",
      "order": 20
    },
    {
      "id": "xzfg-d0d74f67c4-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第二章全民健身计划"
      ],
      "text": "全民健身计划由县级以上人民政府体育主管部门会同有关部门组织实施。县级以上地方人民政府应当加强组织和协调，对本行政区域全民健身计划实施情况负责。\n县级以上人民政府体育主管部门应当在本级人民政府任期届满时会同有关部门对全民健身计划实施情况进行评估，并将评估结果向本级人民政府报告。",
      "order": 22
    },
    {
      "id": "xzfg-d0d74f67c4-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第三章全民健身活动"
      ],
      "text": "每年8月8日为全民健身日。县级以上人民政府及其有关部门应当在全民健身日加强全民健身宣传。\n国家机关、企业事业单位和其他组织应当在全民健身日结合自身条件组织本单位人员开展全民健身活动。\n县级以上人民政府体育主管部门应当在全民健身日组织开展免费健身指导服务。\n公共体育设施应当在全民健身日向公众免费开放；国家鼓励其他各类体育设施在全民健身日向公众免费开放。",
      "order": 25
    },
    {
      "id": "xzfg-d0d74f67c4-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第三章全民健身活动"
      ],
      "text": "国务院体育主管部门应当定期举办全国性群众体育比赛活动；国务院其他有关部门、全国性社会团体等，可以根据需要举办相应的全国性群众体育比赛活动。\n地方人民政府应当定期举办本行政区域的群众体育比赛活动。",
      "order": 29
    },
    {
      "id": "xzfg-d0d74f67c4-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第三章全民健身活动"
      ],
      "text": "县级人民政府体育主管部门应当在传统节日和农闲季节组织开展与农村生产劳动和文化生活相适应的全民健身活动。",
      "order": 31
    },
    {
      "id": "xzfg-d0d74f67c4-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第三章全民健身活动"
      ],
      "text": "国家机关、企业事业单位和其他组织应当组织本单位人员开展工间(前)操和业余健身活动；有条件的，可以举办运动会，开展体育锻炼测验、体质测定等活动。",
      "order": 32
    },
    {
      "id": "xzfg-d0d74f67c4-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第三章全民健身活动"
      ],
      "text": "工会、共青团、妇联、残联等社会团体应当结合自身特点，组织成员开展全民健身活动。\n单项体育协会应当将普及推广体育项目和组织开展全民健身活动列入工作计划，并对全民健身活动给予指导和支持。",
      "order": 33
    },
    {
      "id": "xzfg-d0d74f67c4-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第三章全民健身活动"
      ],
      "text": "基层文化体育组织、居民委员会和村民委员会应当组织居民开展全民健身活动，协助政府做好相关工作。",
      "order": 35
    },
    {
      "id": "xzfg-d0d74f67c4-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第三章全民健身活动"
      ],
      "text": "鼓励全民健身活动站点、体育俱乐部等群众性体育组织开展全民健身活动，宣传科学健身知识；县级以上人民政府体育主管部门和其他有关部门应当给予支持。",
      "order": 36
    },
    {
      "id": "xzfg-d0d74f67c4-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第三章全民健身活动"
      ],
      "text": "对于依法举办的群众体育比赛等全民健身活动，任何组织或者个人不得非法设置审批和收取审批费用。",
      "order": 37
    },
    {
      "id": "xzfg-d0d74f67c4-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第三章全民健身活动"
      ],
      "text": "广播电台、电视台、报刊和互联网站等应当加强对全民健身活动的宣传报道，普及科学健身知识，增强公民健身意识。",
      "order": 38
    },
    {
      "id": "xzfg-d0d74f67c4-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第三章全民健身活动"
      ],
      "text": "学校应当按照《中华人民共和国体育法》和《学校体育工作条例》的规定，根据学生的年龄、性别和体质状况，组织实施体育课教学，开展广播体操、眼保健操等体育活动，指导学生的体育锻炼，提高学生的身体素质。\n学校应当保证学生在校期间每天参加1小时的体育活动。",
      "order": 39
    },
    {
      "id": "xzfg-d0d74f67c4-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第三章全民健身活动"
      ],
      "text": "学校每学年至少举办一次全校性的运动会；有条件的，还可以有计划地组织学生参加远足、野营、体育夏(冬)令营等活动。",
      "order": 41
    },
    {
      "id": "xzfg-d0d74f67c4-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第三章全民健身活动"
      ],
      "text": "基层文化体育组织、学校、家庭应当加强合作，支持和引导学生参加校外体育活动。\n青少年活动中心、少年宫、妇女儿童中心等应当为学生开展体育活动提供便利。",
      "order": 42
    },
    {
      "id": "xzfg-d0d74f67c4-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第三章全民健身活动"
      ],
      "text": "组织大型全民健身活动，应当按照国家有关大型群众性活动安全管理的规定，做好安全工作。",
      "order": 44
    },
    {
      "id": "xzfg-d0d74f67c4-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第三章全民健身活动"
      ],
      "text": "任何组织或者个人不得利用健身活动从事宣扬封建迷信、违背社会公德、扰乱公共秩序、损害公民身心健康的行为。",
      "order": 45
    },
    {
      "id": "xzfg-d0d74f67c4-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第四章全民健身保障"
      ],
      "text": "县级以上人民政府应当将全民健身工作所需经费列入本级财政预算，并随着国民经济的发展逐步增加对全民健身的投入。\n按照国家有关彩票公益金的分配政策由体育主管部门分配使用的彩票公益金，应当根据国家有关规定用于全民健身事业。",
      "order": 47
    },
    {
      "id": "xzfg-d0d74f67c4-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第四章全民健身保障"
      ],
      "text": "公共体育设施的规划、建设、使用、管理、保护和公共体育设施管理单位提供服务，应当遵守《公共文化体育设施条例》的规定。\n公共体育设施的规划、建设应当与当地经济发展水平相适应，方便群众就近参加健身活动；农村地区公共体育设施的规划、建设还应当考虑农村生产劳动和文化生活习惯。",
      "order": 49
    },
    {
      "id": "xzfg-d0d74f67c4-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第四章全民健身保障"
      ],
      "text": "学校应当在课余时间和节假日向学生开放体育设施。公办学校应当积极创造条件向公众开放体育设施；国家鼓励民办学校向公众开放体育设施。\n县级人民政府对向公众开放体育设施的学校给予支持，为向公众开放体育设施的学校办理有关责任保险。\n学校可以根据维持设施运营的需要向使用体育设施的公众收取必要的费用。",
      "order": 51
    },
    {
      "id": "xzfg-d0d74f67c4-0029",
      "articleNumber": 29,
      "displayNumber": "第二十九条",
      "path": [
        "第四章全民健身保障"
      ],
      "text": "公园、绿地等公共场所的管理单位，应当根据自身条件安排全民健身活动场地。县级以上地方人民政府体育主管部门根据实际情况免费提供健身器材。\n居民住宅区的设计应当安排健身活动场地。",
      "order": 54
    },
    {
      "id": "xzfg-d0d74f67c4-0030",
      "articleNumber": 30,
      "displayNumber": "第三十条",
      "path": [
        "第四章全民健身保障"
      ],
      "text": "公园、绿地、广场等公共场所和居民住宅区的管理单位，应当对该公共场所和居民住宅区配置的全民健身器材明确管理和维护责任人。",
      "order": 56
    },
    {
      "id": "xzfg-d0d74f67c4-0031",
      "articleNumber": 31,
      "displayNumber": "第三十一条",
      "path": [
        "第四章全民健身保障"
      ],
      "text": "国家加强社会体育指导人员队伍建设，对全民健身活动进行科学指导。\n国家对不以收取报酬为目的向公众提供传授健身技能、组织健身活动、宣传科学健身知识等服务的社会体育指导人员实行技术等级制度。县级以上地方人民政府体育主管部门应当免费为其提供相关知识和技能培训，并建立档案。\n国家对以健身指导为职业的社会体育指导人员实行职业资格证书制度。以对高危险性体育项目进行健身指导为职业的社会体育指导人员，应当依照国家有关规定取得职业资格证书。",
      "order": 57
    },
    {
      "id": "xzfg-d0d74f67c4-0032",
      "articleNumber": 32,
      "displayNumber": "第三十二条",
      "path": [
        "第四章全民健身保障"
      ],
      "text": "企业、个体工商户经营高危险性体育项目的，应当符合下列条件，并向县级以上地方人民政府体育主管部门提出申请：\n(一)相关体育设施符合国家标准；\n(二)具有达到规定数量的取得国家职业资格证书的社会体育指导人员和救助人员；\n(三)具有相应的安全保障制度和措施。\n县级以上地方人民政府体育主管部门应当自收到申请之日起30日内进行实地核查，做出批准或者不予批准的决定。批准的，应当发给许可证；不予批准的，应当书面通知申请人并说明理由。\n国务院体育主管部门应当会同有关部门制定、调整高危险性体育项目目录，经国务院批准后予以公布。",
      "order": 60
    },
    {
      "id": "xzfg-d0d74f67c4-0033",
      "articleNumber": 33,
      "displayNumber": "第三十三条",
      "path": [
        "第四章全民健身保障"
      ],
      "text": "国家鼓励全民健身活动组织者和健身场所管理者依法投保有关责任保险。\n国家鼓励参加全民健身活动的公民依法投保意外伤害保险。",
      "order": 66
    },
    {
      "id": "xzfg-d0d74f67c4-0034",
      "articleNumber": 34,
      "displayNumber": "第三十四条",
      "path": [
        "第四章全民健身保障"
      ],
      "text": "县级以上地方人民政府体育主管部门对高危险性体育项目经营活动，应当依法履行监督检查职责。",
      "order": 68
    },
    {
      "id": "xzfg-d0d74f67c4-0035",
      "articleNumber": 35,
      "displayNumber": "第三十五条",
      "path": [
        "第五章法律责任"
      ],
      "text": "学校违反本条例规定的，由县级以上人民政府教育主管部门按照管理权限责令改正；拒不改正的，对负有责任的主管人员和其他直接责任人员依法给予处分。",
      "order": 70
    },
    {
      "id": "xzfg-d0d74f67c4-0036",
      "articleNumber": 36,
      "displayNumber": "第三十六条",
      "path": [
        "第五章法律责任"
      ],
      "text": "未经批准，擅自经营高危险性体育项目的，由县级以上地方人民政府体育主管部门按照管理权限责令改正；有违法所得的，没收违法所得；违法所得不足3万元或者没有违法所得的，并处3万元以上10万元以下的罚款；违法所得3万元以上的，并处违法所得2倍以上5倍以下的罚款。",
      "order": 71
    },
    {
      "id": "xzfg-d0d74f67c4-0037",
      "articleNumber": 37,
      "displayNumber": "第三十七条",
      "path": [
        "第五章法律责任"
      ],
      "text": "高危险性体育项目经营者取得许可证后，不再符合本条例规定条件仍经营该体育项目的，由县级以上地方人民政府体育主管部门按照管理权限责令改正；有违法所得的，没收违法所得；违法所得不足3万元或者没有违法所得的，并处3万元以上10万元以下的罚款；违法所得3万元以上的，并处违法所得2倍以上5倍以下的罚款；拒不改正的，由原发证机关吊销许可证。",
      "order": 72
    },
    {
      "id": "xzfg-d0d74f67c4-0038",
      "articleNumber": 38,
      "displayNumber": "第三十八条",
      "path": [
        "第五章法律责任"
      ],
      "text": "利用健身活动从事宣扬封建迷信、违背社会公德、扰乱公共秩序、损害公民身心健康的行为的，由公安机关依照《中华人民共和国治安管理处罚法》的规定给予处罚；构成犯罪的，依法追究刑事责任。",
      "order": 73
    },
    {
      "id": "xzfg-d0d74f67c4-0039",
      "articleNumber": 39,
      "displayNumber": "第三十九条",
      "path": [
        "第五章法律责任"
      ],
      "text": "县级以上人民政府及其有关部门的工作人员在全民健身工作中玩忽职守、滥用职权、徇私舞弊的，依法给予处分；构成犯罪的，依法追究刑事责任。",
      "order": 74
    },
    {
      "id": "xzfg-d0d74f67c4-0040",
      "articleNumber": 40,
      "displayNumber": "第四十条",
      "path": [
        "第六章附则"
      ],
      "text": "本条例自2009年10月1日起施行。",
      "order": 76
    }
  ]
}
