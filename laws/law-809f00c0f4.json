  "articles": [
    {
      "id": "law-809f00c0f4-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了合理开发利用和保护煤炭资源，规范煤炭生产、经营活动，促进和保障煤炭行业的发展，制定本法。",
      "order": 2
    },
    {
      "id": "law-809f00c0f4-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "在中华人民共和国领域和中华人民共和国管辖的其他海域从事煤炭生产、经营活动，适用本法。",
      "order": 3
    },
    {
      "id": "law-809f00c0f4-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "煤炭资源属于国家所有。地表或者地下的煤炭资源的国家所有权，不因其依附的土地的所有权或者使用权的不同而改变。",
      "order": 4
    },
    {
      "id": "law-809f00c0f4-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "国家对煤炭开发实行统一规划、合理布局、综合利用的方针。",
      "order": 5
    },
    {
      "id": "law-809f00c0f4-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "国家依法保护煤炭资源，禁止任何乱采、滥挖破坏煤炭资源的行为。",
      "order": 6
    },
    {
      "id": "law-809f00c0f4-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第一章总则"
      ],
      "text": "国家保护依法投资开发煤炭资源的投资者的合法权益。\n国家保障国有煤矿的健康发展。\n国家对乡镇煤矿采取扶持、改造、整顿、联合、提高的方针，实行正规合理开发和有序发展。",
      "order": 7
    },
    {
      "id": "law-809f00c0f4-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第一章总则"
      ],
      "text": "煤矿企业必须坚持安全第一、预防为主的安全生产方针，建立健全安全生产的责任制度和群防群治制度。",
      "order": 10
    },
    {
      "id": "law-809f00c0f4-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第一章总则"
      ],
      "text": "各级人民政府及其有关部门和煤矿企业必须采取措施加强劳动保护，保障煤矿职工的安全和健康。\n国家对煤矿井下作业的职工采取特殊保护措施。",
      "order": 11
    },
    {
      "id": "law-809f00c0f4-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第一章总则"
      ],
      "text": "国家鼓励和支持在开发利用煤炭资源过程中采用先进的科学技术和管理方法。\n煤矿企业应当加强和改善经营管理，提高劳动生产率和经济效益。",
      "order": 13
    },
    {
      "id": "law-809f00c0f4-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第一章总则"
      ],
      "text": "国家维护煤矿矿区的生产秩序、工作秩序，保护煤矿企业设施。",
      "order": 15
    },
    {
      "id": "law-809f00c0f4-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第一章总则"
      ],
      "text": "开发利用煤炭资源，应当遵守有关环境保护的法律、法规，防治污染和其他公害，保护生态环境。",
      "order": 16
    },
    {
      "id": "law-809f00c0f4-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第一章总则"
      ],
      "text": "国务院煤炭管理部门依法负责全国煤炭行业的监督管理。国务院有关部门在各自的职责范围内负责煤炭行业的监督管理。\n县级以上地方人民政府煤炭管理部门和有关部门依法负责本行政区域内煤炭行业的监督管理。",
      "order": 17
    },
    {
      "id": "law-809f00c0f4-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第一章总则"
      ],
      "text": "煤炭矿务局是国有煤矿企业，具有独立法人资格。\n矿务局和其他具有独立法人资格的煤矿企业、煤炭经营企业依法实行自主经营、自负盈亏、自我约束、自我发展。",
      "order": 19
    },
    {
      "id": "law-809f00c0f4-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第二章煤炭生产开发规划与煤矿建设"
      ],
      "text": "国务院煤炭管理部门根据全国矿产资源勘查规划编制全国煤炭资源勘查规划。",
      "order": 22
    },
    {
      "id": "law-809f00c0f4-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第二章煤炭生产开发规划与煤矿建设"
      ],
      "text": "国务院煤炭管理部门根据全国矿产资源规划规定的煤炭资源，组织编制和实施煤炭生产开发规划。\n省、自治区、直辖市人民政府煤炭管理部门根据全国矿产资源规划规定的煤炭资源，组织编制和实施本地区煤炭生产开发规划，并报国务院煤炭管理部门备案。",
      "order": 23
    },
    {
      "id": "law-809f00c0f4-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第二章煤炭生产开发规划与煤矿建设"
      ],
      "text": "煤炭生产开发规划应当根据国民经济和社会发展的需要制定，并纳入国民经济和社会发展计划。",
      "order": 25
    },
    {
      "id": "law-809f00c0f4-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第二章煤炭生产开发规划与煤矿建设"
      ],
      "text": "国家制定优惠政策，支持煤炭工业发展，促进煤矿建设。\n煤矿建设项目应当符合煤炭生产开发规划和煤炭产业政策。",
      "order": 26
    },
    {
      "id": "law-809f00c0f4-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第二章煤炭生产开发规划与煤矿建设"
      ],
      "text": "煤矿建设使用土地，应当依照有关法律、行政法规的规定办理。征收土地的，应当依法支付土地补偿费和安置补偿费，做好迁移居民的安置工作。\n煤矿建设应当贯彻保护耕地、合理利用土地的原则。\n地方人民政府对煤矿建设依法使用土地和迁移居民，应当给予支持和协助。",
      "order": 28
    },
    {
      "id": "law-809f00c0f4-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第二章煤炭生产开发规划与煤矿建设"
      ],
      "text": "煤矿建设应当坚持煤炭开发与环境治理同步进行。煤矿建设项目的环境保护设施必须与主体工程同时设计、同时施工、同时验收、同时投入使用。",
      "order": 31
    },
    {
      "id": "law-809f00c0f4-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第三章煤炭生产与煤矿安全"
      ],
      "text": "煤矿投入生产前，煤矿企业应当依照有关安全生产的法律、行政法规的规定取得安全生产许可证。未取得安全生产许可证的，不得从事煤炭生产。",
      "order": 33
    },
    {
      "id": "law-809f00c0f4-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第三章煤炭生产与煤矿安全"
      ],
      "text": "对国民经济具有重要价值的特殊煤种或者稀缺煤种，国家实行保护性开采。",
      "order": 34
    },
    {
      "id": "law-809f00c0f4-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第三章煤炭生产与煤矿安全"
      ],
      "text": "开采煤炭资源必须符合煤矿开采规程，遵守合理的开采顺序，达到规定的煤炭资源回采率。\n煤炭资源回采率由国务院煤炭管理部门根据不同的资源和开采条件确定。\n国家鼓励煤矿企业进行复采或者开采边角残煤和极薄煤。",
      "order": 35
    },
    {
      "id": "law-809f00c0f4-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第三章煤炭生产与煤矿安全"
      ],
      "text": "煤矿企业应当加强煤炭产品质量的监督检查和管理。煤炭产品质量应当按照国家标准或者行业标准分等论级。",
      "order": 38
    },
    {
      "id": "law-809f00c0f4-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第三章煤炭生产与煤矿安全"
      ],
      "text": "煤炭生产应当依法在批准的开采范围内进行，不得超越批准的开采范围越界、越层开采。\n采矿作业不得擅自开采保安煤柱，不得采用可能危及相邻煤矿生产安全的决水、爆破、贯通巷道等危险方法。",
      "order": 39
    },
    {
      "id": "law-809f00c0f4-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第三章煤炭生产与煤矿安全"
      ],
      "text": "因开采煤炭压占土地或者造成地表土地塌陷、挖损，由采矿者负责进行复垦，恢复到可供利用的状态；造成他人损失的，应当依法给予补偿。",
      "order": 41
    },
    {
      "id": "law-809f00c0f4-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第三章煤炭生产与煤矿安全"
      ],
      "text": "关闭煤矿和报废矿井，应当依照有关法律、法规和国务院煤炭管理部门的规定办理。",
      "order": 42
    },
    {
      "id": "law-809f00c0f4-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第三章煤炭生产与煤矿安全"
      ],
      "text": "国家建立煤矿企业积累煤矿衰老期转产资金的制度。\n国家鼓励和扶持煤矿企业发展多种经营。",
      "order": 43
    },
    {
      "id": "law-809f00c0f4-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第三章煤炭生产与煤矿安全"
      ],
      "text": "国家提倡和支持煤矿企业和其他企业发展煤电联产、炼焦、煤化工、煤建材等，进行煤炭的深加工和精加工。\n国家鼓励煤矿企业发展煤炭洗选加工，综合开发利用煤层气、煤矸石、煤泥、石煤和泥炭。",
      "order": 45
    },
    {
      "id": "law-809f00c0f4-0029",
      "articleNumber": 29,
      "displayNumber": "第二十九条",
      "path": [
        "第三章煤炭生产与煤矿安全"
      ],
      "text": "国家发展和推广洁净煤技术。\n国家采取措施取缔土法炼焦。禁止新建土法炼焦窑炉；现有的土法炼焦限期改造。",
      "order": 47
    },
    {
      "id": "law-809f00c0f4-0030",
      "articleNumber": 30,
      "displayNumber": "第三十条",
      "path": [
        "第三章煤炭生产与煤矿安全"
      ],
      "text": "县级以上各级人民政府及其煤炭管理部门和其他有关部门，应当加强对煤矿安全生产工作的监督管理。",
      "order": 49
    },
    {
      "id": "law-809f00c0f4-0031",
      "articleNumber": 31,
      "displayNumber": "第三十一条",
      "path": [
        "第三章煤炭生产与煤矿安全"
      ],
      "text": "煤矿企业的安全生产管理，实行矿务局长、矿长负责制。",
      "order": 50
    },
    {
      "id": "law-809f00c0f4-0032",
      "articleNumber": 32,
      "displayNumber": "第三十二条",
      "path": [
        "第三章煤炭生产与煤矿安全"
      ],
      "text": "矿务局长、矿长及煤矿企业的其他主要负责人必须遵守有关矿山安全的法律、法规和煤炭行业安全规章、规程，加强对煤矿安全生产工作的管理，执行安全生产责任制度，采取有效措施，防止伤亡和其他安全生产事故的发生。",
      "order": 51
    },
    {
      "id": "law-809f00c0f4-0033",
      "articleNumber": 33,
      "displayNumber": "第三十三条",
      "path": [
        "第三章煤炭生产与煤矿安全"
      ],
      "text": "煤矿企业应当对职工进行安全生产教育、培训；未经安全生产教育、培训的，不得上岗作业。\n煤矿企业职工必须遵守有关安全生产的法律、法规、煤炭行业规章、规程和企业规章制度。",
      "order": 52
    },
    {
      "id": "law-809f00c0f4-0034",
      "articleNumber": 34,
      "displayNumber": "第三十四条",
      "path": [
        "第三章煤炭生产与煤矿安全"
      ],
      "text": "在煤矿井下作业中，出现危及职工生命安全并无法排除的紧急情况时，作业现场负责人或者安全管理人员应当立即组织职工撤离危险现场，并及时报告有关方面负责人。",
      "order": 54
    },
    {
      "id": "law-809f00c0f4-0035",
      "articleNumber": 35,
      "displayNumber": "第三十五条",
      "path": [
        "第三章煤炭生产与煤矿安全"
      ],
      "text": "煤矿企业工会发现企业行政方面违章指挥、强令职工冒险作业或者生产过程中发现明显重大事故隐患，可能危及职工生命安全的情况，有权提出解决问题的建议，煤矿企业行政方面必须及时作出处理决定。企业行政方面拒不处理的，工会有权提出批评、检举和控告。",
      "order": 55
    },
    {
      "id": "law-809f00c0f4-0036",
      "articleNumber": 36,
      "displayNumber": "第三十六条",
      "path": [
        "第三章煤炭生产与煤矿安全"
      ],
      "text": "煤矿企业必须为职工提供保障安全生产所需的劳动保护用品。",
      "order": 56
    },
    {
      "id": "law-809f00c0f4-0037",
      "articleNumber": 37,
      "displayNumber": "第三十七条",
      "path": [
        "第三章煤炭生产与煤矿安全"
      ],
      "text": "煤矿企业应当依法为职工参加工伤保险缴纳工伤保险费。鼓励企业为井下作业职工办理意外伤害保险，支付保险费。",
      "order": 57
    },
    {
      "id": "law-809f00c0f4-0038",
      "articleNumber": 38,
      "displayNumber": "第三十八条",
      "path": [
        "第三章煤炭生产与煤矿安全"
      ],
      "text": "煤矿企业使用的设备、器材、火工产品和安全仪器，必须符合国家标准或者行业标准。",
      "order": 58
    },
    {
      "id": "law-809f00c0f4-0039",
      "articleNumber": 39,
      "displayNumber": "第三十九条",
      "path": [
        "第四章煤炭经营"
      ],
      "text": "煤炭经营企业从事煤炭经营，应当遵守有关法律、法规的规定，改善服务，保障供应。禁止一切非法经营活动。",
      "order": 60
    },
    {
      "id": "law-809f00c0f4-0040",
      "articleNumber": 40,
      "displayNumber": "第四十条",
      "path": [
        "第四章煤炭经营"
      ],
      "text": "煤炭经营应当减少中间环节和取消不合理的中间环节，提倡有条件的煤矿企业直销。\n煤炭用户和煤炭销区的煤炭经营企业有权直接从煤矿企业购进煤炭。在煤炭产区可以组成煤炭销售、运输服务机构，为中小煤矿办理经销、运输业务。\n禁止行政机关违反国家规定擅自设立煤炭供应的中间环节和额外加收费用。",
      "order": 61
    },
    {
      "id": "law-809f00c0f4-0041",
      "articleNumber": 41,
      "displayNumber": "第四十一条",
      "path": [
        "第四章煤炭经营"
      ],
      "text": "从事煤炭运输的车站、港口及其他运输企业不得利用其掌握的运力作为参与煤炭经营、谋取不正当利益的手段。",
      "order": 64
    },
    {
      "id": "law-809f00c0f4-0042",
      "articleNumber": 42,
      "displayNumber": "第四十二条",
      "path": [
        "第四章煤炭经营"
      ],
      "text": "国务院物价行政主管部门会同国务院煤炭管理部门和有关部门对煤炭的销售价格进行监督管理。",
      "order": 65
    },
    {
      "id": "law-809f00c0f4-0043",
      "articleNumber": 43,
      "displayNumber": "第四十三条",
      "path": [
        "第四章煤炭经营"
      ],
      "text": "煤矿企业和煤炭经营企业供应用户的煤炭质量应当符合国家标准或者行业标准，质级相符，质价相符。用户对煤炭质量有特殊要求的，由供需双方在煤炭购销合同中约定。\n煤矿企业和煤炭经营企业不得在煤炭中掺杂、掺假，以次充好。",
      "order": 66
    },
    {
      "id": "law-809f00c0f4-0044",
      "articleNumber": 44,
      "displayNumber": "第四十四条",
      "path": [
        "第四章煤炭经营"
      ],
      "text": "煤矿企业和煤炭经营企业供应用户的煤炭质量不符合国家标准或者行业标准，或者不符合合同约定，或者质级不符、质价不符，给用户造成损失的，应当依法给予赔偿。",
      "order": 68
    },
    {
      "id": "law-809f00c0f4-0045",
      "articleNumber": 45,
      "displayNumber": "第四十五条",
      "path": [
        "第四章煤炭经营"
      ],
      "text": "煤矿企业、煤炭经营企业、运输企业和煤炭用户应当依照法律、国务院有关规定或者合同约定供应、运输和接卸煤炭。\n运输企业应当将承运的不同质量的煤炭分装、分堆。",
      "order": 69
    },
    {
      "id": "law-809f00c0f4-0046",
      "articleNumber": 46,
      "displayNumber": "第四十六条",
      "path": [
        "第四章煤炭经营"
      ],
      "text": "煤炭的进出口依照国务院的规定，实行统一管理。\n具备条件的大型煤矿企业经国务院对外经济贸易主管部门依法许可，有权从事煤炭出口经营。",
      "order": 71
    },
    {
      "id": "law-809f00c0f4-0047",
      "articleNumber": 47,
      "displayNumber": "第四十七条",
      "path": [
        "第四章煤炭经营"
      ],
      "text": "煤炭经营管理办法，由国务院依照本法制定。",
      "order": 73
    },
    {
      "id": "law-809f00c0f4-0048",
      "articleNumber": 48,
      "displayNumber": "第四十八条",
      "path": [
        "第五章煤矿矿区保护"
      ],
      "text": "任何单位或者个人不得危害煤矿矿区的电力、通讯、水源、交通及其他生产设施。\n禁止任何单位和个人扰乱煤矿矿区的生产秩序和工作秩序。",
      "order": 75
    },
    {
      "id": "law-809f00c0f4-0049",
      "articleNumber": 49,
      "displayNumber": "第四十九条",
      "path": [
        "第五章煤矿矿区保护"
      ],
      "text": "对盗窃或者破坏煤矿矿区设施、器材及其他危及煤矿矿区安全的行为，一切单位和个人都有权检举、控告。",
      "order": 77
    },
    {
      "id": "law-809f00c0f4-0050",
      "articleNumber": 50,
      "displayNumber": "第五十条",
      "path": [
        "第五章煤矿矿区保护"
      ],
      "text": "未经煤矿企业同意，任何单位或者个人不得在煤矿企业依法取得土地使用权的有效期间内在该土地上种植、养殖、取土或者修建建筑物、构筑物。",
      "order": 78
    },
    {
      "id": "law-809f00c0f4-0051",
      "articleNumber": 51,
      "displayNumber": "第五十一条",
      "path": [
        "第五章煤矿矿区保护"
      ],
      "text": "未经煤矿企业同意，任何单位或者个人不得占用煤矿企业的铁路专用线、专用道路、专用航道、专用码头、电力专用线、专用供水管路。",
      "order": 79
    },
    {
      "id": "law-809f00c0f4-0052",
      "articleNumber": 52,
      "displayNumber": "第五十二条",
      "path": [
        "第五章煤矿矿区保护"
      ],
      "text": "任何单位或者个人需要在煤矿采区范围内进行可能危及煤矿安全的作业时，应当经煤矿企业同意，报煤炭管理部门批准，并采取安全措施后，方可进行作业。\n在煤矿矿区范围内需要建设公用工程或者其他工程的，有关单位应当事先与煤矿企业协商并达成协议后，方可施工。",
      "order": 80
    },
    {
      "id": "law-809f00c0f4-0053",
      "articleNumber": 53,
      "displayNumber": "第五十三条",
      "path": [
        "第六章监督检查"
      ],
      "text": "煤炭管理部门和有关部门依法对煤矿企业和煤炭经营企业执行煤炭法律、法规的情况进行监督检查。",
      "order": 83
    },
    {
      "id": "law-809f00c0f4-0054",
      "articleNumber": 54,
      "displayNumber": "第五十四条",
      "path": [
        "第六章监督检查"
      ],
      "text": "煤炭管理部门和有关部门的监督检查人员应当熟悉煤炭法律、法规，掌握有关煤炭专业技术，公正廉洁，秉公执法。",
      "order": 84
    },
    {
      "id": "law-809f00c0f4-0055",
      "articleNumber": 55,
      "displayNumber": "第五十五条",
      "path": [
        "第六章监督检查"
      ],
      "text": "煤炭管理部门和有关部门的监督检查人员进行监督检查时，有权向煤矿企业、煤炭经营企业或者用户了解有关执行煤炭法律、法规的情况，查阅有关资料，并有权进入现场进行检查。\n煤矿企业、煤炭经营企业和用户对依法执行监督检查任务的煤炭管理部门和有关部门的监督检查人员应当提供方便。",
      "order": 85
    },
    {
      "id": "law-809f00c0f4-0056",
      "articleNumber": 56,
      "displayNumber": "第五十六条",
      "path": [
        "第六章监督检查"
      ],
      "text": "煤炭管理部门和有关部门的监督检查人员对煤矿企业和煤炭经营企业违反煤炭法律、法规的行为，有权要求其依法改正。\n煤炭管理部门和有关部门的监督检查人员进行监督检查时，应当出示证件。",
      "order": 87
    },
    {
      "id": "law-809f00c0f4-0057",
      "articleNumber": 57,
      "displayNumber": "第五十七条",
      "path": [
        "第七章法律责任"
      ],
      "text": "违反本法第二十二条的规定，开采煤炭资源未达到国务院煤炭管理部门规定的煤炭资源回采率的，由煤炭管理部门责令限期改正；逾期仍达不到规定的回采率的，责令停止生产。",
      "order": 90
    },
    {
      "id": "law-809f00c0f4-0058",
      "articleNumber": 58,
      "displayNumber": "第五十八条",
      "path": [
        "第七章法律责任"
      ],
      "text": "违反本法第二十四条的规定，擅自开采保安煤柱或者采用危及相邻煤矿生产安全的危险方法进行采矿作业的，由劳动行政主管部门会同煤炭管理部门责令停止作业；由煤炭管理部门没收违法所得，并处违法所得一倍以上五倍以下的罚款；构成犯罪的，由司法机关依法追究刑事责任；造成损失的，依法承担赔偿责任。",
      "order": 91
    },
    {
      "id": "law-809f00c0f4-0059",
      "articleNumber": 59,
      "displayNumber": "第五十九条",
      "path": [
        "第七章法律责任"
      ],
      "text": "违反本法第四十三条的规定，在煤炭产品中掺杂、掺假，以次充好的，责令停止销售，没收违法所得，并处违法所得一倍以上五倍以下的罚款；构成犯罪的，由司法机关依法追究刑事责任。",
      "order": 92
    },
    {
      "id": "law-809f00c0f4-0060",
      "articleNumber": 60,
      "displayNumber": "第六十条",
      "path": [
        "第七章法律责任"
      ],
      "text": "违反本法第五十条的规定，未经煤矿企业同意，在煤矿企业依法取得土地使用权的有效期间内在该土地上修建建筑物、构筑物的，由当地人民政府动员拆除；拒不拆除的，责令拆除。",
      "order": 93
    },
    {
      "id": "law-809f00c0f4-0061",
      "articleNumber": 61,
      "displayNumber": "第六十一条",
      "path": [
        "第七章法律责任"
      ],
      "text": "违反本法第五十一条的规定，未经煤矿企业同意，占用煤矿企业的铁路专用线、专用道路、专用航道、专用码头、电力专用线、专用供水管路的，由县级以上地方人民政府责令限期改正；逾期不改正的，强制清除，可以并处五万元以下的罚款；造成损失的，依法承担赔偿责任。",
      "order": 94
    },
    {
      "id": "law-809f00c0f4-0062",
      "articleNumber": 62,
      "displayNumber": "第六十二条",
      "path": [
        "第七章法律责任"
      ],
      "text": "违反本法第五十二条的规定，未经批准或者未采取安全措施，在煤矿采区范围内进行危及煤矿安全作业的，由煤炭管理部门责令停止作业，可以并处五万元以下的罚款；造成损失的，依法承担赔偿责任。",
      "order": 95
    },
    {
      "id": "law-809f00c0f4-0063",
      "articleNumber": 63,
      "displayNumber": "第六十三条",
      "path": [
        "第七章法律责任"
      ],
      "text": "有下列行为之一的，由公安机关依照治安管理处罚法的有关规定处罚；构成犯罪的，由司法机关依法追究刑事责任：\n（一）阻碍煤矿建设，致使煤矿建设不能正常进行的；\n（二）故意损坏煤矿矿区的电力、通讯、水源、交通及其他生产设施的；\n（三）扰乱煤矿矿区秩序，致使生产、工作不能正常进行的；\n（四）拒绝、阻碍监督检查人员依法执行职务的。",
      "order": 96
    },
    {
      "id": "law-809f00c0f4-0064",
      "articleNumber": 64,
      "displayNumber": "第六十四条",
      "path": [
        "第七章法律责任"
      ],
      "text": "煤矿企业的管理人员违章指挥、强令职工冒险作业，发生重大伤亡事故的，依照刑法有关规定追究刑事责任。",
      "order": 101
    },
    {
      "id": "law-809f00c0f4-0065",
      "articleNumber": 65,
      "displayNumber": "第六十五条",
      "path": [
        "第七章法律责任"
      ],
      "text": "煤矿企业的管理人员对煤矿事故隐患不采取措施予以消除，发生重大伤亡事故的，依照刑法有关规定追究刑事责任。",
      "order": 102
    },
    {
      "id": "law-809f00c0f4-0066",
      "articleNumber": 66,
      "displayNumber": "第六十六条",
      "path": [
        "第七章法律责任"
      ],
      "text": "煤炭管理部门和有关部门的工作人员玩忽职守、徇私舞弊、滥用职权的，依法给予行政处分；构成犯罪的，由司法机关依法追究刑事责任。",
      "order": 103
    },
    {
      "id": "law-809f00c0f4-0067",
      "articleNumber": 67,
      "displayNumber": "第六十七条",
      "path": [
        "第八章附则"
      ],
      "text": "本法自1996年12月1日起施行。",
      "order": 105
    }
  ]
}
