  "articles": [
    {
      "id": "xzfg-b0572fb002-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了做好民兵工作，加强国防后备力量建设，根据《中华人民共和国兵役法》的有关规定，制定本条例。",
      "order": 2
    },
    {
      "id": "xzfg-b0572fb002-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "民兵是中国共产党领导的不脱离生产的群众武装组织，是中华人民共和国武装力量的组成部分，是中国人民解放军的助手和后备力量。",
      "order": 3
    },
    {
      "id": "xzfg-b0572fb002-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "民兵工作的任务是：\n(一)建立和巩固民兵组织，提高民兵军政素质，配备和管理民兵武器装备，储备战时所需的后备兵员；\n(二)发动民兵参加社会主义现代化建设，组织民兵担负战备执勤，维护社会治安；\n(三)组织民兵参军参战，支援前线，抵抗侵略，保卫祖国。",
      "order": 4
    },
    {
      "id": "xzfg-b0572fb002-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "民兵工作应当贯彻人民战争思想，坚持劳武结合，坚持民兵制度与预备役制度、民兵工作与战时兵员动员准备工作的结合。",
      "order": 8
    },
    {
      "id": "xzfg-b0572fb002-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "全国的民兵工作在国务院、中央军委领导下，由中国人民解放军总参谋部主管。\n军区按照上级赋予的任务，负责本区域的民兵工作。\n省军区(含卫戍区、警备区，下同)、军分区(含警备区，下同)、县(含市、市辖区，下同)人民武装部，是本地区的军事领导指挥机关，负责本区域的民兵工作。\n乡、民族乡、镇、街道和企业事业单位设立的人民武装部，负责办理本区域、本单位的民兵工作，按规定不设立人民武装部的街道、企业事业单位，确定一个部门办理。",
      "order": 9
    },
    {
      "id": "xzfg-b0572fb002-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第一章总则"
      ],
      "text": "乡、民族乡、镇、街道和企业事业单位的人民武装部体制的变动，按照国家有关规定办理。",
      "order": 13
    },
    {
      "id": "xzfg-b0572fb002-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第一章总则"
      ],
      "text": "地方各级人民政府必须加强对民兵工作的领导，统筹安排民兵工作，组织和监督完成民兵工作任务。地方各级人民政府的有关部门，应当协助军事机关开展民兵工作，解决有关问题。\n企业事业单位应当按照当地人民政府和本地区军事领导指挥机关的要求，把民兵工作纳入管理计划，完成民兵工作任务。",
      "order": 14
    },
    {
      "id": "xzfg-b0572fb002-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第一章总则"
      ],
      "text": "民兵应当做到：服从组织领导，听从上级指挥，掌握军事技术，爱护武器装备，学习政治文化，带头参加生产劳动，遵守法律、法规，保护群众利益。",
      "order": 16
    },
    {
      "id": "xzfg-b0572fb002-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第二章民兵组织"
      ],
      "text": "民兵的组建范围，按照《中华人民共和国兵役法》第三十七条的规定执行。",
      "order": 18
    },
    {
      "id": "xzfg-b0572fb002-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第二章民兵组织"
      ],
      "text": "公民应当依照《中华人民共和国兵役法》第三十七条、三十八条的规定参加民兵组织。",
      "order": 19
    },
    {
      "id": "xzfg-b0572fb002-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第二章民兵组织"
      ],
      "text": "民兵按照便于领导，便于活动，便于执行任务的原则编组。农村一般以行政村为单位编民兵连或者营，城市一般以企业事业单位、街道为单位编民兵排、连、营、团。\n基干民兵单独编组，根据民兵人数分别编班、排、连、营或者团。\n根据战备需要和现有武器装备，在基干民兵中组建民兵专业技术分队；在重点人防城市、交通枢纽和其他重要防卫目标地区，组建民兵高炮营、团。民兵专业技术分队可以跨单位编组。",
      "order": 20
    },
    {
      "id": "xzfg-b0572fb002-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第二章民兵组织"
      ],
      "text": "民兵干部由政治思想好、身体健康、年纪较轻、有一定文化知识和军事素质、热爱民兵工作的人员担任。\n民兵干部应当优先从转业、退伍军人中选拔。",
      "order": 23
    },
    {
      "id": "xzfg-b0572fb002-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第二章民兵组织"
      ],
      "text": "民兵干部由本单位提名，由基层人民武装部或者本地区军事领导指挥机关按照任免权限任命。\n企业事业单位的民兵连以上军政主官，由本单位负责人兼任。\n基干民兵连长或者营长，由专职人民武装干部或者本单位负责人兼任。",
      "order": 25
    },
    {
      "id": "xzfg-b0572fb002-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第二章民兵组织"
      ],
      "text": "民兵组织每年整顿一次。整顿的内容包括：对民兵进行宣传教育、民兵的出入转队、调配干部、工作总结、清点装备、健全制度、集结点验等项工作。\n退出现役的士兵，符合服预备役条件的，应当及时编入民兵组织。",
      "order": 28
    },
    {
      "id": "xzfg-b0572fb002-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第三章政治工作"
      ],
      "text": "民兵政治工作应当学习人民解放军的政治工作经验，继承和发扬民兵工作的优良传统，保证民兵工作方针、政策的贯彻执行和各项任务的完成。",
      "order": 31
    },
    {
      "id": "xzfg-b0572fb002-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第三章政治工作"
      ],
      "text": "民兵政治教育以中国共产党的基本路线和国防教育为重点，进行民兵性质任务、优良传统、爱国主义、革命英雄主义、形势战备和政策法制等教育。\n民兵政治教育主要结合组织整顿、军事训练、征兵和重大节日活动进行。",
      "order": 32
    },
    {
      "id": "xzfg-b0572fb002-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第三章政治工作"
      ],
      "text": "民兵政治教育，平时应当根据民兵军事训练、战备执勤的任务、要求和民兵思想实际做好民兵的思想政治工作，提高练兵习武的自觉性，发动民兵带头参加社会主义物质文明和精神文明建设。战时应当动员民兵参军参战，支援前线，组织民兵开展杀敌立功、瓦解敌军等活动，保证战斗、战勤任务的完成。",
      "order": 34
    },
    {
      "id": "xzfg-b0572fb002-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第三章政治工作"
      ],
      "text": "对专职人民武装干部的培养、选拔、调整和配备，应当按照有关规定进行。专职人民武装干部的任免，由本地区军事领导指挥机关按照任免权限办理。",
      "order": 35
    },
    {
      "id": "xzfg-b0572fb002-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第四章军事训练"
      ],
      "text": "民兵军事训练应当按照总参谋部颁发的《民兵军事训练大纲》进行，实施规范化训练。全国每年的训练任务，由总参谋部规定后，逐级下达。",
      "order": 37
    },
    {
      "id": "xzfg-b0572fb002-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第四章军事训练"
      ],
      "text": "民兵的军事训练由县人民武装部组织实施。专职人民武装干部的军事训练，由军分区组织实施。\n军兵种机关、部队和军事院校，应当协助省军区、军分区、县人民武装部开展民兵军事训练。",
      "order": 38
    },
    {
      "id": "xzfg-b0572fb002-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第四章军事训练"
      ],
      "text": "对参加军事训练的基干民兵，应当进行考核。考核合格的，由县人民武装部进行登记。民兵军事训练成绩评定标准，由总参谋部制定。",
      "order": 40
    },
    {
      "id": "xzfg-b0572fb002-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第四章军事训练"
      ],
      "text": "县应当逐步建立民兵军事训练基地，对民兵实行集中训练。\n民兵军事训练基地应当健全管理制度，完善基本设施，保障军事训练的需要。",
      "order": 41
    },
    {
      "id": "xzfg-b0572fb002-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第四章军事训练"
      ],
      "text": "民兵军事训练的教材、器材，分级负责解决。总参谋部负责组织编印教材和配发部分制式训练器材，其余所需的训练器材，由省军区、军分区、县人民武装部分别购置或者调整解决。\n民兵训练教材、器材应当严格管理，不得挪作它用。",
      "order": 43
    },
    {
      "id": "xzfg-b0572fb002-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第四章军事训练"
      ],
      "text": "农村的民兵和民兵干部在参加军事训练期间，由当地人民政府采取平衡负担的办法，按照当地同等劳力的收入水平给予误工补贴。\n企业事业单位的民兵和民兵干部在参加军事训练期间，由原单位照发工资和奖金，原有的福利待遇不变；其伙食补助和往返差旅费由原单位按照国家规定在有关项目中开支。\n企业事业单位自行组织的民兵活动，所需费用由本单位负责解决。",
      "order": 45
    },
    {
      "id": "xzfg-b0572fb002-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第五章武器装备"
      ],
      "text": "民兵武器装备的发展和配备，由总参谋部统一规划。军区、省军区、军分区和县人民武装部根据上级的规划，进行配备和补充。",
      "order": 49
    },
    {
      "id": "xzfg-b0572fb002-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第五章武器装备"
      ],
      "text": "民兵武器装备的配备应当根据基干民兵的组建计划和战备、执勤、军事训练的需要，做到保证重点，合理布局。",
      "order": 50
    },
    {
      "id": "xzfg-b0572fb002-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第五章武器装备"
      ],
      "text": "民兵配属部队执行作战、支前任务所需武器装备，由县人民武装部配发；到达部队后，由所在部队补充。",
      "order": 51
    },
    {
      "id": "xzfg-b0572fb002-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第五章武器装备"
      ],
      "text": "民兵武器装备的调动，按照管辖范围，分别由县人民武装部、军分区、省军区、军区批准，跨军区调动或者调出民兵系统的，由总参谋部批准。\n民兵武器装备，不得擅自借出。因执勤、训练需要借用配发给民兵或者民兵组织的武器装备时，必须报经县人民武装部批准。",
      "order": 52
    },
    {
      "id": "xzfg-b0572fb002-0029",
      "articleNumber": 29,
      "displayNumber": "第二十九条",
      "path": [
        "第五章武器装备"
      ],
      "text": "民兵武器装备的保管，按照总参谋部的规定办理。\n保管民兵武器装备的单位，必须有坚固的库(室)、健全的管理制度。武器库(室)必须有专人看管，有报警、消防等安全设施。",
      "order": 54
    },
    {
      "id": "xzfg-b0572fb002-0030",
      "articleNumber": 30,
      "displayNumber": "第三十条",
      "path": [
        "第五章武器装备"
      ],
      "text": "掌握武器的民兵和民兵武器库(室)的看管人员，应当按照有关规定由人民武装部门审查批准。",
      "order": 56
    },
    {
      "id": "xzfg-b0572fb002-0031",
      "articleNumber": 31,
      "displayNumber": "第三十一条",
      "path": [
        "第五章武器装备"
      ],
      "text": "民兵武器装备的修理，农村的，由县人民武装部负责；城市的，由配有武器装备的单位负责。上述单位不能修理的武器，由军分区、省军区、军区修械所(厂)修理。",
      "order": 57
    },
    {
      "id": "xzfg-b0572fb002-0032",
      "articleNumber": 32,
      "displayNumber": "第三十二条",
      "path": [
        "第六章战备执勤"
      ],
      "text": "民兵战备执勤，由县人民武装部根据上级赋予的任务，制定计划，具体组织实施。",
      "order": 59
    },
    {
      "id": "xzfg-b0572fb002-0033",
      "articleNumber": 33,
      "displayNumber": "第三十三条",
      "path": [
        "第六章战备执勤"
      ],
      "text": "陆海边防地区和其他战备重点地区的民兵组织，应当根据上级军事机关的要求，与驻地的人民解放军和人民武装警察部队实行联防。\n发现敌人袭扰、空降和潜入等紧急情况，民兵应当在当地军事机关组织指挥下迅速进行围歼或者搜捕。\n战时，民兵应当配合部队作战，担负各项战斗勤务，支援前线，保护群众，保卫生产。\n民兵应当配合公安机关维护社会治安。",
      "order": 60
    },
    {
      "id": "xzfg-b0572fb002-0034",
      "articleNumber": 34,
      "displayNumber": "第三十四条",
      "path": [
        "第六章战备执勤"
      ],
      "text": "组织民兵担负勤务，应当爱惜民力，严加控制。\n陆海边防民兵固定哨所的设立，由军分区根据战备需要提出方案，报省军区批准。\n使用民兵担负守护桥梁、隧道、仓库等重要目标勤务，由目标归属单位根据国家有关规定提出申请，报省军区批准。\n民兵担负治安勤务，由本地区军事领导指挥机关报同级人民政府批准，并报上级军事机关备案。在厂矿范围内，使用民兵担负维护治安、保护生产方面的勤务，由厂矿批准，报县人民武装部备案。",
      "order": 64
    },
    {
      "id": "xzfg-b0572fb002-0035",
      "articleNumber": 35,
      "displayNumber": "第三十五条",
      "path": [
        "第六章战备执勤"
      ],
      "text": "民兵担负勤务的报酬或者补助，由使用单位支付。\n民兵守护重要目标执勤点所需营房、营具、厨具和通信、照明、饮水、警戒等设施，以及执勤民兵的生活补贴、执勤用品、必要的文化用品、医疗、伤亡抚恤等经费，由目标归属单位解决。",
      "order": 68
    },
    {
      "id": "xzfg-b0572fb002-0036",
      "articleNumber": 36,
      "displayNumber": "第三十六条",
      "path": [
        "第六章战备执勤"
      ],
      "text": "对参战、执行战勤任务、参加军事训练和维护社会治安中伤亡民兵的优待、安置和抚恤，按照国家有关规定办理。",
      "order": 70
    },
    {
      "id": "xzfg-b0572fb002-0037",
      "articleNumber": 37,
      "displayNumber": "第三十七条",
      "path": [
        "第七章民兵事业费"
      ],
      "text": "民兵事业费是保障民兵建设的专项经费，是国家预算的组成部分，应当严格管理，专款专用。",
      "order": 72
    },
    {
      "id": "xzfg-b0572fb002-0038",
      "articleNumber": 38,
      "displayNumber": "第三十八条",
      "path": [
        "第七章民兵事业费"
      ],
      "text": "民兵事业费由省军区、军分区、县人民武装部按级负责管理。\n民兵事业费的年度指标，由省军区根据全年民兵工作任务，向省(含自治区、直辖市，下同)人民政府编造预算，经批准后组织实施。\n省军区后勤部与省财政厅(局)建立财务领报关系。省军区、军分区司令部负责拟制经费的分配和使用计划，后勤部负责财务的管理和监督。\n县人民武装部是民兵事业费的基层开支单位，直接掌管民兵事业费的使用。",
      "order": 73
    },
    {
      "id": "xzfg-b0572fb002-0039",
      "articleNumber": 39,
      "displayNumber": "第三十九条",
      "path": [
        "第七章民兵事业费"
      ],
      "text": "民兵事业费应当主要分配到县人民武装部使用。省军区、军分区两级留用的民兵事业费，除民兵装备管理维修费外，不得超过全省总指标的20%。",
      "order": 77
    },
    {
      "id": "xzfg-b0572fb002-0040",
      "articleNumber": 40,
      "displayNumber": "第四十条",
      "path": [
        "第七章民兵事业费"
      ],
      "text": "民兵事业费主要用于民兵的军事训练、武器装备管理维修、组织建设、政治工作等项开支。",
      "order": 78
    },
    {
      "id": "xzfg-b0572fb002-0041",
      "articleNumber": 41,
      "displayNumber": "第四十一条",
      "path": [
        "第七章民兵事业费"
      ],
      "text": "民兵事业费的使用和管理实施办法，由省人民政府、省军区制定。\n民兵事业费的预算、决算和使用管理，由财政部、总参谋部实施监督，并接受审计机关的审计。",
      "order": 79
    },
    {
      "id": "xzfg-b0572fb002-0042",
      "articleNumber": 42,
      "displayNumber": "第四十二条",
      "path": [
        "第八章奖励和惩处"
      ],
      "text": "民兵、民兵组织和人民武装干部在参战、支前中做出显著成绩的，参照《中国人民解放军纪律条令》规定的奖励项目和批准权限，由军队给予奖励；在完成民兵工作或者执行维护社会治安等其他任务中做出显著成绩的，由地方人民政府、本地区的军事领导指挥机关给予奖励。",
      "order": 82
    },
    {
      "id": "xzfg-b0572fb002-0043",
      "articleNumber": 43,
      "displayNumber": "第四十三条",
      "path": [
        "第八章奖励和惩处"
      ],
      "text": "依照本条例规定，公民应当参加民兵组织而拒绝参加的，民兵拒绝、逃避军事训练和执行任务经教育不改的，由人民武装部门提请民兵所在单位给予行政处分，或者提请地方人民政府有关部门给予行政处罚，并强制其履行兵役义务。\n民兵拒绝、逃避参军、参战、支前、维护社会治安等重大任务，或者在执行任务中因玩忽职守造成严重后果的，参照《中华人民共和国兵役法》的有关规定处罚；构成犯罪的，依法追究刑事责任。",
      "order": 83
    },
    {
      "id": "xzfg-b0572fb002-0044",
      "articleNumber": 44,
      "displayNumber": "第四十四条",
      "path": [
        "第八章奖励和惩处"
      ],
      "text": "对违反本条例规定，拒绝建立或者擅自取消民兵组织，拒绝完成民兵工作任务的单位，由本地区军事领导指挥机关报同级人民政府批准，对该单位给予批评或者行政处罚，对该单位负责人给予行政处分，并责令限期改正。",
      "order": 85
    },
    {
      "id": "xzfg-b0572fb002-0045",
      "articleNumber": 45,
      "displayNumber": "第四十五条",
      "path": [
        "第九章附则"
      ],
      "text": "本条例由中国人民解放军总参谋部负责解释。",
      "order": 87
    },
    {
      "id": "xzfg-b0572fb002-0046",
      "articleNumber": 46,
      "displayNumber": "第四十六条",
      "path": [
        "第九章附则"
      ],
      "text": "本条例自1991年1月1日起施行。1978年8月国防部颁布的《民兵工作条例》即行废止。",
      "order": 88
    }
  ]
}
