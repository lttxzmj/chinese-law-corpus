{
  "id": "xzfg-32579eef56",
  "officialId": "",
  "title": "禁止向企业摊派暂行条例",
  "category": "行政法规",
  "issuingAuthority": "国务院",
  "promulgationDate": "1988-04-27",
  "effectiveDate": "",
  "status": "effective",
  "source": {
    "metadataPath": "data/laws/xzfg-32579eef56/metadata.json",
