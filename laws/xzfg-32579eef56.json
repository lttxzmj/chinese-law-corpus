    }
  ],
  "articles": [
    {
      "id": "xzfg-32579eef56-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了禁止向企业摊派，保护企业的合法权益，制定本条例。",
      "order": 2
    },
    {
      "id": "xzfg-32579eef56-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "本条例所称摊派是指在法律、法规的规定之外，以任何方式要求企业提供财力、物力和人力的行为。",
      "order": 3
    },
    {
      "id": "xzfg-32579eef56-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "禁止任何国家机关、人民团体、部队、企业、事业单位和其他社会组织(以下统称单位)向企业摊派。",
      "order": 4
    },
    {
      "id": "xzfg-32579eef56-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第二章禁止各种形式的摊派"
      ],
      "text": "不得在法律、法规的规定之外向企业征收下列费用：\n(一)各地教育部门、学校自定的职工子女入学费；\n(二)建田费、垦复费；\n(三)进入城市落户的人头费；\n(四)煤气开发费；\n(五)集中供电费；\n(六)过路费；\n(七)过桥费(集资或用贷款建桥的除外)；\n(八)排水增容费；\n(九)各种名目的治安管理费；\n(十)各种名目的卫生费；\n(十一)绿化费；\n(十二)支农费；\n(十三)各种名目的会议费；\n(十四)其他名目的费用。\n城市市区新建项目，需要征收城市建设配套费的，应当按照有关法律、法规的规定办理。",
      "order": 6
    },
    {
      "id": "xzfg-32579eef56-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第二章禁止各种形式的摊派"
      ],
      "text": "法律、法规规定的征收费用项目，任何单位不得超出征收的范围，提高征收的标准，变更征收的办法。",
      "order": 22
    },
    {
      "id": "xzfg-32579eef56-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第二章禁止各种形式的摊派"
      ],
      "text": "不得强制企业赞助、资助、捐献财物。\n企业自愿赞助、资助、捐献的款项只能从企业的自有资金中支出，不得计入成本。",
      "order": 23
    },
    {
      "id": "xzfg-32579eef56-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第二章禁止各种形式的摊派"
      ],
      "text": "除法律、法规规定外，不得强制企业购买有价证券或以其他形式向企业集资。",
      "order": 25
    },
    {
      "id": "xzfg-32579eef56-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第二章禁止各种形式的摊派"
      ],
      "text": "除法律、法规规定的强制保险项目外，不得强制企业参加保险。",
      "order": 26
    },
    {
      "id": "xzfg-32579eef56-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第二章禁止各种形式的摊派"
      ],
      "text": "除法律、法规规定外，不得将公益性义务劳动改变为向企业摊派财物。",
      "order": 27
    },
    {
      "id": "xzfg-32579eef56-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第二章禁止各种形式的摊派"
      ],
      "text": "不得违反本条例规定向企业进行其他形式的摊派。",
      "order": 28
    },
    {
      "id": "xzfg-32579eef56-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第二章禁止各种形式的摊派"
      ],
      "text": "禁止对抵制摊派的企业进行打击报复。\n不得利用职权或业务上的便利给予抵制摊派的企业以歧视性待遇。",
      "order": 29
    },
    {
      "id": "xzfg-32579eef56-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第二章禁止各种形式的摊派"
      ],
      "text": "在发生自然灾害、意外事故等紧急情况时，各级地方人民政府作出决定要求企业提供财力、物力和人力的，不视为摊派，但事后须报上一级人民政府备案。",
      "order": 31
    },
    {
      "id": "xzfg-32579eef56-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第三章权利与责任"
      ],
      "text": "企业有权拒绝任何单位的摊派。\n企业对收取费用的项目性质不明确的，应当向收费单位上一级人民政府的财政部门报告，经审查符合法律、法规规定的，才能支付。",
      "order": 33
    },
    {
      "id": "xzfg-32579eef56-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第三章权利与责任"
      ],
      "text": "财政部门对企业依照第十三条第二款提出的报告，应当在接到报告后三十日内作出应否缴纳的答复。期满不答复的，视为不同意缴纳。\n企业对财政部门的答复有异议的，可以向上一级财政部门反映。",
      "order": 35
    },
    {
      "id": "xzfg-32579eef56-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第三章权利与责任"
      ],
      "text": "任何单位和个人都有权向审计机关或其他有关部门控告、检举、揭发摊派行为。",
      "order": 37
    },
    {
      "id": "xzfg-32579eef56-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第三章权利与责任"
      ],
      "text": "审计机关对于收到的控告、检举、揭发以及其他部门根据第十七条规定移送的摊派案件，可以会同有关部门进行调查。被调查的单位必须如实提供情况，不得刁难和阻挠。",
      "order": 38
    },
    {
      "id": "xzfg-32579eef56-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第三章权利与责任"
      ],
      "text": "计划、财政、物价、税务、银行等部门应当加强监督检查，发现摊派行为，应当及时制止；制止无效时应当移送审计机关立案处理。",
      "order": 39
    },
    {
      "id": "xzfg-32579eef56-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第四章奖励与惩罚"
      ],
      "text": "经审计机关确认为摊派行为的，审计机关应当通知摊派单位停止摊派行为，并限期退回摊派的财物；期满不退回的，审计机关可以书面通知摊派单位的开户银行从其有关存款中扣还。\n摊派财物已不存在而无法追回时，审计机关可以通知有关部门扣缴相当于所摊派财物价值的款额，或采取其他经济补偿措施。",
      "order": 41
    },
    {
      "id": "xzfg-32579eef56-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第四章奖励与惩罚"
      ],
      "text": "对摊派单位的负责人和直接责任人员，监察机关或有关主管部门可根据情节轻重给予相应的行政处分。",
      "order": 43
    },
    {
      "id": "xzfg-32579eef56-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第四章奖励与惩罚"
      ],
      "text": "违反本条例规定，对控告、检举、揭发和抵制摊派的单位和人员进行打击报复的，应当从重处罚；构成犯罪的，由司法机关依法追究刑事责任。",
      "order": 44
    },
    {
      "id": "xzfg-32579eef56-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第四章奖励与惩罚"
      ],
      "text": "私分摊派财物的，由监察机关追究其单位负责人的行政责任；构成犯罪的，由司法机关依法追究刑事责任。",
      "order": 45
    },
    {
      "id": "xzfg-32579eef56-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第四章奖励与惩罚"
      ],
      "text": "对检举、揭发、抵制摊派有功的人员，审计机关可给予表彰。",
      "order": 46
    },
    {
      "id": "xzfg-32579eef56-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第四章奖励与惩罚"
      ],
      "text": "追回的摊派财物，属于企业已报告或控告的，应当退还企业；未报告和控告的，一律上缴中央财政。",
      "order": 47
    },
    {
      "id": "xzfg-32579eef56-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第四章奖励与惩罚"
      ],
      "text": "摊派单位对审计机关作出的经济处罚决定不服的，可以在接到决定书之日起十五日内向上一级审计机关申请复审。在复审期间，不影响原处罚决定的执行。",
      "order": 48
    },
    {
      "id": "xzfg-32579eef56-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第五章附则"
      ],
      "text": "本条例所称企业，是指依法在工商行政管理机关登记注册的企业。",
      "order": 50
    },
    {
      "id": "xzfg-32579eef56-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第五章附则"
      ],
      "text": "向国家机关、人民团体、部队、事业单位和其他社会组织(含基本建设单位)以及个人的摊派，比照本条例处理。",
      "order": 51
    },
    {
      "id": "xzfg-32579eef56-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第五章附则"
      ],
      "text": "本条例自1988年5月20日起施行。",
      "order": 52
    }
  ]
}
