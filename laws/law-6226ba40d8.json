  "articles": [
    {
      "id": "law-6226ba40d8-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了加强海关队伍建设，增强海关工作人员的责任感、荣誉感和组织纪律性，有利于海关工作人员依法履行职责，根据宪法，制定本条例。",
      "order": 2
    },
    {
      "id": "law-6226ba40d8-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "海关实行关衔制度。海关总署、分署、特派员办公室、各直属海关、隶属海关和办事处的国家公务员可以授予海关关衔。\n海关缉私警察实行人民警察警衔制度。",
      "order": 3
    },
    {
      "id": "law-6226ba40d8-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "关衔是区分海关工作人员等级、表明海关工作人员身份的称号、标志和国家给予海关工作人员的荣誉。",
      "order": 5
    },
    {
      "id": "law-6226ba40d8-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "海关工作人员实行职务等级编制关衔。",
      "order": 6
    },
    {
      "id": "law-6226ba40d8-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "关衔高的海关工作人员对关衔低的海关工作人员，关衔高的为上级。当关衔高的海关工作人员在职务上隶属于关衔低的海关工作人员时，职务高的为上级。",
      "order": 7
    },
    {
      "id": "law-6226ba40d8-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第一章总则"
      ],
      "text": "海关总署主管关衔工作。",
      "order": 8
    },
    {
      "id": "law-6226ba40d8-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第二章关衔等级的设置"
      ],
      "text": "海关关衔设下列五等十三级：\n（一）海关总监、海关副总监；\n（二）关务监督：一级、二级、三级；\n（三）关务督察：一级、二级、三级；\n（四）关务督办：一级、二级、三级；\n（五）关务员：一级、二级。",
      "order": 10
    },
    {
      "id": "law-6226ba40d8-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第二章关衔等级的设置"
      ],
      "text": "海关工作人员实行下列职务等级编制关衔：\n（一）署级正职：海关总监；\n（二）署级副职：海关副总监；\n（三）局级正职：一级关务监督至二级关务监督；\n（四）局级副职：二级关务监督至三级关务监督；\n（五）处级正职：三级关务监督至二级关务督察；\n（六）处级副职：一级关务督察至三级关务督察；\n（七）科级正职：二级关务督察至二级关务督办；\n（八）科级副职：三级关务督察至三级关务督办；\n（九）科员职：一级关务督办至一级关务员；\n（十）办事员职：二级关务督办至二级关务员。",
      "order": 16
    },
    {
      "id": "law-6226ba40d8-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第三章关衔的授予"
      ],
      "text": "关衔的授予以海关工作人员现任职务、德才表现、任职时间和工作年限为依据。",
      "order": 28
    },
    {
      "id": "law-6226ba40d8-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第三章关衔的授予"
      ],
      "text": "海关招考录用海关工作人员或者从其他部门调任海关工作人员，在确定职务后授予相应的关衔。",
      "order": 29
    },
    {
      "id": "law-6226ba40d8-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第三章关衔的授予"
      ],
      "text": "关衔按照下列规定权限批准授予：\n（一）海关总监、海关副总监、一级关务监督、二级关务监督由国务院总理批准授予；\n（二）三级关务监督至三级关务督察，由海关总署署长批准授予；\n（三）海关总署机关及海关总署派出机构的一级关务督办以下的关衔由海关总署政治部主任批准授予；\n（四）各直属海关、隶属海关的一级关务督办以下的关衔由各直属海关关长批准授予。",
      "order": 30
    },
    {
      "id": "law-6226ba40d8-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第四章关衔的晋级"
      ],
      "text": "二级关务督察以下关衔的海关工作人员，在其职务等级编制关衔幅度内，按照下列期限晋级：\n二级关务员至一级关务督办，每三年晋升一级；\n一级关务督办至一级关务督察，每四年晋升一级。",
      "order": 36
    },
    {
      "id": "law-6226ba40d8-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第四章关衔的晋级"
      ],
      "text": "二级关务督察以下关衔的海关工作人员，晋级期限届满，经考核具备晋级条件的，应当逐级晋升；不具备晋级条件的，应当延期晋升。在工作中有突出功绩的，经批准可以提前晋升。",
      "order": 39
    },
    {
      "id": "law-6226ba40d8-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第四章关衔的晋级"
      ],
      "text": "一级关务督察以上关衔的海关工作人员晋级，在职务等级编制关衔幅度内，根据其德才表现和工作实绩实行选升。",
      "order": 40
    },
    {
      "id": "law-6226ba40d8-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第四章关衔的晋级"
      ],
      "text": "海关工作人员提升职务，其关衔低于新任职务等级编制关衔的最低关衔的，应当晋升至新任职务等级编制关衔的最低关衔。",
      "order": 41
    },
    {
      "id": "law-6226ba40d8-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第四章关衔的晋级"
      ],
      "text": "关务员晋升关务督办，关务督办晋升关务督察，关务督察晋升关务监督，经培训合格后，方可晋升。",
      "order": 42
    },
    {
      "id": "law-6226ba40d8-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第四章关衔的晋级"
      ],
      "text": "关衔晋级的批准权限适用本条例第十一条的规定。",
      "order": 43
    },
    {
      "id": "law-6226ba40d8-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第五章关衔的保留、降级、取消"
      ],
      "text": "海关工作人员退休后，其关衔予以保留，但不得佩带标志。\n海关工作人员调离、辞职或者被辞退的，其关衔不予保留。",
      "order": 45
    },
    {
      "id": "law-6226ba40d8-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第五章关衔的保留、降级、取消"
      ],
      "text": "海关工作人员因不胜任现任职务被调任下级职务的，其关衔高于新任职务等级编制关衔的最高关衔的，应当降级至新任职务等级编制关衔的最高关衔。关衔降级的批准权限与原关衔的批准权限相同。",
      "order": 47
    },
    {
      "id": "law-6226ba40d8-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第五章关衔的保留、降级、取消"
      ],
      "text": "海关工作人员受到降级、撤职行政处分的，应当相应降低关衔。关衔降级的批准权限与原关衔的批准权限相同。关衔降级后，其关衔晋级的期限按照降级后的关衔等级重新计算。\n关衔降级不适用于二级关务员。",
      "order": 48
    },
    {
      "id": "law-6226ba40d8-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第五章关衔的保留、降级、取消"
      ],
      "text": "海关工作人员受到开除行政处分的，因犯罪被依法判处剥夺政治权利或者有期徒刑以上刑罚的，其关衔相应取消，并且不再履行批准手续。\n退休的海关工作人员犯罪的，适用前款规定。",
      "order": 50
    },
    {
      "id": "law-6226ba40d8-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第六章附则"
      ],
      "text": "海关关衔标志式样和佩带办法，由国务院规定。",
      "order": 53
    },
    {
      "id": "law-6226ba40d8-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第六章附则"
      ],
      "text": "本条例自公布之日起施行。",
      "order": 54
    }
  ]
}
