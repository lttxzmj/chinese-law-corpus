  ],
  "articles": [
    {
      "id": "xzfg-204d5f1411-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了有助于国家货币政策的正确制定，根据中国人民银行法的规定，制定本条例。",
      "order": 2
    },
    {
      "id": "xzfg-204d5f1411-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "货币政策委员会工作坚持中国共产党的领导，推动健全现代货币政策框架，重要事项报党中央、国务院。",
      "order": 3
    },
    {
      "id": "xzfg-204d5f1411-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "货币政策委员会是中国人民银行制定货币政策的咨询议事机构。\n货币政策委员会依照本条例组成。",
      "order": 4
    },
    {
      "id": "xzfg-204d5f1411-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "货币政策委员会的职责是，在综合分析宏观经济形势的基础上，依据国家的宏观经济调控目标，讨论下列货币政策事项，并提出建议：\n（一）货币政策的制定、调整；\n（二）一定时期内的货币政策控制目标；\n（三）货币政策工具的运用；\n（四）有关货币政策的重要措施；\n（五）货币政策与其他宏观经济政策的协调。",
      "order": 6
    },
    {
      "id": "xzfg-204d5f1411-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "货币政策委员会通过全体会议履行职责。",
      "order": 12
    },
    {
      "id": "xzfg-204d5f1411-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第二章组织机构"
      ],
      "text": "货币政策委员会由下列单位和人员组成：\n中国人民银行行长；\n国务院副秘书长1人；\n国家发展和改革委员会副主任1人；\n财政部副部长1人；\n中国人民银行副行长2人；\n国家金融监督管理总局局长；\n中国证券监督管理委员会主席；\n国家统计局局长；\n国家外汇管理局局长；\n中国银行业协会会长；\n专家委员3人。\n货币政策委员会组成单位和人员的调整，由国务院决定。",
      "order": 14
    },
    {
      "id": "xzfg-204d5f1411-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第二章组织机构"
      ],
      "text": "货币政策委员会委员包括当然委员和提名委员。中国人民银行行长、国家金融监督管理总局局长、中国证券监督管理委员会主席、国家外汇管理局局长为货币政策委员会的当然委员。货币政策委员会其他委员为提名委员，其人选由中国人民银行提名或者中国人民银行商有关部门提名，报请国务院任命。",
      "order": 27
    },
    {
      "id": "xzfg-204d5f1411-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第二章组织机构"
      ],
      "text": "货币政策委员会设主席一人，副主席一人。主席由中国人民银行行长担任；副主席由主席指定。",
      "order": 28
    },
    {
      "id": "xzfg-204d5f1411-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第二章组织机构"
      ],
      "text": "货币政策委员会委员应当具备下列条件：\n（一）年龄一般在65周岁以下，具有中华人民共和国国籍；\n（二）公正廉洁，忠于职守，无违法、违纪记录；\n（三）具有宏观经济、金融等方面的专业知识和实践经验，熟悉有关法律、法规和政策。",
      "order": 29
    },
    {
      "id": "xzfg-204d5f1411-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第二章组织机构"
      ],
      "text": "货币政策委员会中的专家委员除应当符合本条例第九条规定的条件外，还应当具备下列条件：\n（一）具有高级专业技术职称，从事经济金融工作10年以上，具有较高的学术水平；\n（二）非国家公务员，并且不在任何营利性机构任职。",
      "order": 33
    },
    {
      "id": "xzfg-204d5f1411-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第二章组织机构"
      ],
      "text": "货币政策委员会委员中的中国银行业协会会长任期一般不超过5年；专家委员一届任期不超过3年，最长任期一般不超过两届。",
      "order": 36
    },
    {
      "id": "xzfg-204d5f1411-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第二章组织机构"
      ],
      "text": "货币政策委员会委员有下列情形之一的，由中国人民银行报请国务院免去其货币政策委员会委员职务：\n（一）本人提出书面辞职申请的；\n（二）任职期间因职务变动，已经不能代表有关单位担任货币政策委员会委员的；\n（三）依照本条例第十一条规定任期已满的；\n（四）不履行委员义务或者因各种原因不能胜任委员工作的。",
      "order": 37
    },
    {
      "id": "xzfg-204d5f1411-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第二章组织机构"
      ],
      "text": "货币政策委员会设立秘书处，作为货币政策委员会的常设办事机构。",
      "order": 42
    },
    {
      "id": "xzfg-204d5f1411-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第三章委员的权利与义务"
      ],
      "text": "货币政策委员会委员具有同等的权利与义务。",
      "order": 44
    },
    {
      "id": "xzfg-204d5f1411-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第三章委员的权利与义务"
      ],
      "text": "货币政策委员会委员为履行职责需要，享有下列权利：\n（一）了解经济、金融和货币政策方面的情况；\n（二）对货币政策委员会所讨论的问题发表意见；\n（三）向货币政策委员会就货币政策问题提出议案，并享有表决权。",
      "order": 45
    },
    {
      "id": "xzfg-204d5f1411-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第三章委员的权利与义务"
      ],
      "text": "货币政策委员会委员应当出席货币政策委员会会议，并就有关货币政策事项提出意见和建议。",
      "order": 49
    },
    {
      "id": "xzfg-204d5f1411-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第三章委员的权利与义务"
      ],
      "text": "货币政策委员会委员应当恪尽职守，不得滥用职权、徇私舞弊。",
      "order": 50
    },
    {
      "id": "xzfg-204d5f1411-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第三章委员的权利与义务"
      ],
      "text": "货币政策委员会委员应当保守国家秘密、商业秘密，遵守货币政策委员会的工作制度，不得违反规定透露货币政策及有关情况。\n货币政策委员会委员违反规定泄露国家秘密、商业秘密的，撤销货币政策委员会委员的职务，并依法追究法律责任。",
      "order": 51
    },
    {
      "id": "xzfg-204d5f1411-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第三章委员的权利与义务"
      ],
      "text": "货币政策委员会委员在任职期内和离职以后一年内，不得公开反对已按法定程序制定的货币政策。",
      "order": 53
    },
    {
      "id": "xzfg-204d5f1411-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第四章工作程序"
      ],
      "text": "货币政策委员会实行例会制度，每季度召开1次。\n货币政策委员会主席或者1/3以上委员联名，可以提议召开临时会议。\n中国人民银行在货币政策委员会例会召开后，采取多种方式加强预期引导和市场沟通。",
      "order": 55
    },
    {
      "id": "xzfg-204d5f1411-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第四章工作程序"
      ],
      "text": "货币政策委员会秘书处应当在货币政策委员会例会召开前，将会议议题及有关资料送达全部委员。",
      "order": 58
    },
    {
      "id": "xzfg-204d5f1411-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第四章工作程序"
      ],
      "text": "货币政策委员会会议有2/3以上委员出席，方可举行。",
      "order": 59
    },
    {
      "id": "xzfg-204d5f1411-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第四章工作程序"
      ],
      "text": "货币政策委员会会议应当以会议纪要的形式记录各种意见。\n货币政策委员会委员提出的货币政策议案，经出席会议的2/3以上委员表决通过，形成货币政策委员会建议书。",
      "order": 60
    },
    {
      "id": "xzfg-204d5f1411-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第四章工作程序"
      ],
      "text": "中国人民银行报请国务院批准有关利率、汇率或者其他货币政策重要事项的决定方案时，可以将货币政策委员会建议书或者会议纪要作为附件一并报送。",
      "order": 62
    },
    {
      "id": "xzfg-204d5f1411-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第四章工作程序"
      ],
      "text": "货币政策委员会的内部工作制度，由货币政策委员会制定。",
      "order": 63
    },
    {
      "id": "xzfg-204d5f1411-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第五章附则"
      ],
      "text": "本条例自发布之日起施行。",
      "order": 65
    }
  ]
}
