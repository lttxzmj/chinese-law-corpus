  "articles": [
    {
      "id": "xzfg-21fa00a1c4-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了规范事业单位的人事管理，保障事业单位工作人员的合法权益，建设高素质的事业单位工作人员队伍，促进公共服务发展，制定本条例。",
      "order": 2
    },
    {
      "id": "xzfg-21fa00a1c4-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "事业单位人事管理，坚持党管干部、党管人才原则，全面准确贯彻民主、公开、竞争、择优方针。\n国家对事业单位工作人员实行分级分类管理。",
      "order": 3
    },
    {
      "id": "xzfg-21fa00a1c4-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "中央事业单位人事综合管理部门负责全国事业单位人事综合管理工作。\n县级以上地方各级事业单位人事综合管理部门负责本辖区事业单位人事综合管理工作。\n事业单位主管部门具体负责所属事业单位人事管理工作。",
      "order": 5
    },
    {
      "id": "xzfg-21fa00a1c4-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "事业单位应当建立健全人事管理制度。\n事业单位制定或者修改人事管理制度，应当通过职工代表大会或者其他形式听取工作人员意见。",
      "order": 8
    },
    {
      "id": "xzfg-21fa00a1c4-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第二章岗位设置"
      ],
      "text": "国家建立事业单位岗位管理制度，明确岗位类别和等级。",
      "order": 11
    },
    {
      "id": "xzfg-21fa00a1c4-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第二章岗位设置"
      ],
      "text": "事业单位根据职责任务和工作需要，按照国家有关规定设置岗位。\n岗位应当具有明确的名称、职责任务、工作标准和任职条件。",
      "order": 12
    },
    {
      "id": "xzfg-21fa00a1c4-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第二章岗位设置"
      ],
      "text": "事业单位拟订岗位设置方案，应当报人事综合管理部门备案。",
      "order": 14
    },
    {
      "id": "xzfg-21fa00a1c4-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第三章公开招聘和竞聘上岗"
      ],
      "text": "事业单位新聘用工作人员，应当面向社会公开招聘。但是，国家政策性安置、按照人事管理权限由上级任命、涉密岗位等人员除外。",
      "order": 16
    },
    {
      "id": "xzfg-21fa00a1c4-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第三章公开招聘和竞聘上岗"
      ],
      "text": "事业单位公开招聘工作人员按照下列程序进行：\n(一)制定公开招聘方案；\n(二)公布招聘岗位、资格条件等招聘信息；\n(三)审查应聘人员资格条件；\n(四)考试、考察；\n(五)体检；\n(六)公示拟聘人员名单；\n(七)订立聘用合同，办理聘用手续。",
      "order": 17
    },
    {
      "id": "xzfg-21fa00a1c4-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第三章公开招聘和竞聘上岗"
      ],
      "text": "事业单位内部产生岗位人选，需要竞聘上岗的，按照下列程序进行：\n(一)制定竞聘上岗方案；\n(二)在本单位公布竞聘岗位、资格条件、聘期等信息；\n(三)审查竞聘人员资格条件；\n(四)考评；\n(五)在本单位公示拟聘人员名单；\n(六)办理聘任手续。",
      "order": 25
    },
    {
      "id": "xzfg-21fa00a1c4-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第三章公开招聘和竞聘上岗"
      ],
      "text": "事业单位工作人员可以按照国家有关规定进行交流。",
      "order": 32
    },
    {
      "id": "xzfg-21fa00a1c4-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第四章聘用合同"
      ],
      "text": "事业单位与工作人员订立的聘用合同，期限一般不低于3年。",
      "order": 34
    },
    {
      "id": "xzfg-21fa00a1c4-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第四章聘用合同"
      ],
      "text": "初次就业的工作人员与事业单位订立的聘用合同期限3年以上的，试用期为12个月。",
      "order": 35
    },
    {
      "id": "xzfg-21fa00a1c4-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第四章聘用合同"
      ],
      "text": "事业单位工作人员在本单位连续工作满10年且距法定退休年龄不足10年，提出订立聘用至退休的合同的，事业单位应当与其订立聘用至退休的合同。",
      "order": 36
    },
    {
      "id": "xzfg-21fa00a1c4-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第四章聘用合同"
      ],
      "text": "事业单位工作人员连续旷工超过15个工作日，或者1年内累计旷工超过30个工作日的，事业单位可以解除聘用合同。",
      "order": 37
    },
    {
      "id": "xzfg-21fa00a1c4-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第四章聘用合同"
      ],
      "text": "事业单位工作人员年度考核不合格且不同意调整工作岗位，或者连续两年年度考核不合格的，事业单位提前30日书面通知，可以解除聘用合同。",
      "order": 38
    },
    {
      "id": "xzfg-21fa00a1c4-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第四章聘用合同"
      ],
      "text": "事业单位工作人员提前30日书面通知事业单位，可以解除聘用合同。但是，双方对解除聘用合同另有约定的除外。",
      "order": 39
    },
    {
      "id": "xzfg-21fa00a1c4-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第四章聘用合同"
      ],
      "text": "事业单位工作人员受到开除处分的，解除聘用合同。",
      "order": 40
    },
    {
      "id": "xzfg-21fa00a1c4-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第四章聘用合同"
      ],
      "text": "自聘用合同依法解除、终止之日起，事业单位与被解除、终止聘用合同人员的人事关系终止。",
      "order": 41
    },
    {
      "id": "xzfg-21fa00a1c4-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第五章考核和培训"
      ],
      "text": "事业单位应当根据聘用合同规定的岗位职责任务，全面考核工作人员的表现，重点考核工作绩效。考核应当听取服务对象的意见和评价。",
      "order": 43
    },
    {
      "id": "xzfg-21fa00a1c4-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第五章考核和培训"
      ],
      "text": "考核分为平时考核、年度考核和聘期考核。\n年度考核的结果可以分为优秀、合格、基本合格和不合格等档次，聘期考核的结果可以分为合格和不合格等档次。",
      "order": 44
    },
    {
      "id": "xzfg-21fa00a1c4-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第五章考核和培训"
      ],
      "text": "考核结果作为调整事业单位工作人员岗位、工资以及续订聘用合同的依据。",
      "order": 46
    },
    {
      "id": "xzfg-21fa00a1c4-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第五章考核和培训"
      ],
      "text": "事业单位应当根据不同岗位的要求，编制工作人员培训计划，对工作人员进行分级分类培训。\n工作人员应当按照所在单位的要求，参加岗前培训、在岗培训、转岗培训和为完成特定任务的专项培训。",
      "order": 47
    },
    {
      "id": "xzfg-21fa00a1c4-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第五章考核和培训"
      ],
      "text": "培训经费按照国家有关规定列支。",
      "order": 49
    },
    {
      "id": "xzfg-21fa00a1c4-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第六章奖励和处分"
      ],
      "text": "事业单位工作人员或者集体有下列情形之一的，给予奖励：\n(一)长期服务基层，爱岗敬业，表现突出的；\n(二)在执行国家重要任务、应对重大突发事件中表现突出的；\n(三)在工作中有重大发明创造、技术革新的；\n(四)在培养人才、传播先进文化中作出突出贡献的；\n(五)有其他突出贡献的。",
      "order": 51
    },
    {
      "id": "xzfg-21fa00a1c4-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第六章奖励和处分"
      ],
      "text": "奖励坚持精神奖励与物质奖励相结合、以精神奖励为主的原则。",
      "order": 57
    },
    {
      "id": "xzfg-21fa00a1c4-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第六章奖励和处分"
      ],
      "text": "奖励分为嘉奖、记功、记大功、授予荣誉称号。",
      "order": 58
    },
    {
      "id": "xzfg-21fa00a1c4-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第六章奖励和处分"
      ],
      "text": "事业单位工作人员有下列行为之一的，给予处分：\n(一)损害国家声誉和利益的；\n(二)失职渎职的；\n(三)利用工作之便谋取不正当利益的；\n(四)挥霍、浪费国家资财的；\n(五)严重违反职业道德、社会公德的；\n(六)其他严重违反纪律的。",
      "order": 59
    },
    {
      "id": "xzfg-21fa00a1c4-0029",
      "articleNumber": 29,
      "displayNumber": "第二十九条",
      "path": [
        "第六章奖励和处分"
      ],
      "text": "处分分为警告、记过、降低岗位等级或者撤职、开除。\n受处分的期间为：警告，6个月；记过，12个月；降低岗位等级或者撤职，24个月。",
      "order": 66
    },
    {
      "id": "xzfg-21fa00a1c4-0030",
      "articleNumber": 30,
      "displayNumber": "第三十条",
      "path": [
        "第六章奖励和处分"
      ],
      "text": "给予工作人员处分，应当事实清楚、证据确凿、定性准确、处理恰当、程序合法、手续完备。",
      "order": 68
    },
    {
      "id": "xzfg-21fa00a1c4-0031",
      "articleNumber": 31,
      "displayNumber": "第三十一条",
      "path": [
        "第六章奖励和处分"
      ],
      "text": "工作人员受开除以外的处分，在受处分期间没有再发生违纪行为的，处分期满后，由处分决定单位解除处分并以书面形式通知本人。",
      "order": 69
    },
    {
      "id": "xzfg-21fa00a1c4-0032",
      "articleNumber": 32,
      "displayNumber": "第三十二条",
      "path": [
        "第七章工资福利和社会保险"
      ],
      "text": "国家建立激励与约束相结合的事业单位工资制度。\n事业单位工作人员工资包括基本工资、绩效工资和津贴补贴。\n事业单位工资分配应当结合不同行业事业单位特点，体现岗位职责、工作业绩、实际贡献等因素。",
      "order": 71
    },
    {
      "id": "xzfg-21fa00a1c4-0033",
      "articleNumber": 33,
      "displayNumber": "第三十三条",
      "path": [
        "第七章工资福利和社会保险"
      ],
      "text": "国家建立事业单位工作人员工资的正常增长机制。\n事业单位工作人员的工资水平应当与国民经济发展相协调、与社会进步相适应。",
      "order": 74
    },
    {
      "id": "xzfg-21fa00a1c4-0034",
      "articleNumber": 34,
      "displayNumber": "第三十四条",
      "path": [
        "第七章工资福利和社会保险"
      ],
      "text": "事业单位工作人员享受国家规定的福利待遇。\n事业单位执行国家规定的工时制度和休假制度。",
      "order": 76
    },
    {
      "id": "xzfg-21fa00a1c4-0035",
      "articleNumber": 35,
      "displayNumber": "第三十五条",
      "path": [
        "第七章工资福利和社会保险"
      ],
      "text": "事业单位及其工作人员依法参加社会保险，工作人员依法享受社会保险待遇。",
      "order": 78
    },
    {
      "id": "xzfg-21fa00a1c4-0036",
      "articleNumber": 36,
      "displayNumber": "第三十六条",
      "path": [
        "第七章工资福利和社会保险"
      ],
      "text": "事业单位工作人员符合国家规定退休条件的，应当退休。",
      "order": 79
    },
    {
      "id": "xzfg-21fa00a1c4-0037",
      "articleNumber": 37,
      "displayNumber": "第三十七条",
      "path": [
        "第八章人事争议处理"
      ],
      "text": "事业单位工作人员与所在单位发生人事争议的，依照《中华人民共和国劳动争议调解仲裁法》等有关规定处理。",
      "order": 81
    },
    {
      "id": "xzfg-21fa00a1c4-0038",
      "articleNumber": 38,
      "displayNumber": "第三十八条",
      "path": [
        "第八章人事争议处理"
      ],
      "text": "事业单位工作人员对涉及本人的考核结果、处分决定等不服的，可以按照国家有关规定申请复核、提出申诉。",
      "order": 82
    },
    {
      "id": "xzfg-21fa00a1c4-0039",
      "articleNumber": 39,
      "displayNumber": "第三十九条",
      "path": [
        "第八章人事争议处理"
      ],
      "text": "负有事业单位聘用、考核、奖励、处分、人事争议处理等职责的人员履行职责，有下列情形之一的，应当回避：\n(一)与本人有利害关系的；\n(二)与本人近亲属有利害关系的；\n(三)其他可能影响公正履行职责的。",
      "order": 83
    },
    {
      "id": "xzfg-21fa00a1c4-0040",
      "articleNumber": 40,
      "displayNumber": "第四十条",
      "path": [
        "第八章人事争议处理"
      ],
      "text": "对事业单位人事管理工作中的违法违纪行为，任何单位或者个人可以向事业单位人事综合管理部门、主管部门或者监察机关投诉、举报，有关部门和机关应当及时调查处理。",
      "order": 87
    },
    {
      "id": "xzfg-21fa00a1c4-0041",
      "articleNumber": 41,
      "displayNumber": "第四十一条",
      "path": [
        "第九章法律责任"
      ],
      "text": "事业单位违反本条例规定的，由县级以上事业单位人事综合管理部门或者主管部门责令限期改正；逾期不改正的，对直接负责的主管人员和其他直接责任人员依法给予处分。",
      "order": 89
    },
    {
      "id": "xzfg-21fa00a1c4-0042",
      "articleNumber": 42,
      "displayNumber": "第四十二条",
      "path": [
        "第九章法律责任"
      ],
      "text": "对事业单位工作人员的人事处理违反本条例规定给当事人造成名誉损害的，应当赔礼道歉、恢复名誉、消除影响；造成经济损失的，依法给予赔偿。",
      "order": 90
    },
    {
      "id": "xzfg-21fa00a1c4-0043",
      "articleNumber": 43,
      "displayNumber": "第四十三条",
      "path": [
        "第九章法律责任"
      ],
      "text": "事业单位人事综合管理部门和主管部门的工作人员在事业单位人事管理工作中滥用职权、玩忽职守、徇私舞弊的，依法给予处分；构成犯罪的，依法追究刑事责任。",
      "order": 91
    },
    {
      "id": "xzfg-21fa00a1c4-0044",
      "articleNumber": 44,
      "displayNumber": "第四十四条",
      "path": [
        "第十章附则"
      ],
      "text": "本条例自2014年7月1日起施行。",
      "order": 93
    }
  ]
}
