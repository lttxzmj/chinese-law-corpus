  "articles": [
    {
      "id": "law-f92347d895-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章一般规定"
      ],
      "text": "为了明确涉外民事关系的法律适用，合理解决涉外民事争议，维护当事人的合法权益，制定本法。",
      "order": 2
    },
    {
      "id": "law-f92347d895-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章一般规定"
      ],
      "text": "涉外民事关系适用的法律，依照本法确定。其他法律对涉外民事关系法律适用另有特别规定的，依照其规定。\n本法和其他法律对涉外民事关系法律适用没有规定的，适用与该涉外民事关系有最密切联系的法律。",
      "order": 3
    },
    {
      "id": "law-f92347d895-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章一般规定"
      ],
      "text": "当事人依照法律规定可以明示选择涉外民事关系适用的法律。",
      "order": 5
    },
    {
      "id": "law-f92347d895-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章一般规定"
      ],
      "text": "中华人民共和国法律对涉外民事关系有强制性规定的，直接适用该强制性规定。",
      "order": 6
    },
    {
      "id": "law-f92347d895-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章一般规定"
      ],
      "text": "外国法律的适用将损害中华人民共和国社会公共利益的，适用中华人民共和国法律。",
      "order": 7
    },
    {
      "id": "law-f92347d895-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第一章一般规定"
      ],
      "text": "涉外民事关系适用外国法律，该国不同区域实施不同法律的，适用与该涉外民事关系有最密切联系区域的法律。",
      "order": 8
    },
    {
      "id": "law-f92347d895-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第一章一般规定"
      ],
      "text": "诉讼时效，适用相关涉外民事关系应当适用的法律。",
      "order": 9
    },
    {
      "id": "law-f92347d895-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第一章一般规定"
      ],
      "text": "涉外民事关系的定性，适用法院地法律。",
      "order": 10
    },
    {
      "id": "law-f92347d895-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第一章一般规定"
      ],
      "text": "涉外民事关系适用的外国法律，不包括该国的法律适用法。",
      "order": 11
    },
    {
      "id": "law-f92347d895-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第一章一般规定"
      ],
      "text": "涉外民事关系适用的外国法律，由人民法院、仲裁机构或者行政机关查明。当事人选择适用外国法律的，应当提供该国法律。\n不能查明外国法律或者该国法律没有规定的，适用中华人民共和国法律。",
      "order": 12
    },
    {
      "id": "law-f92347d895-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第二章民事主体"
      ],
      "text": "自然人的民事权利能力，适用经常居所地法律。",
      "order": 15
    },
    {
      "id": "law-f92347d895-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第二章民事主体"
      ],
      "text": "自然人的民事行为能力，适用经常居所地法律。\n自然人从事民事活动，依照经常居所地法律为无民事行为能力，依照行为地法律为有民事行为能力的，适用行为地法律，但涉及婚姻家庭、继承的除外。",
      "order": 16
    },
    {
      "id": "law-f92347d895-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第二章民事主体"
      ],
      "text": "宣告失踪或者宣告死亡，适用自然人经常居所地法律。",
      "order": 18
    },
    {
      "id": "law-f92347d895-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第二章民事主体"
      ],
      "text": "法人及其分支机构的民事权利能力、民事行为能力、组织机构、股东权利义务等事项，适用登记地法律。\n法人的主营业地与登记地不一致的，可以适用主营业地法律。法人的经常居所地，为其主营业地。",
      "order": 19
    },
    {
      "id": "law-f92347d895-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第二章民事主体"
      ],
      "text": "人格权的内容，适用权利人经常居所地法律。",
      "order": 21
    },
    {
      "id": "law-f92347d895-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第二章民事主体"
      ],
      "text": "代理适用代理行为地法律，但被代理人与代理人的民事关系，适用代理关系发生地法律。\n当事人可以协议选择委托代理适用的法律。",
      "order": 22
    },
    {
      "id": "law-f92347d895-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第二章民事主体"
      ],
      "text": "当事人可以协议选择信托适用的法律。当事人没有选择的，适用信托财产所在地法律或者信托关系发生地法律。",
      "order": 24
    },
    {
      "id": "law-f92347d895-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第二章民事主体"
      ],
      "text": "当事人可以协议选择仲裁协议适用的法律。当事人没有选择的，适用仲裁机构所在地法律或者仲裁地法律。",
      "order": 25
    },
    {
      "id": "law-f92347d895-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第二章民事主体"
      ],
      "text": "依照本法适用国籍国法律，自然人具有两个以上国籍的，适用有经常居所的国籍国法律；在所有国籍国均无经常居所的，适用与其有最密切联系的国籍国法律。自然人无国籍或者国籍不明的，适用其经常居所地法律。",
      "order": 26
    },
    {
      "id": "law-f92347d895-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第二章民事主体"
      ],
      "text": "依照本法适用经常居所地法律，自然人经常居所地不明的，适用其现在居所地法律。",
      "order": 27
    },
    {
      "id": "law-f92347d895-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第三章婚姻家庭"
      ],
      "text": "结婚条件，适用当事人共同经常居所地法律；没有共同经常居所地的，适用共同国籍国法律；没有共同国籍，在一方当事人经常居所地或者国籍国缔结婚姻的，适用婚姻缔结地法律。",
      "order": 29
    },
    {
      "id": "law-f92347d895-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第三章婚姻家庭"
      ],
      "text": "结婚手续，符合婚姻缔结地法律、一方当事人经常居所地法律或者国籍国法律的，均为有效。",
      "order": 30
    },
    {
      "id": "law-f92347d895-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第三章婚姻家庭"
      ],
      "text": "夫妻人身关系，适用共同经常居所地法律；没有共同经常居所地的，适用共同国籍国法律。",
      "order": 31
    },
    {
      "id": "law-f92347d895-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第三章婚姻家庭"
      ],
      "text": "夫妻财产关系，当事人可以协议选择适用一方当事人经常居所地法律、国籍国法律或者主要财产所在地法律。当事人没有选择的，适用共同经常居所地法律；没有共同经常居所地的，适用共同国籍国法律。",
      "order": 32
    },
    {
      "id": "law-f92347d895-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第三章婚姻家庭"
      ],
      "text": "父母子女人身、财产关系，适用共同经常居所地法律；没有共同经常居所地的，适用一方当事人经常居所地法律或者国籍国法律中有利于保护弱者权益的法律。",
      "order": 33
    },
    {
      "id": "law-f92347d895-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第三章婚姻家庭"
      ],
      "text": "协议离婚，当事人可以协议选择适用一方当事人经常居所地法律或者国籍国法律。当事人没有选择的，适用共同经常居所地法律；没有共同经常居所地的，适用共同国籍国法律；没有共同国籍的，适用办理离婚手续机构所在地法律。",
      "order": 34
    },
    {
      "id": "law-f92347d895-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第三章婚姻家庭"
      ],
      "text": "诉讼离婚，适用法院地法律。",
      "order": 35
    },
    {
      "id": "law-f92347d895-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第三章婚姻家庭"
      ],
      "text": "收养的条件和手续，适用收养人和被收养人经常居所地法律。收养的效力，适用收养时收养人经常居所地法律。收养关系的解除，适用收养时被收养人经常居所地法律或者法院地法律。",
      "order": 36
    },
    {
      "id": "law-f92347d895-0029",
      "articleNumber": 29,
      "displayNumber": "第二十九条",
      "path": [
        "第三章婚姻家庭"
      ],
      "text": "扶养，适用一方当事人经常居所地法律、国籍国法律或者主要财产所在地法律中有利于保护被扶养人权益的法律。",
      "order": 37
    },
    {
      "id": "law-f92347d895-0030",
      "articleNumber": 30,
      "displayNumber": "第三十条",
      "path": [
        "第三章婚姻家庭"
      ],
      "text": "监护，适用一方当事人经常居所地法律或者国籍国法律中有利于保护被监护人权益的法律。",
      "order": 38
    },
    {
      "id": "law-f92347d895-0031",
      "articleNumber": 31,
      "displayNumber": "第三十一条",
      "path": [
        "第四章继承"
      ],
      "text": "法定继承，适用被继承人死亡时经常居所地法律，但不动产法定继承，适用不动产所在地法律。",
      "order": 40
    },
    {
      "id": "law-f92347d895-0032",
      "articleNumber": 32,
      "displayNumber": "第三十二条",
      "path": [
        "第四章继承"
      ],
      "text": "遗嘱方式，符合遗嘱人立遗嘱时或者死亡时经常居所地法律、国籍国法律或者遗嘱行为地法律的，遗嘱均为成立。",
      "order": 41
    },
    {
      "id": "law-f92347d895-0033",
      "articleNumber": 33,
      "displayNumber": "第三十三条",
      "path": [
        "第四章继承"
      ],
      "text": "遗嘱效力，适用遗嘱人立遗嘱时或者死亡时经常居所地法律或者国籍国法律。",
      "order": 42
    },
    {
      "id": "law-f92347d895-0034",
      "articleNumber": 34,
      "displayNumber": "第三十四条",
      "path": [
        "第四章继承"
      ],
      "text": "遗产管理等事项，适用遗产所在地法律。",
      "order": 43
    },
    {
      "id": "law-f92347d895-0035",
      "articleNumber": 35,
      "displayNumber": "第三十五条",
      "path": [
        "第四章继承"
      ],
      "text": "无人继承遗产的归属，适用被继承人死亡时遗产所在地法律。",
      "order": 44
    },
    {
      "id": "law-f92347d895-0036",
      "articleNumber": 36,
      "displayNumber": "第三十六条",
      "path": [
        "第五章物权"
      ],
      "text": "不动产物权，适用不动产所在地法律。",
      "order": 46
    },
    {
      "id": "law-f92347d895-0037",
      "articleNumber": 37,
      "displayNumber": "第三十七条",
      "path": [
        "第五章物权"
      ],
      "text": "当事人可以协议选择动产物权适用的法律。当事人没有选择的，适用法律事实发生时动产所在地法律。",
      "order": 47
    },
    {
      "id": "law-f92347d895-0038",
      "articleNumber": 38,
      "displayNumber": "第三十八条",
      "path": [
        "第五章物权"
      ],
      "text": "当事人可以协议选择运输中动产物权发生变更适用的法律。当事人没有选择的，适用运输目的地法律。",
      "order": 48
    },
    {
      "id": "law-f92347d895-0039",
      "articleNumber": 39,
      "displayNumber": "第三十九条",
      "path": [
        "第五章物权"
      ],
      "text": "有价证券，适用有价证券权利实现地法律或者其他与该有价证券有最密切联系的法律。",
      "order": 49
    },
    {
      "id": "law-f92347d895-0040",
      "articleNumber": 40,
      "displayNumber": "第四十条",
      "path": [
        "第五章物权"
      ],
      "text": "权利质权，适用质权设立地法律。",
      "order": 50
    },
    {
      "id": "law-f92347d895-0041",
      "articleNumber": 41,
      "displayNumber": "第四十一条",
      "path": [
        "第六章债权"
      ],
      "text": "当事人可以协议选择合同适用的法律。当事人没有选择的，适用履行义务最能体现该合同特征的一方当事人经常居所地法律或者其他与该合同有最密切联系的法律。",
      "order": 52
    },
    {
      "id": "law-f92347d895-0042",
      "articleNumber": 42,
      "displayNumber": "第四十二条",
      "path": [
        "第六章债权"
      ],
      "text": "消费者合同，适用消费者经常居所地法律；消费者选择适用商品、服务提供地法律或者经营者在消费者经常居所地没有从事相关经营活动的，适用商品、服务提供地法律。",
      "order": 53
    },
    {
      "id": "law-f92347d895-0043",
      "articleNumber": 43,
      "displayNumber": "第四十三条",
      "path": [
        "第六章债权"
      ],
      "text": "劳动合同，适用劳动者工作地法律；难以确定劳动者工作地的，适用用人单位主营业地法律。劳务派遣，可以适用劳务派出地法律。",
      "order": 54
    },
    {
      "id": "law-f92347d895-0044",
      "articleNumber": 44,
      "displayNumber": "第四十四条",
      "path": [
        "第六章债权"
      ],
      "text": "侵权责任，适用侵权行为地法律，但当事人有共同经常居所地的，适用共同经常居所地法律。侵权行为发生后，当事人协议选择适用法律的，按照其协议。",
      "order": 55
    },
    {
      "id": "law-f92347d895-0045",
      "articleNumber": 45,
      "displayNumber": "第四十五条",
      "path": [
        "第六章债权"
      ],
      "text": "产品责任，适用被侵权人经常居所地法律；被侵权人选择适用侵权人主营业地法律、损害发生地法律的，或者侵权人在被侵权人经常居所地没有从事相关经营活动的，适用侵权人主营业地法律或者损害发生地法律。",
      "order": 56
    },
    {
      "id": "law-f92347d895-0046",
      "articleNumber": 46,
      "displayNumber": "第四十六条",
      "path": [
        "第六章债权"
      ],
      "text": "通过网络或者采用其他方式侵害姓名权、肖像权、名誉权、隐私权等人格权的，适用被侵权人经常居所地法律。",
      "order": 57
    },
    {
      "id": "law-f92347d895-0047",
      "articleNumber": 47,
      "displayNumber": "第四十七条",
      "path": [
        "第六章债权"
      ],
      "text": "不当得利、无因管理，适用当事人协议选择适用的法律。当事人没有选择的，适用当事人共同经常居所地法律；没有共同经常居所地的，适用不当得利、无因管理发生地法律。",
      "order": 58
    },
    {
