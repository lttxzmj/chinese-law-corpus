  ],
  "articles": [
    {
      "id": "xzfg-ac265f5311-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为保护职工健康，消除粉尘危害，防止发生尘肺病，促进生产发展，制定本条例。",
      "order": 2
    },
    {
      "id": "xzfg-ac265f5311-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "本条例适用于所有有粉尘作业的企业、事业单位。",
      "order": 3
    },
    {
      "id": "xzfg-ac265f5311-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "尘肺病系指在生产活动中吸入粉尘而发生的肺组织纤维化为主的疾病。",
      "order": 4
    },
    {
      "id": "xzfg-ac265f5311-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "地方各级人民政府要加强对尘肺病防治工作的领导。在制定本地区国民经济和社会发展计划时，要统筹安排尘肺病防治工作。",
      "order": 5
    },
    {
      "id": "xzfg-ac265f5311-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "企业、事业单位的主管部门应当根据国家卫生等有关标准，结合实际情况，制定所属企业的尘肺病防治规划，并督促其施行。\n乡镇企业主管部门，必须指定专人负责乡镇企业尘肺病的防治工作，建立监督检查制度，并指导乡镇企业对尘肺病的防治工作。",
      "order": 6
    },
    {
      "id": "xzfg-ac265f5311-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第一章总则"
      ],
      "text": "企业、事业单位的负责人，对本单位的尘肺病防治工作负有直接责任，应采取有效措施使本单位的粉尘作业场所达到国家卫生标准。",
      "order": 8
    },
    {
      "id": "xzfg-ac265f5311-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第二章防尘"
      ],
      "text": "凡有粉尘作业的企业、事业单位应采取综合防尘措施和无尘或低尘的新技术、新工艺、新设备，使作业场所的粉尘浓度不超过国家卫生标准。",
      "order": 10
    },
    {
      "id": "xzfg-ac265f5311-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第二章防尘"
      ],
      "text": "尘肺病诊断标准由卫生行政部门制定，粉尘浓度卫生标准由卫生行政部门会同劳动等有关部门联合制定。",
      "order": 11
    },
    {
      "id": "xzfg-ac265f5311-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第二章防尘"
      ],
      "text": "防尘设施的鉴定和定型制度，由劳动部门会同卫生行政部门制定。任何企业、事业单位除特殊情况外，未经上级主管部门批准，不得停止运行或者拆除防尘设施。",
      "order": 12
    },
    {
      "id": "xzfg-ac265f5311-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第二章防尘"
      ],
      "text": "防尘经费应当纳入基本建设和技术改造经费计划，专款专用，不得挪用。",
      "order": 13
    },
    {
      "id": "xzfg-ac265f5311-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第二章防尘"
      ],
      "text": "严禁任何企业、事业单位将粉尘作业转嫁、外包或以联营的形式给没有防尘设施的乡镇、街道企业或个体工商户。\n中、小学校各类校办的实习工厂或车间，禁止从事有粉尘的作业。",
      "order": 14
    },
    {
      "id": "xzfg-ac265f5311-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第二章防尘"
      ],
      "text": "职工使用的防止粉尘危害的防护用品，必须符合国家的有关标准。企业、事业单位应当建立严格的管理制度，并教育职工按规定和要求使用。\n对初次从事粉尘作业的职工，由其所在单位进行防尘知识教育和考核，考试合格后方可从事粉尘作业。\n不满十八周岁的未成年人，禁止从事粉尘作业。",
      "order": 16
    },
    {
      "id": "xzfg-ac265f5311-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第二章防尘"
      ],
      "text": "新建、改建、扩建、续建有粉尘作业的工程项目，防尘设施必须与主体工程同时设计、同时施工、同时投产。设计任务书，必须经当地卫生行政部门、劳动部门和工会组织审查同意后，方可施工。竣工验收，应由当地卫生行政部门、劳动部门和工会组织参加，凡不符合要求的，不得投产。",
      "order": 19
    },
    {
      "id": "xzfg-ac265f5311-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第二章防尘"
      ],
      "text": "作业场所的粉尘浓度超过国家卫生标准，又未积极治理，严重影响职工安全健康时，职工有权拒绝操作。",
      "order": 20
    },
    {
      "id": "xzfg-ac265f5311-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第三章监督和监测"
      ],
      "text": "卫生行政部门、劳动部门和工会组织分工协作，互相配合，对企业、事业单位的尘肺病防治工作进行监督。",
      "order": 22
    },
    {
      "id": "xzfg-ac265f5311-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第三章监督和监测"
      ],
      "text": "卫生行政部门负责卫生标准的监测；劳动部门负责劳动卫生工程技术标准的监测。\n工会组织负责组织职工群众对本单位的尘肺病防治工作进行监督，并教育职工遵守操作规程与防尘制度。",
      "order": 23
    },
    {
      "id": "xzfg-ac265f5311-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第三章监督和监测"
      ],
      "text": "凡有粉尘作业的企业、事业单位，必须定期测定作业场所的粉尘浓度。测尘结果必须向主管部门和当地卫生行政部门、劳动部门和工会组织报告，并定期向职工公布。\n从事粉尘作业的单位必须建立测尘资料档案。",
      "order": 25
    },
    {
      "id": "xzfg-ac265f5311-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第三章监督和监测"
      ],
      "text": "卫生行政部门和劳动部门，要对从事粉尘作业的企业、事业单位的测尘机构加强业务指导，并对测尘人员加强业务指导和技术培训。",
      "order": 27
    },
    {
      "id": "xzfg-ac265f5311-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第四章健康管理"
      ],
      "text": "各企业、事业单位对新从事粉尘作业的职工，必须进行健康检查。对在职和离职的从事粉尘作业的职工，必须定期进行健康检查。检查的内容、期限和尘肺病诊断标准，按卫生行政部门有关职业病管理的规定执行。",
      "order": 29
    },
    {
      "id": "xzfg-ac265f5311-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第四章健康管理"
      ],
      "text": "各企业、事业单位必须贯彻执行职业病报告制度，按期向当地卫生行政部门、劳动部门、工会组织和本单位的主管部门报告职工尘肺病发生和死亡情况。",
      "order": 30
    },
    {
      "id": "xzfg-ac265f5311-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第四章健康管理"
      ],
      "text": "各企业、事业单位对已确诊为尘肺病的职工，必须调离粉尘作业岗位，并给予治疗或疗养。尘肺病患者的社会保险待遇，按国家有关规定办理。",
      "order": 31
    },
    {
      "id": "xzfg-ac265f5311-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第五章奖励和处罚"
      ],
      "text": "对在尘肺病防治工作中做出显著成绩的单位和个人，由其上级主管部门给予奖励。",
      "order": 33
    },
    {
      "id": "xzfg-ac265f5311-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第五章奖励和处罚"
      ],
      "text": "凡违反本条例规定，有下列行为之一的，卫生行政部门和劳动部门，可视其情节轻重，给予警告、限期治理、罚款和停业整顿的处罚。但停业整顿的处罚，需经当地人民政府同意。\n(一)作业场所粉尘浓度超过国家卫生标准，逾期不采取措施的；\n(二)任意拆除防尘设施，致使粉尘危害严重的；\n(三)挪用防尘措施经费的；\n(四)工程设计和竣工验收未经卫生行政部门、劳动部门和工会组织审查同意，擅自施工、投产的；\n(五)将粉尘作业转嫁、外包或以联营的形式给没有防尘设施的乡镇、街道企业或个体工商户的；\n(六)不执行健康检查制度和测尘制度的；\n(七)强令尘肺病患者继续从事粉尘作业的；\n(八)假报测尘结果或尘肺病诊断结果的；\n(九)安排未成年人从事粉尘作业的。",
      "order": 34
    },
    {
      "id": "xzfg-ac265f5311-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第五章奖励和处罚"
      ],
      "text": "当事人对处罚不服的，可在接到处罚通知之日起十五日内，向作出处理的部门的上级机关申请复议。但是，对停业整顿的决定应当立即执行。上级机关应当在接到申请之日起三十日内作出答复。对答复不服的，可以在接到答复之日起十五日内，向人民法院起诉。",
      "order": 44
    },
    {
      "id": "xzfg-ac265f5311-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第五章奖励和处罚"
      ],
      "text": "企业、事业单位负责人和监督、监测人员玩忽职守，致使公共财产、国家和人民利益遭受损失，情节轻微的，由其主管部门给予行政处分；造成重大损失，构成犯罪的，由司法机关依法追究直接责任人员的刑事责任。",
      "order": 45
    },
    {
      "id": "xzfg-ac265f5311-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第六章附则"
      ],
      "text": "本条例由国务院卫生行政部门和劳动部门联合进行解释。",
      "order": 47
    },
    {
      "id": "xzfg-ac265f5311-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第六章附则"
      ],
      "text": "各省、自治区、直辖市人民政府应当结合当地实际情况，制定本条例的实施办法。",
      "order": 48
    },
    {
      "id": "xzfg-ac265f5311-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第六章附则"
      ],
      "text": "本条例自发布之日起施行。",
      "order": 49
    }
  ]
}
