  ],
  "articles": [
    {
      "id": "xzfg-408ce7c8b7-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了加强电力监管，规范电力监管行为，完善电力监管制度，制定本条例。",
      "order": 2
    },
    {
      "id": "xzfg-408ce7c8b7-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "电力监管的任务是维护电力市场秩序，依法保护电力投资者、经营者、使用者的合法权益和社会公共利益，保障电力系统安全稳定运行，促进电力事业健康发展。",
      "order": 3
    },
    {
      "id": "xzfg-408ce7c8b7-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "电力监管应当依法进行，并遵循公开、公正和效率的原则。",
      "order": 4
    },
    {
      "id": "xzfg-408ce7c8b7-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "国务院电力监管机构依照本条例和国务院有关规定，履行电力监管和行政执法职能；国务院有关部门依照有关法律、行政法规和国务院有关规定，履行相关的监管职能和行政执法职能。",
      "order": 5
    },
    {
      "id": "xzfg-408ce7c8b7-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "任何单位和个人对违反本条例和国家有关电力监管规定的行为有权向电力监管机构和政府有关部门举报，电力监管机构和政府有关部门应当及时处理，并依照有关规定对举报有功人员给予奖励。",
      "order": 6
    },
    {
      "id": "xzfg-408ce7c8b7-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第二章监管机构"
      ],
      "text": "国务院电力监管机构根据履行职责的需要，经国务院批准，设立派出机构。国务院电力监管机构对派出机构实行统一领导和管理。\n国务院电力监管机构的派出机构在国务院电力监管机构的授权范围内，履行电力监管职责。",
      "order": 8
    },
    {
      "id": "xzfg-408ce7c8b7-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第二章监管机构"
      ],
      "text": "电力监管机构从事监管工作的人员，应当具备与电力监管工作相适应的专业知识和业务工作经验。",
      "order": 10
    },
    {
      "id": "xzfg-408ce7c8b7-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第二章监管机构"
      ],
      "text": "电力监管机构从事监管工作的人员，应当忠于职守，依法办事，公正廉洁，不得利用职务便利谋取不正当利益，不得在电力企业、电力调度交易机构兼任职务。",
      "order": 11
    },
    {
      "id": "xzfg-408ce7c8b7-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第二章监管机构"
      ],
      "text": "电力监管机构应当建立监管责任制度和监管信息公开制度。",
      "order": 12
    },
    {
      "id": "xzfg-408ce7c8b7-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第二章监管机构"
      ],
      "text": "电力监管机构及其从事监管工作的人员依法履行电力监管职责，有关单位和人员应当予以配合和协助。",
      "order": 13
    },
    {
      "id": "xzfg-408ce7c8b7-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第二章监管机构"
      ],
      "text": "电力监管机构应当接受国务院财政、监察、审计等部门依法实施的监督。",
      "order": 14
    },
    {
      "id": "xzfg-408ce7c8b7-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第三章监管职责"
      ],
      "text": "国务院电力监管机构依照有关法律、行政法规和本条例的规定，在其职责范围内制定并发布电力监管规章、规则。",
      "order": 16
    },
    {
      "id": "xzfg-408ce7c8b7-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第三章监管职责"
      ],
      "text": "电力监管机构依照有关法律和国务院有关规定，颁发和管理电力业务许可证。",
      "order": 17
    },
    {
      "id": "xzfg-408ce7c8b7-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第三章监管职责"
      ],
      "text": "电力监管机构按照国家有关规定，对发电企业在各电力市场中所占份额的比例实施监管。",
      "order": 18
    },
    {
      "id": "xzfg-408ce7c8b7-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第三章监管职责"
      ],
      "text": "电力监管机构对发电厂并网、电网互联以及发电厂与电网协调运行中执行有关规章、规则的情况实施监管。",
      "order": 19
    },
    {
      "id": "xzfg-408ce7c8b7-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第三章监管职责"
      ],
      "text": "电力监管机构对电力市场向从事电力交易的主体公平、无歧视开放的情况以及输电企业公平开放电网的情况依法实施监管。",
      "order": 20
    },
    {
      "id": "xzfg-408ce7c8b7-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第三章监管职责"
      ],
      "text": "电力监管机构对电力企业、电力调度交易机构执行电力市场运行规则的情况，以及电力调度交易机构执行电力调度规则的情况实施监管。",
      "order": 21
    },
    {
      "id": "xzfg-408ce7c8b7-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第三章监管职责"
      ],
      "text": "电力监管机构对供电企业按照国家规定的电能质量和供电服务质量标准向用户提供供电服务的情况实施监管。",
      "order": 22
    },
    {
      "id": "xzfg-408ce7c8b7-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第三章监管职责"
      ],
      "text": "电力监管机构具体负责电力安全监督管理工作。\n国务院电力监管机构经商国务院发展改革部门、国务院安全生产监督管理部门等有关部门后，制订重大电力生产安全事故处置预案，建立重大电力生产安全事故应急处置制度。",
      "order": 23
    },
    {
      "id": "xzfg-408ce7c8b7-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第三章监管职责"
      ],
      "text": "国务院价格主管部门、国务院电力监管机构依照法律、行政法规和国务院的规定，对电价实施监管。",
      "order": 25
    },
    {
      "id": "xzfg-408ce7c8b7-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第四章监管措施"
      ],
      "text": "电力监管机构根据履行监管职责的需要，有权要求电力企业、电力调度交易机构报送与监管事项相关的文件、资料。\n电力企业、电力调度交易机构应当如实提供有关文件、资料。",
      "order": 27
    },
    {
      "id": "xzfg-408ce7c8b7-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第四章监管措施"
      ],
      "text": "国务院电力监管机构应当建立电力监管信息系统。\n电力企业、电力调度交易机构应当按照国务院电力监管机构的规定将与监管相关的信息系统接入电力监管信息系统。",
      "order": 29
    },
    {
      "id": "xzfg-408ce7c8b7-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第四章监管措施"
      ],
      "text": "电力监管机构有权责令电力企业、电力调度交易机构按照国家有关电力监管规章、规则的规定如实披露有关信息。",
      "order": 31
    },
    {
      "id": "xzfg-408ce7c8b7-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第四章监管措施"
      ],
      "text": "电力监管机构依法履行职责，可以采取下列措施，进行现场检查：\n(一)进入电力企业、电力调度交易机构进行检查；\n(二)询问电力企业、电力调度交易机构的工作人员，要求其对有关检查事项作出说明；\n(三)查阅、复制与检查事项有关的文件、资料，对可能被转移、隐匿、损毁的文件、资料予以封存；\n(四)对检查中发现的违法行为，有权当场予以纠正或者要求限期改正。",
      "order": 32
    },
    {
      "id": "xzfg-408ce7c8b7-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第四章监管措施"
      ],
      "text": "依法从事电力监管工作的人员在进行现场检查时，应当出示有效执法证件；未出示有效执法证件的，电力企业、电力调度交易机构有权拒绝检查。",
      "order": 37
    },
    {
      "id": "xzfg-408ce7c8b7-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第四章监管措施"
      ],
      "text": "发电厂与电网并网、电网与电网互联，并网双方或者互联双方达不成协议，影响电力交易正常进行的，电力监管机构应当进行协调；经协调仍不能达成协议的，由电力监管机构作出裁决。",
      "order": 38
    },
    {
      "id": "xzfg-408ce7c8b7-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第四章监管措施"
      ],
      "text": "电力企业发生电力生产安全事故，应当及时采取措施，防止事故扩大，并向电力监管机构和其他有关部门报告。电力监管机构接到发生重大电力生产安全事故报告后，应当按照重大电力生产安全事故处置预案，及时采取处置措施。\n电力监管机构按照国家有关规定组织或者参加电力生产安全事故的调查处理。",
      "order": 39
    },
    {
      "id": "xzfg-408ce7c8b7-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第四章监管措施"
      ],
      "text": "电力监管机构对电力企业、电力调度交易机构违反有关电力监管的法律、行政法规或者有关电力监管规章、规则，损害社会公共利益的行为及其处理情况，可以向社会公布。",
      "order": 41
    },
    {
      "id": "xzfg-408ce7c8b7-0029",
      "articleNumber": 29,
      "displayNumber": "第二十九条",
      "path": [
        "第五章法律责任"
      ],
      "text": "电力监管机构从事监管工作的人员有下列情形之一的，依法给予行政处分；构成犯罪的，依法追究刑事责任：\n(一)违反有关法律和国务院有关规定颁发电力业务许可证的；\n(二)发现未经许可擅自经营电力业务的行为，不依法进行处理的；\n(三)发现违法行为或者接到对违法行为的举报后，不及时进行处理的；\n(四)利用职务便利谋取不正当利益的。\n电力监管机构从事监管工作的人员在电力企业、电力调度交易机构兼任职务的，由电力监管机构责令改正，没收兼职所得；拒不改正的，予以辞退或者开除。",
      "order": 43
    },
    {
      "id": "xzfg-408ce7c8b7-0030",
      "articleNumber": 30,
      "displayNumber": "第三十条",
      "path": [
        "第五章法律责任"
      ],
      "text": "违反规定未取得电力业务许可证擅自经营电力业务的，由电力监管机构责令改正，没收违法所得，可以并处违法所得5倍以下的罚款；构成犯罪的，依法追究刑事责任。",
      "order": 49
    },
    {
      "id": "xzfg-408ce7c8b7-0031",
      "articleNumber": 31,
      "displayNumber": "第三十一条",
      "path": [
        "第五章法律责任"
      ],
      "text": "电力企业违反本条例规定，有下列情形之一的，由电力监管机构责令改正；拒不改正的，处10万元以上100万元以下的罚款；对直接负责的主管人员和其他直接责任人员，依法给予处分；情节严重的，可以吊销电力业务许可证：\n(一)不遵守电力市场运行规则的；\n(二)发电厂并网、电网互联不遵守有关规章、规则的；\n(三)不向从事电力交易的主体公平、无歧视开放电力市场或者不按照规定公平开放电网的。",
      "order": 50
    },
    {
      "id": "xzfg-408ce7c8b7-0032",
      "articleNumber": 32,
      "displayNumber": "第三十二条",
      "path": [
        "第五章法律责任"
      ],
      "text": "供电企业未按照国家规定的电能质量和供电服务质量标准向用户提供供电服务的，由电力监管机构责令改正，给予警告；情节严重的，对直接负责的主管人员和其他直接责任人员，依法给予处分。",
      "order": 54
    },
    {
      "id": "xzfg-408ce7c8b7-0033",
      "articleNumber": 33,
      "displayNumber": "第三十三条",
      "path": [
        "第五章法律责任"
      ],
      "text": "电力调度交易机构违反本条例规定，不按照电力市场运行规则组织交易的，由电力监管机构责令改正；拒不改正的，处10万元以上100万元以下的罚款；对直接负责的主管人员和其他直接责任人员，依法给予处分。\n电力调度交易机构工作人员泄露电力交易内幕信息的，由电力监管机构责令改正，并依法给予处分。",
      "order": 55
    },
    {
      "id": "xzfg-408ce7c8b7-0034",
      "articleNumber": 34,
      "displayNumber": "第三十四条",
      "path": [
        "第五章法律责任"
      ],
      "text": "电力企业、电力调度交易机构有下列情形之一的，由电力监管机构责令改正；拒不改正的，处5万元以上50万元以下的罚款，对直接负责的主管人员和其他直接责任人员，依法给予处分；构成犯罪的，依法追究刑事责任：\n(一)拒绝或者阻碍电力监管机构及其从事监管工作的人员依法履行监管职责的；\n(二)提供虚假或者隐瞒重要事实的文件、资料的；\n(三)未按照国家有关电力监管规章、规则的规定披露有关信息的。",
      "order": 57
    },
    {
      "id": "xzfg-408ce7c8b7-0035",
      "articleNumber": 35,
      "displayNumber": "第三十五条",
      "path": [
        "第五章法律责任"
      ],
      "text": "本条例规定的罚款和没收的违法所得，按照国家有关规定上缴国库。",
      "order": 61
    },
    {
      "id": "xzfg-408ce7c8b7-0036",
      "articleNumber": 36,
      "displayNumber": "第三十六条",
      "path": [
        "第六章附则"
      ],
      "text": "电力企业应当按照国务院价格主管部门、财政部门的有关规定缴纳电力监管费。",
      "order": 63
    },
    {
      "id": "xzfg-408ce7c8b7-0037",
      "articleNumber": 37,
      "displayNumber": "第三十七条",
      "path": [
        "第六章附则"
      ],
      "text": "本条例自2005年5月1日起施行。",
      "order": 64
    }
  ]
}
