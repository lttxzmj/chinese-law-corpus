  "articles": [
    {
      "id": "xzfg-6eb08fd160-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了规范国际货物运输代理行为，保障进出口货物收货人、发货人和国际货物运输代理企业的合法权益，促进对外贸易的发展，制定本规定。",
      "order": 2
    },
    {
      "id": "xzfg-6eb08fd160-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "本规定所称国际货物运输代理业，是指接受进出口货物收货人、发货人的委托，以委托人的名义或者以自己的名义，为委托人办理国际货物运输及相关业务并收取服务报酬的行业。",
      "order": 3
    },
    {
      "id": "xzfg-6eb08fd160-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "国际货物运输代理企业必须依法取得中华人民共和国企业法人资格。",
      "order": 4
    },
    {
      "id": "xzfg-6eb08fd160-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "国务院对外贸易经济合作主管部门负责对全国的国际货物运输代理业实施监督管理。\n省、自治区、直辖市和经济特区的人民政府对外经济贸易主管部门(以下简称地方对外贸易主管部门)依照本规定，在国务院对外贸易经济合作主管部门授权的范围内，负责对本行政区域内的国际货物运输代理业实施监督管理。",
      "order": 5
    },
    {
      "id": "xzfg-6eb08fd160-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "对国际货物运输代理业实施监督管理，应当遵循下列原则：\n(一)适应对外贸易发展的需要，促进国际货物运输代理业的合理布局；\n(二)保护公平竞争，促进国际货物运输代理业服务质量的提高。",
      "order": 7
    },
    {
      "id": "xzfg-6eb08fd160-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第一章总则"
      ],
      "text": "从事国际货物运输代理业务的企业，应当遵守中华人民共和国的法律、行政法规、接受有关行业主管机关依照有关法律、行政法规规定实施的监督管理。",
      "order": 10
    },
    {
      "id": "xzfg-6eb08fd160-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第二章设立条件"
      ],
      "text": "设立国际货物运输代理企业，根据其行业特点，应当具备下列条件：\n(一)有与其从事的国际货物运输代理业务相适应的专业人员；\n(二)有固定的营业场所和必要的营业设施；\n(三)有稳定的进出口货源市场。",
      "order": 12
    },
    {
      "id": "xzfg-6eb08fd160-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第二章设立条件"
      ],
      "text": "国际货物运输代理企业的注册资本最低限额应当符合下列要求：\n(一)经营海上国际货物运输代理业务的，注册资本最低限额为500万元人民币；\n(二)经营航空国际货物运输代理业务的，注册资本最低限额为300万元人民币；\n(三)经营陆路国际货物运输代理业务或者国际快递业务的，注册资本最低限额为200万元人民币。\n经营前款两项以上业务的，注册资本最低限额为其中最高一项的限额。\n国际货物运输代理企业每设立一个从事国际货物运输代理业务的分支机构，应当增加注册资本50万元。",
      "order": 16
    },
    {
      "id": "xzfg-6eb08fd160-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第三章审批程序"
      ],
      "text": "申请设立国际货物运输代理企业，申请人应当向拟设立国际货物运输代理企业所在地的地方对外贸易主管部门提出申请，由地方对外贸易主管部门提出意见后，转报国务院对外贸易经济合作主管部门审查批准。\n国务院部门在北京的直属企业申请在北京设立国际货物运输代理企业的，可以直接向国务院对外贸易经济合作主管部门提出申请，由国务院对外贸易经济合作主管部门审查批准。",
      "order": 23
    },
    {
      "id": "xzfg-6eb08fd160-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第三章审批程序"
      ],
      "text": "申请设立国际货物运输代理企业，应当报送下列文件：\n(一)申请书；\n(二)企业章程草案；\n(三)负责人和主要业务人员的姓名、职务和身份证明；\n(四)资信证明和营业设施情况；\n(五)国务院对外贸易经济合作主管部门规定的其他文件。",
      "order": 25
    },
    {
      "id": "xzfg-6eb08fd160-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第三章审批程序"
      ],
      "text": "地方对外贸易主管部门应当自收到申请设立国际货物运输代理企业的申请书和其他文件之日起45天内提出意见，并转报国务院对外贸易经济合作主管部门。\n国务院对外贸易经济合作主管部门应当自收到申请设立国际货物运输代理企业的申请书和其他文件之日起45天内决定批准或者不批准；对批准设立的国际货物运输代理企业，颁发批准证书。",
      "order": 31
    },
    {
      "id": "xzfg-6eb08fd160-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第三章审批程序"
      ],
      "text": "国际货物运输代理企业应当凭国务院对外贸易经济合作主管部门颁发的批准证书，依照有关法律、行政法规的规定，办理企业登记、税务登记手续。",
      "order": 33
    },
    {
      "id": "xzfg-6eb08fd160-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第三章审批程序"
      ],
      "text": "申请人自收到批准证书之日起180天内无正当理由未开始营业的，国务院对外贸易经济合作主管部门应当撤销批准证书。",
      "order": 34
    },
    {
      "id": "xzfg-6eb08fd160-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第三章审批程序"
      ],
      "text": "批准证书的有效期为3年。\n国际货物运输代理企业在批准证书有效期届满时，需要继续从事国际货物运输代理业务的，应当在批准证书有效期届满的30天前向国务院对外贸易经济合作主管部门申请换领批准证书。\n国际货物运输代理企业未依照前款规定申请换领批准证书的，其从事国际货物运输代理业务的资格自批准证书有效期届满时自动丧失。",
      "order": 35
    },
    {
      "id": "xzfg-6eb08fd160-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第三章审批程序"
      ],
      "text": "国际货物运输代理企业终止营业，应当依照本规定第九条规定的设立申请批准程序，报告所在地的地方对外贸易主管部门或者国务院对外贸易经济合作主管部门并缴销批准证书。",
      "order": 38
    },
    {
      "id": "xzfg-6eb08fd160-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第三章审批程序"
      ],
      "text": "国际货物运输代理企业申请设立从事国际货物运输代理业务的分支机构，应当依照本章规定的程序办理。",
      "order": 39
    },
    {
      "id": "xzfg-6eb08fd160-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第四章业务"
      ],
      "text": "国际货物运输代理企业可以接受委托，代为办理下列部分或者全部业务：\n(一)订舱、仓储；\n(二)货物的监装、监卸，集装箱拼装拆箱；\n(三)国际多式联运；\n(四)国际快递，私人信函除外；\n(五)报关、报检、报验、保险；\n(六)缮制有关单证，交付运费，结算、交付杂费；\n(七)其他国际货物运输代理业务。\n国际货物运输代理企业应当在批准的业务经营范围内，从事经营活动。从事前款有关业务，依照有关法律、行政法规的规定，需经有关主管机关注册的，还应当向有关主管机关注册。\n国际货物运输代理企业之间也可以相互委托办理本条第一款规定的业务。",
      "order": 41
    },
    {
      "id": "xzfg-6eb08fd160-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第四章业务"
      ],
      "text": "国际货物运输代理企业应当遵循安全、迅速、准确、节省、方便的经营方针，为进出口货物的收货人、发货人提供服务。",
      "order": 51
    },
    {
      "id": "xzfg-6eb08fd160-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第四章业务"
      ],
      "text": "国际货物运输代理企业，必须依照国家有关规定确定收费标准，并在其营业地点予以公布。",
      "order": 52
    },
    {
      "id": "xzfg-6eb08fd160-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第四章业务"
      ],
      "text": "国际货物运输代理企业从事国际货物运输代理业务，必须使用经税务机关核准的发票。",
      "order": 53
    },
    {
      "id": "xzfg-6eb08fd160-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第四章业务"
      ],
      "text": "国际货物运输代理企业应当于每年3月底前，向其所在地的地方对外贸易主管部门报送上一年度的经营情况资料。",
      "order": 54
    },
    {
      "id": "xzfg-6eb08fd160-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第四章业务"
      ],
      "text": "国际货物运输代理企业不得有下列行为：\n(一)以不正当竞争手段从事经营活动；\n(二)出借、出租或者转让批准证书和有关国际货物运输代理业务单证。",
      "order": 55
    },
    {
      "id": "xzfg-6eb08fd160-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第五章罚则"
      ],
      "text": "国际货物运输代理企业违反本规定第十九条、第二十一条规定的，由国务院对外贸易经济合作主管部门予以警告并责令限期改正；未在限期内改正的，可以撤销其批准证书。",
      "order": 59
    },
    {
      "id": "xzfg-6eb08fd160-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第五章罚则"
      ],
      "text": "国际货物运输代理企业违反本规定第十七条第二款、第二十条、第二十二条规定的，由国务院对外贸易经济合作主管部门予以警告、责令停业整顿直至撤销其批准证书；工商行政管理、海关、税务等有关主管机关并可依照有关法律、行政法规的规定予以处罚。",
      "order": 60
    },
    {
      "id": "xzfg-6eb08fd160-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第五章罚则"
      ],
      "text": "违反本规定的规定，擅自从事本规定第十七条规定的国际货物运输代理业务的，由国务院对外贸易经济合作主管部门取缔非法经营活动，并由工商行政管理机关依照有关法律、行政法规的规定予以处罚。",
      "order": 61
    },
    {
      "id": "xzfg-6eb08fd160-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第五章罚则"
      ],
      "text": "违反本规定，构成犯罪的，依法追究刑事责任。",
      "order": 62
    },
    {
      "id": "xzfg-6eb08fd160-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第六章附则"
      ],
      "text": "国际货物运输代理企业可以依法设立国际货物运输代理业协会，协会依照其章程对会员进行协调指导，提供服务。",
      "order": 64
    },
    {
      "id": "xzfg-6eb08fd160-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第六章附则"
      ],
      "text": "本规定自发布之日起施行。",
      "order": 65
    }
  ]
}
