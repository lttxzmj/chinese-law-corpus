{
  "id": "xzfg-558c210f2b",
  "officialId": "国务院令第330号",
  "title": "中华人民共和国保障措施条例",
  "category": "行政法规",
  "issuingAuthority": "国务院",
  "promulgationDate": "2004-03-31",
  "effectiveDate": "",
  "status": "effective",
