  ],
  "articles": [
    {
      "id": "xzfg-4d8cdb56d9-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [
        "第一章总则"
      ],
      "text": "为了加强对破坏性地震应急活动的管理，减轻地震灾害损失，保障国家财产和公民人身、财产安全，维护社会秩序，制定本条例。",
      "order": 2
    },
    {
      "id": "xzfg-4d8cdb56d9-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [
        "第一章总则"
      ],
      "text": "在中华人民共和国境内从事破坏性地震应急活动，必须遵守本条例。",
      "order": 3
    },
    {
      "id": "xzfg-4d8cdb56d9-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [
        "第一章总则"
      ],
      "text": "地震应急工作实行政府领导、统一管理和分级、分部门负责的原则。",
      "order": 4
    },
    {
      "id": "xzfg-4d8cdb56d9-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [
        "第一章总则"
      ],
      "text": "各级人民政府应当加强地震应急的宣传、教育工作，提高社会防震减灾意识。",
      "order": 5
    },
    {
      "id": "xzfg-4d8cdb56d9-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [
        "第一章总则"
      ],
      "text": "任何组织和个人都有参加地震应急活动的义务。\n中国人民解放军和中国人民武装警察部队是地震应急工作的重要力量。",
      "order": 6
    },
    {
      "id": "xzfg-4d8cdb56d9-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [
        "第二章应急机构"
      ],
      "text": "国务院防震减灾工作主管部门指导和监督全国地震应急工作。国务院有关部门按照各自的职责，具体负责本部门的地震应急工作。",
      "order": 9
    },
    {
      "id": "xzfg-4d8cdb56d9-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [
        "第二章应急机构"
      ],
      "text": "造成特大损失的严重破坏性地震发生后，国务院设立抗震救灾指挥部，国务院防震减灾工作主管部门为其办事机构；国务院有关部门设立本部门的地震应急机构。",
      "order": 10
    },
    {
      "id": "xzfg-4d8cdb56d9-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [
        "第二章应急机构"
      ],
      "text": "县级以上地方人民政府防震减灾工作主管部门指导和监督本行政区域内的地震应急工作。\n破坏性地震发生后，有关县级以上地方人民政府应当设立抗震救灾指挥部，对本行政区域内的地震应急工作实行集中领导，其办事机构设在本级人民政府防震减灾工作主管部门或者本级人民政府指定的其他部门；国务院另有规定的，从其规定。",
      "order": 11
    },
    {
      "id": "xzfg-4d8cdb56d9-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [
        "第三章应急预案"
      ],
      "text": "国家的破坏性地震应急预案，由国务院防震减灾工作主管部门会同国务院有关部门制定，报国务院批准。",
      "order": 14
    },
    {
      "id": "xzfg-4d8cdb56d9-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [
        "第三章应急预案"
      ],
      "text": "国务院有关部门应当根据国家的破坏性地震应急预案，制定本部门的破坏性地震应急预案，并报国务院防震减灾工作主管部门备案。",
      "order": 15
    },
    {
      "id": "xzfg-4d8cdb56d9-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [
        "第三章应急预案"
      ],
      "text": "根据地震灾害预测，可能发生破坏性地震地区的县级以上地方人民政府防震减灾工作主管部门应当会同同级有关部门以及有关单位，参照国家的破坏性地震应急预案，制定本行政区域内的破坏性地震应急预案，报本级人民政府批准；省、自治区和人口在100万以上的城市的破坏性地震应急预案，还应当报国务院防震减灾工作主管部门备案。",
      "order": 16
    },
    {
      "id": "xzfg-4d8cdb56d9-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [
        "第三章应急预案"
      ],
      "text": "部门和地方制定破坏性地震应急预案，应当从本部门或者本地区的实际情况出发，做到切实可行。",
      "order": 17
    },
    {
      "id": "xzfg-4d8cdb56d9-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [
        "第三章应急预案"
      ],
      "text": "破坏性地震应急预案应当包括下列主要内容：\n(一)应急机构的组成和职责；\n(二)应急通信保障；\n(三)抢险救援的人员、资金、物资准备；\n(四)灾害评估准备；\n(五)应急行动方案。",
      "order": 18
    },
    {
      "id": "xzfg-4d8cdb56d9-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [
        "第三章应急预案"
      ],
      "text": "制定破坏性地震应急预案的部门和地方，应当根据震情的变化以及实施中发现的问题，及时对其制定的破坏性地震应急预案进行修订、补充；涉及重大事项调整的，应当报经原批准机关同意。",
      "order": 24
    },
    {
      "id": "xzfg-4d8cdb56d9-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [
        "第四章临震应急"
      ],
      "text": "地震临震预报，由省、自治区、直辖市人民政府依照国务院有关发布地震预报的规定统一发布，其他任何组织或者个人不得发布地震预报。\n任何组织或者个人都不得传播有关地震的谣言。发生地震谣传时，防震减灾工作主管部门应当协助人民政府迅速予以平息和澄清。",
      "order": 26
    },
    {
      "id": "xzfg-4d8cdb56d9-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [
        "第四章临震应急"
      ],
      "text": "破坏性地震临震预报发布后，有关省、自治区、直辖市人民政府可以宣布预报区进入临震应急期，并指明临震应急期的起止时间。\n临震应急期一般为10日；必要时，可以延长10日。",
      "order": 28
    },
    {
      "id": "xzfg-4d8cdb56d9-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [
        "第四章临震应急"
      ],
      "text": "在临震应急期，有关地方人民政府应当根据震情，统一部署破坏性地震应急预案的实施工作，并对临震应急活动中发生的争议采取紧急处理措施。",
      "order": 30
    },
    {
      "id": "xzfg-4d8cdb56d9-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [
        "第四章临震应急"
      ],
      "text": "在临震应急期，各级防震减灾工作主管部门应当协助本级人民政府对实施破坏性地震应急预案工作进行检查。",
      "order": 31
    },
    {
      "id": "xzfg-4d8cdb56d9-0019",
      "articleNumber": 19,
      "displayNumber": "第十九条",
      "path": [
        "第四章临震应急"
      ],
      "text": "在临震应急期，有关地方人民政府应当根据实际情况，向预报区的居民以及其他人员提出避震撤离的劝告；情况紧急时，应当有组织地进行避震疏散。",
      "order": 32
    },
    {
      "id": "xzfg-4d8cdb56d9-0020",
      "articleNumber": 20,
      "displayNumber": "第二十条",
      "path": [
        "第四章临震应急"
      ],
      "text": "在临震应急期，有关地方人民政府有权在本行政区域内紧急调用物资、设备、人员和占用场地，任何组织或者个人都不得阻拦；调用物资、设备或者占用场地的，事后应当及时归还或者给予补偿。",
      "order": 33
    },
    {
      "id": "xzfg-4d8cdb56d9-0021",
      "articleNumber": 21,
      "displayNumber": "第二十一条",
      "path": [
        "第四章临震应急"
      ],
      "text": "在临震应急期，有关部门应当对生命线工程和次生灾害源采取紧急防护措施。",
      "order": 34
    },
    {
      "id": "xzfg-4d8cdb56d9-0022",
      "articleNumber": 22,
      "displayNumber": "第二十二条",
      "path": [
        "第五章震后应急"
      ],
      "text": "破坏性地震发生后，有关的省、自治区、直辖市人民政府应当宣布灾区进入震后应急期，并指明震后应急期的起止时间。\n震后应急期一般为10日；必要时，可以延长20日。",
      "order": 36
    },
    {
      "id": "xzfg-4d8cdb56d9-0023",
      "articleNumber": 23,
      "displayNumber": "第二十三条",
      "path": [
        "第五章震后应急"
      ],
      "text": "破坏性地震发生后，抗震救灾指挥部应当及时组织实施破坏性地震应急预案，及时将震情、灾情及其发展趋势等信息报告上一级人民政府。",
      "order": 38
    },
    {
      "id": "xzfg-4d8cdb56d9-0024",
      "articleNumber": 24,
      "displayNumber": "第二十四条",
      "path": [
        "第五章震后应急"
      ],
      "text": "防震减灾工作主管部门应当加强现场地震监测预报工作，并及时会同有关部门评估地震灾害损失；灾情调查结果，应当及时报告本级人民政府抗震救灾指挥部和上一级防震减灾工作主管部门。",
      "order": 39
    },
    {
      "id": "xzfg-4d8cdb56d9-0025",
      "articleNumber": 25,
      "displayNumber": "第二十五条",
      "path": [
        "第五章震后应急"
      ],
      "text": "交通、铁路、民航等部门应当尽快恢复被损毁的道路、铁路、水港、空港和有关设施，并优先保证抢险救援人员、物资的运输和灾民的疏散。其他部门有交通运输工具的，应当无条件服从抗震救灾指挥部的征用或者调用。",
      "order": 40
    },
    {
      "id": "xzfg-4d8cdb56d9-0026",
      "articleNumber": 26,
      "displayNumber": "第二十六条",
      "path": [
        "第五章震后应急"
      ],
      "text": "通信部门应当尽快恢复被破坏的通信设施，保证抗震救灾通信畅通。其他部门有通信设施的，应当优先为破坏性地震应急工作服务。",
      "order": 41
    },
    {
      "id": "xzfg-4d8cdb56d9-0027",
      "articleNumber": 27,
      "displayNumber": "第二十七条",
      "path": [
        "第五章震后应急"
      ],
      "text": "供水、供电部门应当尽快恢复被破坏的供水、供电设施，保证灾区用水、用电。",
      "order": 42
    },
    {
      "id": "xzfg-4d8cdb56d9-0028",
      "articleNumber": 28,
      "displayNumber": "第二十八条",
      "path": [
        "第五章震后应急"
      ],
      "text": "卫生部门应当立即组织急救队伍，利用各种医疗设施或者建立临时治疗点，抢救伤员，及时检查、监测灾区的饮用水源、食品等，采取有效措施防止和控制传染病的暴发流行，并向受灾人员提供精神、心理卫生方面的帮助。医药部门应当及时提供救灾所需药品。其他部门应当配合卫生、医药部门，做好卫生防疫以及伤亡人员的抢救、处理工作。",
      "order": 43
    },
    {
      "id": "xzfg-4d8cdb56d9-0029",
      "articleNumber": 29,
      "displayNumber": "第二十九条",
      "path": [
        "第五章震后应急"
      ],
      "text": "民政部门应当迅速设置避难场所和救济物资供应点，提供救济物品等，保障灾民的基本生活，做好灾民的转移和安置工作。其他部门应当支持、配合民政部门妥善安置灾民。",
      "order": 44
    },
    {
      "id": "xzfg-4d8cdb56d9-0030",
      "articleNumber": 30,
      "displayNumber": "第三十条",
      "path": [
        "第五章震后应急"
      ],
      "text": "公安部门应当加强灾区的治安管理和安全保卫工作，预防和制止各种破坏活动，维护社会治安，保证抢险救灾工作顺利进行，尽快恢复社会秩序。",
      "order": 45
    },
    {
      "id": "xzfg-4d8cdb56d9-0031",
      "articleNumber": 31,
      "displayNumber": "第三十一条",
      "path": [
        "第五章震后应急"
      ],
      "text": "石油、化工、水利、电力、建设等部门和单位以及危险品生产、储运等单位，应当按照各自的职责，对可能发生或者已经发生次生灾害的地点和设施采取紧急处置措施，并加强监视、控制，防止灾害扩展。\n公安消防机构应当严密监视灾区火灾的发生；出现火灾时，应当组织力量抢救人员和物资，并采取有效防范措施，防止火势扩大、蔓延。",
      "order": 46
    },
    {
      "id": "xzfg-4d8cdb56d9-0032",
      "articleNumber": 32,
      "displayNumber": "第三十二条",
      "path": [
        "第五章震后应急"
      ],
      "text": "广播电台、电视台等新闻单位应当根据抗震救灾指挥部提供的情况，按照规定及时向公众发布震情、灾情等有关信息，并做好宣传、报道工作。",
      "order": 48
    },
    {
      "id": "xzfg-4d8cdb56d9-0033",
      "articleNumber": 33,
      "displayNumber": "第三十三条",
      "path": [
        "第五章震后应急"
      ],
      "text": "抗震救灾指挥部可以请求非灾区的人民政府接受并妥善安置灾民和提供其他救援。",
      "order": 49
    },
    {
      "id": "xzfg-4d8cdb56d9-0034",
      "articleNumber": 34,
      "displayNumber": "第三十四条",
      "path": [
        "第五章震后应急"
      ],
      "text": "破坏性地震发生后，国内非灾区提供的紧急救援，由抗震救灾指挥部负责接受和安排；国际社会提供的紧急救援，由国务院民政部门负责接受和安排；国外红十字会和国际社会通过中国红十字会提供的紧急救援，由中国红十字会负责接受和安排。",
      "order": 50
    },
    {
      "id": "xzfg-4d8cdb56d9-0035",
      "articleNumber": 35,
      "displayNumber": "第三十五条",
      "path": [
        "第五章震后应急"
      ],
      "text": "因严重破坏性地震应急的需要，可以在灾区实行特别管制措施。省、自治区、直辖市行政区域内的特别管制措施，由省、自治区、直辖市人民政府决定；跨省、自治区、直辖市的特别管制措施，由有关省、自治区、直辖市人民政府共同决定或者由国务院决定；中断干线交通或者封锁国境的特别管制措施，由国务院决定。\n特别管制措施的解除，由原决定机关宣布。",
      "order": 51
    },
    {
      "id": "xzfg-4d8cdb56d9-0036",
      "articleNumber": 36,
      "displayNumber": "第三十六条",
      "path": [
        "第六章奖励和处罚"
      ],
      "text": "在破坏性地震应急活动中有下列事迹之一的，由其所在单位、上级机关或者防震减灾工作主管部门给予表彰或者奖励：\n(一)出色完成破坏性地震应急任务的；\n(二)保护国家、集体和公民的财产或者抢救人员有功的；\n(三)及时排除险情，防止灾害扩大，成绩显著的；\n(四)对地震应急工作提出重大建议，实施效果显著的；\n(五)因震情、灾情测报准确和信息传递及时而减轻灾害损失的；\n(六)及时供应用于应急救灾的物资和工具或者节约经费开支，成绩显著的；\n(七)有其他特殊贡献的。",
      "order": 54
    },
    {
      "id": "xzfg-4d8cdb56d9-0037",
      "articleNumber": 37,
      "displayNumber": "第三十七条",
      "path": [
        "第六章奖励和处罚"
      ],
      "text": "有下列行为之一的，对负有直接责任的主管人员和其他直接责任人员依法给予行政处分；属于违反治安管理行为的，依照治安管理处罚法的规定给予处罚；构成犯罪的，依法追究刑事责任：\n(一)不按照本条例规定制定破坏性地震应急预案的；\n(二)不按照破坏性地震应急预案的规定和抗震救灾指挥部的要求实施破坏性地震应急预案的；\n(三)违抗抗震救灾指挥部命令，拒不承担地震应急任务的；\n(四)阻挠抗震救灾指挥部紧急调用物资、人员或者占用场地的；\n(五)贪污、挪用、盗窃地震应急工作经费或者物资的；\n(六)有特定责任的国家工作人员在临震应急期或者震后应急期不坚守岗位，不及时掌握震情、灾情，临阵脱逃或者玩忽职守的；\n(七)在临震应急期或者震后应急期哄抢国家、集体或者公民的财产的；\n(八)阻碍抗震救灾人员执行职务或者进行破坏活动的；\n(九)不按照规定和实际情况报告灾情的；\n(十)散布谣言，扰乱社会秩序，影响破坏性地震应急工作的；\n(十一)有对破坏性地震应急工作造成危害的其他行为的。",
      "order": 62
    },
    {
      "id": "xzfg-4d8cdb56d9-0038",
      "articleNumber": 38,
      "displayNumber": "第三十八条",
      "path": [
        "第七章附则"
      ],
      "text": "本条例下列用语的含义：\n(一)“地震应急”，是指为了减轻地震灾害而采取的不同于正常工作程序的紧急防灾和抢险行动；\n(二)“破坏性地震”，是指造成一定数量的人员伤亡和经济损失的地震事件；\n(三)“严重破坏性地震”，是指造成严重的人员伤亡和经济损失，使灾区丧失或者部分丧失自我恢复能力，需要国家采取对抗行动的地震事件；\n(四)“生命线工程”，是指对社会生活、生产有重大影响的交通、通信、供水、排水、供电、供气、输油等工程系统；\n(五)“次生灾害源”，是指因地震而可能引发水灾、火灾、爆炸等灾害的易燃易爆物品、有毒物质贮存设施、水坝、堤岸等。",
      "order": 75
    },
    {
      "id": "xzfg-4d8cdb56d9-0039",
      "articleNumber": 39,
      "displayNumber": "第三十九条",
      "path": [
        "第七章附则"
      ],
      "text": "本条例自1995年4月1日起施行。",
      "order": 81
    }
  ]
}
