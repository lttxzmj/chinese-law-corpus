{
  "id": "law-782a466a52",
  "officialId": "",
  "title": "中华人民共和国国籍法",
  "category": "法律",
  "issuingAuthority": "全国人民代表大会",
  "promulgationDate": "1980-09-10",
  "effectiveDate": "1980-09-10",
  "status": "effective",
  "source": {
    "metadataPath": "data/laws/law-782a466a52/metadata.json",
    "docxPath": "data/laws/law-782a466a52/official.docx",
    "pdfPath": "data/laws/law-782a466a52/official.pdf"
  },
  "paragraphCount": 26,
  "sectionCount": 0,
  "articleCount": 18,
  "sections": [],
  "articles": [
    {
      "id": "law-782a466a52-0001",
      "articleNumber": 1,
      "displayNumber": "第一条",
      "path": [],
      "text": "中华人民共和国国籍的取得、丧失和恢复，都适用本法。",
      "order": 1
    },
    {
      "id": "law-782a466a52-0002",
      "articleNumber": 2,
      "displayNumber": "第二条",
      "path": [],
      "text": "中华人民共和国是统一的多民族的国家，各民族的人都具有中国国籍。",
      "order": 2
    },
    {
      "id": "law-782a466a52-0003",
      "articleNumber": 3,
      "displayNumber": "第三条",
      "path": [],
      "text": "中华人民共和国不承认中国公民具有双重国籍。",
      "order": 3
    },
    {
      "id": "law-782a466a52-0004",
      "articleNumber": 4,
      "displayNumber": "第四条",
      "path": [],
      "text": "父母双方或一方为中国公民，本人出生在中国，具有中国国籍。",
      "order": 4
    },
    {
      "id": "law-782a466a52-0005",
      "articleNumber": 5,
      "displayNumber": "第五条",
      "path": [],
      "text": "父母双方或一方为中国公民，本人出生在外国，具有中国国籍；但父母双方或一方为中国公民并定居在外国，本人出生时即具有外国国籍的，不具有中国国籍。",
      "order": 5
    },
    {
      "id": "law-782a466a52-0006",
      "articleNumber": 6,
      "displayNumber": "第六条",
      "path": [],
      "text": "父母无国籍或国籍不明，定居在中国，本人出生在中国，具有中国国籍。",
      "order": 6
    },
    {
      "id": "law-782a466a52-0007",
      "articleNumber": 7,
      "displayNumber": "第七条",
      "path": [],
      "text": "外国人或无国籍人，愿意遵守中国宪法和法律，并具有下列条件之一的，可以经申请批准加入中国国籍：\n一、中国人的近亲属；\n二、定居在中国的；\n三、有其它正当理由。",
      "order": 7
    },
    {
      "id": "law-782a466a52-0008",
      "articleNumber": 8,
      "displayNumber": "第八条",
      "path": [],
      "text": "申请加入中国国籍获得批准的，即取得中国国籍；被批准加入中国国籍的，不得再保留外国国籍。",
      "order": 11
    },
    {
      "id": "law-782a466a52-0009",
      "articleNumber": 9,
      "displayNumber": "第九条",
      "path": [],
      "text": "定居外国的中国公民，自愿加入或取得外国国籍的，即自动丧失中国国籍。",
      "order": 12
    },
    {
      "id": "law-782a466a52-0010",
      "articleNumber": 10,
      "displayNumber": "第十条",
      "path": [],
      "text": "中国公民具有下列条件之一的，可以经申请批准退出中国国籍：\n一、外国人的近亲属；\n二、定居在外国的；\n三、有其它正当理由。",
      "order": 13
    },
    {
      "id": "law-782a466a52-0011",
      "articleNumber": 11,
      "displayNumber": "第十一条",
      "path": [],
      "text": "申请退出中国国籍获得批准的，即丧失中国国籍。",
      "order": 17
    },
    {
      "id": "law-782a466a52-0012",
      "articleNumber": 12,
      "displayNumber": "第十二条",
      "path": [],
      "text": "国家工作人员和现役军人，不得退出中国国籍。",
      "order": 18
    },
    {
      "id": "law-782a466a52-0013",
      "articleNumber": 13,
      "displayNumber": "第十三条",
      "path": [],
      "text": "曾有过中国国籍的外国人，具有正当理由，可以申请恢复中国国籍；被批准恢复中国国籍的，不得再保留外国国籍。",
      "order": 19
    },
    {
      "id": "law-782a466a52-0014",
      "articleNumber": 14,
      "displayNumber": "第十四条",
      "path": [],
      "text": "中国国籍的取得、丧失和恢复，除第九条规定的以外，必须办理申请手续。未满十八周岁的人，可由其父母或其他法定代理人代为办理申请。",
      "order": 20
    },
    {
      "id": "law-782a466a52-0015",
      "articleNumber": 15,
      "displayNumber": "第十五条",
      "path": [],
      "text": "受理国籍申请的机关，在国内为当地市、县公安局，在国外为中国外交代表机关和领事机关。",
      "order": 21
    },
    {
      "id": "law-782a466a52-0016",
      "articleNumber": 16,
      "displayNumber": "第十六条",
      "path": [],
      "text": "加入、退出和恢复中国国籍的申请，由中华人民共和国公安部审批。经批准的，由公安部发给证书。",
      "order": 22
    },
    {
      "id": "law-782a466a52-0017",
      "articleNumber": 17,
      "displayNumber": "第十七条",
      "path": [],
      "text": "本法公布前，已经取得中国国籍的或已经丧失中国国籍的，继续有效。",
      "order": 23
    },
    {
      "id": "law-782a466a52-0018",
      "articleNumber": 18,
      "displayNumber": "第十八条",
      "path": [],
      "text": "本法自公布之日起施行。",
      "order": 24
    }
  ]
}
